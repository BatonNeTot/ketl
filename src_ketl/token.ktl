//🫖ketl

export class Token {
    export enum Type: u8 {
        ID,
        LITERAL_INTEGER, LITERAL_STRING, LITERAL_CHAR,
        PARENTHESIS_LEFT, PARENTHESIS_RIGHT,
        CURLY_LEFT, CURLY_RIGHT,
        SQUARE_LEFT, SQUARE_RIGHT,
        DOT, COMMA, QUESTION_MARK,
        DOLLAR, COLON, AT,
        ARROW_RIGHT, DOUBLE_ARROW_RIGHT, TERMINATION_CHARACTER,
        LOGICAL_NOT, LOGICAL_AND, LOGICAL_OR,
        LESS, LESS_OR_EQUAL,
        GREATER, GREATER_OR_EQUAL,
        EQUAL, NOT_EQUAL,
        BITWISE_NOT, BITWISE_AND, BITWISE_OR,
        BITWISE_XOR, BITWISE_SHIFT_LEFT, BITWISE_SHIFT_RIGHT,
        INCREMENT, DECREMENT,
        PLUS, MINUS,
        MULTIPLY, DIVIDE, REMAINDER,
        CONCAT,
        ASSIGN,
        ASSIGN_PLUS, ASSIGN_MINUS, 
        ASSIGN_MULTIPLY, ASSIGN_DIVIDE, ASSIGN_REMAINDER,
        ASSIGN_CONCAT,
        ASSIGN_BITWISE_SHIFT_LEFT, ASSIGN_BITWISE_SHIFT_RIGHT,
        ASSIGN_BITWISE_AND, ASSIGN_BITWISE_OR, ASSIGN_BITWISE_XOR,
        I8, I16, I32, I64,
        U8, U16, U32, U64,
        F32, F64,

        BOOL,
        BREAK,
        CASE,
        CEXPORT,
        CHAR,
        CIMPORT,
        CLASS,
        CONST,
        CONTINUE,
        DEFAULT,
        DO,
        ELSE,
        ENUM,
        EXPORT,
        EXTEND,
        FALSE,
        FN,
        FOR,
        FROM,
        IF,
        IMPORT,
        MIMIC,
        NULL,
        RAW,
        RETURN,
        SHARED,
        STRUCT,
        SWITCH,
        TRUE,
        UNION,
        UNPACK,
        VAR,
        VOID,
        WHILE,
        EOF,
        ERROR,
    }
    
    export mimic Length = u16;
    export mimic Offset = u32;

    var type: Type;
    var length: Length;
    var offset: Offset;
}