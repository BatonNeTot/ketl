
export class Token {
    export enum Type : u8 {
        ID,
        LITERAL_NULL, LITERAL_INTEGER, LITERAL_STRING, LITERAL_CHAR,
        PARENTHESIS_LEFT, PARENTHESIS_RIGHT,
        CURLY_LEFT, CURLY_RIGHT,
        SQUARE_LEFT, SQUARE_RIGHT,
        DOT, COMMA, QUESTION_MARK, DOLLAR, COLON, ARROW_RIGHT, TERMINATION_CHARACTER,
        LOGICAL_NOT, LOGICAL_AND, LOGICAL_OR,
        LESS, LESS_OR_EQUAL, GREATER, GREATER_OR_EQUAL, EQUAL, NOT_EQUAL,
        BITWISE_NOT, BITWISE_AND, BITWISE_OR, BITWISE_XOR, BITWISE_SHIFT_LEFT, BITWISE_SHIFT_RIGHT,
        INCREMENT, DECREMENT, PLUS, MINUS, MULTIPLY, DIVIDE, REMAINDER,
        ASSIGN,
        ASSIGN_PLUS, ASSIGN_MINUS, ASSIGN_MULTIPLY, ASSIGN_DIVIDE, ASSIGN_REMAINDER,
        ASSIGN_BITWISE_SHIFT_LEFT, ASSIGN_BITWISE_SHIFT_RIGHT, ASSIGN_BITWISE_AND, ASSIGN_BITWISE_OR, ASSIGN_BITWISE_XOR,
        I8, I16, I32, I64, U8, U16, U32, U64, F32, F64,
        BOOL,
        BREAK,
        CASE,
        CHAR,
        CIMPORT,
        CLASS,
        CONST,
        CONTINUE,
        DEFAULT,
        DO,
        ELSE,
        ENUM,
        EXPORT,
        FALSE,
        FN,
        FOR,
        IF,
        IMPORT,
        MIMIC,
        NONE,
        RAW,
        RETURN,
        STRUCT,
        SWITCH,
        TRUE,
        UNION,
        VAR,
        WHILE,
        EOF,
        ERROR,
    }
    
    export mimic Length = u16;
    export mimic Offset = u32;
    export mimic Iterator = u32;

    var type : Type;
    var length : Length;
    var offset : Offset;
}