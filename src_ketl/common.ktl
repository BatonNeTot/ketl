export class ArrayHeader {
    var data : raw;
    var capacity : u64;
    var size : u64;
    var is_slice : bool;
}

var prime_capacities = u32[31]{
    /*1, */3, 11, 23, 53, 97, 193, 389,
    769, 1543, 3079, 6151, 12289,
    24593, 49157, 98317, 196613, 393241,
    786433, 1572869, 3145739, 6291469,
    12582917, 25165843, 50331653, 100663319,
    201326611, 402653189, 805306457,
    1610612741, 3221225473, 4294967291
};

export class HashMap {

    export class Bucket {
        var next: Bucket;
        var hash: u64;
        var key: raw;
        var value: raw;
    }

    var buckets: Bucket[];
    var equality: (raw, raw) => bool;
    var hasher: (raw) => u64;
	var size: u32;
    var capacity_index: u32;

    export fn construct(equality: (raw, raw) => bool, hasher: (raw) => u64) => HashMap {
        var initial_capacity_index: u32;
        var initial_capacity = prime_capacities[initial_capacity_index];

        var buckets = Bucket[initial_capacity];
        
        var self = HashMap();
        self.buckets = buckets;
        self.equality = equality;
        self.hasher = hasher;
        return self;
    }

    export fn get_or_null(self: HashMap, key: raw) => Bucket {
        var capacity = prime_capacities[self.capacity_index];
        var hash = self.hasher(key);
        var index = hash % capacity;
        var bucket = self.buckets[index];
    
        while (bucket != null) {
            if (bucket.hash == hash && self.equality(bucket.key, key)) {
                return bucket;
            }
    
            bucket = bucket.next;
        }
        return null;
    }

    export fn get_or_insert(self: HashMap, key: raw, value: raw) => Bucket {
        var capacity = prime_capacities[self.capacity_index];
        var hash = self.hasher(key);
        var index = hash % capacity;
        var bucket = self.buckets[index];
    
        while (bucket != null) {
            if (bucket.hash == hash && self.equality(bucket.key, key)) {
                return bucket;
            }
    
            bucket = bucket.next;
        }
            
        var buckets = self.buckets;
    
        self.size += 1;
        if (self.size > capacity) {
            var new_capacity_index = self.capacity_index + 1;
            assert(new_capacity_index < prime_capacities.size);

            self.capacity_index = new_capacity_index;
            var new_capacity = prime_capacities[new_capacity_index];
            var new_buckets = Bucket[new_capacity];
            
            self.buckets = new_buckets;
    
            var i: u32;
            while (i < capacity) {
                bucket = buckets[i];
                while (bucket != null) {
                    var next = bucket.next;
    
                    var new_index = bucket.hash % new_capacity;
                    bucket.next = new_buckets[new_index];
                    new_buckets[new_index] = bucket;
    
                    bucket = next;
                }

                i += 1;
            }
            
            index = hash % new_capacity;
            buckets = new_buckets;
        }
    
        bucket = Bucket();

        bucket.hash = hash;
        bucket.key = key;
        bucket.value = value;
        bucket.next = buckets[index];

        buckets[index] = bucket;
        return bucket;
    }

    // returns true if erase was successful
    export fn erase(self: HashMap, bucket: Bucket) => bool {
        var capacity = prime_capacities[self.capacity_index];
        var index = bucket.hash % capacity;
        var head_bucket = self.buckets[index];
    
        if (head_bucket == bucket) {
            self.buckets[index] = bucket.next;
            return true;
        }
    
        while (head_bucket != null) {
            if (head_bucket.next == bucket) {
                head_bucket.next = bucket.next;
                return true;
            }
            head_bucket = head_bucket.next;
        }

        return false;
    }

    export fn clear(self: HashMap) {
        self.size = 0;
    }
}

export class IntHashMap {

    extend HashMap;
    
    fn is_equal(lhs: raw, rhs: raw) => bool {
        return lhs == rhs;
    }

    fn get_hash(key: raw) => u64 {
        return key$cast(u64);
    }

    export fn construct() => IntHashMap {
        return HashMap.construct(is_equal, get_hash)$cast(IntHashMap);
    }

    export fn get_or_null(self: IntHashMap, key: u64) => HashMap.Bucket {
        return HashMap.get_or_null(self, key$cast(raw));
    }

    export fn get_or_insert(self: IntHashMap, key: u64, value: raw) => HashMap.Bucket {
        return HashMap.get_or_insert(self, key$cast(raw), value);
    }
}

export class StrHashMap {

    extend HashMap;
    
    fn is_equal(lhs: raw, rhs: raw) => bool {
        return lhs$cast(str) == rhs$cast(str);
    }

    export fn construct() => StrHashMap {
        return HashMap.construct(is_equal, get_hash)$cast(StrHashMap);
    }

    // TODO make m's and p's bigger
    shared m1: u32 = 1000000007;
    shared m2: u32 = 1000000009;

    shared MAX_STRING_LENGTH: u64 = 100;

    shared pow_p1 = u64[MAX_STRING_LENGTH]{
        1, 31, 961, 29791, 923521, 28629151, 
        887503681, 512613922, 891031477, 621975598, 
        281243405, 718545499, 274910315, 522219709, 
        188810867, 853136842, 447241920, 864499429, 
        799482117, 783945459, 302309061, 371580828, 
        519005591, 89173209, 764369465, 695453254, 
        559050727, 330572418, 247744888, 680091479, 
        82835702, 567906748, 605109069, 758381013, 
        509811242, 804148397, 928600139, 786604113, 
        384727335, 926547308, 722966352, 411956758, 
        770659414, 890441673, 603691674, 714441768, 
        147694654, 578534246, 934561507, 971406521, 
        113601941, 521660150, 171464538, 315400643, 
        777419870, 100015802, 100489841, 115185050, 
        570736529, 692832280, 477800533, 811816425, 
        166309000, 155578965, 822947887, 511384322, 
        852913877, 440330005, 650230064, 157131844, 
        871087136, 3701027, 114731837, 556686926, 
        257294587, 976132148, 260096378, 62987662, 
        952617515, 531142762, 465425510, 428190712, 
        273911981, 491271355, 229411900, 111768851, 
        464834360, 409865062, 705816838, 880321831, 
        289976572, 989273676, 667483746, 691995986, 
        451875419, 8137891, 252274621, 820513202, 
        435909087, 513181606
    };
    shared pow_p2 = u64[MAX_STRING_LENGTH]{
        1, 37, 1369, 50653, 1874161, 69343957, 
        565726391, 931876287, 479422313, 738625428, 
        329140593, 178201833, 593467767, 958307190, 
        457365715, 922531311, 133658201, 945353401, 
        978075531, 188794323, 985389897, 459425865, 
        998756861, 954003533, 298130406, 30824923, 
        140522142, 199319209, 374810670, 867994673, 
        115802613, 284696645, 533775775, 749703504, 
        739029405, 344087742, 731246346, 56114559, 
        76238665, 820830587, 370731449, 717063496, 
        531349118, 659917195, 416935999, 426631828, 
        785377501, 58967276, 181789194, 726200124, 
        869404354, 167960810, 214549916, 938346829, 
        718832367, 596797345, 81501567, 15557952, 
        575644224, 298836099, 56935564, 106615850, 
        944786423, 957097345, 412601450, 266253515, 
        851379974, 501058759, 539173921, 949434906, 
        129091207, 776374623, 725860799, 856849329, 
        703424894, 26720844, 988671228, 580835112, 
        490898955, 163261173, 40663347, 504543830, 
        668121548, 720497060, 658390986, 360466266, 
        337251725, 478313717, 697607376, 811472687, 
        24489149, 906098513, 525644684, 448853137, 
        607565925, 479939027, 757743846, 36522050, 
        351315841, 998686009
    };

    fn get_hash(key: raw) => u64 {
        return get_string_hash(key$cast(str));
    }

    fn get_string_hash(string: str) => u64 {
        if (string == null) {
            return 0;
        }
        assert(string.size < MAX_STRING_LENGTH);

        var first_part: u32;
        var second_part: u32;

        var counter: u64;

        while (counter < string.size) {
            var symbol = string[counter];

            if (counter >= MAX_STRING_LENGTH) {
                return 0;
            }

            first_part = ((first_part + (symbol - ' ')$cast(u64) * pow_p1[counter]) % m1)$cast(u32);
            second_part = ((second_part + (symbol - ' ')$cast(u64) * pow_p2[counter]) % m2)$cast(u32);

            counter += 1;
        }

        return (first_part$cast(u64) << 32) + second_part;
    }

    export fn get_or_null(self: StrHashMap, key: str) => HashMap.Bucket {
        return HashMap.get_or_null(self, key$cast(raw));
    }

    export fn get_or_insert(self: StrHashMap, key: str, value: raw) => HashMap.Bucket {
        return HashMap.get_or_insert(self, key$cast(raw), value);
    }
}

export fn align_forward(size: u64, alignment: u8) => u64 {
    return (size + (alignment - 1)) & ~(alignment - 1);
}

export class StringBuffer {
    var buffer : str;

    export fn construct() => StringBuffer {
        var obj = StringBuffer();
        obj.buffer = "";
        return obj;
    }

    export fn write(buffer: StringBuffer, message : str) => StringBuffer {
        buffer.buffer ..= message;
        return buffer;
    }
} 

export class FilePointer {
    var offset : u32;
    var pointer : u32;
    var length : u32;

    export fn construct(offset: u32, pointer: u32, length: u32) => FilePointer {
        var obj = FilePointer();
        obj.offset = offset; 
        obj.pointer = pointer; 
        obj.length = length; 
        return obj;
    }
}

cimport printf(message : cstr)

export fn print(message: str) {
    printf(message$cast(cstr));
}

export fn println(message: str) {
    printf(message$cast(cstr));
    printf("\n"$cast(cstr));
}

export class File {

    cimport fopen(path: cstr, mode: cstr) => File
    cimport fseek(file: File, offset: i64, origin: i32)
    cimport ftell(file: File) => i64
    cimport fread(buffer: raw, size: u64, count: u64, file: File)
    cimport ferror(file: File) => i32
    cimport fclose(file: File)

    cimport malloc(size : u64) => raw

    class IntPointer {
        var value: i32;
    }

    cimport _errno() => IntPointer

    fn get_last_error() => i32 {
        return _errno().value;
    }

    export fn read(path: str) => str {
        var file = fopen(path$cast(cstr), "rb"$cast(cstr));
        if (file == null) {
            print("error opening file '");
            print(path);
            print("':");
            println(get_last_error()$cast(str));
            assert(false);
        }
        
        var SEEK_END: i32 = 2;
        fseek(file, 0, SEEK_END);
        var filesize = ftell(file);
        assert(filesize >= 0);

        var buffer = malloc(filesize$cast(u64));

        var SEEK_SET: i32 = 0;
        fseek(file, 0, SEEK_SET);
        fread(buffer, 1, filesize$cast(u64), file);
        assert(ferror(file) == 0);

        fclose(file);

        var string = ArrayHeader();

        string.data = buffer;
        string.capacity = filesize$cast(u64);
        string.size = string.capacity;

        return string$cast(raw)$cast(str);
    }
} 

export class LogAccum {
    var err : StringBuffer;
    var full : StringBuffer;

    export fn construct() => LogAccum {
        var obj = LogAccum();
        obj.err = StringBuffer.construct();
        obj.full = StringBuffer.construct();
        return obj;
    }

    export fn check(self: LogAccum) => bool {
        if (self.err.buffer.size > 0) {
            print(self.err.buffer);
            return false;
        } else {
            return true;
        }
    }

    export class LogInfo {
        var lines_offsets : u32[];
        var filename : str;
        var source : str;

        export fn get_line_offset(info : LogInfo, line : u32) => u32 {
            if (line >= info.lines_offsets.size) {
                return info.source.size$cast(u32) - 1;
            }
            return info.lines_offsets[line];
        }

        export fn find_line(info : LogInfo, offset : u32) => u32 {
            assert(info.lines_offsets.size < 5000);
            var lhs : u32 = 0;
            // TODO make cast deduce type from the left side
            var rhs : u32 = info.lines_offsets.size$cast(u32);

            while (lhs + 1 < rhs) {
                var mid : u32 = (lhs + rhs) / 2;
                var mid_offset : u32 = info.lines_offsets[mid];
                if (mid_offset < offset) {
                    lhs = mid;
                } else if (offset < mid_offset) {
                    rhs = mid;
                } else {
                    return mid;
                }
            }
            return lhs;
        }
    }

    export fn error(accum : LogAccum, info : LogInfo, pointer : FilePointer, message : str) {
        var line = info->find_line(pointer.offset);
        var offset = pointer.offset - info->get_line_offset(line);

        accum.err->write(info.filename)
            ->write(":")->write((line + 1)$cast(str))
            ->write(":")->write((offset + 1)$cast(str))
            ->write(": error: ")->write(message)
            ->write("\n");

        // TODO show the source and error placement
    }

    export fn warning(accum : LogAccum, info : LogInfo, pointer : FilePointer, message : str) {
        // TODO
    }
}