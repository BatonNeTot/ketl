//🫖ketl

from token import Token

export class Lexer {
    var tokens : Token[];
    var lines_offsets : u32[];
    var filename : str;
    var source : str;
    var offset : u32;
    var token_iterator : Token.Iterator;
    
    fn init(lexer : Lexer) {
        lexer.tokens = Token[0];
        lexer.lines_offsets = u32[0];
    }

    fn get_line_offset(lexer : Lexer, line : u32) -> u32 {
        if (line >= lexer.lines_offsets.size) {
            return lexer.source.size$cast(u32);
        }
        return lexer.lines_offsets[line];
    }

    fn find_line(lexer : Lexer, offset : u32) -> u32 {
        var lhs : u32 = 0;
        // TODO make cast deduce type from the left side
        var rhs : u32 = lexer.lines_offsets.size$cast(u32);

        while (lhs + 1 < rhs) {
            var mid : u32 = (lhs + rhs) / 2;
            var mid_offset : u32 = lexer.lines_offsets[mid];
            if (mid_offset < offset) {
                lhs = mid;
            } else if (offset < mid_offset) {
                rhs = mid;
            } else {
                return mid;
            }
        }
        return lhs;
    }
    
    fn is_space(symbol : char) -> bool {
        return symbol == ' ' || (symbol >= '\t' && symbol <= '\r');
    }

    fn is_numeric(symbol : char) -> bool {
        return symbol >= '0' && symbol <= '9';
    }

    fn is_alpha(symbol : char) -> bool {
        return (symbol >= 'a' && symbol <= 'z') || (symbol >= 'A' && symbol <= 'Z');
    }

    fn increment_line(lexer : Lexer) {
        lexer.lines_offsets ..= lexer.offset;
    }

    fn add_token(lexer : Lexer, type : Token.Type, length : u32) {
        var token = Token();
        token.type = type;
        // TODO make cast deduce type from the left side
        token.length = length$cast(Token.Length);
        token.offset = lexer.offset;
        lexer.tokens ..= token;
        lexer.offset += length;
    }

    fn get_symbol(lexer : Lexer) -> char {
        var symbol = '\0';
        var offset = lexer.offset;
        if (offset < lexer.source.size) {
            symbol = lexer.source[offset];
        }
        return symbol;
    }

    fn parse_next_line(lexer : Lexer, next_symbol : char) -> bool {
        if (next_symbol == '\r') {

            var offset = lexer.offset;
            if (offset + 1 < lexer.source.size && lexer.source[offset + 1] == '\n') {
                lexer.offset += 2;
            } else {
                lexer.offset += 1;
            }
            lexer@increment_line();
            return true;
        }

        if (next_symbol == '\n') {
            lexer.offset += 2;
            lexer@increment_line();
            return true;
        }

        return false;
    }

    fn parse_comments(lexer : Lexer, next_symbol : char) -> bool {
        var offset = lexer.offset;
        if (next_symbol != '/' || offset + 1 >= lexer.source.size) {
            return false;
        }

        next_symbol = lexer.source[offset + 1];

        // single line comment
        if (next_symbol == '/') {
            lexer.offset += 2;
            while (true) {
                next_symbol = lexer@get_symbol();
                if (next_symbol == '\0' || lexer@parse_next_line(next_symbol)) {
                    break;
                }
                lexer.offset += 1;
            }
            return true;
        }

        // multiline comment
        if (next_symbol == '*') {
            lexer.offset += 2;
            while (true) {
                next_symbol = lexer@get_symbol();
                if (lexer@parse_next_line(next_symbol)) {
                    continue;
                }

                if (next_symbol == '\0') {
                    // TODO ERROR
                    break;
                }

                if (next_symbol == '*' && lexer.offset + 1 < lexer.source.size && lexer.source[lexer.offset + 1] == '/') {
                    lexer.offset += 2;
                    break;
                }

                lexer.offset += 1;
            }

            return true;
        }

        return false;
    }

    fn parse_literal_char(lexer : Lexer, next_symbol : char) -> bool {
        if (next_symbol != '\'') {
            return false;
        }

        var char_length : u32 = 1;
        var char_offset = lexer.offset += 1;

        if (lexer@get_symbol() == '\\') {
            // TODO replace with increment
            char_length += 1;
        }

        if (lexer@parse_next_line(next_symbol)) {
            // TODO ERROR and decide how to cleverly restore lexing
            assert(false);
        }


        var end_mark_offset = char_offset + char_length;

        // error correction
        if (end_mark_offset >= lexer.source.size || lexer.source[end_mark_offset] != '\'') {
            // TODO ERROR
            if (end_mark_offset >= lexer.source.size) {
                char_length = lexer.source.size$cast(u32) - char_offset;
            }
            lexer@add_token(Token.Type.LITERAL_CHAR, char_length);
            return true;
        }

        lexer@add_token(Token.Type.LITERAL_CHAR, char_length);
        lexer.offset += 1;
        return true;
    }

    fn parse_literal_string(lexer : Lexer, next_symbol : char) -> bool {
        if (next_symbol != '"') {
            return false;
        }

        var literal_start_offset = lexer.offset += 1;
        while (true) {
            next_symbol = lexer@get_symbol();
            if (lexer@parse_next_line(next_symbol)) {
                // TODO ERROR
                continue;
            }

            if (next_symbol == '\0') {
                // TODO ERROR
                break;
            }
            
            if (next_symbol == '"') {
                break;
            }

            lexer.offset += 1;
        }

        var literal_length = lexer.offset - literal_start_offset;
        lexer.offset = literal_start_offset;
        lexer@add_token(Token.Type.LITERAL_STRING, literal_length);
        lexer.offset += 1;
        return true;
    }

    fn parse_literal_integer(lexer : Lexer, next_symbol : char) -> bool {
        if (!lexer.is_numeric(next_symbol)) {
            return false;
        }

        var literal_start_offset = lexer.offset;
        lexer.offset += 1;


        while (true) {
            next_symbol = lexer@get_symbol();
            if (!lexer.is_numeric(next_symbol)) {
                break;
            }
            
            lexer.offset += 1;
        }

        var literal_length = lexer.offset - literal_start_offset;
        lexer.offset = literal_start_offset;
        lexer@add_token(Token.Type.LITERAL_INTEGER, literal_length);
        return true;
    }
    
    fn parse_id(lexer : Lexer, next_symbol : char) -> bool {
        if (next_symbol != '_' && !lexer.is_alpha(next_symbol)) {
            return false;
        }

        var id_start_offset = lexer.offset;
        lexer.offset = id_start_offset + 1;

        while (true) {
            next_symbol = lexer@get_symbol();
            if (next_symbol != '_' && !lexer.is_alpha(next_symbol) && !lexer.is_numeric(next_symbol)) {
                break;
            }
            
            lexer.offset += 1;
        }

        var id_length = lexer.offset - id_start_offset;
        lexer.offset = id_start_offset;

        var first_symbol = lexer@get_symbol();
        switch (first_symbol) {
            case 'b' -> {
                if ("break" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.BREAK, id_length);
                    return true;
                }
            }
            case 'c' -> {
                if ("case" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.CASE, id_length);
                    return true;
                }
                if ("cexport" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.CEXPORT, id_length);
                    return true;
                }
                if ("cimport" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.CIMPORT, id_length);
                    return true;
                }
                if ("class" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.CLASS, id_length);
                    return true;
                }
                if ("continue" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.CONTINUE, id_length);
                    return true;
                }
            }
            case 'd' -> {
                if ("default" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.DEFAULT, id_length);
                    return true;
                }
                if ("do" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.DO, id_length);
                    return true;
                }
            }
            case 'e' -> {
                if ("else" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.ELSE, id_length);
                    return true;
                }
                if ("enum" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.ENUM, id_length);
                    return true;
                }
                if ("export" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.EXPORT, id_length);
                    return true;
                }
            }
            case 'f' -> {
                if ("false" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.LITERAL_FALSE, id_length);
                    return true;
                }
                if ("fn" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.FN, id_length);
                    return true;
                }
                if ("for" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.FOR, id_length);
                    return true;
                }
                if ("from" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.FROM, id_length);
                    return true;
                }
            }
            case 'i' -> {
                if ("if" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.IF, id_length);
                    return true;
                }
                if ("import" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.IMPORT, id_length);
                    return true;
                }
                if ("i64" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.I64, id_length);
                    return true;
                }
            }
            case 'm' -> {
                if ("mimic" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.MIMIC, id_length);
                    return true;
                }
            }
            case 'n' -> {
                if ("none" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.NONE, id_length);
                    return true;
                }
                if ("null" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.LITERAL_NULL, id_length);
                    return true;
                }
            }
            case 'r' -> {
                if ("raw" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.RAW, id_length);
                    return true;
                }
                if ("return" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.RETURN, id_length);
                    return true;
                }
            }
            case 't' -> {
                if ("true" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.LITERAL_TRUE, id_length);
                    return true;
                }
            }
            case 'u' -> {
                if ("unpack" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.UNPACK, id_length);
                    return true;
                }
            }
            case 'v' -> {
                if ("var" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.VAR, id_length);
                    return true;
                }
            }
            case 'w' -> {
                if ("while" == lexer.source[lexer.offset:lexer.offset + id_length]) {
                    lexer@add_token(Token.Type.WHILE, id_length);
                    return true;
                }
            }
        }

        lexer@add_token(Token.Type.ID, id_length);
        return true;
    }
    
    fn parse_operator(lexer : Lexer, next_symbol : char) -> bool {
        switch (next_symbol) {  
            case '(' -> {
                lexer@add_token(Token.Type.PARENTHESIS_LEFT, 1);
                return true;
            } 
            case ')' -> {
                lexer@add_token(Token.Type.PARENTHESIS_RIGHT, 1);
                return true;
            } 
            case '{' -> {
                lexer@add_token(Token.Type.CURLY_LEFT, 1);
                return true;
            } 
            case '}' -> {
                lexer@add_token(Token.Type.CURLY_RIGHT, 1);
                return true;
            } 
            case '[' -> {
                lexer@add_token(Token.Type.SQUARE_LEFT, 1);
                return true;
            } 
            case ']' -> {
                lexer@add_token(Token.Type.SQUARE_RIGHT, 1);
                return true;
            } 
            case '.' -> {
                
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '.') {
                    lexer.offset += 2;
                    var third_symbol = lexer@get_symbol();
                    lexer.offset -= 2;

                    if (third_symbol == '=') {
                        lexer@add_token(Token.Type.ASSIGN_CONCAT, 3);
                    } else {
                        lexer@add_token(Token.Type.CONCAT, 2);
                    }
                } else {
                    lexer@add_token(Token.Type.DOT, 1);
                }
                return true;
            } 
            case ',' -> {
                lexer@add_token(Token.Type.COMMA, 1);
                return true;
            } 
            case '?' -> {
                lexer@add_token(Token.Type.QUESTION_MARK, 1);
                return true;
            } 
            case '$' -> {
                lexer@add_token(Token.Type.DOLLAR, 1);
                return true;
            } 
            case '@' -> {
                lexer@add_token(Token.Type.AT, 1);
                return true;
            } 
            case ':' -> {
                lexer@add_token(Token.Type.COLON, 1);
                return true;
            } 
            case ';' -> {
                lexer@add_token(Token.Type.TERMINATION_CHARACTER, 1);
                return true;
            } 
            case '~' -> {
                lexer@add_token(Token.Type.BITWISE_NOT, 1);
                return true;
            } 
            case '=' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;

                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.EQUAL, 2);
                } else {
                    lexer@add_token(Token.Type.ASSIGN, 1);
                }
                return true;
            } 
            case '^' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_BITWISE_XOR, 2);
                } else {
                    lexer@add_token(Token.Type.BITWISE_XOR, 1);
                }
                return true;
            } 
            case '*' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_MULTIPLY, 2);
                } else {
                    lexer@add_token(Token.Type.MULTIPLY, 1);
                }
                return true;
            } 
            case '/' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_DIVIDE, 2);
                } else {
                    lexer@add_token(Token.Type.DIVIDE, 1);
                }
                return true;
            } 
            case '%' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_REMAINDER, 2);
                } else {
                    lexer@add_token(Token.Type.REMAINDER, 1);
                }
                return true;
            } 
            case '!' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.NOT_EQUAL, 2);
                } else {
                    lexer@add_token(Token.Type.LOGICAL_NOT, 1);
                }
                return true;
            } 
            case '+' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_PLUS, 2);
                } else if (second_symbol == '+') {
                    lexer@add_token(Token.Type.INCREMENT, 2);
                } else {
                    lexer@add_token(Token.Type.PLUS, 1);
                }
                return true;
            } 
            case '-' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_MINUS, 2);
                } else if (second_symbol == '-') {
                    lexer@add_token(Token.Type.DECREMENT, 2);
                } else if (second_symbol == '>') {
                    lexer@add_token(Token.Type.ARROW_RIGHT, 2);
                } else {
                    lexer@add_token(Token.Type.MINUS, 1);
                }
                return true;
            } 
            case '&' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_BITWISE_AND, 2);
                } else if (second_symbol == next_symbol) {
                    lexer@add_token(Token.Type.LOGICAL_AND, 2);
                } else {
                    lexer@add_token(Token.Type.BITWISE_AND, 1);
                }
                return true;
            } 
            case '|' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.ASSIGN_BITWISE_OR, 2);
                } else if (second_symbol == next_symbol) {
                    lexer@add_token(Token.Type.LOGICAL_OR, 2);
                } else {
                    lexer@add_token(Token.Type.BITWISE_OR, 1);
                }
                return true;
            } 
            case '<' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.LESS_OR_EQUAL, 2);
                } else if (second_symbol == next_symbol) {
                    lexer.offset += 2;
                    var third_symbol = lexer@get_symbol();
                    lexer.offset -= 2;

                    if (third_symbol == '=') {
                        lexer@add_token(Token.Type.ASSIGN_BITWISE_SHIFT_LEFT, 3);
                    } else {
                        lexer@add_token(Token.Type.BITWISE_SHIFT_LEFT, 2);
                    }
                } else {
                    lexer@add_token(Token.Type.LESS, 1);
                }
                return true;
            } 
            case '>' -> {
                lexer.offset += 1;
                var second_symbol = lexer@get_symbol();
                lexer.offset -= 1;
                
                if (second_symbol == '=') {
                    lexer@add_token(Token.Type.GREATER_OR_EQUAL, 2);
                } else if (second_symbol == next_symbol) {
                    lexer.offset += 2;
                    var third_symbol = lexer@get_symbol();
                    lexer.offset -= 2;

                    if (third_symbol == '=') {
                        lexer@add_token(Token.Type.ASSIGN_BITWISE_SHIFT_RIGHT, 3);
                    } else {
                        lexer@add_token(Token.Type.BITWISE_SHIFT_RIGHT, 2);
                    }
                } else {
                    lexer@add_token(Token.Type.GREATER, 1);
                }
                return true;
            } 
            default -> return false;
        }
    }
    
    fn build_tokens(lexer : Lexer, filename : str, source : str) {
        lexer.filename = filename;
        lexer.source = source;
        lexer.offset = 0;
        lexer.token_iterator = 0;
        lexer.tokens@clear();
        lexer.lines_offsets@clear();
        lexer.lines_offsets ..= 0;

        while (true) {
            var next_symbol = lexer@get_symbol();

            if (next_symbol == '\0') {
                break;
            }

            if (lexer@parse_next_line(next_symbol)) {
                continue;
            }

            if (lexer.is_space(next_symbol)) {
                lexer.offset += 1;
                continue;
            }

            if (lexer@parse_comments(next_symbol)) {
                continue;
            }

            if (lexer@parse_literal_char(next_symbol)) {
                continue;
            }

            if (lexer@parse_literal_string(next_symbol)) {
                continue;
            }

            if (lexer@parse_literal_integer(next_symbol)) {
                continue;
            }

            if (lexer@parse_id(next_symbol)) {
                continue;
            }

            if (lexer@parse_operator(next_symbol)) {
                continue;
            }

            // TODO ERROR
            break;
        }

        lexer@add_token(Token.Type.EOF, 0);
    }
}
