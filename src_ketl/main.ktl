from module import Modules
from common import StrHashMap
import common

#entry
fn main(args: str[]) {
    eval("test_case");
}

cexport fn eval(module_name: str) {
    var module = Modules.instance->load(module_name, null, null, true);
    if (module != null && !module.has_errors) {
        module->print_asm();
    }
}