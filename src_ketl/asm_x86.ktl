//🫖ketl

from common import IntHashMap
from common import align_forward

from hir import HIR

cimport printf(message: cstr)

export class ASMX86 {

    enum ABI: u8 {
        WINDOWS,
        SYSTEM_V,
        DEFAULT,
    }

    export enum Tag: u8 {
        LABEL,
        DIRECTIVE,

        PUSH,
        POP,

        MOV,
        LEA,

        MOVSX8,
        MOVSX16,
        MOVSX32,

        MOVZX8,
        MOVZX16,

        ADD,
        SUB,
        NEG,
        MUL,
        IMUL,
        DIV,
        IDIV,
        
        AND,
        OR,
        XOR,
        NOT,

        CMP,
        TEST,

        SETE,
        SETZ = SETE,
        SETNE,
        SETNZ = SETNE,

        SETG,
        SETNLE = SETG,
        SETGE,
        SETNL = SETGE,
        SETL,
        SETNGE = SETL,
        SETLE,
        SETNG = SETLE,

        JMP,

        JE,
        JZ = JE,
        JNE,
        JNZ = JNE,

        CALL,
        RET,
    }

    export enum Size: u8 {
        Bit8    = 1,
        Bit16   = 2,
        Bit32   = 4,
        Bit64   = 8,
        Ptr     = 8, // sizeof(void*)
        None    = 0,
    }

    export enum ArgType: u8 {
        EMPTY,
        M,         // ModRM:r/m (r, w)
        RM,        // ModRM:reg (w),        ModRM:r/m (r)
        MR,        // ModRM:r/m (w),        ModRM:reg (r)
        MI,        // ModRM:r/m (r, w),     imm
        MI_CHAR,   // ModRM:r/m (r, w),     char
        JI,        // .imm
    }

    export enum Reg: u8 {
        AX,
        CX,
        DX,
        BX,
        SP,
        BP,
        SI,
        DI,
        R8,
        R9,
        R10,
        R11,
        R12,
        R13,
        R14,
        R15,
        None,
    }

    export class ModRM {
        var indir: bool;
        var label: bool;
        var base: Reg;
        var index: Reg;
        var scale_power: Size;
        var disp: i32;
        var literal: str;

        fn construct_empty() => ModRM {
            var self = ModRM();

            self.base = Reg.None;
            self.index = Reg.None;

            return self;
        }

        fn construct_literal(literal: str) => ModRM {
            var self = ModRM();

            self.label = true;
            self.base = Reg.None;
            self.index = Reg.None;
            self.literal = literal;

            return self;
        }

        fn construct_reg(reg: Reg) => ModRM {
            var self = ModRM();

            self.base = reg;
            self.index = Reg.None;

            return self;
        }

        fn construct_indir_base_disp(base: Reg, disp: i32) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.base = base;
            self.index = Reg.None;
            self.disp = disp;

            return self;
        }

        fn construct_indir_base_label(base: Reg, label: str, disp: i32) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.label = true;
            self.base = base;
            self.index = Reg.None;
            self.disp = disp;
            self.literal = label;

            return self;
        }

        fn construct_indir_rip_label(label: str) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.label = true;
            self.base = Reg.None;
            self.index = Reg.None;
            self.literal = label;

            return self;
        }

    }

    mimic Offset = u32;

    export class Instr {
        var tag: Tag;
        var size: Size;
        var arg_type: ArgType;
        var opcode_size: u8;
        var modrm: ModRM;
        var reg: Reg;
        var imm64: i64;
        var goto_offset: Offset;
        var opcode_offset: u64;
    }

    var instrs: Instr[];

    shared parameters_regs = Reg[][ABI$count] {
        Reg[4]{
            Reg.CX,
            Reg.DX,
            Reg.R8,
            Reg.R9,
        },
        Reg[6]{
            Reg.DI,
            Reg.SI,
            Reg.DX,
            Reg.CX,
            Reg.R8,
            Reg.R9,
        },
    };

    export class Builder {

        class ArgInfo {
            var stack_offset: u32;
            var name: str;

            export fn construct(stack_offset: u32, name: str) => ArgInfo {
                var self = ArgInfo();

                self.stack_offset = stack_offset;
                self.name = name;

                return self;
            }
        };

        var instrs: Instr[];
        var hir: HIR;
        var abi: ABI;
        var variables: IntHashMap;
        var stack_reserved_size: u32;
        
        export fn construct(abi: ABI) => Builder {
            var self = Builder();

            self.abi = abi;
            if (abi == ABI.DEFAULT) {
                // TODO actually deduce from the system
                self.abi = ABI.WINDOWS;
            }
            self.variables = IntHashMap.construct();

            return self;
        }

        fn label(self: Builder, directive: str) {
            var instr = Instr();

            instr.tag = Tag.LABEL;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_literal(directive);
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn directive(self: Builder, directive: str) {
            var instr = Instr();

            instr.tag = Tag.DIRECTIVE;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_literal(directive);
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert(self: Builder, tag: Tag) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_empty();
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert_rm(self: Builder, tag: Tag, size: Size, modrm: ModRM) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.M;
            instr.modrm = modrm;
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert_reg_rm(self: Builder, tag: Tag, size: Size, lhs: Reg, rhs: ModRM) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.RM;
            instr.modrm = rhs;
            instr.reg = lhs;

            self.instrs ..= instr;
        }

        fn insert_rm_reg(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: Reg) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MR;
            instr.modrm = lhs;
            instr.reg = rhs;

            self.instrs ..= instr;
        }

        fn insert_rm_imm(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: u64) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MI;
            instr.modrm = lhs;
            instr.imm64 = rhs$cast(i64);

            self.instrs ..= instr;
        }

        fn insert_rm_char(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: char) {
            var instr = Instr();

            assert(size == Size.Bit8);

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MI_CHAR;
            instr.modrm = lhs;
            instr.imm64 = rhs$cast(i64);

            self.instrs ..= instr;
        }

        fn insert_jimm(self: Builder, tag: Tag, size: Size, val: Offset) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.JI;
            instr.modrm = ModRM.construct_empty();
            instr.goto_offset = val;

            self.instrs ..= instr;
        }

        fn finalize_stask_size(self: Builder) {
            var has_calls = self.hir.max_call_arg_count != (-1)$cast(u8);

            switch (self.abi) {
                case ABI.WINDOWS => {
                    var WINDOWS_SHADOW_STACK_SPACE: u32 = 8; // I'm not sure about it, I came to this during msvc disasm study
                    if (!has_calls && self.stack_reserved_size <= 0) {
                        self.stack_reserved_size = 0;
                        return;
                    }

                    self.stack_reserved_size = align_forward(self.stack_reserved_size, 16)$cast(u32); // 16-bites aligned
                    self.stack_reserved_size += WINDOWS_SHADOW_STACK_SPACE; // add shadow space AFTER alignment
                    return;
                }
                case ABI.SYSTEM_V => {
                    var SYSTEM_V_SHADOW_STACK_SPACE: u32 = 128;
                    if (!((has_calls && self.stack_reserved_size > 0) || (!has_calls && self.stack_reserved_size > SYSTEM_V_SHADOW_STACK_SPACE))) {
                        return;
                    }

                    if (!has_calls && self.stack_reserved_size > SYSTEM_V_SHADOW_STACK_SPACE) {
                        self.stack_reserved_size -= SYSTEM_V_SHADOW_STACK_SPACE;
                    }
                    self.stack_reserved_size = align_forward(self.stack_reserved_size, 16)$cast(u32); // 16-bites aligned
                }
            };
        }

        export fn build(self: Builder, hir: HIR) => ASMX86 {
            self.instrs = Instr[0];
            self.hir = hir;
            self.variables->clear();

            self.stack_reserved_size = 0;

            assert(self.abi == ABI.WINDOWS);
            {
                if (self.hir.max_call_arg_count != (-1)$cast(u8) && self.hir.max_call_arg_count > 0) {
                    var parameters_needed = parameters_regs[self.abi].size;
                    if (parameters_needed < self.hir.max_call_arg_count) {
                        parameters_needed = self.hir.max_call_arg_count;
                    }
                    self.stack_reserved_size = self.hir.max_call_arg_count * raw$size; // size of reg parameters, has to be preallocated
                }
            }

            for (var varr <- self.hir.vars[self.hir.parameters_count:self.hir.vars.size]) {
                if (varr.kind != HIR.Var.Kind.Regular &&
                    varr.kind != HIR.Var.Kind.Field) {
                    continue;
                }

                if (varr.kind == HIR.Var.Kind.Field) {
                    assert(false);
                    // TODO
                    /*
                    ketl_hir_var_id_t object_id = p_hir->p_vars_infos[var.info].parent_id;
                    ketl_hir_var_t object = p_hir->p_vars[object_id];

                    const char* p_field_name = KETL_ATOMIC_STRING_GET_POINTER(p_hir->p_symbols, p_hir->p_vars_infos[var.info].name);

                    ketl_atomic_string s_field_name = ketl_atomic_strings_get(&p_builder->p_state->atomic_strings, p_field_name, KETL_NULL_TERMINATED_LENGTH_32);
                    ketl_asm_x86_offset_t field_offset = ketl_type_get_field_offset(p_hir->p_used_types[object.type], s_field_name, p_builder->p_state);

                    ketl_asm_x86_arg_info_t arg_info = {
                        .stack_offset = field_offset,
                        .s_name = s_field_name,
                    };

                    ketl_asm_x86_variables_t_get_or_insert_copy(&p_builder->variables, var.info, arg_info);
                    */
                }

                var var_common = varr$cast(HIR.VarCommon);
                var var_info_index = var_common.info;
                var var_info = self.hir.vars_infos[var_info_index];

                // local or temporary variable
                var arg_info = ArgInfo.construct(self.stack_reserved_size, var_info.name);


                var bucket = self.variables->get_or_insert(var_info_index, arg_info);
                if (bucket.value$cast(ArgInfo).stack_offset == arg_info.stack_offset) {
                    // TODO FIX take into account type size and alignment
                    self.stack_reserved_size += i64$size;
                }
            }

            self->finalize_stask_size();
            assert(self.abi != ABI.WINDOWS || self.stack_reserved_size < 4096); // TODO additional call for win32 if reserved stack size bigger then a page

            assert(self.abi == ABI.WINDOWS);
            {
                if (self.stack_reserved_size > 0) {
                    self->insert_rm_imm(Tag.SUB, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);

                    self->directive("seh_stackalloc " .. self.stack_reserved_size$cast(str));
                    self->directive("seh_endprologue");
                }

                var var_id = self.hir.parameters_count;
                while (var_id > 0) {
                    var_id -= 1;
                    var varr = self.hir.vars[var_id];

                    assert(false);
                    // TODO
                    /*
                    ANN_ASSERT(var.uid == KETL_HIR_VAR_UID_PARAMETER);

                    ketl_asm_x86_arg_info_t arg_info = {
                        .stack_offset = (var_id + 1) * sizeof(void*) + stack_reserved_size,
                        .s_name = ketl_atomic_strings_get(&p_builder->p_state->atomic_strings, 
                        KETL_ATOMIC_STRING_GET_POINTER(p_hir->p_symbols, p_hir->p_vars_infos[var.info].name), KETL_NULL_TERMINATED_LENGTH_32),
                    };

                    ketl_asm_x86_variables_t_get_or_insert_copy(&p_builder->variables, var.info, arg_info);

                    if (var_id < get_reg_paramters_count(p_builder->abi_type)) {
                        ketl_asm_x86_insert_rm_reg(p_builder, KETL_ASM_X86_MOV, KETL_ASM_X86_64B, modrm_stack(p_builder, KETL_ASM_X86_64B, arg_info), 
                            get_reg_parameter(p_builder->abi_type, var_id));
                    }
                    */
                }
            }

            var first_instr_in_block = true;
            var block_counter: u16;

            var i: u32;
            while (i < self.hir.instrs.size) {
                if (first_instr_in_block) {
                    first_instr_in_block = false;
                    
                    /*
                    ketl_hir_to_asm_offsets_t_get_or_insert_copy(&p_builder->hir_to_asm_offsets, i, p_builder->instrs.size);

                    char a_label_buffer[256] = {'\0'};
                    uint32_t label_length = snprintf(a_label_buffer, ANN_ARRAY_SIZE(a_label_buffer), ".LBB%"PRIu16"_%"PRIu16, func_index, block_counter);
                    ketl_atomic_string s_label = ketl_atomic_strings_get(&p_builder->p_state->atomic_strings, a_label_buffer, label_length);
                    ++block_counter;

                    ketl_asm_label(p_builder, s_label);
                    */
                }

                var instr = self.hir.instrs[i];

                switch (instr.tag) {
                    default => assert(false);
                    case HIR.Tag.PLUS => {

                    }


                    case HIR.Tag.RETURN_VALUE => {
                        var hir_info = instr$cast(HIR.ReturnValue);
                        // TODO fix, get from the value
                        var size = Size.Bit64;
                        // TODO
                        //push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->value_var, size, p_builder);
                        if (self.stack_reserved_size > 0) {
                            self->directive("seh_startepilogue");
                            self->insert_rm_imm(Tag.ADD, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);
                            self->directive("seh_endepilogue");
                        }
                        self->insert(Tag.RET);

                        first_instr_in_block = true;
                    }
                }

                i += 1;
            }

            var asm_x86 = ASMX86();
            asm_x86.instrs = self.instrs;
            return asm_x86;
        }
    }

    export fn print(self: ASMX86) {
        printf("TEST"$cast(cstr));
    } 
}
