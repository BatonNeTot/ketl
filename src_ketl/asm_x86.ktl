from common import IntHashMap
from common import align_forward
import common

from type import Type
from type import TypePrimitive
from type import TypeEnum
from type import TypeFunction
from type import Types
from hir import HIR

export class ASMX86 {

    enum ABI: u8 {
        WINDOWS,
        SYSTEM_V,
        DEFAULT,
    }

    export enum Tag: u8 {
        LABEL,
        DIRECTIVE,

        PUSH,
        POP,

        MOV,
        LEA,

        MOVSX8,
        MOVSX16,
        MOVSX32,

        MOVZX8,
        MOVZX16,

        ADD,
        SUB,
        NEG,
        MUL,
        IMUL,
        DIV,
        IDIV,
        
        AND,
        OR,
        XOR,
        NOT,

        CMP,
        TEST,

        SETE,
        SETZ = SETE,
        SETNE,
        SETNZ = SETNE,

        SETG,
        SETNLE = SETG,
        SETGE,
        SETNL = SETGE,
        SETL,
        SETNGE = SETL,
        SETLE,
        SETNG = SETLE,

        JMP,

        JE,
        JZ = JE,
        JNE,
        JNZ = JNE,

        CALL,
        RET,
    }

    export enum Size: u8 {
        Bit8    = 1,
        Bit16   = 2,
        Bit32   = 4,
        Bit64   = 8,
        Ptr     = 8, // sizeof(void*)
        None    = 0,
    }

    fn print_ptr_size(size: Size) {
        switch (size) {
            case Size.Bit8  => common.print("byte");
            case Size.Bit16 => common.print("word");
            case Size.Bit32 => common.print("dword");
            case Size.Bit64 => common.print("qword");
            default => common.print("error"); 
        }
    }

    fn print_directive_size(size: Size) {
        switch (size) {
            case Size.Bit8  => common.print("byte");
            case Size.Bit16 => common.print("2byte");
            case Size.Bit32 => common.print("4byte");
            case Size.Bit64 => common.print("8byte");
            default => common.print("error"); 
        }
    }

    export enum ArgType: u8 {
        EMPTY,
        M,         // ModRM:r/m (r, w)
        RM,        // ModRM:reg (w),        ModRM:r/m (r)
        MR,        // ModRM:r/m (w),        ModRM:reg (r)
        MI,        // ModRM:r/m (r, w),     imm
        MI_CHAR,   // ModRM:r/m (r, w),     char
        JI,        // .imm
    }

    export enum Reg: u8 {
        AX,
        CX,
        DX,
        BX,
        SP,
        BP,
        SI,
        DI,
        R8,
        R9,
        R10,
        R11,
        R12,
        R13,
        R14,
        R15,
        None,
    }

    fn print_reg(reg: Reg, size: Size) {
        switch (reg) {
            case Reg.AX =>
                switch (size) {
                    case Size.Bit8  => common.print("al");
                    case Size.Bit16 => common.print("ax");
                    case Size.Bit32 => common.print("eax");
                    case Size.Bit64 => common.print("rax");
                    default => common.print("$reg-error");
                }
            case Reg.CX =>
                switch (size) {
                    case Size.Bit8  => common.print("cl");
                    case Size.Bit16 => common.print("cx");
                    case Size.Bit32 => common.print("ecx");
                    case Size.Bit64 => common.print("rcx");
                    default => common.print("$reg-error");
                }
            case Reg.DX =>
                switch (size) {
                    case Size.Bit8  => common.print("dl");
                    case Size.Bit16 => common.print("dx");
                    case Size.Bit32 => common.print("edx");
                    case Size.Bit64 => common.print("rdx");
                    default => common.print("$reg-error");
                }
            case Reg.BX =>
                switch (size) {
                    case Size.Bit8  => common.print("bl");
                    case Size.Bit16 => common.print("bx");
                    case Size.Bit32 => common.print("ebx");
                    case Size.Bit64 => common.print("rbx");
                    default => common.print("$reg-error");
                }
            case Reg.SP =>
                switch (size) {
                    case Size.Bit8  => common.print("spl");
                    case Size.Bit16 => common.print("sp");
                    case Size.Bit32 => common.print("esp");
                    case Size.Bit64 => common.print("rsp");
                    default => common.print("$reg-error");
                }
            case Reg.BP =>
                switch (size) {
                    case Size.Bit8  => common.print("bpl");
                    case Size.Bit16 => common.print("bp");
                    case Size.Bit32 => common.print("ebp");
                    case Size.Bit64 => common.print("rbp");
                    default => common.print("$reg-error");
                }
            case Reg.SI =>
                switch (size) {
                    case Size.Bit8  => common.print("sil");
                    case Size.Bit16 => common.print("si");
                    case Size.Bit32 => common.print("esi");
                    case Size.Bit64 => common.print("rsi");
                    default => common.print("$reg-error");
                }
            case Reg.DI =>
                switch (size) {
                    case Size.Bit8  => common.print("dil");
                    case Size.Bit16 => common.print("di");
                    case Size.Bit32 => common.print("edi");
                    case Size.Bit64 => common.print("rdi");
                    default => common.print("$reg-error");
                }
            case Reg.R8 =>
                switch (size) {
                    case Size.Bit8  => common.print("r8b");
                    case Size.Bit16 => common.print("r8w");
                    case Size.Bit32 => common.print("r8d");
                    case Size.Bit64 => common.print("r8");
                    default => common.print("$reg-error");
                }
            case Reg.R9 =>
                switch (size) {
                    case Size.Bit8  => common.print("r9b");
                    case Size.Bit16 => common.print("r9w");
                    case Size.Bit32 => common.print("r9d");
                    case Size.Bit64 => common.print("r9");
                    default => common.print("$reg-error");
                }
            case Reg.R10 =>
                switch (size) {
                    case Size.Bit8  => common.print("r10b");
                    case Size.Bit16 => common.print("r10w");
                    case Size.Bit32 => common.print("r10d");
                    case Size.Bit64 => common.print("r10");
                    default => common.print("$reg-error");
                }
            case Reg.R11 =>
                switch (size) {
                    case Size.Bit8  => common.print("r11b");
                    case Size.Bit16 => common.print("r11w");
                    case Size.Bit32 => common.print("r11d");
                    case Size.Bit64 => common.print("r11");
                    default => common.print("$reg-error");
                }
            case Reg.R12 =>
                switch (size) {
                    case Size.Bit8  => common.print("r12b");
                    case Size.Bit16 => common.print("r12w");
                    case Size.Bit32 => common.print("r12d");
                    case Size.Bit64 => common.print("r12");
                    default => common.print("$reg-error");
                }
            case Reg.R13 =>
                switch (size) {
                    case Size.Bit8  => common.print("r13b");
                    case Size.Bit16 => common.print("r13w");
                    case Size.Bit32 => common.print("r13d");
                    case Size.Bit64 => common.print("r13");
                    default => common.print("$reg-error");
                }
            case Reg.R14 =>
                switch (size) {
                    case Size.Bit8  => common.print("r14b");
                    case Size.Bit16 => common.print("r14w");
                    case Size.Bit32 => common.print("r14d");
                    case Size.Bit64 => common.print("r14");
                    default => common.print("$reg-error");
                }
            case Reg.R15 =>
                switch (size) {
                    case Size.Bit8  => common.print("r15b");
                    case Size.Bit16 => common.print("r15w");
                    case Size.Bit32 => common.print("r15d");
                    case Size.Bit64 => common.print("r15");
                    default => common.print("$reg-error");
                }
            default => common.print("$reg-error");
        }
    }

    export class ModRM {
        var indir: bool;
        var label: bool;
        var base: Reg;
        var index: Reg;
        var scale_power: u8;
        var disp: i32;
        var literal: str;

        fn construct_empty() => ModRM {
            var self = ModRM();

            self.base = Reg.None;
            self.index = Reg.None;

            return self;
        }

        fn construct_literal(literal: str) => ModRM {
            var self = ModRM();

            self.label = true;
            self.base = Reg.None;
            self.index = Reg.None;
            self.literal = literal;

            return self;
        }

        fn construct_reg(reg: Reg) => ModRM {
            var self = ModRM();

            self.base = reg;
            self.index = Reg.None;

            return self;
        }

        fn construct_indir_base_disp(base: Reg, disp: i32) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.base = base;
            self.index = Reg.None;
            self.disp = disp;

            return self;
        }

        fn construct_indir_base_label(base: Reg, label: str, disp: i32) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.label = true;
            self.base = base;
            self.index = Reg.None;
            self.disp = disp;
            self.literal = label;

            return self;
        }

        fn construct_indir_rip_label(label: str) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.label = true;
            self.base = Reg.None;
            self.index = Reg.None;
            self.literal = label;

            return self;
        }

        shared scale_powers = u8[4]{
            1, 2, 4, 8
        };

        fn print(modrm: ModRM, size: Size) {
            if (!modrm.indir) {
                if (modrm.label) {
                    common.print(modrm.literal);
                } else {
                    modrm.base->print_reg(size);
                }
                return;
            }

            size->print_ptr_size();
            common.print(" ptr [");

            if (modrm.base == Reg.None && modrm.label) {
                common.print("rip + ");
                common.print(modrm.literal);
                common.print("]");
                return;
            }

            modrm.base->print_reg(Size.Ptr);
            
            if (modrm.index != Reg.None) {
                common.print(" + (");
                modrm.index->print_reg(Size.Ptr);
                common.print(" * ");
                common.print(scale_powers[modrm.scale_power]$cast(str));
                common.print(")");
            }

            if (modrm.disp != 0) {
                if (modrm.disp >= 0) {
                    common.print(" + 0x");
                    common.print(modrm.disp$cast(str));
                } else {
                    common.print(" - 0x");
                    common.print((-modrm.disp)$cast(str));
                }
            }

            common.print("]");
        }

    }

    mimic Offset = u32;

    export class Instr {
        var tag: Tag;
        var size: Size;
        var arg_type: ArgType;
        var opcode_size: u8;
        var modrm: ModRM;
        var reg: Reg;
        var imm64: i64;
        var goto_offset: Offset;
        var opcode_offset: u64;

        fn print(instr: Instr, instrs: Instr[]) {
            if (instr.tag == Tag.LABEL) {
                common.print(instr.modrm.literal);
                common.print(":");
                return;
            } else {
                common.print("    ");
            }

            switch (instr.tag) {
                case Tag.DIRECTIVE => {
                    common.print(".");
                    common.print(instr.modrm.literal);
                }

                case Tag.PUSH => common.print("push ");
                case Tag.POP => common.print("pop ");

                case Tag.MOV => common.print("mov ");
                case Tag.LEA => common.print("lea ");

                case Tag.MOVSX8 => common.print("movsx ");
                case Tag.MOVSX16 => common.print("movsx ");
                case Tag.MOVSX32 => common.print("movsxd ");
                case Tag.MOVZX8 => common.print("movzx ");
                case Tag.MOVZX16 => common.print("movzx ");

                case Tag.ADD => common.print("add ");
                case Tag.SUB => common.print("sub ");
                case Tag.NEG => common.print("neg ");
                case Tag.MUL => common.print("mul ");
                case Tag.IMUL => common.print("imul ");
                case Tag.DIV => common.print("div ");
                case Tag.IDIV => common.print("idiv ");

                case Tag.AND => common.print("and ");
                case Tag.OR => common.print("or ");
                case Tag.XOR => common.print("xor ");
                case Tag.NOT => common.print("not ");

                case Tag.CMP => common.print("cmp ");
                case Tag.TEST => common.print("test ");
                    
                case Tag.SETE => common.print("sete ");
                case Tag.SETNE => common.print("setne ");
                case Tag.SETG => common.print("setg ");
                case Tag.SETGE => common.print("setge ");
                case Tag.SETL => common.print("setl ");
                case Tag.SETLE => common.print("setle ");

                case Tag.JMP => common.print("jmp ");
                case Tag.JNE => common.print("jne ");

                case Tag.CALL => common.print("call ");
                case Tag.RET => common.print("ret");
            }

            switch (instr.arg_type) {
                case ArgType.EMPTY => break;
                case ArgType.M => {
                    instr.modrm->print(instr.size);

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        common.print(" # ");
                        common.print(instr.modrm.literal);
                    }
                }
                case ArgType.RM => {
                    var rhs_size = instr.size;
                    switch (instr.tag) {
                        case Tag.MOVSX8  => rhs_size = Size.Bit8;
                        case Tag.MOVSX16 => rhs_size = Size.Bit16;
                        case Tag.MOVSX32 => rhs_size = Size.Bit32;
                        case Tag.MOVZX8  => rhs_size = Size.Bit8;
                        case Tag.MOVZX16 => rhs_size = Size.Bit16;
                    }
                    instr.reg->print_reg(instr.size);
                    common.print(", ");
                    instr.modrm->print(rhs_size);

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        common.print(" # ");
                        common.print(instr.modrm.literal);
                    }
                }
                case ArgType.MR => {
                    instr.modrm->print(instr.size);
                    common.print(", ");
                    instr.reg->print_reg(instr.size);

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        common.print(" # ");
                        common.print(instr.modrm.literal);
                    }
                }
                case ArgType.MI => {
                    instr.modrm->print(instr.size);
                    common.print(", "); 
                    common.print(instr.imm64$cast(str)); // TODO make 0x version

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        common.print(" # ");
                        common.print(instr.modrm.literal);
                    }
                }
                case ArgType.MI_CHAR => {
                    instr.modrm->print(instr.size);
                    common.print(", ");
                    common.print(instr.imm64$cast(str)); // TODO make 0x version
                    // TODO ketl_lexer_is_character_escaped
                    // common.print("    # '\\");
                    common.print("    # '");
                    // common.print(("" .. ketl_lexer_get_escape_character(instr.imm64)$cast(char)));
                    common.print(("" .. instr.imm64$cast(char)));
                    common.print("'");

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        common.print(" # ");
                        common.print(instr.modrm.literal);
                    }
                }
                case ArgType.JI => common.print(instrs[instr.goto_offset].modrm.literal);
            }
        }
    }

    var instrs: Instr[];

    shared parameters_regs = Reg[][ABI$count] {
        Reg[4]{
            Reg.CX,
            Reg.DX,
            Reg.R8,
            Reg.R9,
        },
        Reg[6]{
            Reg.DI,
            Reg.SI,
            Reg.DX,
            Reg.CX,
            Reg.R8,
            Reg.R9,
        },
    };

    export class Builder {

        class ArgInfo {
            var stack_offset: u32;
            var name: str;

            export fn construct(stack_offset: u32, name: str) => ArgInfo {
                var self = ArgInfo();

                self.stack_offset = stack_offset;
                self.name = name;

                return self;
            }
        };

        var instrs: Instr[];
        var hir: HIR;
        var abi: ABI;
        var variables: IntHashMap;
        var stack_reserved_size: u32;
        
        export fn construct(abi: ABI) => Builder {
            var self = Builder();

            self.abi = abi;
            if (abi == ABI.DEFAULT) {
                // TODO actually deduce from the system
                self.abi = ABI.WINDOWS;
            }
            self.variables = IntHashMap.construct();

            return self;
        }

        fn label(self: Builder, directive: str) {
            var instr = Instr();

            instr.tag = Tag.LABEL;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_literal(directive);
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn directive(self: Builder, directive: str) {
            var instr = Instr();

            instr.tag = Tag.DIRECTIVE;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_literal(directive);
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert(self: Builder, tag: Tag) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_empty();
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert_rm(self: Builder, tag: Tag, size: Size, modrm: ModRM) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.M;
            instr.modrm = modrm;
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert_reg_rm(self: Builder, tag: Tag, size: Size, lhs: Reg, rhs: ModRM) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.RM;
            instr.modrm = rhs;
            instr.reg = lhs;

            self.instrs ..= instr;
        }

        fn insert_rm_reg(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: Reg) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MR;
            instr.modrm = lhs;
            instr.reg = rhs;

            self.instrs ..= instr;
        }

        fn insert_rm_imm(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: u64) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MI;
            instr.modrm = lhs;
            instr.imm64 = rhs$cast(i64);

            self.instrs ..= instr;
        }

        fn insert_rm_char(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: char) {
            var instr = Instr();

            assert(size == Size.Bit8);

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MI_CHAR;
            instr.modrm = lhs;
            instr.imm64 = rhs$cast(i64);

            self.instrs ..= instr;
        }

        fn insert_jimm(self: Builder, tag: Tag, size: Size, val: Offset) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.JI;
            instr.modrm = ModRM.construct_empty();
            instr.goto_offset = val;

            self.instrs ..= instr;
        }

        class MovArg {
            var varr: HIR.Var;
            var var_id: HIR.VarId;
            var decl: HIR.Decl;
            var literal: u64;
            var type: Type;

            fn construct(var_id: HIR.VarId, builder: Builder) => MovArg {
                var varr = builder.hir.vars[var_id];

                // TODO
                /*
                while (var.uid == KETL_HIR_VAR_UID_CAST) {
                    var_id = var.cast_target;
                    var = p_builder->p_hir->p_vars[var_id];
                }
                */

                var decl: HIR.Decl;
                if (varr.kind == HIR.Var.Kind.Common) {
                    var var_common = varr$cast(HIR.VarCommon);
                    decl = builder.hir.decls[var_common.decl];
                }
                var literal: u64;
                if (varr.kind == HIR.Var.Kind.Literal) {
                    var var_literal = varr$cast(HIR.VarLiteral);
                    literal = var_literal.value;
                }
                // TODO placeholder
                var type = Types.instance.type_i64;
                
                var self = MovArg();
                self.varr = varr;
                self.var_id = var_id;
                self.decl = decl;
                self.literal = literal;
                self.type = type;
                return self;
            }
        }

        fn modrm_stack(self: Builder, size: Size, arg_info: ArgInfo) => ModRM {
            switch (self.abi) {
                case ABI.WINDOWS =>
                    // TODO self.inline_symbols
                    if (true) {
                        return ModRM.construct_indir_base_label(Reg.SP, arg_info.name, arg_info.stack_offset$cast(i32));
                    } else {
                        return ModRM.construct_indir_base_disp(Reg.SP, arg_info.stack_offset$cast(i32));
                    }
                case ABI.SYSTEM_V =>
                    // TODO 4294967296 => 0x100000000
                    return ModRM.construct_indir_base_disp(Reg.BP, (4294967296$cast(u64) - arg_info.stack_offset - size)$cast(i32));
            }

            assert(false);
            return ModRM.construct_empty();
        }

        fn push_cast_aware_mov(self: Builder, rhs_type: Type, size: Size, target_reg: Reg, rhs: ModRM) {
            var rhs_type_size = Size.Bit64; // TODO ketl_type_get_stack_size(p_rhs_type);
            assert(size == rhs_type_size || (rhs_type != null && (rhs_type.kind == Type.Kind.Primitive || rhs_type.kind == Type.Kind.Enum)));

            if (size > rhs_type_size) {
                if (rhs_type.kind == Type.Kind.Enum) {
                    rhs_type = rhs_type$cast(TypeEnum).parent;
                }
                var rhs_primitive_type = rhs_type$cast(TypePrimitive);
                if (rhs_primitive_type.is_signed) {
                    switch (rhs_type_size) {
                        case Size.Bit8 =>
                            if (size < Size.Bit64) {
                                self->insert_reg_rm(Tag.MOVSX8, Size.Bit32, target_reg, rhs);
                            } else {
                                self->insert_reg_rm(Tag.MOVSX8, Size.Bit64, target_reg, rhs);
                            }
                        case Size.Bit16 =>
                            if (size < Size.Bit64) {
                                self->insert_reg_rm(Tag.MOVSX16, Size.Bit32, target_reg, rhs);
                            } else {
                                self->insert_reg_rm(Tag.MOVSX16, Size.Bit64, target_reg, rhs);
                            }
                        case Size.Bit32 =>
                            if (size < Size.Bit64) {
                                self->insert_reg_rm(Tag.MOVSX32, Size.Bit32, target_reg, rhs);
                            } else {
                                self->insert_reg_rm(Tag.MOVSX32, Size.Bit64, target_reg, rhs);
                            }
                    }
                } else {
                    switch (rhs_type_size) {
                        case Size.Bit8 =>
                            self->insert_reg_rm(Tag.MOVZX8, Size.Bit32, target_reg, rhs);
                        case Size.Bit16 =>
                            self->insert_reg_rm(Tag.MOVZX16, Size.Bit32, target_reg, rhs);
                        case Size.Bit32 =>
                            self->insert_reg_rm(Tag.MOV, Size.Bit32, target_reg, rhs);
                    }
                }
            } else {
                self->insert_reg_rm(Tag.MOV, size, target_reg, rhs); 
            }
        }

        fn push_mov_from_stack(self: Builder, target_reg: Reg, arg: MovArg, size: Size) {
            if (arg.varr.kind == HIR.Var.Kind.Literal) {
                var literal = arg.literal;

                var type = arg.type;
                assert(type == null || type.kind == Type.Kind.Primitive || type.kind == Type.Kind.Enum);

                if (type == Types.instance.type_char$cast(Type)) {
                    var value = literal$cast(char);
                    self->insert_rm_char(Tag.MOV, Size.Bit8, ModRM.construct_reg(target_reg), value);
                } else {
                    var value = literal$cast(i64);

                    // TODO FIX
                    // get type size and use appropriate load global bytecode
                    self->insert_rm_imm(Tag.MOV, Size.Bit64, ModRM.construct_reg(target_reg), value$cast(u64));
                }

                return;
            }

            /*
            if (p_arg->var.info != KETL_HIR_VAR_INFO_TEMP && p_arg->var.uid == KETL_HIR_VAR_UID_GLOBAL) {
                ketl_namespace_node* p_namespace_node = ketl_namespace_find_by_index(p_arg->p_var_info->p_namespace, p_arg->p_var_info->namespace_node_index);

                if (p_builder->inline_symbols) {
                    ketl_atomic_string s_name = p_namespace_node->s_name;
                    if (p_arg->var.type == KETL_HIR_USED_TYPE_META) {
                        if (s_name != KETL_ATOMIC_STRING_EMPTY) {
                            ketl_asm_x86_insert_reg_rm(p_builder, KETL_ASM_X86_LEA, KETL_ASM_X86_PTRSIZE, target_reg, MODRM_INDIR_RIP_LABEL(s_name));
                        } else {
                            ketl_asm_x86_insert_rm_imm(p_builder, KETL_ASM_X86_MOV, KETL_ASM_X86_PTRSIZE, MODRM_REG(target_reg), 0);
                        }
                    } else {
                        if (p_arg->p_type->kind == KETL_TYPE_CFUNCTION) {
                            ketl_asm_x86_insert_reg_rm(p_builder, KETL_ASM_X86_LEA, KETL_ASM_X86_PTRSIZE, target_reg, MODRM_INDIR_RIP_LABEL(s_name));
                        } else {
                            push_cast_aware_mov(p_builder, p_arg->p_type, size, target_reg, MODRM_INDIR_RIP_LABEL(s_name));
                        }
                    }
                } else {
                    ANN_ASSERT(p_arg->var.type != KETL_HIR_USED_TYPE_META);
                    // TODO FIX
                    // get type size and use appropriate load global bytecode
                    ketl_asm_x86_insert_rm_imm(p_builder, KETL_ASM_X86_MOV, KETL_ASM_X86_64B, MODRM_REG(target_reg), (int64_t)&p_namespace_node->variable);
                    push_cast_aware_mov(p_builder, p_arg->p_type, size, target_reg, MODRM_INDIR_BASE_DISP(target_reg, 0));
                }
                return;
            }

            if (p_arg->var.info != KETL_HIR_VAR_INFO_TEMP && p_arg->var.uid == KETL_HIR_VAR_UID_FIELD) {
                ketl_hir_var_id_t object_id = p_arg->p_var_info->parent_id;
                ketl_hir_var_t object = p_builder->p_hir->p_vars[object_id];

                while (object.uid == KETL_HIR_VAR_UID_CAST) {
                    object_id = object.cast_target;
                    object = p_builder->p_hir->p_vars[object_id];
                }

                ketl_asm_x86_variables_t_bucket* object_bucket = ketl_asm_x86_variables_t_get_or_null(&p_builder->variables, p_arg->var.info);
                ANN_ASSERT(object_bucket != NULL);

                ketl_asm_x86_reg_t donor_reg = target_reg != KETL_ASM_X86_R11 ? KETL_ASM_X86_R11 : KETL_ASM_X86_R10;
                
                push_mov_from_stack_hir(donor_reg, object_id, KETL_ASM_X86_PTRSIZE, p_builder);
                if (p_builder->inline_symbols) {
                    char a_fullname_buffer[256];
                    uint32_t fullname_length = 0;

                    const char* p_field_name = KETL_ATOMIC_STRING_GET_POINTER(p_builder->p_hir->p_symbols, p_arg->p_var_info->name);

                    ketl_type* p_object_type = p_builder->p_hir->p_used_types[p_builder->p_hir->p_vars[p_arg->p_var_info->parent_id].type];

                    if (p_object_type->kind == KETL_TYPE_CLASS) {
                        ketl_type_class* p_class_type = (ketl_type_class*)p_object_type;
                        bool is_export = ketl_namespace_find(p_class_type->namespace.p_parent, p_class_type->namespace.s_name)->info.export;

                        const char* p_class_name = ketl_atomic_strings_get_pointer(&p_builder->p_state->atomic_strings, p_class_type->namespace.s_fullname);
                        if (is_export) {
                            ++p_class_name; // skip dot
                        }
                        
                        fullname_length = snprintf(a_fullname_buffer, ANN_ARRAY_SIZE(a_fullname_buffer), "%s.%s", p_class_name, p_field_name);
                    } else {
                        fullname_length = snprintf(a_fullname_buffer, ANN_ARRAY_SIZE(a_fullname_buffer), "__ketl_rt.ArrayHeader.%s", p_field_name);
                    }

                    push_cast_aware_mov(p_builder, p_arg->p_type, size, target_reg, MODRM_INDIR_BASE_LABEL(donor_reg, 
                        ketl_atomic_strings_get(&p_builder->p_state->atomic_strings, a_fullname_buffer, fullname_length),
                        object_bucket->value.stack_offset)); 
                } else {
                    push_cast_aware_mov(p_builder, p_arg->p_type, size, target_reg, MODRM_INDIR_BASE_DISP(donor_reg, object_bucket->value.stack_offset)); 
                }
                return;
            }

            if (p_arg->var.info != KETL_HIR_VAR_INFO_TEMP && p_arg->var.uid == KETL_HIR_VAR_UID_INDEX) {
                ketl_hir_var_id_t object_id = p_arg->p_var_info->parent_id;
                ketl_hir_var_t object = p_builder->p_hir->p_vars[object_id];
                ketl_hir_var_id_t arg_id = p_arg->p_var_info->arg_id;

                ANN_ASSERT(object.type != KETL_HIR_USED_TYPE_UNKNOWN);
                ketl_type* p_object_type = p_builder->p_hir->p_used_types[object.type];
                ketl_type* p_value_type = ((ketl_type_array*)p_object_type)->p_value_type;

                ketl_asm_x86_insert_reg_rm(p_builder, KETL_ASM_X86_MOV, KETL_ASM_X86_64B, KETL_ASM_X86_R9, MODRM_REG(KETL_ASM_X86_CX)); 

                if (p_builder->inline_symbols) {
                    char a_stack_size_buffer[16];
                    snprintf(a_stack_size_buffer, ANN_ARRAY_SIZE(a_stack_size_buffer), "%"PRIu64, (uint64_t)ketl_type_get_stack_size(p_value_type));
                    push_mov_arg a_arguments[] = {
                        {.var = {.uid = KETL_HIR_VAR_UID_LITERAL }, .p_literal = a_stack_size_buffer}, // stack_size
                        arg_from_hir_var_id(object_id, p_builder),
                        arg_from_hir_var_id(arg_id, p_builder),
                    };
                    
                    push_function_arguments(a_arguments, ANN_ARRAY_SIZE(a_arguments), p_builder);

                    // call __ketl_rt.array_get_value
                    ketl_atomic_string s_rt_array_get_value_name = ketl_atomic_strings_get(&p_builder->p_state->atomic_strings, "__ketl_rt.array_get_value", KETL_NULL_TERMINATED_LENGTH_32);
                    ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_LABEL(s_rt_array_get_value_name));
                } else {
                    //ketl_gc_get_value(&p_builder->p_state->gc, 
                    //  p_hir->p_used_types[p_hir_info->array_value], array_var, append_var);
                    char a_gc_address_buffer[16];
                    snprintf(a_gc_address_buffer, ANN_ARRAY_SIZE(a_gc_address_buffer), "%"PRIu64, (uint64_t)&p_builder->p_state->gc);
                    char a_stack_size_buffer[16];
                    snprintf(a_stack_size_buffer, ANN_ARRAY_SIZE(a_stack_size_buffer), "%"PRIu64, (uint64_t)ketl_type_get_stack_size(p_value_type));
                    push_mov_arg a_arguments[] = {
                        {.var = {.uid = KETL_HIR_VAR_UID_LITERAL }, .p_literal = a_gc_address_buffer},
                        {.var = {.uid = KETL_HIR_VAR_UID_LITERAL }, .p_literal = a_stack_size_buffer},
                        arg_from_hir_var_id(object_id, p_builder),
                        arg_from_hir_var_id(arg_id, p_builder),
                    };
                    push_function_arguments(a_arguments, ANN_ARRAY_SIZE(a_arguments), p_builder);

                    void* func_address;
                    #define KETL_POINTER_CONVERTER
                    #define KETL_POINTER_CONVERTER_ARG  &ketl_gc_get_value
                    #define KETL_POINTER_CONVERTER_VAR  func_address
                    #define KETL_POINTER_CONVERTER_TYPE void*
                    #include "meta.i"
                    
                    ketl_asm_x86_insert_rm_imm(p_builder, KETL_ASM_X86_MOV, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX), (uint64_t)func_address);

                    // call get_value from gc
                    ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));
                }

                ketl_asm_x86_insert_reg_rm(p_builder, KETL_ASM_X86_MOV, KETL_ASM_X86_64B, KETL_ASM_X86_CX, MODRM_REG(KETL_ASM_X86_R9)); 

                if (target_reg != KETL_ASM_X86_AX) {
                    push_cast_aware_mov(p_builder, p_arg->p_type, size, target_reg, MODRM_REG(KETL_ASM_X86_AX)); 
                }
                return;
            }
            */

            var var_decl_id = arg.varr$cast(HIR.VarCommon).decl;

            var bucket = self.variables->get_or_null(var_decl_id);
            assert(bucket != null);

            self->push_cast_aware_mov(arg.type, size, target_reg, self->modrm_stack(size, bucket.value));
        }

        fn push_mov_from_stack_hir(self: Builder, target_reg: Reg, var_id: HIR.VarId, size: Size) {
            var arg = MovArg.construct(var_id, self);
            self->push_mov_from_stack(target_reg, arg, size);
        }

