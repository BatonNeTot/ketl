        fn finalize_stask_size(self: Builder) {
            var has_calls = self.hir.max_call_arg_count != (-1)$cast(u8);

            switch (self.abi) {
                case ABI.WINDOWS => {
                    var WINDOWS_SHADOW_STACK_SPACE: u32 = 8; // I'm not sure about it, I came to this during msvc disasm study
                    if (!has_calls && self.stack_reserved_size <= 0) {
                        self.stack_reserved_size = 0;
                        return;
                    }

                    self.stack_reserved_size = align_forward(self.stack_reserved_size, 16)$cast(u32); // 16-bites aligned
                    self.stack_reserved_size += WINDOWS_SHADOW_STACK_SPACE; // add shadow space AFTER alignment
                    return;
                }
                case ABI.SYSTEM_V => {
                    var SYSTEM_V_SHADOW_STACK_SPACE: u32 = 128;
                    if (!((has_calls && self.stack_reserved_size > 0) || (!has_calls && self.stack_reserved_size > SYSTEM_V_SHADOW_STACK_SPACE))) {
                        return;
                    }

                    if (!has_calls && self.stack_reserved_size > SYSTEM_V_SHADOW_STACK_SPACE) {
                        self.stack_reserved_size -= SYSTEM_V_SHADOW_STACK_SPACE;
                    }
                    self.stack_reserved_size = align_forward(self.stack_reserved_size, 16)$cast(u32); // 16-bites aligned
                }
            };
        }

        export fn build(self: Builder, hir: HIR) => ASMX86 {
            self.instrs = Instr[0];
            self.hir = hir;
            self.variables->clear();

            self.stack_reserved_size = 0;

            var abi_parameters_regs = parameters_regs[self.abi];

            assert(self.abi == ABI.WINDOWS);
            {
                if (self.hir.max_call_arg_count != (-1)$cast(u8) && self.hir.max_call_arg_count > 0) {
                    var parameters_needed = abi_parameters_regs.size;
                    if (parameters_needed < self.hir.max_call_arg_count) {
                        parameters_needed = self.hir.max_call_arg_count;
                    }
                    self.stack_reserved_size = self.hir.max_call_arg_count * raw$size; // size of reg parameters, has to be preallocated
                }
            }

            var decl_id: HIR.DeclId = self.hir.parameters_count;
            while (decl_id < self.hir.decls.size) {
                var decl = self.hir.decls[decl_id];

                // local or temporary variable
                var arg_info = ArgInfo.construct(self.stack_reserved_size, decl.name);


                var bucket = self.variables->get_or_insert(decl_id, arg_info);
                if (bucket.value$cast(ArgInfo).stack_offset == arg_info.stack_offset) {
                    // TODO FIX take into account type size and alignment
                    self.stack_reserved_size += i64$size;
                }

                decl_id += 1;
            }

            self->finalize_stask_size();
            assert(self.abi != ABI.WINDOWS || self.stack_reserved_size < 4096); // TODO additional call for win32 if reserved stack size bigger then a page

            assert(self.abi == ABI.WINDOWS);
            {
                if (self.stack_reserved_size > 0) {
                    self->insert_rm_imm(Tag.SUB, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);

                    self->directive(("seh_stackalloc " .. self.stack_reserved_size$cast(str)));
                    self->directive("seh_endprologue");
                }

                var decl_id = self.hir.parameters_count;
                while (decl_id > 0) {
                    decl_id -= 1;
                    var decl = self.hir.decls[decl_id];

                    assert(decl.kind == HIR.Decl.Kind.Parameter);
                    var parameter = decl$cast(HIR.DeclParameter);

                    var arg_info = ArgInfo.construct((decl_id + 1) * raw$size + self.stack_reserved_size, decl.name);

                    self.variables->get_or_insert(decl_id, arg_info);

                    if (decl_id < abi_parameters_regs.size) {
                        // TODO fix use actual size
                        var size = Size.Bit64;
                        self->insert_rm_reg(Tag.MOV, size, self->modrm_stack(size, arg_info), abi_parameters_regs[decl_id]);
                    }
                }
            }

            var first_instr_in_block = true;
            var block_counter: u16;

            var i: u32;
            while (i < self.hir.instrs.size) {
                if (first_instr_in_block) {
                    first_instr_in_block = false;
                    
                    /*
                    ketl_hir_to_asm_offsets_t_get_or_insert_copy(&p_builder->hir_to_asm_offsets, i, p_builder->instrs.size);
                    */

                    var label = ".LBB";
                    label ..= "0"; // TODO func_index$cast(str);
                    label ..= "_";
                    label ..= block_counter$cast(str);
                    block_counter += 1;

                    self->label(label);
                }

                var instr = self.hir.instrs[i];

                switch (instr.tag) {
                    default => {
                        common.print("unknown tag: ");
                        common.println(instr.tag$cast(str));
                        assert(false);
                    }
                    case HIR.Tag.PLUS
                    case HIR.Tag.MINUS

                    case HIR.Tag.MULTY
                    case HIR.Tag.DIVIDE
                    case HIR.Tag.MOD

                    case HIR.Tag.BITWISE_AND
                    case HIR.Tag.BITWISE_OR
                    case HIR.Tag.BITWISE_XOR => {
                        var hir_info = instr$cast(HIR.BinaryOp);
                        var type = self.hir.vars[hir_info.output].type;
                        var size = type->get_stack_size()$cast(Size);
                        self->push_mov_from_stack_hir(Reg.CX, hir_info.rhs, size);
                        self->push_mov_from_stack_hir(Reg.AX, hir_info.lhs, size);

                        switch (instr.tag) {
                            case HIR.Tag.PLUS => self->insert_reg_rm(Tag.ADD, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.MINUS => self->insert_reg_rm(Tag.SUB, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            
                            case HIR.Tag.MULTY => // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.DIVIDE => {
                                self->insert_reg_rm(Tag.IMUL, size, Reg.DX, ModRM.construct_reg(Reg.DX));
                                // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                            }
                            case HIR.Tag.MOD => {
                                self->insert_reg_rm(Tag.XOR, size, Reg.DX, ModRM.construct_reg(Reg.DX));
                                // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                                self->insert_reg_rm(Tag.MOV, size, Reg.AX, ModRM.construct_reg(Reg.DX));
                            }
                            
                            case HIR.Tag.BITWISE_AND => self->insert_reg_rm(Tag.AND, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.BITWISE_OR => self->insert_reg_rm(Tag.OR, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.BITWISE_XOR => self->insert_reg_rm(Tag.XOR, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                        }

                        self->push_mov_to_stack_hir(hir_info.output, Reg.AX, size);
                    }

                    case HIR.Tag.ASSIGN => {
                        var hir_info = instr$cast(HIR.Assign);
                        var type = self.hir.vars[hir_info.dst].type;
                        var size = type->get_stack_size()$cast(Size);
                        self->push_mov_from_stack_hir(Reg.AX, hir_info.src, size);
                        self->push_mov_to_stack_hir(hir_info.dst, Reg.AX, size);
                    }

                    case HIR.Tag.CALL => {
                        var hir_info = instr$cast(HIR.Call);

                        var callee = self.hir.vars[hir_info.callee];
                        assert(callee.type != null);
                        var callee_type = callee.type;

                        // TODO FIX allow other types to be called
                        assert(callee_type.kind == Type.Kind.Function || callee_type.kind == Type.Kind.CFunction);

                        var func_type = callee_type$cast(TypeFunction); 
                        var return_type = func_type.signature.parameters[0];

                        self->push_function_arguments_hir(hir_info.args);

                        // call
                        assert(callee.kind == HIR.Var.Kind.Common);
                        var func_decl_id = callee$cast(HIR.VarCommon).decl;
                        var func_decl = self.hir.decls[func_decl_id];

                        // TODO self.inline_symbols
                        if (true && func_decl.kind == HIR.Decl.Kind.Global) {
                            var namespace_node = func_decl$cast(HIR.DeclGlobal).node;
                            var func_name = namespace_node.name;
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        if (return_type != Types.instance.type_void$cast(Type)) {
                            self->push_mov_to_stack_hir(hir_info.output, Reg.AX, return_type->get_stack_size()$cast(Size));
                        }
                    }

                    case HIR.Tag.RETURN => {
                        if (self.stack_reserved_size > 0) {
                            self->directive("seh_startepilogue");
                            self->insert_rm_imm(Tag.ADD, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);
                            self->directive("seh_endepilogue");
                        }
                        self->insert(Tag.RET);

                        first_instr_in_block = true;
                    }

                    case HIR.Tag.RETURN_VALUE => {
                        var hir_info = instr$cast(HIR.ReturnValue);
                        // TODO fix, get from the value
                        var size = Size.Bit64;
                        self->push_mov_from_stack_hir(Reg.AX, hir_info.value, size);
                        if (self.stack_reserved_size > 0) {
                            self->directive("seh_startepilogue");
                            self->insert_rm_imm(Tag.ADD, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);
                            self->directive("seh_endepilogue");
                        }
                        self->insert(Tag.RET);

                        first_instr_in_block = true;
                    }
                }

                i += 1;
            }

            var asm_x86 = ASMX86();
            asm_x86.instrs = self.instrs;
            return asm_x86;
        }
    }

    export fn print(self: ASMX86, func_name: str) {
        common.println("    .def    " .. func_name .. ";                    # @" .. func_name);
        common.println("    .scl    2;");
        common.println("    .type   32;");
        common.println("    .endef");
        common.println("    .globl	" .. func_name);
        common.println("    .p2align	4");
        common.println(func_name .. ":");
        common.println(".seh_proc " .. func_name);

        for (var instr <- self.instrs) {
            instr->print(self.instrs);
            common.print("\n");
        }

        common.println("    .seh_endproc");
    } 
}
