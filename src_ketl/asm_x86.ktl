from common import IntHashMap
from common import align_forward
from common import uint_to_str
import io

from type_base import Type
from value import Value
from type import TypePrimitive
from type import TypeEnum
from type import TypeFunction
from type import TypeArray
from type import TypeClass
from type import Types
from hir import HIR

from namespace import Namespace

export class ASMX86 {

    enum ABI: u8 {
        WINDOWS,
        SYSTEM_V,
        DEFAULT,
    }

    export enum Tag: u8 {
        LABEL,
        DIRECTIVE,

        PUSH,
        POP,

        MOV,
        LEA,

        MOVSX8,
        MOVSX16,
        MOVSX32,

        MOVZX8,
        MOVZX16,

        ADD,
        SUB,
        NEG,
        MUL,
        IMUL,
        DIV,
        IDIV,
        
        AND,
        OR,
        XOR,
        NOT,

        SAL,
        SAR,
        SHL,
        SHR,

        CMP,
        TEST,

        SETE,
        SETZ = SETE, // TODO actually separate them
        SETNE,
        SETNZ = SETNE,

        SETG,
        SETNLE = SETG,
        SETGE,
        SETNL = SETGE,
        SETL,
        SETNGE = SETL,
        SETLE,
        SETNG = SETLE,

        JMP,

        JE,
        JZ = JE,
        JNE,
        JNZ = JNE,

        CALL,
        RET,
    }

    export enum Size: u8 {
        Bit8    = 1,
        Bit16   = 2,
        Bit32   = 4,
        Bit64   = 8,
        Ptr     = 8, // sizeof(void*)
        None    = 0,
    }

    fn print_ptr_size(size: Size) {
        switch (size) {
            case Size.Bit8  => io.print("byte");
            case Size.Bit16 => io.print("word");
            case Size.Bit32 => io.print("dword");
            case Size.Bit64 => io.print("qword");
            default => io.print("error"); 
        }
    }

    export fn print_directive_size(size: Size) {
        switch (size) {
            case Size.Bit8  => io.print("byte");
            case Size.Bit16 => io.print("2byte");
            case Size.Bit32 => io.print("4byte");
            case Size.Bit64 => io.print("8byte");
            default => io.print("error"); 
        }
    }

    export enum ArgType: u8 {
        EMPTY,
        M,         // ModRM:r/m (r, w)
        RM,        // ModRM:reg (w),        ModRM:r/m (r)
        MR,        // ModRM:r/m (w),        ModRM:reg (r)
        MI,        // ModRM:r/m (r, w),     imm
        MI_CHAR,   // ModRM:r/m (r, w),     char
        JI,        // .imm
    }

    export enum Reg: u8 {
        AX,
        CX,
        DX,
        BX,
        SP,
        BP,
        SI,
        DI,
        R8,
        R9,
        R10,
        R11,
        R12,
        R13,
        R14,
        R15,
        None,
    }

    fn print_reg(reg: Reg, size: Size) {
        switch (reg) {
            case Reg.AX =>
                switch (size) {
                    case Size.Bit8  => io.print("al");
                    case Size.Bit16 => io.print("ax");
                    case Size.Bit32 => io.print("eax");
                    case Size.Bit64 => io.print("rax");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.CX =>
                switch (size) {
                    case Size.Bit8  => io.print("cl");
                    case Size.Bit16 => io.print("cx");
                    case Size.Bit32 => io.print("ecx");
                    case Size.Bit64 => io.print("rcx");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.DX =>
                switch (size) {
                    case Size.Bit8  => io.print("dl");
                    case Size.Bit16 => io.print("dx");
                    case Size.Bit32 => io.print("edx");
                    case Size.Bit64 => io.print("rdx");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.BX =>
                switch (size) {
                    case Size.Bit8  => io.print("bl");
                    case Size.Bit16 => io.print("bx");
                    case Size.Bit32 => io.print("ebx");
                    case Size.Bit64 => io.print("rbx");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.SP =>
                switch (size) {
                    case Size.Bit8  => io.print("spl");
                    case Size.Bit16 => io.print("sp");
                    case Size.Bit32 => io.print("esp");
                    case Size.Bit64 => io.print("rsp");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.BP =>
                switch (size) {
                    case Size.Bit8  => io.print("bpl");
                    case Size.Bit16 => io.print("bp");
                    case Size.Bit32 => io.print("ebp");
                    case Size.Bit64 => io.print("rbp");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.SI =>
                switch (size) {
                    case Size.Bit8  => io.print("sil");
                    case Size.Bit16 => io.print("si");
                    case Size.Bit32 => io.print("esi");
                    case Size.Bit64 => io.print("rsi");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.DI =>
                switch (size) {
                    case Size.Bit8  => io.print("dil");
                    case Size.Bit16 => io.print("di");
                    case Size.Bit32 => io.print("edi");
                    case Size.Bit64 => io.print("rdi");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R8 =>
                switch (size) {
                    case Size.Bit8  => io.print("r8b");
                    case Size.Bit16 => io.print("r8w");
                    case Size.Bit32 => io.print("r8d");
                    case Size.Bit64 => io.print("r8");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R9 =>
                switch (size) {
                    case Size.Bit8  => io.print("r9b");
                    case Size.Bit16 => io.print("r9w");
                    case Size.Bit32 => io.print("r9d");
                    case Size.Bit64 => io.print("r9");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R10 =>
                switch (size) {
                    case Size.Bit8  => io.print("r10b");
                    case Size.Bit16 => io.print("r10w");
                    case Size.Bit32 => io.print("r10d");
                    case Size.Bit64 => io.print("r10");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R11 =>
                switch (size) {
                    case Size.Bit8  => io.print("r11b");
                    case Size.Bit16 => io.print("r11w");
                    case Size.Bit32 => io.print("r11d");
                    case Size.Bit64 => io.print("r11");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R12 =>
                switch (size) {
                    case Size.Bit8  => io.print("r12b");
                    case Size.Bit16 => io.print("r12w");
                    case Size.Bit32 => io.print("r12d");
                    case Size.Bit64 => io.print("r12");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R13 =>
                switch (size) {
                    case Size.Bit8  => io.print("r13b");
                    case Size.Bit16 => io.print("r13w");
                    case Size.Bit32 => io.print("r13d");
                    case Size.Bit64 => io.print("r13");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R14 =>
                switch (size) {
                    case Size.Bit8  => io.print("r14b");
                    case Size.Bit16 => io.print("r14w");
                    case Size.Bit32 => io.print("r14d");
                    case Size.Bit64 => io.print("r14");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            case Reg.R15 =>
                switch (size) {
                    case Size.Bit8  => io.print("r15b");
                    case Size.Bit16 => io.print("r15w");
                    case Size.Bit32 => io.print("r15d");
                    case Size.Bit64 => io.print("r15");
                    default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
                }
            default => io.print("$reg-error." .. reg$cast(str) .. "." .. size$cast(str));
        }
    }

    export class ModRM {
        var indir: bool;
        var label: bool;
        var base: Reg;
        var index: Reg;
        var scale_power: u8;
        var disp: i32;
        var literal: str;

        fn construct_empty() => ModRM {
            var self = ModRM();

            self.base = Reg.None;
            self.index = Reg.None;

            return self;
        }

        fn construct_literal(literal: str) => ModRM {
            var self = ModRM();

            self.label = true;
            self.base = Reg.None;
            self.index = Reg.None;
            self.literal = literal;

            return self;
        }

        fn construct_reg(reg: Reg) => ModRM {
            var self = ModRM();

            self.base = reg;
            self.index = Reg.None;

            return self;
        }

        fn construct_indir_base_disp(base: Reg, disp: i32) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.base = base;
            self.index = Reg.None;
            self.disp = disp;

            return self;
        }

        fn construct_indir_base_label(base: Reg, label: str, disp: i32) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.label = true;
            self.base = base;
            self.index = Reg.None;
            self.disp = disp;
            self.literal = label;

            return self;
        }

        fn construct_indir_rip_label(label: str) => ModRM {
            var self = ModRM();

            self.indir = true;
            self.label = true;
            self.base = Reg.None;
            self.index = Reg.None;
            self.literal = label;

            return self;
        }

        shared scale_powers = u8[4]{
            1, 2, 4, 8
        };

        fn print(modrm: ModRM, size: Size) {
            if (!modrm.indir) {
                if (modrm.label) {
                    io.print(modrm.literal);
                } else {
                    modrm.base->print_reg(size);
                }
                return;
            }

            size->print_ptr_size();
            io.print(" ptr [");

            if (modrm.base == Reg.None && modrm.label) {
                io.print("rip + ");
                io.print(modrm.literal);
                io.print("]");
                return;
            }

            modrm.base->print_reg(Size.Ptr);
            
            if (modrm.index != Reg.None) {
                io.print(" + (");
                modrm.index->print_reg(Size.Ptr);
                io.print(" * ");
                var scale = scale_powers[modrm.scale_power];
                io.print(scale$cast(str));
                io.print(")");
            }

            if (modrm.disp != 0) {
                if (modrm.disp >= 0) {
                    io.print(" + 0x");
                    io.print(uint_to_str(modrm.disp$cast(u64), 16));
                } else {
                    io.print(" - 0x");
                    io.print(uint_to_str((-modrm.disp)$cast(u64), 16));
                }
            }

            io.print("]");
        }

    }

    mimic Offset = u32;

    export class Instr {
        var tag: Tag;
        var size: Size;
        var arg_type: ArgType;
        var opcode_size: u8;
        var modrm: ModRM;
        var reg: Reg;
        var imm64: i64;
        var goto_offset: Offset;
        var opcode_offset: u64;

        fn print(instr: Instr, instrs: Instr[]) {
            if (instr.tag == Tag.LABEL) {
                io.print(instr.modrm.literal);
                io.print(":");
                return;
            } else {
                io.print("    ");
            }

            switch (instr.tag) {
                case Tag.DIRECTIVE => {
                    io.print(".");
                    io.print(instr.modrm.literal);
                }

                case Tag.PUSH => io.print("push ");
                case Tag.POP => io.print("pop ");

                case Tag.MOV => io.print("mov ");
                case Tag.LEA => io.print("lea ");

                case Tag.MOVSX8 => io.print("movsx ");
                case Tag.MOVSX16 => io.print("movsx ");
                case Tag.MOVSX32 => io.print("movsxd ");
                case Tag.MOVZX8 => io.print("movzx ");
                case Tag.MOVZX16 => io.print("movzx ");

                case Tag.ADD => io.print("add ");
                case Tag.SUB => io.print("sub ");
                case Tag.NEG => io.print("neg ");
                case Tag.MUL => io.print("mul ");
                case Tag.IMUL => io.print("imul ");
                case Tag.DIV => io.print("div ");
                case Tag.IDIV => io.print("idiv ");

                case Tag.AND => io.print("and ");
                case Tag.OR => io.print("or ");
                case Tag.XOR => io.print("xor ");
                case Tag.NOT => io.print("not ");

                case Tag.SAL => io.print("sal ");
                case Tag.SAR => io.print("sar ");
                case Tag.SHL => io.print("shl ");
                case Tag.SHR => io.print("shr ");

                case Tag.CMP => io.print("cmp ");
                case Tag.TEST => io.print("test ");
                    
                case Tag.SETE => io.print("sete ");
                case Tag.SETNE => io.print("setne ");
                case Tag.SETG => io.print("setg ");
                case Tag.SETGE => io.print("setge ");
                case Tag.SETL => io.print("setl ");
                case Tag.SETLE => io.print("setle ");

                case Tag.JMP => io.print("jmp ");
                case Tag.JNE => io.print("jne ");

                case Tag.CALL => io.print("call ");
                case Tag.RET => io.print("ret");
                default => io.print("<error op> ");
            }

            switch (instr.arg_type) {
                case ArgType.EMPTY => break;
                case ArgType.M => {
                    instr.modrm->print(instr.size);

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        io.print(" # ");
                        io.print(instr.modrm.literal);
                    }
                }
                case ArgType.RM => {
                    var rhs_size = instr.size;
                    switch (instr.tag) {
                        case Tag.MOVSX8  => rhs_size = Size.Bit8;
                        case Tag.MOVSX16 => rhs_size = Size.Bit16;
                        case Tag.MOVSX32 => rhs_size = Size.Bit32;
                        case Tag.MOVZX8  => rhs_size = Size.Bit8;
                        case Tag.MOVZX16 => rhs_size = Size.Bit16;
                    }
                    instr.reg->print_reg(instr.size);
                    io.print(", ");
                    instr.modrm->print(rhs_size);

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        io.print(" # ");
                        io.print(instr.modrm.literal);
                    }
                }
                case ArgType.MR => {
                    instr.modrm->print(instr.size);
                    io.print(", ");
                    instr.reg->print_reg(instr.size);

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        io.print(" # ");
                        io.print(instr.modrm.literal);
                    }
                }
                case ArgType.MI => {
                    instr.modrm->print(instr.size);
                    io.print(", 0x"); 
                    io.print(uint_to_str(instr.imm64$cast(u64), 16));

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        io.print(" # ");
                        io.print(instr.modrm.literal);
                    }
                }
                case ArgType.MI_CHAR => {
                    instr.modrm->print(instr.size);
                    io.print(", 0x");
                    io.print(uint_to_str(instr.imm64$cast(u64), 16));
                    // TODO ketl_lexer_is_character_escaped
                    // io.print("    # '\\");
                    io.print("    # '");
                    // io.print(("" .. ketl_lexer_get_escape_character(instr.imm64)$cast(char)));
                    io.print(("" .. instr.imm64$cast(char)));
                    io.print("'");

                    if (instr.modrm.label && instr.modrm.indir && instr.modrm.base != Reg.None) {
                        io.print(" # ");
                        io.print(instr.modrm.literal);
                    }
                }
                case ArgType.JI => io.print(instrs[instr.goto_offset].modrm.literal);
            }
        }
    }

    var instrs: Instr[];

    shared parameters_regs = Reg[][ABI$count] {
        Reg[4]{
            Reg.CX,
            Reg.DX,
            Reg.R8,
            Reg.R9,
        },
        Reg[6]{
            Reg.DI,
            Reg.SI,
            Reg.DX,
            Reg.CX,
            Reg.R8,
            Reg.R9,
        },
    };

    export class Builder {

        class ArgInfo {
            var stack_offset: u32;
            var name: str;

            export fn construct(stack_offset: u32, name: str) => ArgInfo {
                var self = ArgInfo();

                self.stack_offset = stack_offset;
                self.name = name;

                return self;
            }

            export fn error() => ArgInfo {
                var self = ArgInfo();

                self.stack_offset = (-1)$cast(u32);
                self.name = "<undefined>";

                return self;
            }

        };

        var hir: HIR;
        var abi: ABI;
        var instrs: Instr[];
        var hir_to_asm_offsets: IntHashMap;
        var variables: IntHashMap;
        var stack_reserved_size: u32;
        
        export fn construct(abi: ABI) => Builder {
            var self = Builder();

            self.abi = abi;
            if (abi == ABI.DEFAULT) {
                // TODO actually deduce from the system
                self.abi = ABI.WINDOWS;
            }
            self.hir_to_asm_offsets = IntHashMap.construct();
            self.variables = IntHashMap.construct();

            return self;
        }

        fn label(self: Builder, directive: str) {
            var instr = Instr();

            instr.tag = Tag.LABEL;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_literal(directive);
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn directive(self: Builder, directive: str) {
            var instr = Instr();

            instr.tag = Tag.DIRECTIVE;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_literal(directive);
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert(self: Builder, tag: Tag) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = Size.None;
            instr.arg_type = ArgType.EMPTY;
            instr.modrm = ModRM.construct_empty();
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert_rm(self: Builder, tag: Tag, size: Size, modrm: ModRM) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.M;
            instr.modrm = modrm;
            instr.reg = Reg.None;

            self.instrs ..= instr;
        }

        fn insert_reg_rm(self: Builder, tag: Tag, size: Size, lhs: Reg, rhs: ModRM) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.RM;
            instr.modrm = rhs;
            instr.reg = lhs;

            self.instrs ..= instr;
        }

        fn insert_rm_reg(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: Reg) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MR;
            instr.modrm = lhs;
            instr.reg = rhs;

            self.instrs ..= instr;
        }

        fn insert_rm_imm(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: u64) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MI;
            instr.modrm = lhs;
            instr.imm64 = rhs$cast(i64);

            self.instrs ..= instr;
        }

        fn insert_rm_char(self: Builder, tag: Tag, size: Size, lhs: ModRM, rhs: char) {
            var instr = Instr();

            assert(size == Size.Bit8);

            instr.tag = tag;
            instr.size = size;
            instr.arg_type = ArgType.MI_CHAR;
            instr.modrm = lhs;
            instr.imm64 = rhs$cast(i64);

            self.instrs ..= instr;
        }

        fn insert_jimm(self: Builder, tag: Tag, size: Size, val: Offset) {
            var instr = Instr();

            instr.tag = tag;
            instr.size = size; // TODO why size?
            instr.arg_type = ArgType.JI;
            instr.modrm = ModRM.construct_empty();
            instr.goto_offset = val;

            self.instrs ..= instr;
        }

        class AsmArg {
            enum Kind: u8 {
                Literal,
                Global,
                GlobalAddress,
                OnStack,
                Ref,
            }
            var kind: Kind;
            var size: Size;
            var type: Type;

            fn construct_literal(type: Type, value: u64) => AsmArg {
                var arg = AsmArgLiteral();
                arg.kind = AsmArg.Kind.Literal;
                arg.size = type->get_stack_size()$cast(Size);
                arg.type = type;

                arg.value = value;

                return arg;
            }

            fn construct_type(type: Type) => AsmArg {
                var arg = AsmArgGlobal();
                arg.kind = AsmArg.Kind.GlobalAddress;
                arg.size = Size.Ptr;

                arg.label = type->get_name();

                return arg;
            }

            fn construct_constant(constant: HIR.Const) => AsmArg {
                if (constant == null) {
                    return construct_literal(Types.instance.type_raw, 0);
                } else {
                    var arg = AsmArgGlobal();
                    arg.kind = AsmArg.Kind.GlobalAddress;
                    arg.size = Size.Ptr;
                    arg.type = Types.instance.type_raw;

                    arg.label = constant.name;

                    return arg;
                }
            }

            fn construct_constant_size(constant: HIR.Const) => AsmArg {
                if (constant == null) {
                    return construct_literal(Types.instance.type_u64, 0);
                } else {
                    return construct_literal(Types.instance.type_u64, constant.mem_size);
                }
            }
        }

        class AsmArgLiteral {
            extend AsmArg;
            var value: u64;
        }

        class AsmArgGlobal {
            extend AsmArg;
            var label: str;
        }

        class AsmArgOnStack {
            extend AsmArg;
            var name: str;
            var stack: u64;
        }

        class AsmArgRef {
            extend AsmArg;
            var parent: AsmArg;
            var name: str;
            var offset: i64;
        }

        fn get_arg_from_hir(self: Builder, var_id: HIR.VarId) => AsmArg {
            if (var_id >= self.hir.vars.size) {
                return AsmArg.construct_literal(null, 0);
            }

            var varr = self.hir.vars[var_id];
            var type = varr->get_type_forced();

            while (varr.kind == HIR.Var.Kind.Cast) {
                var_id = varr$cast(HIR.VarCast).casted;
                varr = self.hir.vars[var_id];
            }

            if (varr.kind == HIR.Var.Kind.Literal) {
                if (type == null) {
                    type = Types.instance.type_i64;
                }

                var value = varr$cast(HIR.VarLiteral).value;
                assert(type.kind == Type.Kind.Primitive || type.kind == Type.Kind.Enum || 
                    (type->is_pointer_kind() && value == 0));

                var arg = AsmArgLiteral();
                arg.kind = AsmArg.Kind.Literal;
                arg.size = type->get_stack_size()$cast(Size);
                arg.type = type;

                arg.value = value;

                return arg;
            }

            if (varr.kind == HIR.Var.Kind.Global) {
                var namespace_node = varr$cast(HIR.VarGlobal).node;
                var name = namespace_node.name;

                var arg = AsmArgGlobal();
                arg.kind = AsmArg.Kind.Global;
                if (type != null) {
                    arg.size = type->get_stack_size()$cast(Size);
                }
                arg.type = type;

                arg.label = name;

                if (namespace_node.value.kind == Value.Kind.Type) {
                    arg.kind = AsmArg.Kind.GlobalAddress;
                    arg.size = Size.Ptr;
                } else {
                    if (type.kind == Type.Kind.Function || type.kind == Type.Kind.CFunction) {
                        arg.kind = AsmArg.Kind.GlobalAddress;
                        arg.size = Size.Ptr;
                    }
                }

                return arg;
            }

            if (varr.kind == HIR.Var.Kind.Common) {
                var var_common = varr$cast(HIR.VarCommon);
                var decl_id = var_common.decl;
                var decl = self.hir.decls[decl_id];

                var bucket = self.variables->get_or_null(decl_id);
                // TODO create and return asm arg error
                assert(bucket != null);

                // TODO just create AsmArgOnStack directly into variables instead of ArgInfo
                var arg_info = bucket.value$cast(ArgInfo);

                assert(type != null);

                var arg = AsmArgOnStack();
                arg.kind = AsmArg.Kind.OnStack;
                arg.size = type->get_stack_size()$cast(Size);
                arg.type = type;

                arg.name = arg_info.name;
                arg.stack = arg_info.stack_offset;

                return arg;
            }

            if (varr.kind == HIR.Var.Kind.LiteralType) {
                var var_builtin = varr$cast(HIR.VarLiteralType);

                var name = var_builtin.value->get_name();

                var arg = AsmArgGlobal();
                arg.kind = AsmArg.Kind.GlobalAddress;
                arg.size = Size.Ptr;

                arg.label = name;

                return arg;
            }

            if (varr.kind == HIR.Var.Kind.Field) {
                assert(type != null);

                var var_field = varr$cast(HIR.VarField);
                
                var object_id = var_field.object;
                var object = self.hir.vars[object_id];

                var object_type = object->get_type_forced();

                while (object.kind == HIR.Var.Kind.Cast) {
                    object_id = object$cast(HIR.VarCast).casted;
                    object = self.hir.vars[object_id];
                }
                var parent = self->get_arg_from_hir(object_id);

                var field_name = var_field.field;
                var field_offset = var_field.offset;
                assert(field_offset >= 0);
                
                var class_name: str;
                if (object_type.kind == Type.Kind.Class) {
                    var class_type = object_type$cast(TypeClass);
                    var class_namespace_parent = class_type.namespace.parents[0];
                    var is_export = class_namespace_parent->find(class_type.name).info.exxport;

                    class_name = class_type.namespace.fullname;
                    if (!is_export) {
                        class_name = "." .. class_name;
                    }
                } else if (object_type.kind == Type.Kind.Array) {
                    class_name = "ArrayHeader." .. field_name;
                } else {
                    assert(false);
                }

                var field_fullname = class_name .. "." .. field_name;

                var arg = AsmArgRef();
                arg.kind = AsmArg.Kind.Ref;
                arg.size = type->get_stack_size()$cast(Size);
                arg.type = type;

                arg.parent = parent;
                arg.name = field_fullname;
                arg.offset = field_offset$cast(i64);

                return arg;
            }

            io.println(varr.kind$cast(str));
            assert(false);
            return null;
        }

        fn insert_mov_to_reg(self: Builder, size: Size, target_reg: Reg, arg: AsmArg) {
            if (arg.kind == AsmArg.Kind.Literal) {
                var value = arg$cast(AsmArgLiteral).value;

                var type = arg.type;

                if (type == Types.instance.type_char$cast(Type)) {
                    self->insert_rm_char(Tag.MOV, Size.Bit8, ModRM.construct_reg(target_reg), value$cast(char));
                } else {
                    self->insert_rm_imm(Tag.MOV, size, ModRM.construct_reg(target_reg), value);
                }

                return;
            }

            if (arg.kind == AsmArg.Kind.Global) {
                self->push_cast_aware_mov(arg.type, size, target_reg, ModRM.construct_indir_rip_label(arg$cast(AsmArgGlobal).label));
                return;
            }

            if (arg.kind == AsmArg.Kind.GlobalAddress) {
                self->insert_reg_rm(Tag.LEA, Size.Ptr, target_reg, ModRM.construct_indir_rip_label(arg$cast(AsmArgGlobal).label));
                return;
            }

            if (arg.kind == AsmArg.Kind.OnStack) {
                var arg_on_stack = arg$cast(AsmArgOnStack);
                self->push_cast_aware_mov(arg.type, size, target_reg, self->modrm_stack(size, arg_on_stack.stack, arg_on_stack.name));
                return;
            }

            if (arg.kind == AsmArg.Kind.Ref) {
                var arg_ref = arg$cast(AsmArgRef);
                self->insert_mov_to_reg(size, target_reg, arg_ref.parent);
                // self.inline_symbols
                if (true) {
                    self->push_cast_aware_mov(arg.type, size, target_reg, ModRM.construct_indir_base_label(target_reg, arg_ref.name, arg_ref.offset$cast(i32)));
                } else {
                    /*
                    push_cast_aware_mov(p_builder, p_arg->p_type, size, target_reg, MODRM_INDIR_BASE_DISP(donor_reg, object_bucket->value.stack_offset)); 
                    */
                }
                return;
            }

            assert(false);
        }

        fn insert_mov_from_reg(self: Builder, size: Size, arg: AsmArg, source_reg: Reg) {
            if (arg.kind == AsmArg.Kind.Global) {
                self->insert_rm_reg(Tag.MOV, size, ModRM.construct_indir_rip_label(arg$cast(AsmArgGlobal).label), source_reg);
                return;
            }

            if (arg.kind == AsmArg.Kind.OnStack) {
                var arg_on_stack = arg$cast(AsmArgOnStack);
                self->insert_rm_reg(Tag.MOV, size, self->modrm_stack(arg.size, arg_on_stack.stack, arg_on_stack.name), source_reg);
                return;
            }

            if (arg.kind == AsmArg.Kind.Ref) {
                var arg_ref = arg$cast(AsmArgRef);
                var donor_reg = Reg.R10;
                self->insert_mov_to_reg(size, donor_reg, arg_ref.parent);
                // self.inline_symbols
                if (true) {
                    self->insert_rm_reg(Tag.MOV, size, ModRM.construct_indir_base_label(donor_reg, arg_ref.name, arg_ref.offset$cast(i32)), source_reg);
                } else {
                    /*
                    ketl_asm_x86_insert_rm_reg(p_builder, KETL_ASM_X86_MOV, size, MODRM_INDIR_BASE_DISP(donor_reg, object_bucket->value.stack_offset), source_reg);
                    */
                }
                return;
            }

            assert(false);
        }

        fn modrm_stack(self: Builder, size: Size, stack: u64, name: str) => ModRM {
            switch (self.abi) {
                case ABI.WINDOWS =>
                    // TODO self.inline_symbols
                    if (true) {
                        return ModRM.construct_indir_base_label(Reg.SP, name, stack$cast(i32));
                    } else {
                        return ModRM.construct_indir_base_disp(Reg.SP, stack$cast(i32));
                    }
                case ABI.SYSTEM_V =>
                    // TODO 4294967296 => 0x100000000
                    return ModRM.construct_indir_base_disp(Reg.BP, (4294967296$cast(u64) - stack - size)$cast(i32));
            }

            assert(false);
            return ModRM.construct_empty();
        }

        fn modrm_stack_from_arg_info(self: Builder, size: Size, arg_info: ArgInfo) => ModRM {
            return self->modrm_stack(size, arg_info.stack_offset, arg_info.name);
        }

        fn push_cast_aware_mov(self: Builder, rhs_type: Type, size: Size, target_reg: Reg, rhs: ModRM) {
            var rhs_type_size = rhs_type->get_stack_size()$cast(Size);
            if (!(size == rhs_type_size || (rhs_type != null && (rhs_type.kind == Type.Kind.Primitive || rhs_type.kind == Type.Kind.Enum)))) {
                self->insert_reg_rm(Tag.MOV, size, target_reg, rhs); 
                return;
            }

            if (size > rhs_type_size) {
                if (rhs_type.kind == Type.Kind.Enum) {
                    rhs_type = rhs_type$cast(TypeEnum).parent;
                }
                var rhs_primitive_type = rhs_type$cast(TypePrimitive);
                if (rhs_primitive_type.signed) {
                    switch (rhs_type_size) {
                        case Size.Bit8 =>
                            if (size < Size.Bit64) {
                                self->insert_reg_rm(Tag.MOVSX8, Size.Bit32, target_reg, rhs);
                            } else {
                                self->insert_reg_rm(Tag.MOVSX8, Size.Bit64, target_reg, rhs);
                            }
                        case Size.Bit16 =>
                            if (size < Size.Bit64) {
                                self->insert_reg_rm(Tag.MOVSX16, Size.Bit32, target_reg, rhs);
                            } else {
                                self->insert_reg_rm(Tag.MOVSX16, Size.Bit64, target_reg, rhs);
                            }
                        case Size.Bit32 =>
                            if (size < Size.Bit64) {
                                self->insert_reg_rm(Tag.MOVSX32, Size.Bit32, target_reg, rhs);
                            } else {
                                self->insert_reg_rm(Tag.MOVSX32, Size.Bit64, target_reg, rhs);
                            }
                    }
                } else {
                    switch (rhs_type_size) {
                        case Size.Bit8 =>
                            self->insert_reg_rm(Tag.MOVZX8, Size.Bit32, target_reg, rhs);
                        case Size.Bit16 =>
                            self->insert_reg_rm(Tag.MOVZX16, Size.Bit32, target_reg, rhs);
                        case Size.Bit32 =>
                            self->insert_reg_rm(Tag.MOV, Size.Bit32, target_reg, rhs);
                    }
                }
            } else {
                self->insert_reg_rm(Tag.MOV, size, target_reg, rhs); 
            }
        }

        fn push_function_arguments(self: Builder, arguments: AsmArg[]) {
            if (arguments.size == 0) {
                return;
            }

            var i: u64 = arguments.size - 1;
            while (true) {
                var arg = arguments[i];
                var type = arg.type;
                var size = type->get_stack_size()$cast(Size);
                
                var regs = parameters_regs[self.abi];
                var reg_count = regs.size;
                if (i < reg_count) {
                    var reg = regs[i];
                    self->insert_mov_to_reg(size, reg, arg);
                } else {
                    assert(self.abi == ABI.WINDOWS);

                    self->insert_mov_to_reg(size, Reg.AX, arg);
                    var reg_space_size = raw$size * reg_count;

                    var parameter = AsmArgOnStack();
                    parameter.kind = AsmArg.Kind.OnStack;
                    parameter.size = type->get_stack_size()$cast(Size);
                    parameter.type = type;

                    parameter.name = null;
                    parameter.stack = reg_space_size + (i - reg_count) * raw$size;

                    self->insert_mov_from_reg(size, parameter, Reg.AX);
                }

                if (i == 0) {
                    break;
                }
                i -= 1;
            }
        }

        fn finalize_stask_size(self: Builder) {
            var has_calls = self.hir.max_call_arg_count != (-1)$cast(u8);

            switch (self.abi) {
                case ABI.WINDOWS => {
                    var WINDOWS_SHADOW_STACK_SPACE: u32 = 8; // I'm not sure about it, I came to this during msvc disasm study
                    if (!has_calls && self.stack_reserved_size <= 0) {
                        self.stack_reserved_size = 0;
                        return;
                    }

                    self.stack_reserved_size = align_forward(self.stack_reserved_size, 16)$cast(u32); // 16-bites aligned
                    self.stack_reserved_size += WINDOWS_SHADOW_STACK_SPACE; // add shadow space AFTER alignment
                    return;
                }
                case ABI.SYSTEM_V => {
                    var SYSTEM_V_SHADOW_STACK_SPACE: u32 = 128;
                    if (!((has_calls && self.stack_reserved_size > 0) || (!has_calls && self.stack_reserved_size > SYSTEM_V_SHADOW_STACK_SPACE))) {
                        return;
                    }

                    if (!has_calls && self.stack_reserved_size > SYSTEM_V_SHADOW_STACK_SPACE) {
                        self.stack_reserved_size -= SYSTEM_V_SHADOW_STACK_SPACE;
                    }
                    self.stack_reserved_size = align_forward(self.stack_reserved_size, 16)$cast(u32); // 16-bites aligned
                }
            };
        }

        export fn build(self: Builder, hir: HIR, func_index: u16) => ASMX86 {
            self.instrs = Instr[0];
            self.hir = hir;
            self.variables->clear();

            self.stack_reserved_size = 0;

            var abi_parameters_regs = parameters_regs[self.abi];

            assert(self.abi == ABI.WINDOWS);
            {
                if (self.hir.max_call_arg_count != (-1)$cast(u8) && self.hir.max_call_arg_count > 0) {
                    var parameters_needed = abi_parameters_regs.size;
                    if (parameters_needed < self.hir.max_call_arg_count) {
                        parameters_needed = self.hir.max_call_arg_count;
                    }
                    self.stack_reserved_size = self.hir.max_call_arg_count * raw$size; // size of reg parameters, has to be preallocated
                }
            }

            var decl_id: HIR.DeclId = self.hir.parameters_count;
            while (decl_id < self.hir.decls.size) {
                var decl = self.hir.decls[decl_id];

                // local or temporary variable
                var arg_info = ArgInfo.construct(self.stack_reserved_size, decl.name);


                var bucket = self.variables->get_or_insert(decl_id, arg_info);
                if (bucket.value$cast(ArgInfo).stack_offset == arg_info.stack_offset) {
                    // TODO FIX take into account type size and alignment
                    self.stack_reserved_size += i64$size;
                }

                decl_id += 1;
            }

            self->finalize_stask_size();

            assert(self.abi == ABI.WINDOWS);
            {
                if (self.stack_reserved_size > 0) {
                    if (self.stack_reserved_size < 4096) {
                            self->insert_rm_imm(Tag.SUB, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);
                    } else {
                            self->insert_rm_imm(Tag.MOV, Size.Ptr, ModRM.construct_reg(Reg.AX), self.stack_reserved_size);
                            var func_name = "___chkstk_ms";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                            self->insert_rm_reg(Tag.SUB, Size.Ptr, ModRM.construct_reg(Reg.SP), Reg.AX);
                    }

                    self->directive(("seh_stackalloc " .. self.stack_reserved_size$cast(str)));
                    self->directive("seh_endprologue");
                }

                var decl_id: HIR.DeclId = self.hir.parameters_count;
                while (decl_id > 0) {
                    decl_id -= 1;
                    var decl = self.hir.decls[decl_id];

                    assert(decl.kind == HIR.Decl.Kind.Parameter);
                    var parameter = decl$cast(HIR.DeclParameter);

                    var arg_info = ArgInfo.construct((decl_id + 1) * raw$size + self.stack_reserved_size, decl.name);

                    self.variables->get_or_insert(decl_id, arg_info);

                    if (decl_id < abi_parameters_regs.size) {
                        var type = decl->get_type();
                        var size = type->get_stack_size()$cast(Size);
                        var reg = abi_parameters_regs[decl_id];
                        self->insert_rm_reg(Tag.MOV, size, self->modrm_stack_from_arg_info(size, arg_info), reg);
                    }
                }
            }

            var first_instr_in_block = true;
            var block_counter: u16;

            var i: u32;
            while (i < self.hir.instrs.size) {
                if (first_instr_in_block) {
                    first_instr_in_block = false;
                    
                    self.hir_to_asm_offsets->get_or_insert(i, self.instrs.size$cast(raw));

                    var label = ".LBB";
                    label ..= func_index$cast(str);
                    label ..= "_";
                    label ..= block_counter$cast(str);
                    block_counter += 1;

                    self->label(label);
                }

                var instr = self.hir.instrs[i];

                switch (instr.tag) {
                    default => {
                        io.print("unknown tag: ");
                        io.println(instr.tag$cast(str));
                        assert(false);
                    }
                    case HIR.Tag.UNARY_PLUS => {}
                    case HIR.Tag.LOGICAL_NOT
                    case HIR.Tag.BITWISE_NOT
                    case HIR.Tag.UNARY_MINUS => {
                        var hir_info = instr$cast(HIR.UnaryOp);
                        var output = self.hir.vars[hir_info.output];
                        var type = output->get_type_forced();
                        var size = type->get_stack_size()$cast(Size);
                        self->insert_mov_to_reg(size, Reg.AX, self->get_arg_from_hir(hir_info.arg));

                        switch (instr.tag) {
                            case HIR.Tag.LOGICAL_NOT => {
                                self->insert_rm_reg(Tag.TEST, size, ModRM.construct_reg(Reg.AX), Reg.AX);
                                self->insert_rm(Tag.SETZ, Size.Bit8, ModRM.construct_reg(Reg.AX));
                            }
                            case HIR.Tag.BITWISE_NOT => self->insert_reg_rm(Tag.NOT, size, Reg.AX, ModRM.construct_reg(Reg.AX));
                            case HIR.Tag.UNARY_MINUS => self->insert_reg_rm(Tag.NEG, size, Reg.AX, ModRM.construct_reg(Reg.AX));
                        }

                        self->insert_mov_from_reg(size, self->get_arg_from_hir(hir_info.output), Reg.AX);
                    }
                    case HIR.Tag.PLUS
                    case HIR.Tag.MINUS

                    case HIR.Tag.MULTY
                    case HIR.Tag.DIVIDE
                    case HIR.Tag.MOD

                    case HIR.Tag.BITWISE_AND
                    case HIR.Tag.BITWISE_OR
                    case HIR.Tag.BITWISE_XOR 

                    case HIR.Tag.BITWISE_SHIFT_LEFT 
                    case HIR.Tag.BITWISE_SHIFT_RIGHT 

                    case HIR.Tag.EQUAL
                    case HIR.Tag.NOT_EQUAL
                    case HIR.Tag.LESS
                    case HIR.Tag.LESS_OR_EQUAL
                    case HIR.Tag.GREATER
                    case HIR.Tag.GREATER_OR_EQUAL => {
                        var hir_info = instr$cast(HIR.BinaryOp);
                        var output = self.hir.vars[hir_info.output];
                        var type = output->get_type_forced();
                        var size = type->get_stack_size()$cast(Size);
                        self->insert_mov_to_reg(size, Reg.CX, self->get_arg_from_hir(hir_info.rhs));
                        self->insert_mov_to_reg(size, Reg.AX, self->get_arg_from_hir(hir_info.lhs));

                        switch (instr.tag) {
                            case HIR.Tag.PLUS => self->insert_reg_rm(Tag.ADD, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.MINUS => self->insert_reg_rm(Tag.SUB, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            
                            case HIR.Tag.MULTY => // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.DIVIDE => {
                                self->insert_reg_rm(Tag.IMUL, size, Reg.DX, ModRM.construct_reg(Reg.DX));
                                // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                            }
                            case HIR.Tag.MOD => {
                                self->insert_reg_rm(Tag.XOR, size, Reg.DX, ModRM.construct_reg(Reg.DX));
                                // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                                self->insert_reg_rm(Tag.MOV, size, Reg.AX, ModRM.construct_reg(Reg.DX));
                            }
                            
                            case HIR.Tag.BITWISE_AND => self->insert_reg_rm(Tag.AND, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.BITWISE_OR => self->insert_reg_rm(Tag.OR, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.BITWISE_XOR => self->insert_reg_rm(Tag.XOR, size, Reg.AX, ModRM.construct_reg(Reg.CX));

                            case HIR.Tag.BITWISE_SHIFT_LEFT => // explicitly uses CX
                                if (type->is_signed()) self->insert_rm(Tag.SAL, size, ModRM.construct_reg(Reg.AX));
                                else                   self->insert_rm(Tag.SHL, size, ModRM.construct_reg(Reg.AX));
                            case HIR.Tag.BITWISE_SHIFT_RIGHT => // explicitly uses CX
                                if (type->is_signed()) self->insert_rm(Tag.SAR, size, ModRM.construct_reg(Reg.AX));
                                else                   self->insert_rm(Tag.SHR, size, ModRM.construct_reg(Reg.AX));

                            case HIR.Tag.EQUAL => {
                                self->insert_reg_rm(Tag.CMP, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                                // TODO pick correct SETE or SETZ
                                // and below
                                self->insert_rm(Tag.SETE, Size.Bit8, ModRM.construct_reg(Reg.AX));
                            }
                            case HIR.Tag.NOT_EQUAL => {
                                self->insert_reg_rm(Tag.CMP, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                                self->insert_rm(Tag.SETE, Size.Bit8, ModRM.construct_reg(Reg.AX));
                            }
                            case HIR.Tag.LESS  => {
                                self->insert_reg_rm(Tag.CMP, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                                self->insert_rm(Tag.SETL, Size.Bit8, ModRM.construct_reg(Reg.AX));
                            }
                            case HIR.Tag.LESS_OR_EQUAL => {
                                self->insert_reg_rm(Tag.CMP, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                                self->insert_rm(Tag.SETLE, Size.Bit8, ModRM.construct_reg(Reg.AX));
                            }
                            case HIR.Tag.GREATER => {
                                self->insert_reg_rm(Tag.CMP, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                                self->insert_rm(Tag.SETG, Size.Bit8, ModRM.construct_reg(Reg.AX));
                            }
                            case HIR.Tag.GREATER_OR_EQUAL => {
                                self->insert_reg_rm(Tag.CMP, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                                self->insert_rm(Tag.SETGE, Size.Bit8, ModRM.construct_reg(Reg.AX));
                            }
                        }

                        self->insert_mov_from_reg(size, self->get_arg_from_hir(hir_info.output), Reg.AX);
                    }

                    case HIR.Tag.ASSIGN => {
                        var hir_info = instr$cast(HIR.Assign);
                        var dst = self.hir.vars[hir_info.dst];
                        var type = dst->get_type_forced();
                        var size = type->get_stack_size()$cast(Size);
                        self->insert_mov_to_reg(size, Reg.AX, self->get_arg_from_hir(hir_info.src));
                        self->insert_mov_from_reg(size, self->get_arg_from_hir(hir_info.dst), Reg.AX);
                    }

                    case HIR.Tag.ASSIGN_PLUS
                    case HIR.Tag.ASSIGN_MINUS
                    case HIR.Tag.ASSIGN_MULTY
                    case HIR.Tag.ASSIGN_DIVIDE
                    case HIR.Tag.ASSIGN_MOD

                    case HIR.Tag.ASSIGN_BITWISE_AND
                    case HIR.Tag.ASSIGN_BITWISE_OR
                    case HIR.Tag.ASSIGN_BITWISE_XOR => {
                        var hir_info = instr$cast(HIR.Assign);
                        var dst = self.hir.vars[hir_info.dst];
                        var type = dst->get_type_forced();
                        var size = type->get_stack_size()$cast(Size);
                        self->insert_mov_to_reg(size, Reg.CX, self->get_arg_from_hir(hir_info.src));
                        self->insert_mov_to_reg(size, Reg.AX, self->get_arg_from_hir(hir_info.dst));
                        switch (instr.tag) {
                            case HIR.Tag.ASSIGN_PLUS => self->insert_reg_rm(Tag.ADD, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.ASSIGN_MINUS => self->insert_reg_rm(Tag.SUB, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            
                            case HIR.Tag.ASSIGN_MULTY => // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.ASSIGN_DIVIDE => {
                                self->insert_reg_rm(Tag.IMUL, size, Reg.DX, ModRM.construct_reg(Reg.DX));
                                // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                            }
                            case HIR.Tag.ASSIGN_MOD => {
                                self->insert_reg_rm(Tag.XOR, size, Reg.DX, ModRM.construct_reg(Reg.DX));
                                // explicitly uses AX
                                if (type->is_signed()) self->insert_rm(Tag.IMUL, size, ModRM.construct_reg(Reg.CX));
                                else                   self->insert_rm(Tag.MUL, size, ModRM.construct_reg(Reg.CX));
                                self->insert_reg_rm(Tag.MOV, size, Reg.AX, ModRM.construct_reg(Reg.DX));
                            }
                            
                            case HIR.Tag.ASSIGN_BITWISE_AND => self->insert_reg_rm(Tag.AND, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.ASSIGN_BITWISE_OR => self->insert_reg_rm(Tag.OR, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                            case HIR.Tag.ASSIGN_BITWISE_XOR => self->insert_reg_rm(Tag.XOR, size, Reg.AX, ModRM.construct_reg(Reg.CX));
                        }
                        self->insert_mov_from_reg(size, self->get_arg_from_hir(hir_info.dst), Reg.AX);
                    }

                    case HIR.Tag.CALL => {
                        var hir_info = instr$cast(HIR.Call);

                        var callee = self.hir.vars[hir_info.callee];
                        var callee_type = callee->get_type_forced();
                        assert(callee_type != null);

                        // TODO FIX allow other types to be called
                        assert(callee_type.kind == Type.Kind.Function || callee_type.kind == Type.Kind.CFunction);

                        var func_type = callee_type$cast(TypeFunction); 
                        var return_type = func_type.signature.parameters[0];

                        var args = AsmArg[0];
                        for (var var_id <- hir_info.args) {
                            args ..= self->get_arg_from_hir(var_id);
                        }
                        self->push_function_arguments(args);

                        // call
                        var arg_callee = self->get_arg_from_hir(hir_info.callee);

                        // TODO self.inline_symbols
                        if (true && arg_callee.kind == AsmArg.Kind.GlobalAddress) {
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(arg_callee$cast(AsmArgGlobal).label));
                        } else {
                            self->insert_mov_to_reg(return_type->get_stack_size()$cast(Size), Reg.AX, arg_callee);
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_reg(Reg.AX));
                        }
                            
                        if (return_type != Types.instance.type_void$cast(Type)) {
                            self->insert_mov_from_reg(return_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.output), Reg.AX);
                        }
                    }

                    case HIR.Tag.NEW_CLASS => {
                        var hir_info = instr$cast(HIR.New);
                        
                        var callee_type = hir_info.type;

                        assert(callee_type.kind == Type.Kind.Class);

                        self->push_function_arguments(AsmArg[1]{
                            AsmArg.construct_type(callee_type)
                        });

                        // call

                        // TODO self.inline_symbols
                        if (true) {
                            var func_name = "__ketl_rt.new";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        self->insert_mov_from_reg(callee_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.output), Reg.AX);
                    }

                    case HIR.Tag.NEW_ARRAY => {
                        var hir_info = instr$cast(HIR.NewArray);
                        
                        var value_type = hir_info.type;
                        var array_type = Types.instance->get_array_type(value_type);

                        var initial_constant = self.hir->get_constant(hir_info.initial_value);

                        self->push_function_arguments(AsmArg[4]{
                            AsmArg.construct_literal(Types.instance.type_u64, value_type->get_stack_size()),
                            self->get_arg_from_hir(hir_info.size),
                            AsmArg.construct_constant(initial_constant),
                            AsmArg.construct_constant_size(initial_constant),
                        });

                        // call

                        // TODO self.inline_symbols
                        if (true) {
                            var func_name = "__ketl_rt.new_array";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        self->insert_mov_from_reg(array_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.output), Reg.AX);
                    }

                    case HIR.Tag.NEW_SLICE => {
                        var hir_info = instr$cast(HIR.NewSlice);
                        
                        var output = self.hir.vars[hir_info.output];
                        var array_type = output->get_type_forced();

                        self->push_function_arguments(AsmArg[3]{
                            self->get_arg_from_hir(hir_info.mirrored),
                            self->get_arg_from_hir(hir_info.start),
                            self->get_arg_from_hir(hir_info.end),
                        });

                        // call

                        // TODO self.inline_symbols
                        if (true) {
                            var func_name = "__ketl_rt.new_slice";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        self->insert_mov_from_reg(array_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.output), Reg.AX);
                    }

                    case HIR.Tag.GET_ARRAY_VALUE => {
                        var hir_info = instr$cast(HIR.GetArrayValue);
                        
                        var output = self.hir.vars[hir_info.output];
                        var value_type = output->get_type_forced();

                        self->push_function_arguments(AsmArg[3]{
                            AsmArg.construct_literal(Types.instance.type_u64, value_type->get_stack_size()),
                            self->get_arg_from_hir(hir_info.array),
                            self->get_arg_from_hir(hir_info.index),
                        });

                        // call

                        // TODO self.inline_symbols
                        if (true) {
                            var func_name = "__ketl_rt.array_get_value";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        self->insert_mov_from_reg(value_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.output), Reg.AX);
                    }

                    case HIR.Tag.SET_ARRAY_VALUE => {
                        var hir_info = instr$cast(HIR.SetArrayValue);
                        
                        var output = self.hir.vars[hir_info.output];
                        var value_type = output->get_type_forced();

                        self->push_function_arguments(AsmArg[4]{
                            AsmArg.construct_literal(Types.instance.type_u64, value_type->get_stack_size()),
                            self->get_arg_from_hir(hir_info.array),
                            self->get_arg_from_hir(hir_info.index),
                            self->get_arg_from_hir(hir_info.value),
                        });

                        // call

                        // TODO self.inline_symbols
                        if (true) {
                            var func_name = "__ketl_rt.array_set_value";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        self->insert_mov_from_reg(value_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.output), Reg.AX);
                    }

                    case HIR.Tag.APPEND_VALUE => {
                        var hir_info = instr$cast(HIR.Append);
                        
                        var array = self.hir.vars[hir_info.array];
                        var array_type = array->get_type_forced()$cast(TypeArray);
                        assert(array_type.kind == Type.Kind.Array);

                        self->push_function_arguments(AsmArg[3]{
                            AsmArg.construct_literal(Types.instance.type_u64, array_type.value->get_stack_size()),
                            self->get_arg_from_hir(hir_info.array),
                            self->get_arg_from_hir(hir_info.appendee),
                        });

                        // call

                        // TODO self.inline_symbols
                        if (true) {
                            var func_name = "__ketl_rt.append_value";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        self->insert_mov_from_reg(array_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.array), Reg.AX);
                    }

                    case HIR.Tag.APPEND_ARRAY => {
                        var hir_info = instr$cast(HIR.Append);
                        
                        var array = self.hir.vars[hir_info.array];
                        var array_type = array->get_type_forced()$cast(TypeArray);
                        assert(array_type.kind == Type.Kind.Array);

                        self->push_function_arguments(AsmArg[3]{
                            AsmArg.construct_literal(Types.instance.type_u64, array_type.value->get_stack_size()),
                            self->get_arg_from_hir(hir_info.array),
                            self->get_arg_from_hir(hir_info.appendee),
                        });

                        // call

                        // TODO self.inline_symbols
                        if (true) {
                            var func_name = "__ketl_rt.append_array";
                            self->insert_rm(Tag.CALL, Size.Ptr, ModRM.construct_literal(func_name));
                        } else { /*
                            push_mov_from_stack_hir(KETL_ASM_X86_AX, p_hir_info->callee, KETL_ASM_X86_PTRSIZE, p_builder);
                            ketl_asm_x86_insert_rm(p_builder, KETL_ASM_X86_CALL, KETL_ASM_X86_PTRSIZE, MODRM_REG(KETL_ASM_X86_AX));*/
                        }
                            
                        self->insert_mov_from_reg(array_type->get_stack_size()$cast(Size), self->get_arg_from_hir(hir_info.array), Reg.AX);
                    }

                    case HIR.Tag.JUMP => {
                        var hir_info = instr$cast(HIR.Jump);

                        if (!first_instr_in_block) {
                            var dest = self.hir->get_first_non_empty_block(hir_info.dst);
                            
                            if (self.hir.block_offsets[dest] != i + 1) {
                                self->insert_jimm(Tag.JMP, Size.None, dest);
                            }
                        }

                        first_instr_in_block = true;
                    }

                    case HIR.Tag.JUMP_IF_TRUE => {
                        var hir_info = instr$cast(HIR.JumpIf);

                        var true_dest = self.hir->get_first_non_empty_block(hir_info.true_dst);
                        var false_dest = self.hir->get_first_non_empty_block(hir_info.false_dst);
                        
                        var expr = self.hir.vars[hir_info.expr];
                        var type = expr->get_type_forced();
                        var size = type->get_stack_size()$cast(Size);
                        self->insert_mov_to_reg(size, Reg.AX, self->get_arg_from_hir(hir_info.expr));

                        switch (instr.tag) {
                            case HIR.Tag.JUMP_IF_TRUE => {
                                self->insert_rm_reg(Tag.TEST, size, ModRM.construct_reg(Reg.AX), Reg.AX);
                                self->insert_jimm(Tag.JNE, Size.None, true_dest);

                                if (self.hir.block_offsets[false_dest] != i + 1) {
                                    self->insert_jimm(Tag.JMP, Size.None, false_dest);
                                }
                            }
                        }


                        first_instr_in_block = true;
                    }

                    case HIR.Tag.RETURN => {
                        if (self.stack_reserved_size > 0) {
                            self->directive("seh_startepilogue");
                            self->insert_rm_imm(Tag.ADD, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);
                            self->directive("seh_endepilogue");
                        }
                        self->insert(Tag.RET);

                        first_instr_in_block = true;
                    }

                    case HIR.Tag.RETURN_VALUE => {
                        var hir_info = instr$cast(HIR.ReturnValue);
                        var value = self.hir.vars[hir_info.value];
                        var type = value->get_type_forced();
                        var size = type->get_stack_size()$cast(Size);
                        self->insert_mov_to_reg(size, Reg.AX, self->get_arg_from_hir(hir_info.value));
                        if (self.stack_reserved_size > 0) {
                            self->directive("seh_startepilogue");
                            self->insert_rm_imm(Tag.ADD, Size.Ptr, ModRM.construct_reg(Reg.SP), self.stack_reserved_size);
                            self->directive("seh_endepilogue");
                        }
                        self->insert(Tag.RET);

                        first_instr_in_block = true;
                    }
                }

                i += 1;
            }

            i = 0;
            while (i < self.instrs.size) {
                var instr = self.instrs[i];

                switch (instr.tag) {
                    case Tag.JMP
                    case Tag.JNE => {
                        var block = instr.goto_offset$cast(HIR.BlockId);
                        var block_offset = self.hir.block_offsets[block];
                        var bucket = self.hir_to_asm_offsets->get_or_null(block_offset);
                        instr.goto_offset = bucket.value$cast(u64)$cast(u32);
                    }
                }

                i += 1;
            }

            var asm_x86 = ASMX86();
            asm_x86.instrs = self.instrs;
            return asm_x86;
        }
    }

    export fn print(self: ASMX86, func_name: str) {
        io.println("    .def    " .. func_name .. ";                    # @" .. func_name);
        io.println("    .scl    2;");
        io.println("    .type   32;");
        io.println("    .endef");
        io.println("    .globl	" .. func_name);
        io.println("    .p2align	4");
        io.println(func_name .. ":");
        io.println(".seh_proc " .. func_name);

        for (var instr <- self.instrs) {
            instr->print(self.instrs);
            io.print("\n");
        }

        io.println("    .seh_endproc");
    } 
}
