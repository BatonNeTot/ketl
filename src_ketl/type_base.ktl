//🫖ketl

export class Type {
    export enum Kind: u8{
        Primitive,
        Enum,
        Function,
        CFunction,
        Array,
        CArray,
        Class,
    }

    export enum Align: u8 {
        Byte,
        Bytes2,
        Bytes4,
        Bytes8,
        Bytes16,
    }

    export fn find_align_enum(align: u8) => Align {
        switch (align) {
            case 2 =>  return Align.Bytes2;
            case 4 =>  return Align.Bytes4;
            case 8 =>  return Align.Bytes8;
            case 16 => return Align.Bytes16;
        }
        return Align.Byte;
    }

    export fn from_align_enum(align: Align) => u8 {
        switch (align) {
            case Align.Bytes2 =>  return 2;
            case Align.Bytes4 =>  return 4;
            case Align.Bytes8 =>  return 8;
            case Align.Bytes16 => return 16;
        }
        return 1;
    }
 
    var kind: Kind;
    var align: Align;
    var size: u16;

    export fn is_pointer_kind(type: Type) => bool {
        if (type == null) {
            return false;
        }

        if (type.kind == Kind.Primitive || type.kind == Kind.Enum) {
            return false;
        } else {
            return true;
        }
    }

    export fn is_void(type: Type) => bool {
        return type != null && type.size == 0 && type.kind == Kind.Primitive;
    }

    export fn get_size(type: Type) => u16 {
        if (type == null) {
            return 0;
        }

        return type.size;
    }

    export fn get_align(type: Type) => Align {
        if (type == null) {
            return Align.Byte;
        }

        return type.align;
    }

    export fn get_stack_size(type: Type) => u16 {
        if (type == null) {
            return 0;
        }

        if (type->is_pointer_kind()) {
            return raw$size;
        } else {
            return type.size;
        }
    }

    export fn get_stack_align(type: Type) => Align {
        if (type == null) {
            return Align.Byte;
        }

        if (type->is_pointer_kind()) {
            return Align.Bytes8;
        } else {
            return type.align;
        }
    }

    export fn is_signed(type: Type) => bool {
        if (type.kind == Type.Kind.Enum) {
            from type import TypeEnum
            type = type$cast(TypeEnum).parent;
        }

        from type import TypePrimitive
        return type.kind == Type.Kind.Primitive && type$cast(TypePrimitive).is_signed;
    }

    export fn get_name(type: Type) => str {
        if (type == null) {
            return "<null>";
        }

        if (type.kind == Type.Kind.Primitive) {
            from type import TypePrimitive
            return type$cast(TypePrimitive).name;
        }

        if (type.kind == Type.Kind.Enum) {
            from type import TypeEnum
            return type$cast(TypeEnum).name;
        }

        if (type.kind == Type.Kind.Function) {
            from type import TypeFunction;
            var func_type = type$cast(TypeFunction);
            var signature = func_type.signature;

            var result_str = "(";
            for (var parameter <- signature.parameters[1:signature.parameters.size - 1]) {
                result_str ..= parameter->get_name();
                result_str ..= ", ";
            }

            var return_type = signature.parameters[0];
            result_str ..= ") => ";
            result_str ..= return_type->get_name();

            return result_str;
        }

        if (type.kind == Type.Kind.Class) {
            from type import TypeClass
            return type$cast(TypeClass).name;
        }

        assert(false);
        return null;
    }
}
