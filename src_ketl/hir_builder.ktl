//🫖ketl

from common import StrHashMap
from common import FilePointer
from common import LogAccum

import io

from type_base import Type
from type import Types
from type import TypePrimitive
from type import TypeEnum
from type import TypeFunction
from type import TypeArray
from type import TypeClass
from value import Value

from hir import HIR
from variable import VariableDecl

from namespace import Namespace

class HIRBuilder {
    var log_accum: LogAccum;
    var log_info: LogAccum.LogInfo;

    var blocks: HIR.Instr[][];
    var vars: HIR.Var[];
    var decls: HIR.Decl[];
    var consts_infos: HIR.Const[];
    var consts_literals: u8[];

    var current_block: u32;
    var func_index: u16;
    var parameters_counter: u32;
    var max_call_arg_count: u8;

    var temp_counter: u32;
    var string_literal_counter: HIR.ConstId;
    var numeric_literal_counter: HIR.ConstId;

    var return_type: Type;
    var name_to_decl_stack: StrHashMap[];

    export fn construct(return_type: Type, func_index: u16, log_accum: LogAccum, log_info: LogAccum.LogInfo) => HIRBuilder {
        var self = HIRBuilder();

        self.log_accum = log_accum;
        self.log_info = log_info;

        self.blocks = HIR.Instr[][1]{ HIR.Instr[0] };
        self.vars = HIR.Var[0];
        self.decls = HIR.Decl[0];
        self.consts_infos = HIR.Const[0];
        self.consts_literals = u8[0];

        self.name_to_decl_stack = StrHashMap[1]{
            StrHashMap.construct()
        };

        self.return_type = return_type;
        self.func_index = func_index;
        self.max_call_arg_count = (-1)$cast(u8);

        return self;
    }

    fn error(self: HIRBuilder, offset: u32, length: u32, message: str) {
        self.log_accum->error(
            self.log_info,
            FilePointer.construct(offset, offset, length),
            message 
        );
    }
    
    export fn reserve_blocks(self: HIRBuilder, count: u32) => HIR.BlockId {
        var first_block = self.blocks.size$cast(HIR.BlockId);
        while (count > 0) {
            self.blocks ..= HIR.Instr[0];
            count -= 1;
        }
        return first_block;
    }
    export fn set_block(self: HIRBuilder, block: HIR.BlockId) {
        self.current_block = block;
    }

    fn get_current_block(self: HIRBuilder) => HIR.Instr[] {
        return self.blocks[self.current_block];
    }

    fn append_instr(self: HIRBuilder, instr: HIR.Instr) {
        self->get_current_block() ..= instr;
        self->on_append(instr);
    }

    fn on_append(self: HIRBuilder, instr: HIR.Instr) {
        switch (instr.tag) {
            case HIR.Tag.CALL => self->on_call(instr$cast(HIR.Call).args.size);
            case HIR.Tag.NEW_CLASS => self->on_call(1);
            case HIR.Tag.NEW_ARRAY => self->on_call(4);
            case HIR.Tag.NEW_SLICE => self->on_call(3);
            case HIR.Tag.GET_ARRAY_VALUE => self->on_call(3);
            case HIR.Tag.SET_ARRAY_VALUE => self->on_call(4);
            case HIR.Tag.APPEND_VALUE => self->on_call(3);
            case HIR.Tag.APPEND_ARRAY => self->on_call(3);
        }
    }

    fn on_call(self: HIRBuilder, arguments_count: u64) {
        if (self.max_call_arg_count == (-1)$cast(u8) || arguments_count > self.max_call_arg_count) {
            self.max_call_arg_count = arguments_count$cast(u8);
        }
    }

    fn is_undef(self: HIRBuilder, var_id: HIR.VarId) => bool {
        if (var_id == (-1)$cast(HIR.VarId)) {
            return true;
        }

        var varr = self.vars[var_id];

        if (varr.kind == HIR.Var.Kind.Error) {
            return true;
        }

        if (varr.kind != HIR.Var.Kind.Common) {
            return false;
        }

        var decl_id = varr$cast(HIR.VarCommon).decl;
        var decl = self.decls[decl_id];
        return decl.kind == HIR.Decl.Kind.Error;
    }

    fn get_common_type(self: HIRBuilder, lhs_id: HIR.VarId, rhs_id: HIR.VarId) => Type {
        var lhs = self.vars[lhs_id];
        var rhs = self.vars[rhs_id];

        var lhs_type = lhs->get_type();
        var rhs_type = rhs->get_type();

        assert(lhs_type != null || lhs.kind == HIR.Var.Kind.Literal);
        assert(rhs_type != null || rhs.kind == HIR.Var.Kind.Literal);

        var is_lhs_integer = lhs.kind == HIR.Var.Kind.Literal || (lhs_type.kind == Type.Kind.Primitive && lhs_type$cast(TypePrimitive).integer) || lhs_type.kind == Type.Kind.Enum;
        var is_rhs_integer = rhs.kind == HIR.Var.Kind.Literal || (rhs_type.kind == Type.Kind.Primitive && rhs_type$cast(TypePrimitive).integer) || rhs_type.kind == Type.Kind.Enum;

        if (is_lhs_integer || is_rhs_integer) {
            if (lhs_type != null && rhs_type != null) {
                return Types.get_common_type(lhs_type, rhs_type);
            }

            if (lhs_type == null && rhs_type == null) {
                // result type definitely will be big enough for both types
                return Types.get_common_type(lhs->get_type_forced(), rhs->get_type_forced());
            }
            // TODO check if other literal can be stored in the selected literal type
            if (lhs_type != null) {
                return lhs_type;
            } else {
                return rhs_type;
            }
        }

        return Types.get_common_type(lhs_type, rhs_type);
    }

    export fn try_cast_to_type(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo, explicit: bool) => HIR.VarId {
        return self->cast_to_type(var_id, target_type, src_info, explicit, false);
    }

    export fn cast_to_type_forced(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo, explicit: bool) => HIR.VarId {
        return self->cast_to_type(var_id, target_type, src_info, explicit, false);
    }

    fn cast_to_type(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo, explicit: bool, forced: bool) => HIR.VarId {
        if (target_type == null) {
            io.errorln("null target type.");
            assert(false);
            return var_id;
        }

        if (self->is_undef(var_id)) {
            if (forced) {
                return self->push_error_var(src_info);
            } else {
                return (-1)$cast(HIR.VarId);
            }
        }

        var varr = self.vars[var_id];

        var type = varr->get_type();

        if (type == null) {
            if (varr.kind == HIR.Var.Kind.Literal) {
                var literal = varr$cast(HIR.VarLiteral);
                if (target_type.kind == Type.Kind.Primitive) {
                    literal.type = target_type;
                    return var_id;
                } 

                if (target_type.kind == Type.Kind.Enum) {
                    if (!explicit) {
                        if (forced) {
                            self->error(src_info.source_offset, src_info.length, "Can't implicitly cast integer literal to enum '" .. target_type->get_name() .. "'.");
                            return self->push_error_var(src_info);
                        } else {
                            return (-1)$cast(HIR.VarId);
                        }
                    }
                    literal.type = target_type;
                    return var_id;
                }

                if (target_type->is_pointer_kind() && literal.value == 0) {
                    literal.type = target_type;
                    return var_id;
                }
            }

            if (forced) {
                self->error(src_info.source_offset, src_info.length, "Can't implicitly cast literal number to '" .. target_type->get_name() .. "'.");
                return self->push_error_var(src_info);
            } else {
                return (-1)$cast(HIR.VarId);
            }
        }

        if (Types.is_types_equal(type, target_type)) {
            return var_id;
        }

        if (type.kind == Type.Kind.Primitive || type.kind == Type.Kind.Enum) {
            if (target_type.kind == Type.Kind.Primitive || target_type.kind == Type.Kind.Enum) {
                var to_enum = false;
                if (target_type.kind == Type.Kind.Enum) {
                    to_enum = true;
                    target_type = target_type$cast(TypeEnum).parent;
                }
                if (type.kind == Type.Kind.Enum) {
                    type = type$cast(TypeEnum).parent;
                }

                var lhs_type_primitive = target_type$cast(TypePrimitive);
                var rhs_type_primitive = type$cast(TypePrimitive);
                if ((rhs_type_primitive.size > lhs_type_primitive.size || rhs_type_primitive.signed != lhs_type_primitive.signed) && !explicit) {
                    if (forced) {
                        self->error(src_info.source_offset, src_info.length, "Can't cast type '" .. 
                            rhs_type_primitive->get_name() .. "' to type '" .. lhs_type_primitive->get_name() .. "' implicitly.");
                        return self->push_error_var(src_info);
                    } else {
                        return (-1)$cast(HIR.VarId);
                    }
                }

                return self->push_casted_var(var_id, target_type, src_info);
            }

            if (target_type == Types.instance->get_str_type()$cast(Type)) {
                var func_name: str;
                var arg_type: Type;
                if (type->is_signed()) {
                    func_name = "__ketl_rt.int2str";
                    arg_type = Types.instance.type_i64;
                } else {
                    func_name = "__ketl_rt.uint2str";
                    arg_type = Types.instance.type_u64;
                }
                return self->push_call(self->push_arbitrary_global_var(
                    func_name, 
                    Types.instance->get_function_type(Type[2]{
                        Types.instance->get_str_type(),
                        arg_type,
                    }), 
                    src_info), HIR.VarId[1]{ var_id }, src_info);
            }
        }

        if (type->is_pointer_kind() && target_type == Types.instance.type_raw$cast(Type) ||
            target_type->is_pointer_kind() && type == Types.instance.type_raw$cast(Type)) {
            return self->push_casted_var(var_id, target_type, src_info);
        }

        if (type == Types.instance->get_str_type()$cast(Type) && target_type == Types.instance->get_cstr_type()$cast(Type)) {
            return self->push_call(self->push_arbitrary_global_var(
                "__ketl_rt.str2cstr", 
                Types.instance->get_function_type(Type[2]{
                    Types.instance->get_cstr_type(),
                    Types.instance->get_str_type(),
                }), 
                src_info), HIR.VarId[1]{ var_id }, src_info);
        }

        if (type.kind == Type.Kind.Class && target_type.kind == Type.Kind.Class) {
            var rhs_class_type = type$cast(TypeClass);
            var lhs_class_type = target_type$cast(TypeClass);

            var extended_offset = rhs_class_type->find_extended_class_offset(lhs_class_type);
            if (extended_offset >= 0) {
                // TODO align class
                assert(extended_offset == 0);
                return self->push_casted_var(var_id, target_type, src_info);
            }

            extended_offset = lhs_class_type->find_extended_class_offset(rhs_class_type);
            if (extended_offset >= 0) {
                if (!explicit) {
                    if (forced) {
                        self->error(src_info.source_offset, src_info.length, "Can't implicitly cast class '" .. rhs_class_type->get_name() .. "' to class '" .. lhs_class_type->get_name() .. "'.");
                        return self->push_error_var(src_info);
                    } else {
                        return (-1)$cast(HIR.VarId);
                    }
                }

                // TODO align class
                assert(extended_offset == 0);
                return self->push_casted_var(var_id, target_type, src_info);
            }
        }
        
        if (forced) {
            self->error(src_info.source_offset, src_info.length, "Can't convert '" .. type->get_name() .. "' to '" .. target_type->get_name() .. "'.");
            return self->push_error_var(src_info);
        } else {
            return (-1)$cast(HIR.VarId);
        }
    }

    export fn push_tagonly_instr(self: HIRBuilder, tag: HIR.Tag, src_info: HIR.SrcInfo) {
        var instr = HIR.Instr();
        instr.tag = tag;
        instr.src_info = src_info;
        self->append_instr(instr);
    }

    export fn push_jump(self: HIRBuilder, target: HIR.BlockId) {
        var instr = HIR.Jump();
        instr.tag = HIR.Tag.JUMP;
        instr.src_info = null; // TODO
        instr.dst = target;
        self->append_instr(instr);
    }

    export fn push_if(self: HIRBuilder, bool_expr_var: HIR.VarId, true_statement: HIR.BlockId, false_statement: HIR.BlockId) {
        // TODO check casting

        var instr = HIR.JumpIf();
        instr.tag = HIR.Tag.JUMP_IF_TRUE; // TODO pick best
        instr.src_info = null; // TODO
        instr.expr = bool_expr_var;
        instr.true_dst = true_statement;
        instr.false_dst = false_statement;
        self->append_instr(instr);
    }
    
    export fn push_unary_op(self: HIRBuilder, tag: HIR.Tag, var_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(var_id)) {
            return self->push_error_var(src_info);
        }

        var varr = self.vars[var_id];
        var type = varr->get_type_forced();
        // TODO deduce
        var arg_type = type;
        var output_type = type;
        switch (tag) {
            case HIR.Tag.LOGICAL_NOT => output_type = Types.instance.type_bool;
            case HIR.Tag.BITWISE_NOT
            case HIR.Tag.UNARY_PLUS => output_type = arg_type;
            case HIR.Tag.UNARY_MINUS => {
                if (arg_type.kind != Type.Kind.Primitive) {
                    io.errorln("Can't unary minus '" .. arg_type->get_name() .. "' in '" .. self.log_info.filename .. "' at " .. src_info.source_offset$cast(str) .. ".");
                    assert(false);
                }
                output_type = arg_type$cast(TypePrimitive)->get_signed();
            }
        }

        var arg_src_info = self.vars[var_id].src_info;
        var_id = self->cast_to_type_forced(var_id, arg_type, arg_src_info, false);

        var instr = HIR.UnaryOp();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(output_type, instr);
        instr.arg = var_id;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_binary_op(self: HIRBuilder, tag: HIR.Tag, lhs_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(lhs_id) || self->is_undef(rhs_id)) {
            return self->push_error_var(src_info);
        }

        // TODO check if both literals and calc

        var common_type = self->get_common_type(lhs_id, rhs_id);

        if (common_type == null) {
            var lhs = self.vars[lhs_id];
            var rhs = self.vars[rhs_id];

            var lhs_type = lhs->get_type_forced();
            var rhs_type = rhs->get_type_forced();

            if ((tag == HIR.Tag.PLUS || tag == HIR.Tag.MINUS) && 
                (lhs_type == Types.instance.type_raw$cast(Type) && rhs_type.kind == Type.Kind.Primitive && rhs_type$cast(TypePrimitive).numeric ||
                rhs_type == Types.instance.type_raw$cast(Type) && lhs_type.kind == Type.Kind.Primitive && lhs_type$cast(TypePrimitive).numeric)) {
                
                var instr = HIR.BinaryOp();
                instr.tag = tag;
                instr.src_info = src_info;
                instr.output = self->push_instr_result_var(Types.instance.type_raw, instr);
                instr.lhs = lhs_id;
                instr.rhs = rhs_id;
                self->append_instr(instr);

                return instr.output;
            }

            self->error(src_info.source_offset, src_info.length, "Can't do operator '" .. HIR.get_str_representation(tag) .. "' over '" 
                .. lhs_type->get_name() .. "' and '" .. rhs_type->get_name() .. "'.");
            return self->push_error_var(src_info);
        }

        // TODO deduce
        var arg_type = common_type;
        var output_type = common_type;
        switch (tag) {
            case HIR.Tag.LESS
            case HIR.Tag.LESS_OR_EQUAL
            case HIR.Tag.GREATER
            case HIR.Tag.GREATER_OR_EQUAL
            case HIR.Tag.EQUAL
            case HIR.Tag.NOT_EQUAL
                => output_type = Types.instance.type_bool;
        }

        var lhs_src_info = self.vars[lhs_id].src_info;
        var rhs_src_info = self.vars[rhs_id].src_info;
        lhs_id = self->cast_to_type_forced(lhs_id, arg_type, lhs_src_info, false);
        rhs_id = self->cast_to_type_forced(rhs_id, arg_type, rhs_src_info, false);

        var instr = HIR.BinaryOp();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(output_type, instr);
        instr.lhs = lhs_id;
        instr.rhs = rhs_id;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_assign(self: HIRBuilder, tag: HIR.Tag, lhs_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(lhs_id) || self->is_undef(rhs_id)) {
            return self->push_error_var(src_info);
        }

        if (self->is_get_array_value(lhs_id)) {
            if (tag == HIR.Tag.ASSIGN) {
                return self->promote_to_set_array_value(lhs_id, rhs_id, src_info);
            } else {
                assert(false);
            }
        }

        var lhs = self.vars[lhs_id];
        var type = lhs->get_type_forced();
        var rhs_src_info = self.vars[rhs_id].src_info;
        rhs_id = self->cast_to_type_forced(rhs_id, type, rhs_src_info, false);

        if (self->is_undef(rhs_id)) {
            return self->push_error_var(src_info);
        }

        var instr = HIR.Assign();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.dst = lhs_id;
        instr.src = rhs_id;
        self->append_instr(instr);

        // TODO return new var to update src_info
        return instr.dst;
    }

    export fn push_call(self: HIRBuilder, callee_id: HIR.VarId, arguments: HIR.VarId[], src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(callee_id)) {
            return self->push_error_var(src_info);
        }

        var callee = self.vars[callee_id];
        var type = callee->get_type_forced();

        if (type.kind != Type.Kind.Function && type.kind != Type.Kind.CFunction) {
            self->error(src_info.source_offset, src_info.length, "Only functions can be called.");
            return self->push_error_var(src_info);
        }
        var function_type = type$cast(TypeFunction);
        var function_signature = function_type.signature;

        if (function_signature.parameters.size - 1 != arguments.size) {
            self->error(src_info.source_offset, src_info.length, "Arguments count does not match function parameters count: " .. arguments.size$cast(str) .. " instead of " .. (function_signature.parameters.size - 1)$cast(str) .. ".");
            return self->push_error_var(src_info);
        }

        var return_type = function_signature.parameters[0];

        // TODO cast every argument to the parameter type and type check
        
        var instr = HIR.Call();
        instr.tag = HIR.Tag.CALL;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(return_type, instr);
        instr.callee = callee_id;
        instr.args = arguments;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_new(self: HIRBuilder, callee_type: Type, arguments: HIR.VarId[], src_info: HIR.SrcInfo) => HIR.VarId {
        var instr = HIR.New();
        instr.tag = HIR.Tag.NEW_CLASS;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(callee_type, instr);
        instr.type = callee_type;
        instr.args = arguments;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_new_array(self: HIRBuilder, array_type: TypeArray, size: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_new_array_and_init(array_type, size, (-1)$cast(HIR.ConstId), src_info);
    }
    
    export fn push_new_array_and_init(self: HIRBuilder, array_type: TypeArray, size: HIR.VarId, initial_value: HIR.ConstId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(size)) {
            return self->push_error_var(src_info);
        }
        // TODO check types

        var instr = HIR.NewArray();
        instr.tag = HIR.Tag.NEW_ARRAY;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(array_type, instr);
        instr.type = array_type.value;
        instr.size = size;
        instr.initial_value = initial_value;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_new_slice(self: HIRBuilder, array_id: HIR.VarId, start_id: HIR.VarId, end_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(start_id) || self->is_undef(end_id)) {
            return self->push_error_var(src_info);
        }
        // TODO check types

        var array = self.vars[array_id];
        var array_type = array->get_type_forced()$cast(TypeArray);
        assert(array_type.kind == Type.Kind.Array);
        
        var instr = HIR.NewSlice();
        instr.tag = HIR.Tag.NEW_SLICE;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(array_type, instr);
        instr.mirrored = array_id;
        instr.start = start_id;
        instr.end = end_id;
        self->append_instr(instr);

        return instr.output;
    }

    export fn push_get_array_value(self: HIRBuilder, array_id: HIR.VarId, index_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(index_id)) {
            return self->push_error_var(src_info);
        }
        // TODO check types

        var array = self.vars[array_id];
        var array_type = array->get_type_forced()$cast(TypeArray);
        assert(array_type.kind == Type.Kind.Array);
        var value_type = array_type.value;

        var instr = HIR.GetArrayValue();
        instr.tag = HIR.Tag.GET_ARRAY_VALUE;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(value_type, instr);
        instr.array = array_id;
        instr.index = index_id;
        self->append_instr(instr);

        return instr.output;
    }

    export fn push_set_array_value(self: HIRBuilder, array_id: HIR.VarId, index_id: HIR.VarId, value_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(index_id) || self->is_undef(value_id)) {
            return self->push_error_var(src_info);
        }
        // TODO check types

        var array = self.vars[array_id];
        var array_type = array->get_type_forced()$cast(TypeArray);
        assert(array_type.kind == Type.Kind.Array);
        var value_type = array_type.value;
        
        var value_src_info = self.vars[value_id].src_info;
        value_id = self->cast_to_type_forced(value_id, value_type, value_src_info, false);

        var instr = HIR.SetArrayValue();
        instr.tag = HIR.Tag.SET_ARRAY_VALUE;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(value_type, instr);
        instr.array = array_id;
        instr.index = index_id;
        instr.value = value_id;
        self->append_instr(instr);

        return instr.output;
    }

    export fn is_get_array_value(self: HIRBuilder, value_id: HIR.VarId) => bool {
        var value = self.vars[value_id]$cast(HIR.VarCommon);
        if (value.kind != HIR.Var.Kind.Common) {
            return false;
        }

        var decl = self.decls[value.decl]$cast(HIR.DeclInstrResult);
        if (decl.kind != HIR.Decl.Kind.InstrResult) {
            return false;
        }

        return decl.instr.tag == HIR.Tag.GET_ARRAY_VALUE;
    }

    export fn promote_to_set_array_value(self: HIRBuilder, output_id: HIR.VarId, value_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(value_id)) {
            return self->push_error_var(src_info);
        }

        var output = self.vars[output_id]$cast(HIR.VarCommon);
        assert(output.kind == HIR.Var.Kind.Common);

        var decl = self.decls[output.decl]$cast(HIR.DeclInstrResult);
        assert(decl.kind == HIR.Decl.Kind.InstrResult);

        var old_instr = decl.instr$cast(HIR.GetArrayValue);
        assert(old_instr.tag == HIR.Tag.GET_ARRAY_VALUE);

        var block = self->get_current_block();
        var i = block.size;
        while (i > 0) {
            i -= 1;

            if (block[i] == old_instr$cast(HIR.Instr)) {
                break;
            }
        }

        // i will be (-1)$cast(u64), so u64$max;
        assert(i < block.size);

        var type = output->get_type_forced();
        var value_src_info = self.vars[value_id].src_info;
        value_id = self->cast_to_type_forced(value_id, type, value_src_info, false);

        var instr = HIR.SetArrayValue();
        instr.tag = HIR.Tag.SET_ARRAY_VALUE;
        instr.src_info = old_instr.src_info;
        instr.output = old_instr.output;
        instr.array = old_instr.array;
        instr.index = old_instr.index;
        instr.value = value_id;

        block[i] = instr;
        decl.instr = instr;
        self->on_append(instr);

        return instr.output;
    }

    export fn push_append(self: HIRBuilder, array_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(rhs_id)) {
            return self->push_error_var(src_info);
        }

        var array = self.vars[array_id];
        var array_type = array->get_type_forced()$cast(TypeArray);
        assert(array_type.kind == Type.Kind.Array);

        var instr = HIR.Append();
        instr.src_info = src_info;
        instr.array = array_id;
        instr.appendee = rhs_id;

        var rhs = self.vars[rhs_id];
        var rhs_type = rhs->get_type_forced();

        rhs_id = self->try_cast_to_type(rhs_id, array_type.value, src_info, false);
        if (!self->is_undef(rhs_id)) {
            instr.appendee = rhs_id;
            instr.tag = HIR.Tag.APPEND_VALUE;
        } else if (array_type$cast(Type) == rhs_type) {
            instr.tag = HIR.Tag.APPEND_ARRAY;
        } else {
            self->error(src_info.source_offset, src_info.length, "Can't append '" .. rhs_type->get_name() .. "' to '" .. array_type->get_name() .. "'.");
            return self->push_error_var(src_info);
        }

        self->append_instr(instr);

        return array_id;
    }

    export fn push_concat(self: HIRBuilder, lhs_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(lhs_id) || self->is_undef(rhs_id)) {
            return self->push_error_var(src_info);
        }

        var lhs = self.vars[lhs_id];
        var rhs = self.vars[rhs_id];

        var lhs_type = lhs->get_type_forced();
        var rhs_type = rhs->get_type_forced();

        var common_array_type: TypeArray;
        var size_id: HIR.VarId;

        if (lhs_type.kind == Type.Kind.Array) {
            if (rhs_type.kind == Type.Kind.Array) {
                if (lhs_type != rhs_type) {
                    self->error(src_info.source_offset, src_info.length, "Can't concat '" .. lhs_type->get_name() .. "' and '" .. rhs_type->get_name() .. "'.");
                    return self->push_error_var(src_info);
                }

                common_array_type = lhs_type$cast(TypeArray);
                size_id = self->push_temp_var_of_type(Types.instance.type_u64, src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN, size_id, 
                    self->push_field_access_forced(lhs_id, "size", src_info),
                    src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN_PLUS, size_id, 
                    self->push_field_access_forced(rhs_id, "size", src_info),
                    src_info);
            } else {
                rhs_id = self->cast_to_type_forced(rhs_id, lhs_type$cast(TypeArray).value, src_info, false);
                if (self->is_undef(rhs_id)) {
                    return self->push_error_var(src_info);
                }

                common_array_type = lhs_type$cast(TypeArray);
                size_id = self->push_temp_var_of_type(Types.instance.type_u64, src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN, size_id, 
                    self->push_literal_number(1, src_info),
                    src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN_PLUS, size_id, 
                    self->push_field_access_forced(lhs_id, "size", src_info),
                    src_info);
            }
        } else {
            if (rhs_type.kind == Type.Kind.Array) {
                lhs_id = self->cast_to_type_forced(lhs_id, rhs_type$cast(TypeArray).value, src_info, false);
                if (self->is_undef(lhs_id)) {
                    return self->push_error_var(src_info);
                }

                common_array_type = rhs_type$cast(TypeArray);
                size_id = self->push_temp_var_of_type(Types.instance.type_u64, src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN, size_id, 
                    self->push_literal_number(1, src_info),
                    src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN_PLUS, size_id, 
                    self->push_field_access_forced(rhs_id, "size", src_info),
                    src_info);
            } else {
                var common_type = self->get_common_type(lhs_id, rhs_id);

                lhs_id = self->cast_to_type_forced(lhs_id, common_type, src_info, false);
                rhs_id = self->cast_to_type_forced(rhs_id, common_type, src_info, false);
                if (self->is_undef(lhs_id) || self->is_undef(lhs_id)) {
                    return self->push_error_var(src_info);
                }
                
                common_array_type = Types.instance->get_array_type(common_type);
                size_id = self->push_literal_number_of_type(2, Types.instance.type_u64, src_info);
            }
        }
        
        var array_id = self->push_new_array(common_array_type, size_id, src_info);

        array_id = self->push_append(array_id, lhs_id, src_info);
        array_id = self->push_append(array_id, rhs_id, src_info);

        return array_id;
    }

    fn push_new_string_literal(self: HIRBuilder, string: str, src_info: HIR.SrcInfo) => HIR.VarId {
        var size = string.size;

        var initial_value = (-1)$cast(HIR.ConstId);
        if (string.size > 0) {
            initial_value = self->push_string_const(string);
            size = self.consts_infos[initial_value].literal_size;
        }

        var size_id = self->push_literal_number(size, src_info);

        return self->push_new_array_and_init(Types.instance->get_str_type(), size_id, initial_value, src_info);
    }

    fn push_string_const(self: HIRBuilder, string: str) => HIR.ConstId {
        var const_id = self.consts_infos.size$cast(HIR.ConstId);
        var const_offset = self.consts_literals.size$cast(u32);

        self.consts_literals ..= u8[string.size];

        var escape_characters_count: u32;
        var i: u32;
        while (i < string.size) {
            if (string[i] == '\\') {
                escape_characters_count += 1;
            }

            self.consts_literals[const_offset + i] = string[i]$cast(u8);

            i += 1;
        }

        var const = HIR.Const();
        const.offset = const_offset;
        const.literal_size = string.size$cast(u32);
        const.mem_size = const.literal_size - escape_characters_count;
        const.name = ".L__const.str" .. self.func_index$cast(str) .. "_" .. self.string_literal_counter$cast(str);
        const.is_string = true;
        self.consts_infos ..= const;

        self.string_literal_counter += 1;

        return const_id;
    }

    export fn push_return_value(self: HIRBuilder, var_id: HIR.VarId, src_info: HIR.SrcInfo) {
        var_id = self->cast_to_type_forced(var_id, self.return_type, src_info, false);

        var instr = HIR.ReturnValue();
        instr.tag = HIR.Tag.RETURN_VALUE;
        instr.src_info = src_info;
        instr.value = var_id;
        self->append_instr(instr);
    }

    export fn add_parameter(self: HIRBuilder, parameter: VariableDecl) {
        var bucket = self->find_decl_bucket(parameter.name);

        // if got not null - redefinition
        if (bucket != null) {
            // TODO error
            assert(false);
            return;
        }

        var decl_id = self.decls.size$cast(HIR.DeclId);
        bucket = self->last_name_to_decl()->get_or_insert(parameter.name, decl_id$cast(u64)$cast(raw));
        var decl = HIR.DeclParameter();
        decl.kind = HIR.Decl.Kind.Parameter;
        decl.name = parameter.name;

        decl.type = parameter.type;
        decl.src_info = null; // TODO
        self.decls ..= decl;

        self.parameters_counter += 1;
    }

    export fn push_literal_number_of_type(self: HIRBuilder, value: u64, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        // TODO check if type big enough for a value

        var literal_var_id = self.vars.size$cast(HIR.VarId);
        var literal_var = HIR.VarLiteral();
        self.vars ..= literal_var;

        literal_var.kind = HIR.Var.Kind.Literal;
        literal_var.src_info = src_info;

        literal_var.type = type;
        literal_var.value = value;

        return literal_var_id;
    }

    export fn push_literal_number(self: HIRBuilder, value: u64, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_literal_number_of_type(value, null, src_info);
    }

    fn push_common_var(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo, decl_id: HIR.DeclId) => HIR.VarId {
        var var_id = self.vars.size$cast(HIR.VarId);
        var varr = HIR.VarCommon();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Common;
        varr.src_info = src_info;

        varr.type = type;
        varr.decl = decl_id;

        return var_id;
    }

    fn push_casted_var(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var cast_var_id = self.vars.size$cast(HIR.VarId);
        var cast_var = HIR.VarCast();
        self.vars ..= cast_var;

        cast_var.kind = HIR.Var.Kind.Cast;
        cast_var.src_info = src_info;

        cast_var.type = target_type;
        cast_var.casted = var_id;

        return cast_var_id;
    }

    fn generate_temp_name(self: HIRBuilder) => str {
        var name = "~tmp" .. self.temp_counter$cast(str);
        self.temp_counter += 1;
        return name;
    }

    fn push_instr_result_var(self: HIRBuilder, type: Type, instr: HIR.Instr) => HIR.VarId {var temp_decl_id = self.decls.size$cast(HIR.DeclId);
        var decl_id = self.decls.size$cast(HIR.DeclId);
        var decl = HIR.DeclInstrResult();
        decl.kind = HIR.Decl.Kind.InstrResult;

        decl.name = self->generate_temp_name();
        decl.type = type;
        decl.instr = instr;
        self.decls ..= decl;

        return self->push_common_var(type, instr.src_info, decl_id);
    }

    fn push_class_namespace_access(self: HIRBuilder, type: TypeClass, id: str, src_info: HIR.SrcInfo, forced: bool) => HIR.VarId {
        var var_id = self->get_namespace_var(type.namespace, id, src_info, forced);
        if (self->is_undef(var_id) && forced) {
            self->error(src_info.source_offset, src_info.length, "Undeclared property '" .. id .. "' from class '" .. type.name .. "'.");
        }
        return var_id;
    }

    fn push_field_access_impl(self: HIRBuilder, object_id: HIR.VarId, field_type: Type, field_name: str, field_offset: u16, src_info: HIR.SrcInfo) => HIR.VarId {
        var field_var_id = self.vars.size$cast(HIR.VarId);
        var field_var = HIR.VarField();
        self.vars ..= field_var;

        field_var.kind = HIR.Var.Kind.Field;
        field_var.src_info = src_info;

        field_var.type = field_type;
        field_var.object = object_id;
        field_var.field = field_name;
        field_var.offset = field_offset;

        return field_var_id;
    }

    fn push_arbitrary_global_var(self: HIRBuilder, name: str, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var node = Namespace.Node();
        node.key = name;
        node.name = name;

        var value = Value();
        value->set_type(type);
        node.value = value;
        node.info = Namespace.Info.construct(true, false);

        return self->push_node_var(node, src_info);
    }

    export fn try_push_field_access(self: HIRBuilder, object_id: HIR.VarId, field_name: str, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_field_access(object_id, field_name, src_info, false);
    }

    export fn push_field_access_forced(self: HIRBuilder, object_id: HIR.VarId, field_name: str, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_field_access(object_id, field_name, src_info, true);
    }

    fn push_field_access(self: HIRBuilder, object_id: HIR.VarId, field_name: str, src_info: HIR.SrcInfo, forced: bool) => HIR.VarId {
        var object = self.vars[object_id];
        var object_type = object->get_type_forced();
        assert(object_type != null);

        if (object_type.kind == Type.Kind.Class) {
            var type_class = object_type$cast(TypeClass);

            var field_type = type_class->get_field_type(field_name);
            if (field_type != null) {
                return self->push_field_access_impl(
                    object_id, 
                    field_type, 
                    field_name, 
                    type_class->get_field_offset(field_name)$cast(u16), 
                    src_info);
            }
            
            return self->push_class_namespace_access(type_class, field_name, src_info, forced);
        }

        if (object_type.kind == Type.Kind.Array) {
            var type_array = object_type$cast(TypeArray);

            if (field_name == "size") {
                return self->push_field_access_impl(
                    object_id, 
                    Types.instance.type_u64, 
                    field_name, 
                    (raw$size + u64$size)$cast(u16), 
                    src_info);
            } else if (field_name == "clear") {
                return self->push_arbitrary_global_var(
                    "__ketl_rt.array_clear", 
                    Types.instance->get_function_type(Type[2]{
                        Types.instance.type_void,
                        type_array,
                    }), 
                    src_info);
            } else if (field_name == "pop") {
                return self->push_arbitrary_global_var(
                    "__ketl_rt.array_pop", 
                    Types.instance->get_function_type(Type[2]{
                        Types.instance.type_void,
                        type_array,
                    }), 
                    src_info);
            }
        }

        if (forced) {
            self->error(src_info.source_offset, src_info.length, "Can't access field.");
            return self->push_error_var(src_info);
        } else {
            return (-1)$cast(HIR.VarId);
        }
    }

    export fn push_temp_var_of_type(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var temp_decl_id = self.decls.size$cast(HIR.DeclId);
        var temp_decl = HIR.DeclCommon();
        temp_decl.kind = HIR.Decl.Kind.Common;

        temp_decl.name = self->generate_temp_name();
        self.decls ..= temp_decl;

        return self->push_common_var(type, src_info, temp_decl_id);
    }

    export fn push_temp_var(self: HIRBuilder, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_temp_var_of_type(null, src_info);
    }

    export fn push_error_var(self: HIRBuilder, src_info: HIR.SrcInfo) => HIR.VarId {
        var var_id = self.vars.size$cast(HIR.VarId);
        var varr = HIR.Var();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Error;
        varr.src_info = src_info;

        return var_id;
    }

    fn push_symbol_map(self: HIRBuilder) {
        self.name_to_decl_stack ..= StrHashMap.construct();
    }

    fn pop_symbol_map(self: HIRBuilder) {
        self.name_to_decl_stack->pop();
    }

    fn find_decl_bucket(self: HIRBuilder, name: str) => StrHashMap.Bucket {
        var i = self.name_to_decl_stack.size;
        while (i > 0) {
            i -= 1;
            var name_to_decl = self.name_to_decl_stack[i];
            var bucket = name_to_decl->get_or_null(name);
            if (bucket != null) {
                return bucket;
            }
        }

        return null;
    }

    fn first_name_to_decl(self: HIRBuilder) => StrHashMap {
        return self.name_to_decl_stack[0];
    }

    fn last_name_to_decl(self: HIRBuilder) => StrHashMap {
        return self.name_to_decl_stack[self.name_to_decl_stack.size - 1];
    }

    export fn get_default_initial_value(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        // TODO do default contructor or smth
        return self->push_literal_number(0, src_info);
    }

    fn push_node_var(self: HIRBuilder, namespace_node: Namespace.Node, src_info: HIR.SrcInfo) => HIR.VarId {
        var var_id = self.vars.size$cast(HIR.VarId);
        var varr = HIR.VarGlobal();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Global;
        varr.src_info = src_info;

        varr.node = namespace_node;

        return var_id;
    }

    export fn declare_global_var(self: HIRBuilder, namespace: Namespace, name: str, type: Type, src_info: HIR.SrcInfo, exxport: bool) => HIR.VarId {
        var bucket = self->find_decl_bucket(name);

        // if got not null, we found existing decl
        if (self->find_decl_bucket(name) != null) {
            self->error(src_info.source_offset, src_info.length, "Overriding existing variable.");
            return self->push_error_var(src_info);
        }

        // TODO Namespace.declare_var still can crash
        var namespace_node = namespace->declare_var(name, null, type, exxport);
        if (namespace_node == null) {
            self->error(src_info.source_offset, src_info.length, "Overriding existing variable.");
            return self->push_error_var(src_info);
        }
        
        return self->push_node_var(namespace_node, src_info);
    }

    export fn declare_global_node(self: HIRBuilder, namespace: Namespace, key: str, name: str, type: Type, src_info: HIR.SrcInfo, exxport: bool) => Namespace.Node {
        var bucket = self->find_decl_bucket(key);

        // if got not null, we found existing decl
        if (self->find_decl_bucket(key) != null) {
            return null;
        }

        return namespace->declare_var(key, name, type, exxport);
    }

    export fn push_literal_type(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var var_id = self.vars.size$cast(HIR.VarId);
        var varr = HIR.VarLiteralType();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.LiteralType;
        varr.src_info = src_info;

        varr.value = type;

        return var_id;
    }

    export fn push_sequence(self: HIRBuilder, ids: HIR.VarId[], src_info: HIR.SrcInfo) => HIR.VarId {
        var var_id = self.vars.size$cast(HIR.VarId);
        var varr = HIR.VarSequence();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Sequence;
        varr.src_info = src_info;

        varr.values = ids;

        return var_id;
    }

    export fn declare_local_var(self: HIRBuilder, name: str, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var bucket = self->find_decl_bucket(name);

        // if got not null - redefinition
        if (bucket != null) {
            // TODO error
            assert(false);
            return (-1)$cast(HIR.VarId);
        }

        var decl_id = self.decls.size$cast(HIR.DeclId);
        bucket = self->last_name_to_decl()->get_or_insert(name, decl_id$cast(u64)$cast(raw));
        var decl = HIR.DeclCommon();
        decl.kind = HIR.Decl.Kind.Common;
        decl.name = name;

        decl.type = type;
        decl.src_info = src_info;
        self.decls ..= decl;

        return self->push_common_var(type, src_info, decl_id);
    }

    export fn get_var(self: HIRBuilder, namespace: Namespace, name: str, fullname: str, src_info: HIR.SrcInfo) => HIR.VarId {
        var bucket = self->find_decl_bucket(fullname);
        var decl_id: HIR.DeclId;
        var type: Type;

        // if got not null, we found existing decl
        if (bucket != null) {
            decl_id = bucket.value$cast(u64)$cast(HIR.DeclId);
            var decl = self.decls[decl_id];
            type = decl->get_type();
        } else {
            var symbol_node = namespace->find(name);
            
            if (symbol_node != null) {
                return self->push_node_var(symbol_node, src_info);
            }
            
            decl_id = self.decls.size$cast(HIR.DeclId);

            var decl = HIR.Decl();
            decl.kind = HIR.Decl.Kind.Error;
            decl.name = name;
            self.decls ..= decl;

            bucket = self->last_name_to_decl()->get_or_insert(
                    fullname, decl_id$cast(u64)$cast(raw));
        } 

        return self->push_common_var(type, src_info, decl_id);
    }

    export fn get_namespace_var(self: HIRBuilder, namespace: Namespace, name: str, src_info: HIR.SrcInfo, forced: bool) => HIR.VarId {
        var symbol_node = namespace->find(name);
        
        if (symbol_node == null) {
            if (forced) {
                return self->push_error_var(src_info);
            } else {
                return (-1)$cast(HIR.VarId);
            }
        }

        return self->push_node_var(symbol_node, src_info);
    }

    export fn flush(self: HIRBuilder, hir: HIR) {
        hir.instrs = HIR.Instr[0];
        hir.block_offsets = HIR.InstrOffset[0];

        var offset: HIR.InstrOffset;
        for (var instrs <- self.blocks) {
            hir.instrs ..= instrs;
            hir.block_offsets ..= offset;
            offset += instrs.size$cast(HIR.InstrOffset);
        }

        hir.vars = self.vars;
        hir.decls = self.decls;
        hir.consts_infos = self.consts_infos;
        hir.consts_literals = self.consts_literals;

        hir.return_type = self.return_type;
        hir.parameters_count = self.parameters_counter$cast(u8);
        hir.max_call_arg_count = self.max_call_arg_count;
    }
}