//🫖ketl

from common import StrHashMap
from common import FilePointer
from common import LogAccum

import common

from type_base import Type
from type import Types
from type import TypeFunction
from value import Value

from hir import HIR
from variable import VariableDecl

from namespace import Namespace

class HIRBuilder {
    var log_accum: LogAccum;
    var log_info: LogAccum.LogInfo;

    var blocks : HIR.Instr[][];
    var vars : HIR.Var[];
    var decls : HIR.Decl[];
    var consts_infos : HIR.Const[];
    var consts : u8[];

    var current_block: u32;
    var parameters_counter: u32;
    var temp_counter: u32;

    var name_to_decl_stack: StrHashMap[];

    export fn construct(log_accum: LogAccum, log_info: LogAccum.LogInfo) => HIRBuilder {
        var self = HIRBuilder();

        self.log_accum = log_accum;
        self.log_info = log_info;

        self.blocks = HIR.Instr[][1]{ HIR.Instr[0] };
        self.vars = HIR.Var[0];
        self.decls = HIR.Decl[0];
        self.consts_infos = HIR.Const[0];
        self.consts = u8[0];

        self.name_to_decl_stack = StrHashMap[1]{
            StrHashMap.construct()
        };

        return self;
    }

    fn error(self: HIRBuilder, offset: u32, length: u32, message: str) {
        self.log_accum->error(
            self.log_info,
            FilePointer.construct(offset, offset, length),
            message 
        );
    }
    
    export fn reserve_blocks(self: HIRBuilder, count: u32) => HIR.BlockId {
        var first_block = self.blocks.size$cast(HIR.BlockId);
        while (count > 0) {
            self.blocks ..= HIR.Instr[0];
            count -= 1;
        }
        return first_block;
    }
    export fn set_block(self: HIRBuilder, block: HIR.BlockId) {
        self.current_block = block;
    }

    fn get_current_block(self: HIRBuilder) => HIR.Instr[] {
        return self.blocks[self.current_block];
    }

    fn get_type(self: HIRBuilder, var_id: HIR.VarId) => Type {
        var varr = self.vars[var_id];

        if (varr.kind == HIR.Var.Kind.Common) {
            return varr$cast(HIR.VarWithType).type;
        }

        if (varr.kind == HIR.Var.Kind.Literal) {
            var type = varr$cast(HIR.VarWithType).type;
            if (type != null) {
                return type;
            }
            // TODO check value for range
            return Types.instance.type_i64;
        }

        // TODO
        assert(false);
        return null;
    }

    fn get_common_type(self: HIRBuilder, lhs_id: HIR.VarId, rhs_id: HIR.VarId) => Type {
        var lhs = self.vars[lhs_id];
        var rhs = self.vars[rhs_id];

        if (lhs.kind == HIR.Var.Kind.Literal && rhs.kind == HIR.Var.Kind.Literal) {
            var lhs_type = lhs$cast(HIR.VarWithType).type;
            var rhs_type = rhs$cast(HIR.VarWithType).type;
            if (lhs_type != null && rhs_type != null) {
                return Types.get_common_type(lhs_type, rhs_type);
            }
            // TODO check if other literal can be stored in the selected literal type
            if (lhs_type != null) {
                return self->get_type(lhs_id);
            } else {
                return self->get_type(rhs_id);
            }
        }

        return Types.get_common_type(self->get_type(lhs_id), self->get_type(rhs_id));
    }

    fn cast_to_type(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, implicit: bool) => HIR.VarId {
        if (target_type == null) {
            return var_id;
        }

        var type = self->get_type(var_id);

        if (type == null) {
            return var_id;
        }

        if (Types.is_types_equal(type, target_type)) {
            return var_id;
        }

        assert(false);
        return (-1)$cast(HIR.VarId);
    }

    export fn push_tagonly_instr(self: HIRBuilder, tag: HIR.Tag, src_info: HIR.SrcInfo) {
        var instr = HIR.Instr();
        instr.tag = tag;
        instr.src_info = src_info;
        self->get_current_block() ..= instr;
    }

    export fn push_jump(self: HIRBuilder, target: HIR.BlockId) {
        var instr = HIR.Jump();
        instr.tag = HIR.Tag.JUMP;
        instr.src_info = null; // TODO
        instr.dst = target;
        self->get_current_block() ..= instr;
    }

    export fn push_if(self: HIRBuilder, bool_expr_var: HIR.VarId, true_statement: HIR.BlockId, false_statement: HIR.BlockId) {
        // TODO check casting

        var instr = HIR.JumpIf();
        instr.tag = HIR.Tag.JUMP_IF_TRUE; // TODO pick best
        instr.src_info = null; // TODO
        instr.expr = bool_expr_var;
        instr.true_dst = true_statement;
        instr.false_dst = false_statement;
        self->get_current_block() ..= instr;
    }
    
    export fn push_unary_op(self: HIRBuilder, tag: HIR.Tag, var_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        var type = self->get_type(var_id);
        // TODO deduce
        var arg_type = type;
        var output_type = type;
        if (tag == HIR.Tag.LOGICAL_NOT) {
            output_type = Types.instance.type_bool;
        }

        var_id = self->cast_to_type(var_id, arg_type, false);

        var instr = HIR.UnaryOp();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(output_type, instr);
        instr.arg = var_id;
        self->get_current_block() ..= instr;

        return instr.output;
    }
    
    export fn push_binary_op(self: HIRBuilder, tag: HIR.Tag, lhs: HIR.VarId, rhs: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        var common_type = self->get_common_type(lhs, rhs);
        // TODO deduce
        var arg_type = common_type;
        var output_type = common_type;
        switch (tag) {
            case HIR.Tag.LESS
            case HIR.Tag.LESS_OR_EQUAL
            case HIR.Tag.GREATER
            case HIR.Tag.GREATER_OR_EQUAL
            case HIR.Tag.EQUAL
            case HIR.Tag.NOT_EQUAL
                => output_type = Types.instance.type_bool;
        }

        lhs = self->cast_to_type(lhs, arg_type, false);
        rhs = self->cast_to_type(rhs, arg_type, false);

        var instr = HIR.BinaryOp();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(output_type, instr);
        instr.lhs = lhs;
        instr.rhs = rhs;
        self->get_current_block() ..= instr;

        return instr.output;
    }
    
    export fn push_assign(self: HIRBuilder, tag: HIR.Tag, lhs: HIR.VarId, rhs: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        var type = self->get_type(lhs);
        rhs = self->cast_to_type(rhs, type, false);

        var instr = HIR.Assign();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.dst = lhs;
        instr.src = rhs;
        self->get_current_block() ..= instr;

        // TODO return new var to update src_info
        return instr.dst;
    }

    export fn push_hir_call(self: HIRBuilder, callee_id: HIR.VarId, arguments: HIR.VarId[], src_info: HIR.SrcInfo) => HIR.VarId {
        var type = self->get_type(callee_id);
        if (type == null) {
            return self->push_temp_var(src_info);
        }

        if (type.kind != Type.Kind.Function && type.kind != Type.Kind.CFunction) {
            self->error(src_info.source_offset, src_info.length, "Only functions can be called.");
            return self->push_temp_var(src_info);
        }
        var function_type = type$cast(TypeFunction);
        var function_signature = function_type.signature;

        if (function_signature.parameters.size - 1 != arguments.size) {
            self->error(src_info.source_offset, src_info.length, "Arguments count does not match function parameters count: " .. arguments.size$cast(str) .. " instead of " .. (function_signature.parameters.size - 1)$cast(str) .. ".");
            return self->push_temp_var(src_info);
        }

        var return_type = function_signature.parameters[0];

        // TODO cast every argument to the parameter type and type check
        
        var instr = HIR.Call();
        instr.tag = HIR.Tag.CALL;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(return_type, instr);
        instr.callee = callee_id;
        instr.args = arguments;
        self->get_current_block() ..= instr;

        return instr.output;
    }

    export fn push_return_value(self: HIRBuilder, var_id: HIR.VarId, src_info: HIR.SrcInfo) {
        // TODO casting

        var instr = HIR.ReturnValue();
        instr.tag = HIR.Tag.RETURN_VALUE;
        instr.src_info = src_info;
        instr.value = var_id;
        self->get_current_block() ..= instr;
    }

    export fn add_parameter(self: HIRBuilder, parameter: VariableDecl) {
        var bucket = self->find_decl_bucket(parameter.name);

        // if got not null - redefinition
        if (bucket != null) {
            // TODO error
            assert(false);
            return;
        }

        var decl_id = self.decls.size$cast(HIR.DeclId);
        bucket = self->first_name_to_decl()->get_or_insert(parameter.name, decl_id$cast(u64)$cast(raw));
        var decl = HIR.DeclParameter();
        decl.kind = HIR.Decl.Kind.Parameter;
        decl.name = parameter.name;

        decl.type = parameter.type;
        decl.src_info = null; // TODO
        self.decls ..= decl;

        self.parameters_counter += 1;
    }

    fn push_global_decl(self: HIRBuilder, namespace_node: Namespace.Node) => HIR.DeclId {
        var decl_id = self.decls.size$cast(HIR.DeclId);

        var decl = HIR.DeclGlobal();
        decl.kind = HIR.Decl.Kind.Global;
        decl.name = namespace_node.name;
        decl.node = namespace_node;
        self.decls ..= decl;

        return decl_id;
    }

    export fn push_literal_number(self: HIRBuilder, value: u64, src_info: HIR.SrcInfo) => HIR.VarId {
        var literal_var_id = self.vars.size$cast(HIR.VarId);

        var literal_var = HIR.VarLiteral();
        literal_var.kind = HIR.Var.Kind.Literal;
        literal_var.type = null;
        literal_var.src_info = src_info;
        literal_var.value = value;
        self.vars ..= literal_var;

        return literal_var_id;
    }

    fn push_common_var(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo, decl_id: HIR.DeclId) => HIR.VarId {
        var var_id = self.vars.size$cast(HIR.VarId);
        var varr = HIR.VarCommon();
        varr.kind = HIR.Var.Kind.Common;

        varr.type = type;
        varr.src_info = src_info;
        varr.decl = decl_id;
        self.vars ..= varr;

        return var_id;
    }

    fn generate_temp_name(self: HIRBuilder) => str {
        var name = "~tmp" .. self.temp_counter$cast(str);
        self.temp_counter += 1;
        return name;
    }

    fn push_instr_result_var(self: HIRBuilder, type: Type, instr: HIR.Instr) => HIR.VarId {var temp_decl_id = self.decls.size$cast(HIR.DeclId);
        var decl_id = self.decls.size$cast(HIR.DeclId);
        var decl = HIR.DeclInstrResult();
        decl.kind = HIR.Decl.Kind.InstrResult;

        decl.name = self->generate_temp_name();
        decl.type = type;
        decl.instr = instr;
        self.decls ..= decl;

        return self->push_common_var(type, instr.src_info, decl_id);
    }

    export fn push_temp_var_of_type(self: HIRBuilder, src_info: HIR.SrcInfo, type: Type) => HIR.VarId {
        var temp_decl_id = self.decls.size$cast(HIR.DeclId);
        var temp_decl = HIR.DeclCommon();
        temp_decl.kind = HIR.Decl.Kind.Common;

        temp_decl.name = self->generate_temp_name();
        self.decls ..= temp_decl;

        return self->push_common_var(type, src_info, temp_decl_id);
    }

    // TODO replace usage for errors with common var of decl? create var of error?
    export fn push_temp_var(self: HIRBuilder, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_temp_var_of_type(src_info, null);
    }

    fn find_decl_bucket(self: HIRBuilder, name: str) => StrHashMap.Bucket {
        var i = self.name_to_decl_stack.size;
        while (i > 0) {
            i -= 1;
            var name_to_decl = self.name_to_decl_stack[i];
            var bucket = name_to_decl->get_or_null(name);
            if (bucket != null) {
                return bucket;
            }
        }

        return null;
    }

    fn first_name_to_decl(self: HIRBuilder) => StrHashMap {
        return self.name_to_decl_stack[0];
    }

    fn last_name_to_decl(self: HIRBuilder) => StrHashMap {
        return self.name_to_decl_stack[self.name_to_decl_stack.size - 1];
    }

    export fn get_default_initial_value(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        // TODO do default contructor or smth
        return self->push_literal_number(0, src_info);
    }

    // returns null if name is occupied
    fn declare_global(self: HIRBuilder, namespace: Namespace, key: str, name: str, type: Type, exxport: bool) => StrHashMap.Bucket {
        var bucket = self->find_decl_bucket(key);

        // if got not null, we found existing decl
        if (bucket != null) {
            return null;
        }

        // TODO Namespace.declare_var still can crash
        var namespace_node = namespace->declare_var(key, name, type, exxport);
        if (namespace_node == null) {
            return null;
        }
        
        var decl_id = self->push_global_decl(namespace_node);
        bucket = self->first_name_to_decl()->get_or_insert(key, decl_id$cast(u64)$cast(raw));

        return bucket;
    }

    fn get_node_from_decl(self: HIRBuilder, decl_id: HIR.DeclId) => Namespace.Node {
        var decl = self.decls[decl_id];
        if (decl.kind != HIR.Decl.Kind.Global) {
            return null;
        }

        return decl$cast(HIR.DeclGlobal).node;
    }

    export fn declare_global_var(self: HIRBuilder, namespace: Namespace, name: str, type: Type, src_info: HIR.SrcInfo, exxport: bool) => HIR.VarId {
        var bucket = self->declare_global(namespace, name, null, type, exxport);

        if (bucket == null) {
            self->error(src_info.source_offset, src_info.length, "Overriding existing variable.");
            return self->push_temp_var(src_info);
        }

        var decl_id = bucket.value$cast(u64)$cast(HIR.DeclId);
        return self->push_common_var(type, src_info, decl_id);
    }

    export fn declare_global_node(self: HIRBuilder, namespace: Namespace, key: str, name: str, type: Type, src_info: HIR.SrcInfo, exxport: bool) => Namespace.Node {
        var bucket = self->declare_global(namespace, key, name, type, exxport);

        if (bucket == null) {
            self->error(src_info.source_offset, src_info.length, "Overriding existing variable.");
            return null;
        }

        var decl_id = bucket.value$cast(u64)$cast(HIR.DeclId);
        return self->get_node_from_decl(decl_id);
    }

    export fn push_builtin_type(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var var_id = self.vars.size$cast(HIR.VarId);
        var varr = HIR.VarBuiltinType();
        varr.kind = HIR.Var.Kind.BuiltinType;

        varr.src_info = src_info;
        varr.value = type;
        self.vars ..= varr;

        return var_id;
    }

    export fn declare_local_var(self: HIRBuilder, name: str, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var bucket = self->find_decl_bucket(name);

        // if got not null - redefinition
        if (bucket != null) {
            // TODO error
            assert(false);
            return (-1)$cast(HIR.VarId);
        }

        var decl_id = self.decls.size$cast(HIR.DeclId);
        bucket = self->first_name_to_decl()->get_or_insert(name, decl_id$cast(u64)$cast(raw));
        var decl = HIR.DeclCommon();
        decl.kind = HIR.Decl.Kind.Common;
        decl.name = name;

        decl.type = type;
        decl.src_info = src_info;
        self.decls ..= decl;

        return self->push_common_var(type, src_info, decl_id);
    }

    export fn get_var(self: HIRBuilder, namespace: Namespace, name: str, fullname: str, src_info: HIR.SrcInfo) => HIR.VarId {
        var bucket = self->find_decl_bucket(fullname);
        var decl_id: HIR.DeclId;
        var type: Type;

        // if got not null, we found existing decl
        if (bucket != null) {
            decl_id = bucket.value$cast(u64)$cast(HIR.DeclId);
            var decl = self.decls[decl_id];
            type = decl->get_type();
        } else {
            var symbol_node = namespace->find(name);
            
            if (symbol_node != null) {
                decl_id = self->push_global_decl(symbol_node);

                type = symbol_node.value.type;
            } else {
                decl_id = self.decls.size$cast(HIR.DeclId);

                var decl = HIR.Decl();
                decl.kind = HIR.Decl.Kind.Error;
                decl.name = name;
                self.decls ..= decl;
            }

            bucket = self->last_name_to_decl()->get_or_insert(
                    fullname, decl_id$cast(u64)$cast(raw));
        } 

        return self->push_common_var(type, src_info, decl_id);
    }

    export fn flush(self: HIRBuilder, hir: HIR) {
        hir.instrs = HIR.Instr[0];
        hir.block_offsets = HIR.InstrOffset[0];

        var offset: HIR.InstrOffset;
        for (var instrs <- self.blocks) {
            hir.instrs ..= instrs;
            hir.block_offsets ..= offset;
            offset += instrs.size$cast(HIR.InstrOffset);
        }

        hir.vars = self.vars;
        hir.decls = self.decls;
        hir.consts_infos = self.consts_infos;
        hir.consts = self.consts;

        hir.return_type = Types.instance.type_i64; // TODO
        hir.parameters_count = self.parameters_counter$cast(u8);
        hir.max_call_arg_count = 0; // TODO
    }
}