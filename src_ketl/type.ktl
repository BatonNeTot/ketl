//🫖ketl

export class Type {
    export enum Kind : u8{
        Primitive,
        Enum,
        Function,
        CFunction,
        Array,
        CArray,
        Class,
    }

    export enum Align : u8 {
        Byte,
        Bytes2,
        Bytes4,
        Bytes8,
        Bytes16,
    }

    export fn find_align(align: u8) => Align {
        switch (align) {
            case 2 =>  return Align.Bytes2;
            case 4 =>  return Align.Bytes4;
            case 8 =>  return Align.Bytes8;
            case 16 => return Align.Bytes16;
        }
        return Align.Byte;
    }
 
    var kind : Kind;
    var align : Align;
    var size : u16;

    export fn is_pointer_kind(type: Type) => bool {
        if (type == null) {
            return false;
        }

        if (type.kind == Kind.Primitive || type.kind == Kind.Enum) {
            return false;
        } else {
            return true;
        }
    }

    export fn is_void(type: Type) => bool {
        return type != null && type.size == 0 && type.kind == Kind.Primitive;
    }

    export fn get_stack_size(type : Type) => u64 {
        if (type == null) {
            return 0;
        }

        if (type->is_pointer_kind()) {
            return raw$size;
        } else {
            return type.size;
        }
    }

    export fn is_signed(type: Type) => bool {
        if (type.kind == Type.Kind.Enum) {
            type = type$cast(TypeEnum).parent;
        }

        return type.kind == Type.Kind.Primitive && type$cast(TypePrimitive).is_signed;
    }

    export fn get_name(type: Type) => str {
        if (type.kind == Type.Kind.Primitive) {
            return type$cast(TypePrimitive).name;
        }

        assert(false);
        return null;
    }
}

export class Value {
    export enum Kind: u8 {
        None,
        Type,
        Namespace,
        Pointer,
        Func,
        CFunc,
        Bool,
        Int,
        UInt,
    }
    
    var value: u64;
    var type: Type;
    var kind: Kind;

    export fn set_type(self: Value, type: Type) {
        self.type = type;
        if (type.kind == Type.Kind.Primitive) {
            if (type == Types.instance.type_bool$cast(Type)) {
                self.kind = Kind.Bool;
                return;
            }

            var primitive_type = type$cast(TypePrimitive);
            if (primitive_type.is_signed) {
                self.kind = Kind.Int;
            } else {
                self.kind = Kind.UInt;
            }
            return;
        }

        assert(false);
    }
}

export class TypePrimitive {
    extend Type;
    var name: str;
    var is_integer: bool;
    var is_signed: bool;
    var is_numeric: bool;

    fn construct(size: u8, name: str, is_integer: bool, is_signed: bool, is_numeric: bool) => TypePrimitive {
        var self = TypePrimitive();

        self.kind = Kind.Primitive;
        self.align = find_align(size);
        self.size = size;
        self.name = name;
        self.is_integer = is_integer;
        self.is_signed = is_signed;
        self.is_numeric = is_numeric;

        return self;
    }
}

export class TypeEnum {

    export class Pair {
        var name: str;
        var value: Value;
    }

    extend Type;
    var name: str;
    var parent: TypePrimitive;
    var constants: Pair[];
}

export class TypeArray {

    export class Header {
        var data : raw;
        var capacity : u64;
        var size : u64;
        var is_slice : bool;
    }

    extend Type;
    var value : Type;
}

class Types {

    var type_void: TypePrimitive;
    var type_bool: TypePrimitive;
    var type_char: TypePrimitive;
    var type_raw: TypePrimitive;

    var type_i8: TypePrimitive;
    var type_i16: TypePrimitive;
    var type_i32: TypePrimitive;
    var type_i64: TypePrimitive;
    
    var type_u8: TypePrimitive;
    var type_u16: TypePrimitive;
    var type_u32: TypePrimitive;
    var type_u64: TypePrimitive;

    fn construct() => Types {
        var self = Types();

        // temporaly called "none"
        self.type_void = TypePrimitive.construct(0, "none", false, false, false);
        self.type_bool = TypePrimitive.construct(1, "bool", false, false, false);
        self.type_char = TypePrimitive.construct(1, "char", true,  false, false);
        self.type_raw  = TypePrimitive.construct(8, "raw",  false, false, false);

        self.type_i8   = TypePrimitive.construct(1, "i8",   true,  true,  true);
        self.type_i16  = TypePrimitive.construct(2, "i16",  true,  true,  true);
        self.type_i32  = TypePrimitive.construct(4, "i32",  true,  true,  true);
        self.type_i64  = TypePrimitive.construct(8, "i64",  true,  true,  true);
        
        self.type_u8   = TypePrimitive.construct(1, "u8",   true,  false, true);
        self.type_u16  = TypePrimitive.construct(2, "u16",  true,  false, true);
        self.type_u32  = TypePrimitive.construct(4, "u32",  true,  false, true);
        self.type_u64  = TypePrimitive.construct(8, "u64",  true,  false, true);

        return self;
    }

    export shared instance = Types.construct(); 

    export fn get_common_type(lhs: Type, rhs: Type) => Type {
        if (is_types_equal(lhs, rhs)) {
            return lhs;
        }

        assert(false);
        return null;
    }

    export fn is_types_equal(lhs: Type, rhs: Type) => bool {
        return lhs == rhs;
    }
}
