//🫖ketl

from common import Value

export class Type {
    export enum Kind : u8{
        Primitive,
        Enum,
        Function,
        CFunction,
        Array,
        CArray,
        Class,
    }

    export enum Align : u8 {
        Size1Byte,
        Size2Byte,
        Size4Byte,
        Size8Byte,
        Size16Byte,
    }

    var kind : Kind;
    var align : Align;
    var size : u16;

    export fn is_pointer_kind(type: Type) => bool {
        if (type.kind == Kind.Primitive || type.kind == Kind.Enum) {
            return false;
        } else {
            return true;
        }
    }

    export fn get_stack_size(type : Type) => u64 {
        if (type == null) {
            return 0;
        }

        if (type->is_pointer_kind()) {
            return raw$size;
        } else {
            return type.size;
        }
    }


}

export class TypePrimitive {
    extend Type;
    var name: str;
    var is_integer: bool;
    var is_signed: bool;
    var is_numeric: bool;
}

export class TypeEnum {

    export class Pair {
        var name: str;
        var value: Value;
    }

    extend Type;
    var name: str;
    var parent: TypePrimitive;
    var constants: Pair[];
}

export class TypeArray {

    export class Header {
        var data : raw;
        var capacity : u64;
        var size : u64;
        var is_slice : bool;
    }

    extend Type;
    var value : Type;
}
