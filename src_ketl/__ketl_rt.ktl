
class Type {
    export enum Kind : u8{
        Primitive,
        Enum,
        Function,
        CFunction,
        Class,
        Array,
    }

    export enum Align : u8 {
        Size1Byte,
        Size2Byte,
        Size4Byte,
        Size8Byte,
        Size16Byte,
    }

    var kind : Kind;
    var align : Align;
    var size : u16;

    fn get_stack_size(type : Type) -> u64 {
        if (type == null) {
            return 0;
        }

        // TODO fix the namespace to make 'Type.' implicit
        if (type.kind == Type.Kind.Primitive || type.kind == Type.Kind.Enum) {
            return type.size;
        } else {
            return raw$size;
        }
    }
}

class TypeArray {
    // TODO get directly from the Type class
    var kind : Type.Kind;
    var align : Type.Align;
    var size : u16;
    var value : Type;
}

class ArrayHeader {
    var data : raw;
    var size : u64;
    var capacity : u64;
}

/////////////////////////////////////////////

class AtomicStrings {}

cimport malloc(size : u64) -> raw
cimport realloc(pointer : raw, size : u64) -> raw
cimport memset(dest : raw, value : u8, size : u64) -> raw
cimport memcpy(dest : raw, src : raw, size : u64) -> raw

export fn calloc(size : u64) -> raw {
    var pointer = malloc(size);
    memset(pointer, 0, size);
    return pointer;
}

export fn recalloc(old_pointer : raw, old_size : u64, new_size : u64) -> raw {
    var pointer = realloc(old_pointer, new_size);
    memset(pointer + old_size, 0, new_size - old_size);
    return pointer;
}

class GC {

    class U8Wrapper {
        var value : u8;
    }
    class U16Wrapper {
        var value : u16;
    }
    class U32Wrapper {
        var value : u32;
    }
    class U64Wrapper {
        var value : u64;
    }

    export fn new(gc : GC, type : Type, flags : u64) -> raw {
        return calloc(type.size);
    }

    export fn new_array(gc : GC, type : Type, count : u64, flags : u64) -> raw {
        var array_header = ArrayHeader();
        var type_size = Type.get_stack_size(type);
        if (type.kind != Type.Kind.Primitive && type.kind != Type.Kind.Enum) {
            type_size = raw$size;
        }
        array_header.data = calloc(type_size * count);
        array_header.size = count;
        array_header.capacity = count;
        return array_header;
    }

    export fn append_value(gc : GC, type : Type, array_header : ArrayHeader, value : u64) {
        var value_size = Type.get_stack_size(type);
        if (array_header.capacity == 0) {
            // TODO assert(array_header.data == NULL);
            array_header.capacity = 4;
            array_header.data = calloc(value_size * array_header.capacity);
        } else if (array_header.size >= array_header.capacity) {
            // TODO assert(array_header.data != NULL);
            var old_capacity = array_header.capacity;
            // TODO replace with assign_plus
            array_header.capacity = array_header.capacity + array_header.capacity / 2;
            array_header.data = recalloc(array_header.data, value_size * old_capacity, value_size * array_header.capacity);
        }
        // TODO replace with switch
        if (value_size == 1) {
            // TODO fix the namespace to make 'GC.' implicit
            (array_header.data + array_header.size * value_size)$cast(GC.U8Wrapper).value = value$cast(u8);
        } else if (value_size == 2) {
            // TODO fix the namespace to make 'GC.' implicit
            (array_header.data + array_header.size * value_size)$cast(GC.U16Wrapper).value = value$cast(u16);
        } else if (value_size == 4) {
            // TODO fix the namespace to make 'GC.' implicit
            (array_header.data + array_header.size * value_size)$cast(GC.U32Wrapper).value = value$cast(u32);
        } else if (value_size == 8) {
            // TODO fix the namespace to make 'GC.' implicit
            (array_header.data + array_header.size * value_size)$cast(GC.U64Wrapper).value = value$cast(u64);
        }
        // TODO replace with increment
        array_header.size = array_header.size + 1;
    }

}

var gc : GC = calloc(GC$size);

var atomic_strings : AtomicStrings = calloc(AtomicStrings$size);

export fn new(type : Type) -> raw {
    return GC.new(gc, type, 0);
}

export fn new_array(type : Type, count : u64) -> raw {
    return GC.new_array(gc, type, count, 0);
}

export fn append_value(gc : GC, type : Type, array_header : ArrayHeader, value : raw) {
    GC.append_value(gc, type, array_header, value);
}
