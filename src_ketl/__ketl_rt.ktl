    // TODO
}

class GC {

    export class U8Wrapper {
        var value : u8;
    }
    export class U16Wrapper {
        var value : u16;
    }
    export class U32Wrapper {
        var value : u32;
    }
    export class U64Wrapper {
        var value : u64;
    }

    export fn new(gc : GC, type : Type, flags : u64) -> raw {
        return calloc(type.size);
    }

    export fn new_array(gc : GC, stack_size : u64, size : u64, initial_data : raw, initial_data_mem_size : u64, flags : u64) -> raw {
        var array_header = ArrayHeader();
        var type_size = stack_size;
        var mem_size = type_size * size;
        array_header.data = calloc(mem_size);
        array_header.capacity = size;
        array_header.size = size;
        array_header.is_slice = false;
        assert(initial_data == null || initial_data_mem_size <= mem_size);
        if (initial_data != null) {
            memcpy(array_header.data, initial_data, initial_data_mem_size);
        }
        return array_header;
    }

    export fn new_slice(gc : GC, mirrored_array : ArrayHeader, start : u64, end : u64, flags : u64) -> raw {
        var array_header = ArrayHeader();
        var mirrored_offset = start;
        var size = end - start;
        while (mirrored_array != null && mirrored_array.is_slice) {
            mirrored_offset += mirrored_array.capacity; // capacity is mirrored_offset when is_slice == true
            mirrored_array = mirrored_array.data; // data is mirrored_array when is_slice == true
        }
        array_header.data = mirrored_array;
        array_header.capacity = mirrored_offset;
        array_header.size = size;
        array_header.is_slice = true;
        assert(mirrored_array == null || mirrored_array.size >= mirrored_offset + size);
        return array_header;
    }

    export fn append_value(gc : GC, stack_size : u64, array_header : ArrayHeader, value : u64) {
        var value_size = stack_size;
        if (array_header.is_slice) {
            var capacity = array_header.size + 1; // plus appended one
            var data = calloc(value_size * capacity);
            // capacity is mirrored_offset when is_slice == true
            // data is mirrored_array when is_slice == true
            memcpy(data, array_header.data$cast(ArrayHeader).data + array_header.capacity * value_size, array_header.size * value_size);
            array_header.data = data;
            array_header.capacity = capacity;
            array_header.is_slice = false;
        } else if (array_header.capacity == 0) {
            assert(array_header.data == null);
            array_header.capacity = 4;
            array_header.data = calloc(value_size * array_header.capacity);
        } else if (array_header.size >= array_header.capacity) {
            assert(array_header.data != null);
            var old_capacity = array_header.capacity;
            array_header.capacity += array_header.capacity / 2;
            array_header.data = array_header.data@recalloc(value_size * old_capacity, value_size * array_header.capacity);
        }
        // TODO replace with switch; after replace with template/generic 
        if (value_size == 1) {
            (array_header.data + array_header.size * value_size)$cast(U8Wrapper).value = value$cast(u8);
        } else if (value_size == 2) {
            (array_header.data + array_header.size * value_size)$cast(U16Wrapper).value = value$cast(u16);
        } else if (value_size == 4) {
            (array_header.data + array_header.size * value_size)$cast(U32Wrapper).value = value$cast(u32);
        } else if (value_size == 8) {
            (array_header.data + array_header.size * value_size)$cast(U64Wrapper).value = value$cast(u64);
        }
        // TODO replace with increment
        array_header.size += 1;
    }

}

var gc : GC = calloc(GC$size);

var atomic_strings : AtomicStrings = calloc(AtomicStrings$size);

export fn new(type : Type) -> raw {
    return gc@new(type, 0);
}

export fn new_array(stack_size : u64, size : u64, initial_data : raw, initial_data_mem_size : u64) -> raw {
    return gc@new_array(stack_size, size, initial_data, initial_data_mem_size, 0);
}

export fn new_slice(mirrored_array : ArrayHeader, start : u64, end : u64) -> raw {
    return gc@new_slice(mirrored_array, start, end, 0);
}

export fn append_value(stack_size : u64, array_header : ArrayHeader, value : raw) {
    gc@append_value(stack_size, array_header, value);
}

export fn array_clear(array_header : ArrayHeader) {
    if (array_header.is_slice) {
        array_header.data = null;
        array_header.capacity = 0;
        array_header.size = 0;
        array_header.is_slice = false;
    } else {
        array_header.size = 0;
    }
}
 export fn array_get_value(stack_size : u64, array_header : ArrayHeader, index : u64) -> u64 {
    if (array_header.is_slice) {
        return (array_header.data$cast(ArrayHeader).data + stack_size * (array_header.capacity + index))$cast(GC.U64Wrapper).value;
    } else {
        return (array_header.data + stack_size * index)$cast(GC.U64Wrapper).value;
    }
 }
