
class Type {
    export enum Kind : u8{
        Primitive,
        Enum,
        Function,
        CFunction,
        Array,
        Class,
    }

    export enum Align : u8 {
        Size1Byte,
        Size2Byte,
        Size4Byte,
        Size8Byte,
        Size16Byte,
    }

    var kind : Kind;
    var align : Align;
    var size : u16;

    fn get_stack_size(type : Type) -> u64 {
        if (type == null) {
            return 0;
        }

        if (type.kind == Kind.Primitive || type.kind == Kind.Enum) {
            return type.size;
        } else {
            return raw$size;
        }
    }
}

class TypeArray {
    // TODO get directly from the Type class through 'unpack'
    var kind : Type.Kind;
    var align : Type.Align;
    var size : u16;
    var value : Type;
}

export class ArrayHeader {
    var data : raw;
    var capacity : u64;
    var size : u64;
    var is_slice : bool;
}

/////////////////////////////////////////////

class AtomicStrings {}

cimport malloc(size : u64) -> raw
cimport realloc(pointer : raw, size : u64) -> raw
cimport memset(dest : raw, value : u8, size : u64) -> raw
cimport memcpy(dest : raw, src : raw, size : u64) -> raw

export fn calloc(size : u64) -> raw {
    if (size == 0) {
        return null;
    }
    var pointer = malloc(size);
    memset(pointer, 0, size);
    return pointer;
}

export fn recalloc(old_pointer : raw, old_size : u64, new_size : u64) -> raw {
    var pointer = old_pointer@realloc(new_size);
    memset(pointer + old_size, 0, new_size - old_size);
    return pointer;
}

