class AtomicStrings {}

cimport malloc(size : u64) => raw
cimport realloc(pointer : raw, size : u64) => raw
cimport memset(dest : raw, value : u8, size : u64) => raw
cimport memcpy(dest : raw, src : raw, size : u64) => raw
cimport _assert(expr_str: cstr, filename: cstr, line: u64)

export fn calloc(size : u64) => raw {
    if (size == 0) {
        return null;
    }
    var pointer = malloc(size);
    memset(pointer, 0, size);
    return pointer;
}

export fn recalloc(old_pointer : raw, old_size : u64, new_size : u64) => raw {
    var pointer = old_pointer->realloc(new_size);
    memset(pointer + old_size, 0, new_size - old_size);
    return pointer;
}

export fn assert(expr : bool) {
    if (!expr) {
        (null)$cast(TypeArray.Header).data = null; // to fall with better message
        _assert(null, null, 0);
    }
}

class GC {

    export class U8Wrapper {
        var value : u8;
    }
    export class U16Wrapper {
        var value : u16;
    }
    export class U32Wrapper {
        var value : u32;
    }
    export class U64Wrapper {
        var value : u64;
    }

    export fn new(gc : GC, type : Type, flags : u64) => raw {
        return calloc(type.size);
    }

    export fn new_array(gc : GC, stack_size : u64, size : u64, initial_data : raw, initial_data_mem_size : u64, flags : u64) => raw {
        var array_header = TypeArray.Header();
        var type_size = stack_size;
        var mem_size = type_size * size;
        array_header.data = calloc(mem_size);
        array_header.capacity = size;
        array_header.size = size;
        array_header.is_slice = false;
        assert(initial_data == null || initial_data_mem_size <= mem_size);
        if (initial_data != null && initial_data_mem_size > 0) {
            memcpy(array_header.data, initial_data, initial_data_mem_size);
        }
        return array_header;
    }

    export fn new_slice(gc : GC, mirrored_array : TypeArray.Header, start : u64, end : u64, flags : u64) => raw {
        var array_header = TypeArray.Header();
        var mirrored_offset = start;
        if (start > end) {
            end = start;
        }
        var size = end - start;
        while (mirrored_array != null && mirrored_array.is_slice) {
            mirrored_offset += mirrored_array.capacity; // capacity is mirrored_offset when is_slice == true
            mirrored_array = mirrored_array.data; // data is mirrored_array when is_slice == true
        }
        array_header.data = mirrored_array;
        array_header.capacity = mirrored_offset;
        array_header.size = size;
        array_header.is_slice = true;
        assert(mirrored_array == null || mirrored_array.size >= mirrored_offset + size);
        return array_header;
    }

    export fn append_value(gc : GC, stack_size : u64, array_header : TypeArray.Header, value : u64) {
        var value_size = stack_size;
        if (array_header.is_slice) {
            var capacity = array_header.size + 1; // plus appended one
            var data = calloc(value_size * capacity);
            // capacity is mirrored_offset when is_slice == true
            // data is mirrored_array when is_slice == true
            memcpy(data, array_header.data$cast(TypeArray.Header).data + array_header.capacity * value_size, array_header.size * value_size);
            array_header.data = data;
            array_header.capacity = capacity;
            array_header.is_slice = false;
        } else if (array_header.capacity == 0) {
            assert(array_header.data == null);
            array_header.capacity = 4;
            array_header.data = calloc(value_size * array_header.capacity);
        } else if (array_header.size >= array_header.capacity) {
            assert(array_header.data != null);
            var old_capacity = array_header.capacity;
            array_header.capacity += (array_header.capacity + 1) / 2;
            array_header.data = array_header.data->recalloc(value_size * old_capacity, value_size * array_header.capacity);
        }
        // TODO replace with template/generic 
        switch (value_size) {
            case 1 => (array_header.data + array_header.size * value_size)$cast(U8Wrapper).value = value$cast(u8);
            case 2 => (array_header.data + array_header.size * value_size)$cast(U16Wrapper).value = value$cast(u16);
            case 4 => (array_header.data + array_header.size * value_size)$cast(U32Wrapper).value = value$cast(u32);
            case 8 => (array_header.data + array_header.size * value_size)$cast(U64Wrapper).value = value$cast(u64);
        }
        // TODO replace with increment
        array_header.size += 1;
    }

    export fn append_array(gc : GC, stack_size : u64, array_header : TypeArray.Header, other_array_header : TypeArray.Header) {
        var value_size = stack_size;
        if (array_header.is_slice) {
            var capacity = array_header.size + other_array_header.size;
            var data = calloc(value_size * capacity);
            // capacity is mirrored_offset when is_slice == true
            // data is mirrored_array when is_slice == true
            memcpy(data, array_header.data$cast(TypeArray.Header).data + value_size * array_header.capacity, value_size * array_header.size);
            array_header.data = data;
            array_header.capacity = capacity;
            array_header.is_slice = false;
        } else if (array_header.capacity == 0) {
            assert(array_header.data == null);
            array_header.capacity = other_array_header.size;
            array_header.data = calloc(value_size * array_header.capacity);
        } else if (array_header.size + other_array_header.size > array_header.capacity) {
            assert(array_header.data != null);
            var old_capacity = array_header.capacity;
            array_header.capacity = array_header.size + other_array_header.size;
            array_header.data = array_header.data->recalloc(value_size * old_capacity, value_size * array_header.capacity);
        }
        var offset: u64 = 0;
        var array_2cpy = other_array_header;
        while (array_2cpy.is_slice) {
            offset += array_2cpy.capacity; // capacity is mirrored_offset when is_slice == true
            array_2cpy = array_2cpy.data; // data is mirrored_array when is_slice == true
        }
        memcpy(array_header.data + array_header.size * value_size, array_2cpy.data + offset, value_size * other_array_header.size);
        array_header.size += other_array_header.size;
    }

}

var gc : GC = calloc(GC$size);

var atomic_strings : AtomicStrings = calloc(AtomicStrings$size);

export fn new(type : Type) => raw {
    return gc->new(type, 0);
}

export fn new_array(stack_size : u64, size : u64, initial_data : raw, initial_data_mem_size : u64) => raw {
    return gc->new_array(stack_size, size, initial_data, initial_data_mem_size, 0);
}

export fn new_slice(mirrored_array : TypeArray.Header, start : u64, end : u64) => raw {
    return gc->new_slice(mirrored_array, start, end, 0);
}

export fn append_value(stack_size : u64, array_header : TypeArray.Header, value : raw) {
    gc->append_value(stack_size, array_header, value);
}

export fn append_array(stack_size : u64, array_header : TypeArray.Header, other_array_header : TypeArray.Header) {
    gc->append_array(stack_size, array_header, other_array_header);
}

export fn array_clear(array_header : TypeArray.Header) {
    if (array_header.is_slice) {
        array_header.data = null;
        array_header.capacity = 0;
        array_header.size = 0;
        array_header.is_slice = false;
    } else {
        array_header.size = 0;
    }
}
export fn array_pop(array_header : TypeArray.Header) {
    assert(array_header.size > 0);
    array_header.size -= 1;
}
export fn str2cstr(string: TypeArray.Header) => cstr {
    if (string == null) {
        return null;
    }

    var cstring = malloc(string.size + 1);
    memcpy(cstring, string.data, string.size);
    (cstring + string.size)$cast(GC.U8Wrapper).value = '\0';
    return cstring;
}
export fn int2str(value: i64) => str {
    if (value == 0) {
        return "0";
    }

    var buffer = "";

    if (value < 0) {
        value = -value; 

        while (value > 0) {
            var number = value % 10;
            value /= 10;

            buffer = '0' + number$cast(char) .. buffer;
        }

        return "-" .. buffer;
    } else {
        while (value > 0) {
            var number = value % 10;
            value /= 10;

            buffer = '0' + number$cast(char) .. buffer;
        }

        return buffer;
    }
}
export fn str2uint(string: str) => u64 {
    var value: u64;

    var index: u64;
    while (index < string.size) {
        var num = string[index];
        if (num < '0' || num > '9') {
            break;
        }

        value *= 10;
        value += num - '0';
        index += 1;
    }

    return value;
}

export fn array_get_value(stack_size : u64, array_header : TypeArray.Header, index : u64) => u64 {
    var pointer: raw;
    if (array_header.is_slice) {
        pointer = (array_header.data$cast(TypeArray.Header).data + stack_size * (array_header.capacity + index));
    } else {
        assert(index < array_header.size);
        pointer = (array_header.data + stack_size * index);
    }
    // TODO replace with template/generic 
    switch (stack_size) {
        case 1 => return pointer$cast(GC.U8Wrapper).value;
        case 2 => return pointer$cast(GC.U16Wrapper).value;
        case 4 => return pointer$cast(GC.U32Wrapper).value;
        case 8 => return pointer$cast(GC.U64Wrapper).value;
    }
    return 0;
 }
