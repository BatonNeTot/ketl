                break;
            }

            ketl_token_t constant_name = CURRENT_TOKEN(0);
            a_enum_constants[enum_constants_count].s_name = ketl_atomic_strings_get(&p_context->p_state->atomic_strings, TOKEN_STRING(constant_name), TOKEN_LENGTH(constant_name));
