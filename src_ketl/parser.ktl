from common import FilePointer
from common import LogAccum
import common
from variable import VariableDecl

from type import Type
from type import Types
from type import Value
from token import Token
from lexer import TokenIterator
from lexer import Lexer
from hir import HIR

from namespace import Namespace
from func import CompileFunctionDeclaration
from module import Modules

from hir_builder import HIRBuilder

class Parser {

    class Context {
        var log_accum: LogAccum;
        var log_info: LogAccum.LogInfo;

        var source: str;
        var namespace: Namespace;
        var iterator: TokenIterator;
        var hir_builder: HIRBuilder;

        var is_global_scope: bool;
        var exxport: bool;
    }

    fn error(self: Context, offset: u32, length: u32, message: str) {
        self.log_accum->error(
            self.log_info,
            FilePointer.construct(offset, offset, length),
            message 
        );
    }

    fn error_var() => HIR.VarId {
        assert(false);
        return (-1)$cast(HIR.VarId);
    }
 
    fn current_token(context: Context, offset: u64) => Token {
        return context.iterator->current(offset);
    }

    fn token_check(context : Context, token_type : Token.Type) => bool {
        return context->current_token(0).type == token_type;
    }

    fn token_advance(context : Context) {
        while (true) {
            context.iterator->advance();

            if (context->current_token(0).type != Token.Type.ERROR) break;

            // TODO error
            assert(false);
        }
    }

    fn token_match(context : Context, token_type : Token.Type) => bool {
        if (!context->token_check(token_type)) return false;
        context->token_advance();
        return true;
    }

    fn token_consume(context : Context, token_type : Token.Type, message : str) => bool {
        if (!context->token_match(token_type)) {
            var token = context->current_token(0);
            context->error(token.offset, token.length, message);
            return false;
        }
        return true;
    }

    fn token_str(context: Context, token: Token) => str {
        assert(token.offset < context.source.size && token.offset + token.length <= context.source.size);
        return context.source[token.offset:token.offset + token.length];
    }

    fn get_var(context: Context, var_id: HIR.VarId) => HIR.Var {
        return context.hir_builder.vars[var_id];
    }

    class StatementInfo {
        enum ReturnInfo : u8 {
            Empty   = 0,
            None    = 1,
            Value   = 2,
            Undef   = 3, // None | Value
            Always  = 4,

            AlwaysNone  = 5, //None  | Always
            AlwaysValue = 6, //Value | Always;
            AlwaysUndef = 7, //Undef | Always;
        }

        var return_info : ReturnInfo;

        export fn construct(return_info: ReturnInfo) => StatementInfo {
            var self = StatementInfo();
            self.return_info = return_info;
            return self;
        }
    }

    enum Precedence : u8 {
        None,
        Assigment,
        LogicalOr,
        LogicalAnd,
        Equality,
        Comparison,
        Concat,
        Term,
        Factor,
        BitwiseOr,
        BitwiseXor,
        BitwiseAnd,
        Prefix,
        Call,
        Primary,
    }

    enum Associativity : u8 {
        LTR, // Left To Right
        RTL, // Right To Left
    }

    shared associativity = Associativity[Precedence$count]{
        Precedence.None       => Associativity.LTR,
        Precedence.Assigment  => Associativity.RTL,
        Precedence.LogicalOr  => Associativity.LTR,
        Precedence.LogicalAnd => Associativity.LTR,
        Precedence.Equality   => Associativity.LTR,
        Precedence.Comparison => Associativity.LTR,
        Precedence.Concat     => Associativity.LTR,
        Precedence.Term       => Associativity.LTR,
        Precedence.Factor     => Associativity.LTR,
        Precedence.BitwiseOr  => Associativity.LTR,
        Precedence.BitwiseXor => Associativity.LTR,
        Precedence.BitwiseAnd => Associativity.LTR,
        Precedence.Call       => Associativity.LTR,
        Precedence.Primary    => Associativity.LTR,
    };

    class ParseRule {
        var prefix: (Context) => HIR.VarId;
        var ltr_infix: (Context, HIR.VarId) => HIR.VarId;
        var rtl_infix: (Context, HIR.VarId, HIR.VarId) => HIR.VarId;
        var precedence: Precedence;

        export fn construct(prefix: (Context) => HIR.VarId, 
                            ltr_infix: (Context, HIR.VarId) => HIR.VarId, 
                            rtl_infix: (Context, HIR.VarId, HIR.VarId) => HIR.VarId,
                            precedence: Precedence) => ParseRule {
            var self = ParseRule();
            self.prefix = prefix;
            self.ltr_infix = ltr_infix;
            self.rtl_infix = rtl_infix;
            self.precedence = precedence;
            return self;
        }
    }

    shared parse_rule_default = ParseRule.construct(null, null, null, Precedence.None);
    
    fn get_parse_rule(token_type: Token.Type) => ParseRule {
        var parse_rule = parse_rules[token_type];
        if (parse_rule != null) {
            return parse_rule;
        } else {
            return parse_rule_default;
        }
    }

    enum Bracket: u8 {
        PARENTHESIS,
        CURLY,
        SQUARE,
    }

    // returns true if closing bracket met
    fn dummy_parse_bracket(brackets: Bracket[], token_type: Token.Type) => bool {
        switch (token_type) {
            case Token.Type.PARENTHESIS_LEFT => {
                brackets ..= Bracket.PARENTHESIS;
                return false;
            }
            case Token.Type.CURLY_LEFT => {
                brackets ..= Bracket.CURLY;
                return false;
            }
            case Token.Type.SQUARE_LEFT => {
                brackets ..= Bracket.SQUARE;
                return false;
            }
            case Token.Type.PARENTHESIS_RIGHT => {
                if (brackets.size <= 0) {
                    return false;
                }
                var bracket = brackets[brackets.size - 1];
                assert(bracket == Bracket.PARENTHESIS);
                brackets->pop();
                return true;
            }
            case Token.Type.CURLY_RIGHT => {
                if (brackets.size <= 0) {
                    return false;
                }
                var bracket = brackets[brackets.size - 1];
                assert(bracket == Bracket.CURLY);
                brackets->pop();
                return true;
            }
            case Token.Type.SQUARE_RIGHT => {
                if (brackets.size <= 0) {
                    return false;
                }
                var bracket = brackets[brackets.size - 1];
                assert(bracket == Bracket.SQUARE);
                brackets->pop();
                return true;
            }
        }
        return false;
    }

    fn parse_identificator(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        var src_info = HIR.SrcInfo.from_token(token);

        if (token.type == Token.Type.ID) {
            var name = context->token_str(token);
            var var_id = context.hir_builder->get_var(context.namespace, name, name, src_info);
            if (context.hir_builder->get_type(var_id) == null) {
                context->error(src_info.source_offset, src_info.length, "Undeclared variable.");
            }

            return var_id;
        }

        switch (token.type) {
            case Token.Type.I8 => return context.hir_builder->get_type_var(Types.instance.type_i8, src_info);
            case Token.Type.I16 => return context.hir_builder->get_type_var(Types.instance.type_i16, src_info);
            case Token.Type.I32 => return context.hir_builder->get_type_var(Types.instance.type_i32, src_info);
            case Token.Type.I64 => return context.hir_builder->get_type_var(Types.instance.type_i64, src_info);
            case Token.Type.U8 => return context.hir_builder->get_type_var(Types.instance.type_u8, src_info);
            case Token.Type.U16 => return context.hir_builder->get_type_var(Types.instance.type_u16, src_info);
            case Token.Type.U32 => return context.hir_builder->get_type_var(Types.instance.type_u32, src_info);
            case Token.Type.U64 => return context.hir_builder->get_type_var(Types.instance.type_u64, src_info);
        }

        return error_var();
    }

    fn parse_number(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        return context.hir_builder->push_literal_number(context->token_str(token)$cast(u64), HIR.SrcInfo.from_token(token));
    }
    
    fn parse_grouping(context: Context) => HIR.VarId {
        // TODO create new var to update src_info
        var expr = context->parse_expression();
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after expression.");
        return expr;
    }

    fn parse_argument_list(context: Context) => HIR.VarId[] {
        var arguments = HIR.VarId[0];
        if (!context->token_check(Token.Type.PARENTHESIS_RIGHT)) {
            while (true) {
                var arg = context->parse_expression();
                arguments ..= arg;
                
                if (!context->token_match(Token.Type.COMMA)) {
                    break;
                }
            }
        }
        
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after arguments.");
        return arguments;
    }

    fn parse_call(context: Context, callee_id: HIR.VarId) => HIR.VarId {
        var arguments = context->parse_argument_list();
        var callee = context.hir_builder.vars[callee_id];
        var src_info = HIR.SrcInfo.merge(callee.src_info, HIR.SrcInfo.from_token(context->current_token(1)));

        if (callee.kind == HIR.Var.Kind.Common) {
            var decl = context.hir_builder.decls[callee$cast(HIR.VarCommon).decl];

            if (decl.kind == HIR.Decl.Kind.Global && decl$cast(HIR.DeclGlobal).node.value.kind == Value.Kind.Type) {
                assert(false);
                /*
                ketl_hir_var_info_t* p_callee_info = get_var_info(p_context, p_callee->info);
                ketl_namespace_node* p_callee_node = ketl_namespace_find_by_index(p_callee_info->p_namespace, p_callee_info->namespace_node_index);
                if (p_callee_node->variable.kind != KETL_VARIABLE_TYPE) {
                    errorf(expr_info.source_offset, expr_info.length, "Trying to call an improper object.");
                    return push_temp_var(p_context, expr_info);
                }
                ketl_type* p_callee_type = p_callee_node->variable.p_pointer;
                if (p_callee_type->kind != KETL_TYPE_CLASS) {
                    errorf(expr_info.source_offset, expr_info.length, "Only class objects can be constructed through calling a type.");
                    return push_temp_var(p_context, expr_info);
                }
                
                return push_hir_new(p_context, callee, argument_count, expr_info);
                */
            }
        }

        return context.hir_builder->push_hir_call(callee_id, arguments, src_info);
    }

    fn parse_unary_rtl(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        var token_type = token.type;
        var rhs = context->parse_precedence(Precedence.Call);

        switch (token_type) {
            //case Token.Type.LOGICAL_NOT => return context->push_hir_unary_op(KETL_HIR_LOGICAL_NOT, rhs, HIR.SrcInfo.from_token(token));

            //case Token.Type.PLUS        => return context->push_hir_unary_op(KETL_HIR_UNARY_PLUS,  rhs, HIR.SrcInfo.from_token(token));
            //case Token.Type.MINUS       => return context->push_hir_unary_op(KETL_HIR_UNARY_MINUS, rhs, HIR.SrcInfo.from_token(token));
        }

        return error_var();
    }

    fn parse_binary_ltr(context: Context, lhs: HIR.VarId) => HIR.VarId {
        var token_type = context->current_token(1).type;
        var parse_rule = token_type->get_parse_rule();
        var rhs = context->parse_precedence(parse_rule.precedence + 1);
        var src_info = HIR.SrcInfo.merge(context->get_var(lhs).src_info, context->get_var(rhs).src_info);

        switch (token_type) {
            case Token.Type.PLUS             => return context.hir_builder->push_binary_op(HIR.Tag.PLUS,             lhs, rhs, src_info);
            case Token.Type.MINUS            => return context.hir_builder->push_binary_op(HIR.Tag.MINUS,            lhs, rhs, src_info);
            case Token.Type.MULTIPLY         => return context.hir_builder->push_binary_op(HIR.Tag.MULTY,            lhs, rhs, src_info);
            case Token.Type.DIVIDE           => return context.hir_builder->push_binary_op(HIR.Tag.DIVIDE,           lhs, rhs, src_info);
            case Token.Type.REMAINDER        => return context.hir_builder->push_binary_op(HIR.Tag.MOD,              lhs, rhs, src_info);
            
            //case Token.Type.CONCAT:           return push_hir_concat   (p_context,                            lhs, rhs, expr_info_merge(GET_VAR(lhs).src_info, GET_VAR(rhs).src_info));

            case Token.Type.LESS             => return context.hir_builder->push_binary_op(HIR.Tag.LESS,             lhs, rhs, src_info);
            case Token.Type.LESS_OR_EQUAL    => return context.hir_builder->push_binary_op(HIR.Tag.LESS_OR_EQUAL,    lhs, rhs, src_info);
            case Token.Type.GREATER          => return context.hir_builder->push_binary_op(HIR.Tag.GREATER,          lhs, rhs, src_info);
            case Token.Type.GREATER_OR_EQUAL => return context.hir_builder->push_binary_op(HIR.Tag.GREATER_OR_EQUAL, lhs, rhs, src_info);
            case Token.Type.EQUAL            => return context.hir_builder->push_binary_op(HIR.Tag.EQUAL,            lhs, rhs, src_info);
            case Token.Type.NOT_EQUAL        => return context.hir_builder->push_binary_op(HIR.Tag.NOT_EQUAL,        lhs, rhs, src_info);
            
            case Token.Type.BITWISE_AND      => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_AND,      lhs, rhs, src_info);
            case Token.Type.BITWISE_OR       => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_OR,       lhs, rhs, src_info);
            case Token.Type.BITWISE_XOR      => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_XOR,      lhs, rhs, src_info);}

        return error_var();
    }

    fn parse_binary_rtl(context: Context, lhs: HIR.VarId, rhs: HIR.VarId) => HIR.VarId {
        var token_type = context->current_token(1).type;

        switch (token_type) {
            //case Token.Type.ASSIGN            : return push_hir_assign(p_context, KETL_HIR_ASSIGN, lhs, rhs);

            //case Token.Type.ASSIGN_PLUS       : return push_hir_assign(p_context, KETL_HIR_ASSIGN_PLUS, lhs, rhs);
            //case Token.Type.ASSIGN_MINUS      : return push_hir_assign(p_context, KETL_HIR_ASSIGN_MINUS, lhs, rhs);
            //case Token.Type.ASSIGN_MULTIPLY   : return push_hir_assign(p_context, KETL_HIR_ASSIGN_MULTY, lhs, rhs);
            //case Token.Type.ASSIGN_DIVIDE     : return push_hir_assign(p_context, KETL_HIR_ASSIGN_DIV, lhs, rhs);
            //case Token.Type.ASSIGN_REMAINDER  : return push_hir_assign(p_context, KETL_HIR_ASSIGN_MOD, lhs, rhs);

            //case Token.Type.ASSIGN_BITWISE_AND: return push_hir_assign(p_context, KETL_HIR_ASSIGN_BITWISE_AND, lhs, rhs);
            //case Token.Type.ASSIGN_BITWISE_OR : return push_hir_assign(p_context, KETL_HIR_ASSIGN_BITWISE_OR, lhs, rhs);
            //case Token.Type.ASSIGN_BITWISE_XOR: return push_hir_assign(p_context, KETL_HIR_ASSIGN_BITWISE_XOR, lhs, rhs);

            //case Token.Type.ASSIGN_CONCAT     : return push_append    (p_context, lhs, rhs);
        }

        return error_var();
    }
    
    fn parse_lhs_operand(context: Context, precedence: Precedence) => HIR.VarId {    
        var prefix_rule = context->current_token(1).type->get_parse_rule().prefix;
        if (prefix_rule == null) {
            context->error(context->current_token(1).offset, context->current_token(1).length, "Expected expression.");
            return context.hir_builder->push_temp_var(HIR.SrcInfo.from_token(context->current_token(1)));
        }

        var lhs = context->prefix_rule();

        while (precedence < context->current_token(0).type->get_parse_rule().precedence ||
            (associativity[precedence] == Associativity.LTR && precedence == context->current_token(0).type->get_parse_rule().precedence)) {
            context->token_advance();
            var ltr_infix_rule = get_parse_rule(context->current_token(1).type).ltr_infix;
            if (ltr_infix_rule == null) {
                context->error(context->current_token(1).offset, context->current_token(1).length, "Expected operator.");
                return context.hir_builder->push_temp_var(HIR.SrcInfo.from_token(context->current_token(1)));
            }
            lhs = context->ltr_infix_rule(lhs);
        }
    
        return lhs;
    }

    fn parse_precedence(context: Context, precedence: Precedence) => HIR.VarId {
        context->token_advance();

        if (associativity[precedence] == Associativity.LTR) {
            var lhs = context->parse_lhs_operand(precedence);
            return lhs;
        }

        // looking for the rtl operator
        var start_pos = context.iterator->mark();
        var brackets_stack = Bracket[0];

        brackets_stack->dummy_parse_bracket(context->current_token(1).type);
        var parse_rule = context->current_token(1).type->get_parse_rule();
        var token_precedence = parse_rule.precedence;
        while (precedence < token_precedence) {
            context->token_advance();

            var token = context->current_token(1);
            var current_token_type = token.type;
            if (current_token_type == Token.Type.EOF) {
                context->error(token.offset, token.length, "Expected operator.");
                return context.hir_builder->push_temp_var(HIR.SrcInfo.from_token(token));
            }

            parse_rule = current_token_type->get_parse_rule();
            if (!brackets_stack->dummy_parse_bracket(current_token_type)) {
                token_precedence = parse_rule.precedence;
            }
        }

        // we coudln't find rtl operator, restoring token iterator and do simple ltr
        if (precedence != token_precedence) {
            context.iterator->rewind(start_pos);
            
            var lhs = context->parse_lhs_operand(precedence);
            return lhs;
        }

        // parse after the operator, rhs operand
        var rhs = context->parse_precedence(precedence);

        // saving end of the rhs operand for restoring later
        var end_pos = context.iterator->mark();
        context.iterator->rewind(start_pos);

        var lhs = context->parse_lhs_operand(precedence);
            
        context->token_advance();

        // back to the rtl operator
        var rtl_infix = context->current_token(1).type->get_parse_rule().rtl_infix;
        if (rtl_infix == null) {
            context->error(context->current_token(2).offset, context->current_token(2).length, "Expected operator.");
            return context.hir_builder->push_temp_var(HIR.SrcInfo.from_token(context->current_token(2)));
        }
        lhs = context->rtl_infix(lhs, rhs);

        // restore token iterator
        context.iterator->rewind(end_pos);
        return lhs;
    }

    fn parse_expression(context: Context) => HIR.VarId {
        return context->parse_precedence(Precedence.Assigment);
    }

    fn parse_type(context: Context) => Type {
        var type_var_id = context->parse_precedence(Precedence.Assigment + 1);
        var type_var = context->get_var(type_var_id);
        // TODO error
        assert(type_var.kind == HIR.Var.Kind.Common);
        var decl_id = type_var$cast(HIR.VarCommon).decl;
        var decl = context.hir_builder.decls[decl_id];
        // TODO error
        assert(decl.kind == HIR.Decl.Kind.Global);
        var decl_global = decl$cast(HIR.DeclGlobal);
        // TODO error
        assert(decl_global.node != null && decl_global.node.value.kind == Value.Kind.Type);
        return decl_global.node.value.value$cast(raw);
    }

    shared parse_rules = ParseRule[Token.Type$count]{
        Token.Type.ID                  => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.LITERAL_INTEGER     => ParseRule.construct(parse_number,        null,                  null,             Precedence.Primary), 
        Token.Type.PARENTHESIS_LEFT    => ParseRule.construct(parse_grouping,      parse_call,            null,             Precedence.Call),
        Token.Type.LOGICAL_NOT         => ParseRule.construct(parse_unary_rtl,     null,                  null,             Precedence.None),
        //Token.Type.LOGICAL_AND         => ParseRule.construct(null,                parse_short_circuit,   null,             Precedence.LogicalAnd),
        //Token.Type.LOGICAL_OR          => ParseRule.construct(null,                parse_short_circuit,   null,             Precedence.LogicalOr),
        Token.Type.LESS                => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Comparison),
        Token.Type.LESS_OR_EQUAL       => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Comparison),
        Token.Type.GREATER             => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Comparison),
        Token.Type.GREATER_OR_EQUAL    => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Comparison),
        Token.Type.EQUAL               => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Equality),
        Token.Type.NOT_EQUAL           => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Equality),
        Token.Type.BITWISE_NOT         => ParseRule.construct(parse_unary_rtl,     null,                  null,             Precedence.None),
        Token.Type.BITWISE_AND         => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.BitwiseAnd),
        Token.Type.BITWISE_OR          => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.BitwiseOr),
        Token.Type.BITWISE_XOR         => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.BitwiseXor),
        Token.Type.BITWISE_SHIFT_LEFT  => ParseRule.construct(null,                null,                  null,             Precedence.None),
        Token.Type.BITWISE_SHIFT_RIGHT => ParseRule.construct(null,                null,                  null,             Precedence.None),
        Token.Type.INCREMENT           => ParseRule.construct(null,                null,                  null,             Precedence.None),
        Token.Type.DECREMENT           => ParseRule.construct(null,                null,                  null,             Precedence.None),
        Token.Type.PLUS                => ParseRule.construct(parse_unary_rtl,     parse_binary_ltr,      null,             Precedence.Term),
        Token.Type.MINUS               => ParseRule.construct(parse_unary_rtl,     parse_binary_ltr,      null,             Precedence.Term),
        Token.Type.MULTIPLY            => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Factor),
        Token.Type.DIVIDE              => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Factor),
        Token.Type.REMAINDER           => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Factor),
        Token.Type.CONCAT              => ParseRule.construct(null,                parse_binary_ltr,      null,             Precedence.Concat),
        Token.Type.ASSIGN              => ParseRule.construct(null,                null,                  parse_binary_rtl, Precedence.Assigment),
        Token.Type.I8                  => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.I16                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.I32                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.I64                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.U8                  => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.U16                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.U32                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.U64                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.F32                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
        Token.Type.F64                 => ParseRule.construct(parse_identificator, null,                  null,             Precedence.Primary),
    };

    fn parse_from_import(context: Context) => StatementInfo {
        assert(context.is_global_scope);

        var path = "";
        var start_expr_info = HIR.SrcInfo.from_token(context->current_token(0));

        context->token_advance(); // import
        var module_literal = context->current_token(0);
        context->token_advance(); // id
        while (context->token_match(Token.Type.DOT)) {
            path ..= context->token_str(module_literal);
            path ..= "/";
            module_literal = context->current_token(0);
            context->token_advance(); // module id
        }

        context->token_consume(Token.Type.IMPORT, "Expected 'import' keyword after module name.");
        var name_literal = context->current_token(0);
        context->token_advance(); // entity id

        var src_info = HIR.SrcInfo.merge(
            start_expr_info,
            HIR.SrcInfo.from_token(context->current_token(1)));

        var module_name = context->token_str(module_literal);

        // TODO implement
        /*
        ketl_namespace* p_module_namespace = ketl_state_load_module_impl(p_context=>p_state, s_module_name, a_path_buffer, null, p_context=>export);
        if (p_module_namespace == null) {
            errorf(src_info.source_offset, src_info.length, "Couldn't find module '%.*s'.", TOKEN_LENGTH(module_literal), TOKEN_STRING(module_literal));
            return (ketl_statement_info){ .return_info = KETL_RETURN_EMPTY };
        }
        */

        var name = context->token_str(name_literal);

        // TODO 
        /*
        ketl_namespace_node* p_node = ketl_namespace_find(p_module_namespace, s_name);

        if (p_node == null) {
            errorf(src_info.source_offset, src_info.length, "Couldn't find '%.*s' in module '%.*s'.", TOKEN_LENGTH(module_literal), TOKEN_STRING(module_literal),
                TOKEN_LENGTH(name_literal), TOKEN_STRING(name_literal));
            return (ketl_statement_info){ .return_info = KETL_RETURN_EMPTY };
        }

        ketl_variable namespace_var = p_node=>variable;

        ketl_namespace_node* p_local_node = ketl_namespace_put(p_context=>p_namespace, s_name, KETL_ATOMIC_STRING_EMPTY, namespace_var, 
            (ketl_namespace_node_info){ .export = p_context=>export, .imported = true }, &p_context=>p_state=>atomic_strings, false);
        p_local_node=>s_name = p_node=>s_name;
        */

        assert(false);
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_import(context: Context) => StatementInfo {
        assert(context.is_global_scope);

        var path = "";
        var start_expr_info = HIR.SrcInfo.from_token(context->current_token(0));

        context->token_advance(); // import
        var module_literal = context->current_token(0);
        context->token_advance(); // id
        while (context->token_match(Token.Type.DOT)) {
            path ..= context->token_str(module_literal);
            path ..= "/";
            module_literal = context->current_token(0);
            context->token_advance(); // module id
        }

        var src_info = HIR.SrcInfo.merge(
            start_expr_info,
            HIR.SrcInfo.from_token(context->current_token(1)));

        var module_name = context->token_str(module_literal);

        // TODO implement
        /*
        if (!ketl_state_load_module_impl(p_context=>p_state, s_module_name, a_path_buffer, p_context=>p_namespace, p_context=>export)) {
            errorf(src_info.source_offset, src_info.length, "Couldn't find module '%.*s'", TOKEN_LENGTH(module_literal), TOKEN_STRING(module_literal));
        }
        */

        assert(false);
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }
    
    fn declare_var(context: Context, name: str, type: Type, init_value: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        var var_id: HIR.VarId;
        if (context.is_global_scope) {
            var namespace_node = context.namespace->declare_var(name, type, context.exxport);
            var_id = context.hir_builder->declare_global_var(namespace_node, name, src_info);
        } else {
            assert(false);
            /*
            var_id = ketl_hir_builder_register_var(&p_context->hir_builder, p_context->p_namespace, 
                name, src_info, type_index);
                */
        }

        if (context.hir_builder->get_type(var_id) == null) {
            return var_id;
        }

        // TODO if const zero and global omit assign
        context.hir_builder->push_assign(HIR.Tag.ASSIGN, var_id, init_value, src_info);
        return var_id;
    }

    fn parse_var_declaration(context: Context) => StatementInfo {
        var src_info = HIR.SrcInfo.from_token(context->current_token(0));

        context->token_advance(); // var
        var id_literal = context->current_token(0);
        var name = context->token_str(id_literal);
        context->token_advance(); // id

        var type: Type = null;
        var initial_value = (-1)$cast(HIR.VarId);
        if (context->token_match(Token.Type.COLON)) {
            type = context->parse_type();
        }
        if (context->token_match(Token.Type.ASSIGN)) {
            initial_value = context->parse_expression();
            src_info = HIR.SrcInfo.merge(src_info, context->get_var(initial_value).src_info);
            
            if (type == null) {
                type = context.hir_builder->get_type(initial_value);
            } else {
                initial_value = context.hir_builder->cast_to_type(initial_value, type, false);
            }
        } else {
            if (type == null) {
                src_info = HIR.SrcInfo.merge(src_info, HIR.SrcInfo.from_token(context->current_token(1)));
                context->error(src_info.source_offset, src_info.length, "Variable declaration without a type expects an initial expression.");

                initial_value = context.hir_builder->push_temp_var(src_info);
            } else {
                initial_value = context.hir_builder->get_default_initial_value(type, src_info);
            }
        }
        if (type == null) {
            context->error(src_info.source_offset, src_info.length, "Can't deduce var type.");
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }
        
        context->declare_var(name, type, initial_value, src_info);
        context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after variable declaration.");
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }
//*
    fn parse_function_declaration(context: Context) => StatementInfo {
        context->token_advance(); // fn
        var id_literal = context->current_token(0);
        context->token_advance(); // id

        context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected '(' after function name.");

        var function_parameters_names = str[0];
        var function_parameters = Type[1];

        if (!context->token_check(Token.Type.PARENTHESIS_RIGHT)) {
            while (true) {
                var parameter_literal = context->current_token(0);
                function_parameters_names ..= context->token_str(parameter_literal);
                context->token_advance(); // id

                context->token_consume(Token.Type.COLON, "Expected ':' after parameter name.");

                var parameter_type = context->parse_type();
                function_parameters ..= parameter_type;

                if (!context->token_match(Token.Type.COMMA)) {
                    break;
                }
            }
        }
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after parameters.");

        var return_type: Type;
        if (context->token_match(Token.Type.DOUBLE_ARROW_RIGHT)) {
            return_type = context->parse_type();
        }
        if (return_type == null) {
            return_type = Types.instance.type_void;
        }

        function_parameters[0] = return_type;
        
        context->token_consume(Token.Type.CURLY_LEFT, "Expected '{' after function declaration.");

        var function_type = Types.instance->get_function_type(function_parameters);
        var name = context->token_str(id_literal);
        var namespace_node = context.namespace->declare_var(name, function_type, context.exxport);
        
        // looking for the end of the function definition
        var start_pos = context.iterator->mark();
        var brackets_stack = Bracket[0];

        var current_token_type = Token.Type.CURLY_LEFT;
        brackets_stack->dummy_parse_bracket(current_token_type);
        while (brackets_stack.size > 0) {
            var token = context->current_token(0);
            current_token_type = token.type;
            if (current_token_type == Token.Type.EOF) {
                context->error(token.offset, token.length, "Expected '}' after function body.");
                return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
            }

            brackets_stack->dummy_parse_bracket(current_token_type);
            context->token_advance();
        }

        // TODO do proper error evaluation during this pass
        //token_consume(p_context, Token.Type.CURLY_RIGHT, "Expected '}' after function body.");

        // saving end of the function definition for later
        var end_pos = context.iterator->mark();

        var function_decl = CompileFunctionDeclaration();
        function_decl.parent_namespace = context.namespace;
        function_decl.node = namespace_node;
        function_decl.parameters_names = function_parameters_names;
        function_decl.start_pos = start_pos;
        function_decl.end_pos = end_pos;
        
        Modules.instance.active_module.compile_function_declarations ..= function_decl;

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }//*/

    fn parse_declaration(context : Context) => StatementInfo {
        switch (context->current_token(0).type) {
            case Token.Type.IMPORT  => return context->parse_import();
            case Token.Type.FROM    => return context->parse_from_import();
            case Token.Type.VAR     => return context->parse_var_declaration();
            //case Token.Type.CIMPORT => return context->parse_cimport_declaration();
            case Token.Type.FN      => return context->parse_function_declaration();
            //case Token.Type.CLASS   => return context->parse_class_declaration();
            //case Token.Type.ENUM    => return context->parse_enum_declaration();
            //case Token.Type.MIMIC   => return context->parse_mimic_declaration();
            //case Token.Type.EXPORT  => return context->parse_export_declaration();
            //case Token.Type.CEXPORT => return context->parse_cexport_declaration();
            default                 => return context->parse_statement();
        }
    }

    fn parse_block_statement_inner(context : Context) => StatementInfo {
        var return_info = StatementInfo.ReturnInfo.Empty;

        while (!context->token_check(Token.Type.CURLY_RIGHT) && !context->token_check(Token.Type.EOF)) {
            if (return_info & StatementInfo.ReturnInfo.Always > 0) {
                var statement_start = context->current_token(0).offset;

                var decl_return_info = context->parse_declaration().return_info;

                var last_token = context->current_token(1);
                var statement_end = last_token.offset + last_token.length;

                context->error(statement_start, statement_end - statement_start, "Unreachable statement.");

                return_info |= decl_return_info;
            } else {
                return_info |= context->parse_declaration().return_info;
            }
        }

        var statement_info = StatementInfo();
        statement_info.return_info = return_info;
        return statement_info;
    }

    fn parse_block_statement(context : Context) => StatementInfo {
        context->token_advance();

        // TODO push_symbol_map
        var statement_info = context->parse_block_statement_inner();
        // TODO pop_symbol_map

        context->token_consume(Token.Type.CURLY_RIGHT, "Expected '}' at the end of the block.");
        return statement_info;
    }

    fn parse_return_statement(context: Context) => StatementInfo {
        context->token_advance(); // return
        var src_info = HIR.SrcInfo.from_token(context->current_token(1));
        if (context->token_match(Token.Type.TERMINATION_CHARACTER)) {
            context.hir_builder->push_tagonly_instr(HIR.Tag.RETURN, src_info);
            return StatementInfo.construct(StatementInfo.ReturnInfo.AlwaysNone);
        } else {
            context.hir_builder->push_return_value(context->parse_expression(), src_info);
            context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after return statement expression.");
            return StatementInfo.construct(StatementInfo.ReturnInfo.AlwaysValue);
        }
    }

    fn parse_expression_statement(context: Context) => StatementInfo {
        context->parse_expression();
        context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after expression.");
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_statement(context: Context) => StatementInfo {
        switch (context->current_token(0).type) {
            //case Token.Type.CURLY_LEFT            => return context->parse_block_statement();
            //case Token.Type.IF                    => return context->parse_if_statement();
            //case Token.Type.WHILE                 => return context->parse_while_statement();
            //case Token.Type.FOR                   => return context->parse_for_statement();
            //case Token.Type.SWITCH                => return context->parse_switch_statement();
            //case Token.Type.BREAK                 => return context->parse_break_statement();
            //case Token.Type.CONTINUE              => return context->parse_continue_statement();
            case Token.Type.RETURN                => return context->parse_return_statement();
            case Token.Type.TERMINATION_CHARACTER => { 
                context->token_advance(); 
                return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
            }
            default                               => return context->parse_expression_statement();
        }
    }

    export fn build_hir(lexer : Lexer, start_pos: TokenIterator.Index, end_pos: TokenIterator.Index, namespace: Namespace, parameters : VariableDecl[], return_type : Type, func_index: u16, is_global_scope: bool, log_accum: LogAccum) => HIR {
        var context = Context();

        context.log_accum = log_accum;
        context.log_info = lexer->construct_log_info();

        context.source = lexer.source;
        context.namespace = namespace;
        context.iterator = TokenIterator.construct(lexer.tokens[start_pos:end_pos]);
        context.is_global_scope = is_global_scope;

        context.hir_builder = HIRBuilder.construct(context.log_accum, context.log_info);

        for (var parameter <- parameters) {
            // TODO
        }

        if (lexer.tokens.size > 0) {
            var statement_info = context->parse_block_statement_inner();
            if ((statement_info.return_info & StatementInfo.ReturnInfo.Undef) == StatementInfo.ReturnInfo.Undef ||
                (!(statement_info.return_info & StatementInfo.ReturnInfo.Always) && (
                    !!(statement_info.return_info & StatementInfo.ReturnInfo.Value) || (return_type != null && !return_type->is_void())
                ))) {
                context->error(lexer.tokens[end_pos - 1].offset, 1, "Not all control returns value.");
            }

            /* // Doesn't look like necessary
            if (p_context->reserved_break != (ketl_hir_block_index_t)-1 ||
                p_context->reserved_continue != (ketl_hir_block_index_t)-1) {
                errorf(p_lexer->tokens.p_data[end_pos - 1].offset, 1, "Expected statement.");
            }
            */

            if (!(statement_info.return_info & StatementInfo.ReturnInfo.Always)) {
                // we need to return eventually
                context.hir_builder->push_tagonly_instr(HIR.Tag.RETURN, HIR.SrcInfo.construct(lexer.tokens[end_pos - 1].offset, 1));
            }
        }

        var hir = HIR();
        context.hir_builder->flush(hir);
        return hir;
    }
}