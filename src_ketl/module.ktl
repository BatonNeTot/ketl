}

class Modules {

    var modules: StrHashMap;
    var active_module_name: str;
    var loading_modules: bool;

    fn construct() => Modules {
        var self = Modules();
        //self.modules = StrHashMap.construct();
        return self;
    }

    fn init_if_needed(self: Modules) {
        if (self.modules == null) {
            self.modules = StrHashMap.construct();
        }
    }

    shared instance = construct();

    export fn load(self: Modules, module_name: str, folder_path: str, namespace: Namespace, exxport: bool) => Namespace {
        self->init_if_needed();

        var module_filename = module_name .. ".ktl";

        var modules_size = self.modules.size;
        var module_bucket = self.modules->get_or_insert(module_name, null);
        // old insert
        if (modules_size == self.modules.size) {
            var module = module_bucket.value$cast(Module);
            module->preload(module_filename, folder_path, namespace, exxport);
            return module.namespace;
        }

        var top_loading = !self.loading_modules;
        self.loading_modules = true;

        var module = Module.construct(module_name);
        module_bucket.value = module;

        // preloading
        if (!module->preload(module_filename, folder_path, namespace, exxport)) {
            self.modules->erase(module_bucket);
            return null;
        }

        // load will be done later in bulk
        if (!top_loading) {
            return module.namespace;
        }

        // postloading everything
        for (var tmp_bucket <- self.modules.buckets) {
            while (tmp_bucket != null) {
                var tmp_module = tmp_bucket.value$cast(Module);
                if (tmp_module.header_loaded && !tmp_module.body_loaded) {
                    tmp_module->load();
                }
                tmp_bucket = tmp_bucket.next;
            }
        }

        self.loading_modules = false;

        return module.namespace;
    }

}