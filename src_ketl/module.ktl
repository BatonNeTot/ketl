//🫖ketl

from common import StrHashMap
from common import LogAccum
from io import File
import io

from type import Types
from type import TypeFunction

from namespace import Namespace

from func import CompileFunctionDeclaration

from lexer import Lexer
from lexer import TokenIterator
from variable import VariableDecl
from asm_x86 import ASMX86

class Module {

    var name: str;
    var path: str;
    var namespace: Namespace;
    var lexer: Lexer;
    var compile_function_declarations: CompileFunctionDeclaration[];
    var init_asm_x86: ASMX86;
    var entry_asm_x86: ASMX86;
    var has_errors: bool;
    var header_loaded: bool; // after preload
    var body_loaded: bool; // after load

    fn construct(name: str, global_namespace: Namespace) => Module {
        var self = Module();

        self.name = name;
        self.namespace = Namespace.construct(name, global_namespace);
        self.compile_function_declarations = CompileFunctionDeclaration[0];

        return self;
    }

    fn get_func_index_offset(module: Module) => u16 {
        var offset: u16;
        if (module.init_asm_x86 != null) {
            offset += 1;
        }
        if (module.entry_asm_x86 != null) {
            offset += 1;
        }
        return offset;
    }

    export fn print_asm(module: Module) {
        io.println("    .def    @feat.00;");
        io.println("    .scl    3;");
        io.println("    .type   0;");
        io.println("    .endef");
        io.println("    .globl  @feat.00");
        io.println("@feat.00 = 0");
        io.println("    .intel_syntax noprefix");
        io.println("    .file   \"" .. module.name .. ".ktl\"");

        io.println("    .text                    # -- Functions");

        if (module.init_asm_x86 != null) {
            module.init_asm_x86->print(module.name .. "..init");
        }

        if (module.entry_asm_x86 != null) {
            module.entry_asm_x86->print("main");
        }

        for (var compile_func_decl <- module.compile_function_declarations) {
            if (compile_func_decl.asm_x86 != null) {
                compile_func_decl.asm_x86->print(compile_func_decl.node.name);
            }
        }
    }

    fn add_to_namespace(module: Module, namespace: Namespace, namespace_info: Namespace.Info) {
        // TODO
    }

    fn preload(module: Module, module_filename: str, folder_path: str, namespace: Namespace, exxport: bool) => bool {
        if (module.header_loaded) {
            if (namespace != null) {
                module->add_to_namespace(namespace, Namespace.Info.construct(exxport, false));
            }

            return true;
        }

        module.header_loaded = true;
        var stashed_module = Modules.instance.active_module;
        Modules.instance.active_module = module; 

        var fullpath = "";
        {
            if (stashed_module != null) { 
                fullpath ..= stashed_module.path;
            }

            if (folder_path != null && folder_path.size > 0) {
                fullpath ..= folder_path;
            }

            module.path = fullpath;
        }

        var fullpath_filename = fullpath .. module_filename;
        var source = File.read(fullpath_filename);

        var log_accum = LogAccum.construct();
        var lexer = Lexer();
        module.lexer = lexer;
        lexer->init();
        lexer->build_tokens(module_filename, source, log_accum);

        //for (var token <- lexer.tokens) {
        //    io.errorln("from " .. token.offset$cast(str) .. " to " .. (token.offset + token.length)$cast(str) .. " " .. source[token.offset:token.offset + token.length]);
        //}

        var func_index: u16 = 0;

        from parser import Parser
        var hir = Parser.build_hir(lexer, 0, lexer.tokens.size$cast(TokenIterator.Index), module.namespace, VariableDecl[0], Types.instance.type_void, 
            func_index, true, log_accum);

        //hir->print();
        
        if (!log_accum->check()) {
            module.has_errors = true;
            // TODO something on error
            return false;
        }

        if (hir.entry != null) {
            var entry_source = 
                "   from __ketl_rt import cstr2str" ..
                "   from __ketl_rt import U64Wrapper" ..

                "    var args = str[argc];" ..
                "    var i: i64;" ..
                "    while (i < argc) {" ..
                "        var arg = (argv + i$cast(u64) * raw$size)$cast(U64Wrapper).value$cast(raw);" ..
                "        args[i] = cstr2str(arg);" ..
                "        i += 1;" ..
                "    }" ..
                "    " .. hir.entry .. "(args);" ..
                "    return 0;";

            var entry_lexer = Lexer();
            entry_lexer->init();
            entry_lexer->build_tokens(module_filename, entry_source, log_accum);

            var entry_index: u16 = 1;
            var parameters = VariableDecl[2];
            {
                var parameter = VariableDecl();

                parameter.type = Types.instance.type_i64;
                parameter.name = "argc";

                parameters[0] = parameter;
            }
            {
                var parameter = VariableDecl();

                parameter.type = Types.instance.type_raw;
                parameter.name = "argv";

                parameters[1] = parameter;
            }

            var entry_hir = Parser.build_hir(entry_lexer, 0, entry_lexer.tokens.size$cast(TokenIterator.Index), 
                module.namespace, parameters, Types.instance.type_i64, 
                entry_index, false, log_accum);

            //entry_hir->print();

            assert(log_accum->check());

            module.entry_asm_x86 = ASMX86.Builder.construct(ASMX86.ABI.DEFAULT)->build(entry_hir, entry_index);
        }

        module.init_asm_x86 = ASMX86.Builder.construct(ASMX86.ABI.DEFAULT)->build(hir, func_index);

        Modules.instance.active_module = stashed_module;

        if (namespace != null) {
            module->add_to_namespace(namespace, Namespace.Info.construct(exxport, false));
        }
        
        return true;
    }

    fn load(self: Module) {
        var stashed_module = Modules.instance.active_module;
        Modules.instance.active_module = self; 

        {
        var i: u64;
        while (i < self.compile_function_declarations.size) {
            var compile_function_declaration = self.compile_function_declarations[i];

            var node = compile_function_declaration.node;
            var local_namespace = Namespace.construct(node.name, compile_function_declaration.parent_namespace);
            
            var signature = node.value.type$cast(TypeFunction).signature;
            var return_type = signature.parameters[0];

            var parameters_names = compile_function_declaration.parameters_names;
            if (parameters_names.size != signature.parameters.size - 1) {
                i += 1;
                continue;
            }

            var parameters = VariableDecl[0];
            {
                var j: u64;
                while (j < parameters_names.size) {
                    var parameter = VariableDecl();

                    parameter.type = signature.parameters[j + 1];
                    parameter.name = parameters_names[j];

                    parameters ..= parameter;
                    
                    j += 1;
                }
            }

            {
                var log_accum = LogAccum.construct();
                var func_index = i$cast(u16) + self->get_func_index_offset();

                from parser import Parser
                var hir = Parser.build_hir(self.lexer, 
                    compile_function_declaration.start_pos, compile_function_declaration.end_pos, 
                    local_namespace, parameters, return_type, func_index, false, log_accum);
                
                if (!log_accum->check()) {
                    self.has_errors = true;
                    // TODO something on error
                    i += 1;
                    continue;
                }

                compile_function_declaration.asm_x86 = ASMX86.Builder.construct(ASMX86.ABI.DEFAULT)->build(hir, func_index);
            }

            i += 1;
        }
        }

        Modules.instance.active_module = stashed_module;

        self.body_loaded = true;
    }
}

class Modules {

    var global_namespace: Namespace;
    var modules: StrHashMap;
    var active_module: Module;
    var loading_modules: bool;

    fn construct() => Modules {
        var self = Modules();
        return self;
    }

    fn init_modules_if_needed(self: Modules) {
        if (self.modules == null) {
            self.modules = StrHashMap.construct();
        }
    }

    fn init_global_namespace(self: Modules) {
        if (self.global_namespace == null) {
            self.global_namespace = Namespace.construct("", null);

            from type_base import Type
            self.global_namespace->declare_var("assert", "__ketl_rt.assert", Types.instance->get_function_type(
                Type[2] {
                    Types.instance.type_void,
                    Types.instance.type_bool
                }
            ), true);
        }
    }

    shared instance = construct();

    export fn load(self: Modules, module_name: str, folder_path: str, namespace: Namespace, exxport: bool) => Module {
        self->init_modules_if_needed();
        self->init_global_namespace();

        var module_filename = module_name .. ".ktl";

        var modules_size = self.modules.size;
        var module_bucket = self.modules->get_or_insert(module_name, null);
        // old insert
        if (modules_size == self.modules.size) {
            var module = module_bucket.value$cast(Module);
            module->preload(module_filename, folder_path, namespace, exxport);
            return module;
        }

        var top_loading = !self.loading_modules;
        self.loading_modules = true;

        var module = Module.construct(module_name, self.global_namespace);
        module_bucket.value = module;

        // preloading
        if (!module->preload(module_filename, folder_path, namespace, exxport)) {
            self.modules->erase(module_bucket);
            return null;
        }

        // load will be done later in bulk
        if (!top_loading) {
            return module;
        }

        // postloading everything
        for (var tmp_bucket <- self.modules.buckets) {
            while (tmp_bucket != null) {
                var tmp_module = tmp_bucket.value$cast(Module);
                if (tmp_module.header_loaded && !tmp_module.body_loaded) {
                    tmp_module->load();
                }
                tmp_bucket = tmp_bucket.next;
            }
        }

        self.loading_modules = false;

        return module;
    }

}