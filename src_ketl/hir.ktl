//🫖ketl

from type import Type

from token import Token

export class HIR {

    enum Tag : u16 {
        NONE_STMT,

        LOGICAL_NOT,

        PLUS,
        MINUS,

        MULTY,
        IMULTY,
        DIVIDE,
        IDIVIDE,
        MOD,
        IMOD,

        BITWISE_AND,
        BITWISE_OR,
        BITWISE_XOR,

        COMPARE,
        TEST,

        EQUAL,
        NOT_EQUAL,
        LESS,
        ILESS,
        LESS_OR_EQUAL,
        ILESS_OR_EQUAL,
        GREATER,
        IGREATER,
        GREATER_OR_EQUAL,
        IGREATER_OR_EQUAL,

        ASSIGN,

        CALL_VOID,
        CALL,

        NEW_CLASS,
        NEW_ARRAY,
        NEW_SLICE,

        APPEND_VALUE,

        JUMP,

        JUMP_IF_TRUE,
        JUMP_IF_FALSE,
        
        JUMP_IF_EQUAL,
        JUMP_IF_NOT_EQAUL,
        JUMP_IF_LESS,
        JUMP_IF_ILESS,
        JUMP_IF_LESS_OR_EQAUL,
        JUMP_IF_ILESS_OR_EQAUL,
        JUMP_IF_GREATER,
        JUMP_IF_IGREATER,
        JUMP_IF_GREATER_OR_EQAUL,
        JUMP_IF_IGREATER_OR_EQAUL,

        RETURN,
        RETURN_VALUE,
    }

    export fn is_terminator(tag : Tag) => bool {
        return tag >= Tag.JUMP;
    }

    export mimic InstrOffset = u32;
    export mimic VarId = u16;
    export mimic VarInfoId = u16;
    export mimic BlockId = u16;
    export mimic ConstId = u16;

////////////////////////////

    export class SrcInfo {
        export mimic Length = u32;

        var source_offset : Token.Offset;
        var length : Length;

        export fn construct(source_offset : Token.Offset, length : Length) => SrcInfo {
            var self = SrcInfo();
            self.source_offset = source_offset;
            self.length = length;
            return self;
        }

        export fn construct_token(token: Token) => SrcInfo {
            var self = SrcInfo();
            self.source_offset = token.offset;
            self.length = token.length;
            return self;
        }

        export fn construct_merge(lhs: SrcInfo, rhs: SrcInfo) => SrcInfo {
            var self = SrcInfo();
            self.source_offset = lhs.source_offset;
            self.length = rhs->get_end_offset() - lhs.source_offset;
            return self;
        }

        export fn get_end_offset(self: SrcInfo) => Token.Offset {
            return self.source_offset + self.length;
        }
    }

    export class Instr {
        var tag : Tag;
        var src_info: SrcInfo;
    }

    export class InstrWithOutput {
        extend Instr;
        var output : VarId;
    }

    export class UnaryOp {
        extend InstrWithOutput;
        var arg : VarId;
    }

    export class BinaryOp {
        extend InstrWithOutput;
        var lhs : VarId;
        var rhs : VarId;
    }

    export class Call {
        extend InstrWithOutput;
        var callee : VarId;
        var args : VarId[];
    }

    export class CallVoid {
        extend Instr;
        var callee : VarId;
        var args : VarId[];
    }

    export class New {
        extend InstrWithOutput;
        var type : Type;
        var args : VarId[];
    }

    export class NewArray {
        extend InstrWithOutput;
        var type : Type;
        var size : VarId;
        var initial_value : ConstId;
    }

    export class NewSlice {
        extend InstrWithOutput;
        var mirrored : VarId;
        var start : VarId;
        var end : ConstId;
    }

    export class AppendValue {
        extend InstrWithOutput;
        var array : VarId;
        var value : VarId;
    }

    export class Assign {
        extend InstrWithOutput;
        var dst : VarId;
        var src : VarId;
    }

    export class Jump {
        extend Instr;
        var dst : BlockId;
    }

    export class JumpIf {
        extend Instr;
        var true_dst : BlockId;
        var false_dst : BlockId;
    }

    export class ReturnValue {
        extend Instr;
        var value : VarId;
    }

////////////////////////

    export class Var {
        export enum Kind : u8 {
            Regular,
            Literal,
            Cast,
            Global,
            Field,
            Parameter,
            Index,
        } 

        var kind : Kind;
        var type : Type;
        var src_info : SrcInfo;
    }

    export class VarCommon {
        extend Var;
        var info : VarInfoId;
    }

    export class VarLiteral {
        extend Var;
        var value : u64;
    }

    export class VarCast {
        extend Var;
        var casted : VarId;
    }

    export class VarInfo {
        // TODO namespace and namespace index
        var name : str;
        /*
        union {
            struct {
                ketl_namespace* p_namespace;
                uint32_t namespace_node_index;
            };
            ketl_hir_var_id_t parent_id;
        };
        union {
            ketl_hir_symbol_offset_t name;
            ketl_hir_var_id_t arg_id;
        };
        ketl_hir_var_id_t last_var_id;
        // TODO declaration info
        */
    }

    export class Const {
         var offset : u32;
         var size : u32;
         var name : str;
         var is_string : bool;
    }

    var instrs : Instr[];
    var vars : Var[];
    var vars_infos : VarInfo[];
    var block_offsets : InstrOffset[];
    var consts_infos : Const[];
    var consts : u8[];

    var return_type : Type;
    var parameters_count : u8;
    var max_call_arg_count : u8;

    fn format(hir : HIR) => str {
        // TODO
        return "";
    }
}
