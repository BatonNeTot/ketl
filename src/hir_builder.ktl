//🫖ketl

from common import StrHashMap
from common import FilePointer
from errors import ErrorsAccum

import io

from type_base import Type
from type import Types
from type import TypePrimitive
from type import TypeEnum
from type import TypeFunction
from type import TypeArray
from type import TypeClass
from value import Value

from hir import HIR

from namespace import Namespace

class HIRBuilder {
    errors_accum: ErrorsAccum;
    source_info: ErrorsAccum.SourceInfo;

    blocks: HIR.Instr[][];
    vars: HIR.Var[];
    decls: HIR.Decl[];
    consts_infos: HIR.Const[];
    consts_literals: u8[];

    current_block: u32;
    parameters_counter: u32;
    func_index: u16;
    max_call_arg_count: u8;
    entry: str;
    entry_info: HIR.SrcInfo;

    temp_counter: u32;
    string_literal_counter: HIR.ConstId;
    numeric_literal_counter: HIR.ConstId;

    return_type: Type;
    local_map_stack: StrHashMap[];
    global_map_stack: StrHashMap[];

    namespace: Namespace;
    exxport: bool;
    cexxport: bool;
    shhared: bool;

    export fn construct(return_type: Type, func_index: u16, errors_accum: ErrorsAccum, source_info: ErrorsAccum.SourceInfo, is_global: bool) => HIRBuilder {
        self := HIRBuilder();

        self.errors_accum = errors_accum;
        self.source_info = source_info;

        self.blocks = HIR.Instr[][1]{ HIR.Instr[0] };
        self.vars = HIR.Var[0];
        self.decls = HIR.Decl[0];
        self.consts_infos = HIR.Const[0];
        self.consts_literals = u8[0];

        if (is_global) {
            self.local_map_stack = StrHashMap[0];
        } else {
            self.local_map_stack = StrHashMap[1]{
                StrHashMap.construct()
            };
        }
        self.global_map_stack = StrHashMap[1]{
            StrHashMap.construct()
        };

        self.return_type = return_type;
        self.func_index = func_index;
        self.max_call_arg_count = (-1)$cast(u8);

        return self;
    }

    fn error_type(self: HIRBuilder, type: ErrorsAccum.Error, offset: u32, length: u32, message: str) => u64 {
        return self.errors_accum->error(
            type,
            self.source_info,
            FilePointer.construct(offset, offset, length),
            message 
        );
    }

    fn error(self: HIRBuilder, offset: u32, length: u32, message: str) {
        self->error_type(
            ErrorsAccum.Error.Nonspecific,
            offset,
            length,
            message 
        );
    }
    
    export fn reserve_blocks(self: HIRBuilder, count: u32) => HIR.BlockId {
        first_block := self.blocks.size$cast(HIR.BlockId);
        while (count > 0) {
            self.blocks ..= HIR.Instr[0];
            count -= 1;
        }
        return first_block;
    }
    export fn set_block(self: HIRBuilder, block: HIR.BlockId) {
        self.current_block = block;
    }

    export fn get_current_block(self: HIRBuilder) => HIR.BlockId {
        return self.current_block$cast(HIR.BlockId);
    }

    fn get_current_block_instrs(self: HIRBuilder) => HIR.Instr[] {
        return self.blocks[self.current_block];
    }

    fn append_instr(self: HIRBuilder, instr: HIR.Instr) {
        self->get_current_block_instrs() ..= instr;
        self->on_append(instr);
    }

    fn on_append(self: HIRBuilder, instr: HIR.Instr) {
        switch (instr.tag) {
            case HIR.Tag.CALL => self->on_call(instr$cast(HIR.Call).args.size);
            case HIR.Tag.NEW_CLASS => self->on_call(1);
            case HIR.Tag.NEW_ARRAY => self->on_call(4);
            case HIR.Tag.NEW_SLICE => self->on_call(3);
            case HIR.Tag.GET_ARRAY_VALUE => self->on_call(3);
            case HIR.Tag.SET_ARRAY_VALUE => self->on_call(4);
            case HIR.Tag.APPEND_VALUE => self->on_call(3);
            case HIR.Tag.APPEND_ARRAY => self->on_call(3);
        }
    }

    fn on_call(self: HIRBuilder, arguments_count: u64) {
        if (self.max_call_arg_count == (-1)$cast(u8) || arguments_count > self.max_call_arg_count) {
            self.max_call_arg_count = arguments_count$cast(u8);
        }
    }

    fn is_undef(self: HIRBuilder, var_id: HIR.VarId) => bool {
        if (var_id == (-1)$cast(HIR.VarId)) {
            return true;
        }

        varr := self.vars[var_id];

        if (varr.kind == HIR.Var.Kind.Error) {
            return true;
        }

        if (varr.kind != HIR.Var.Kind.Common) {
            return false;
        }

        decl_id := varr$cast(HIR.VarCommon).decl;
        decl := self.decls[decl_id];
        return decl.kind == HIR.Decl.Kind.Error;
    }

    fn get_common_type(self: HIRBuilder, lhs_id: HIR.VarId, rhs_id: HIR.VarId) => Type {
        lhs := self.vars[lhs_id];
        rhs := self.vars[rhs_id];

        lhs_type := lhs->get_type();
        rhs_type := rhs->get_type();

        assert(lhs_type != null || lhs.kind == HIR.Var.Kind.Literal);
        assert(rhs_type != null || rhs.kind == HIR.Var.Kind.Literal);

        is_lhs_integer := 
            lhs.kind == HIR.Var.Kind.Literal || 
            (lhs_type.kind == Type.Kind.Primitive && lhs_type$cast(TypePrimitive).integer) || 
            lhs_type.kind == Type.Kind.Enum;
        is_rhs_integer := 
            rhs.kind == HIR.Var.Kind.Literal || 
            (rhs_type.kind == Type.Kind.Primitive && rhs_type$cast(TypePrimitive).integer) || 
            rhs_type.kind == Type.Kind.Enum;

        if (is_lhs_integer || is_rhs_integer) {
            if (lhs_type != null && rhs_type != null) {
                return Types.get_common_type(lhs_type, rhs_type);
            }

            if (lhs_type == null && rhs_type == null) {
                // result type definitely will be big enough for both types
                return Types.get_common_type(lhs->get_type_forced(), rhs->get_type_forced());
            }
            // TODO check if other literal can be stored in the selected literal type
            if (lhs_type != null) {
                return lhs_type;
            } else {
                return rhs_type;
            }
        }

        return Types.get_common_type(lhs_type, rhs_type);
    }

    export fn try_cast_to_type(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo, explicit: bool) => HIR.VarId {
        return self->cast_to_type(var_id, target_type, src_info, explicit, false);
    }

    export fn cast_to_type_forced(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo, explicit: bool) => HIR.VarId {
        return self->cast_to_type(var_id, target_type, src_info, explicit, true);
    }

    fn cast_to_type(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo, explicit: bool, forced: bool) => HIR.VarId {
        if (target_type == null) {
            if (forced) {
                self->error(src_info.source_offset, src_info.length, "null target type.");
                return self->push_empty_error_var(src_info);
            } else {
                return (-1)$cast(HIR.VarId);
            }
        }

        if (self->is_undef(var_id)) {
            if (forced) {
                return self->push_empty_error_var(src_info);
            } else {
                return (-1)$cast(HIR.VarId);
            }
        }

        varr := self.vars[var_id];

        type := varr->get_type();

        if (type == null) {
            if (varr.kind == HIR.Var.Kind.Literal) {
                literal := varr$cast(HIR.VarLiteral);
                if (target_type.kind == Type.Kind.Primitive) {
                    literal.type = target_type;
                    return var_id;
                } 

                if (target_type.kind == Type.Kind.Enum) {
                    if (!explicit) {
                        if (forced) {
                            self->error(src_info.source_offset, src_info.length, "Can't implicitly cast integer literal to enum '" .. target_type->get_name() .. "'.");
                            return self->push_empty_error_var(src_info);
                        } else {
                            return (-1)$cast(HIR.VarId);
                        }
                    }
                    literal.type = target_type;
                    return var_id;
                }

                if (target_type == Types.instance->get_str_type()$cast(Type)) {
                    if (!explicit) {
                        if (forced) {
                            self->error(src_info.source_offset, src_info.length, "Can't implicitly cast literal number to str.");
                            return self->push_empty_error_var(src_info);
                        } else {
                            return (-1)$cast(HIR.VarId);
                        }
                    }

                    return self->push_new_string_literal(literal.value$cast(str), src_info);
                }
            }

            if (forced) {
                self->error(src_info.source_offset, src_info.length, "Can't cast an expression of undefined type number to '" .. target_type->get_name() .. "'.");
                return self->push_empty_error_var(src_info);
            } else {
                return (-1)$cast(HIR.VarId);
            }
        }

        if (Types.is_types_equal(type, target_type)) {
            return var_id;
        }

        if (type->is_pointer_kind() && target_type == Types.instance.type_raw$cast(Type) ||
            target_type->is_pointer_kind() && type == Types.instance.type_raw$cast(Type)) {
            return self->push_casted_var(var_id, target_type, src_info);
        }

        if (type.kind == Type.Kind.Primitive || type.kind == Type.Kind.Enum) {
            if (target_type.kind == Type.Kind.Primitive || target_type.kind == Type.Kind.Enum) {
                to_enum := false;
                lhs_type_primitive := target_type$cast(TypePrimitive);
                rhs_type_primitive := type$cast(TypePrimitive);

                if (lhs_type_primitive.kind == Type.Kind.Enum) {
                    to_enum = true;
                    lhs_type_primitive = lhs_type_primitive$cast(Type)$cast(TypeEnum).parent;
                }
                if (rhs_type_primitive.kind == Type.Kind.Enum) {
                    rhs_type_primitive = rhs_type_primitive$cast(Type)$cast(TypeEnum).parent;
                }

                if ((to_enum || rhs_type_primitive.size > lhs_type_primitive.size || rhs_type_primitive.signed != lhs_type_primitive.signed) && !explicit) {
                    if (forced) {
                        self->error(src_info.source_offset, src_info.length, "Can't cast type '" .. 
                            type->get_name() .. "' to type '" .. target_type->get_name() .. "' implicitly.");
                        return self->push_empty_error_var(src_info);
                    } else {
                        return (-1)$cast(HIR.VarId);
                    }
                }

                return self->push_casted_var(var_id, target_type, src_info);
            }

            if (target_type == Types.instance->get_str_type()$cast(Type)) {
                if (!explicit) {
                    if (forced) {
                        self->error(src_info.source_offset, src_info.length, "Can't implicitly cast primitive '" .. type->get_name() .. "' to str.");
                        return self->push_empty_error_var(src_info);
                    } else {
                        return (-1)$cast(HIR.VarId);
                    }
                }

                func_name: str;
                arg_type: Type;
                if (type->is_signed()) {
                    func_name = "__ketl_rt.int2str";
                    arg_type = Types.instance.type_i64;
                } else {
                    func_name = "__ketl_rt.uint2str";
                    arg_type = Types.instance.type_u64;
                }
                return self->push_call(self->push_arbitrary_global_var(
                    func_name, 
                    Types.instance->get_function_type(Type[2]{
                        Types.instance->get_str_type(),
                        arg_type,
                    }), 
                    src_info), HIR.VarId[1]{ var_id }, src_info);
            }
        }

        if (type == Types.instance->get_str_type()$cast(Type) && target_type == Types.instance->get_cstr_type()$cast(Type)) {
            if (!explicit) {
                if (forced) {
                    self->error(src_info.source_offset, src_info.length, "Can't implicitly cast str to cstr.");
                    return self->push_empty_error_var(src_info);
                } else {
                    return (-1)$cast(HIR.VarId);
                }
            }
            
            return self->push_call(self->push_arbitrary_global_var(
                "__ketl_rt.str2cstr", 
                Types.instance->get_function_type(Type[2]{
                    Types.instance->get_cstr_type(),
                    Types.instance->get_str_type(),
                }), 
                src_info), HIR.VarId[1]{ var_id }, src_info);
        }

        if (type == Types.instance->get_str_type()$cast(Type) && target_type == Types.instance.type_u64$cast(Type)) {
            if (!explicit) {
                if (forced) {
                    self->error(src_info.source_offset, src_info.length, "Can't implicitly cast str to u64.");
                    return self->push_empty_error_var(src_info);
                } else {
                    return (-1)$cast(HIR.VarId);
                }
            }
            
            return self->push_call(self->push_arbitrary_global_var(
                "__ketl_rt.str2uint", 
                Types.instance->get_function_type(Type[2]{
                    Types.instance.type_u64,
                    Types.instance->get_str_type(),
                }), 
                src_info), HIR.VarId[1]{ var_id }, src_info);
        }

        if (type.kind == Type.Kind.Class && target_type.kind == Type.Kind.Class) {
            rhs_class_type := type$cast(TypeClass);
            lhs_class_type := target_type$cast(TypeClass);

            extended_offset := rhs_class_type->find_extended_class_offset(lhs_class_type);
            if (extended_offset >= 0) {
                // TODO align class
                assert(extended_offset == 0);
                return self->push_casted_var(var_id, target_type, src_info);
            }

            extended_offset = lhs_class_type->find_extended_class_offset(rhs_class_type);
            if (extended_offset >= 0) {
                if (!explicit) {
                    if (forced) {
                        self->error(src_info.source_offset, src_info.length, "Can't implicitly cast class '" .. rhs_class_type->get_name() .. "' to class '" .. lhs_class_type->get_name() .. "'.");
                        return self->push_empty_error_var(src_info);
                    } else {
                        return (-1)$cast(HIR.VarId);
                    }
                }

                // TODO align class
                assert(extended_offset == 0);
                return self->push_casted_var(var_id, target_type, src_info);
            }
        }
        
        if (forced) {
            self->error(src_info.source_offset, src_info.length, "Can't convert '" .. type->get_name() .. "' to '" .. target_type->get_name() .. "'.");
            return self->push_empty_error_var(src_info);
        } else {
            return (-1)$cast(HIR.VarId);
        }
    }

    export fn push_tagonly_instr(self: HIRBuilder, tag: HIR.Tag, src_info: HIR.SrcInfo) {
        instr := HIR.Instr();
        instr.tag = tag;
        instr.src_info = src_info;
        self->append_instr(instr);
    }

    export fn push_variable_op(self: HIRBuilder, tag: HIR.Tag, name: str, src_info: HIR.SrcInfo) {
        instr := HIR.VariableOp();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.name = name;
        self->append_instr(instr);
    }

    export fn push_jump(self: HIRBuilder, target: HIR.BlockId, src_info: HIR.SrcInfo) => HIR.Jump {
        instr := HIR.Jump();
        instr.tag = HIR.Tag.JUMP;
        instr.src_info = src_info;
        instr.dst = target;
        self->append_instr(instr);

        return instr;
    }

    export fn push_jump_if(self: HIRBuilder, bool_expr_var: HIR.VarId, true_statement: HIR.BlockId, false_statement: HIR.BlockId, src_info: HIR.SrcInfo) => HIR.JumpIf {
        // TODO check casting

        instr := HIR.JumpIf();
        instr.tag = HIR.Tag.JUMP_IF_TRUE; // TODO pick best
        instr.src_info = src_info;
        instr.expr = bool_expr_var;
        instr.true_dst = true_statement;
        instr.false_dst = false_statement;
        self->append_instr(instr);

        return instr;
    }
    
    export fn push_unary_op(self: HIRBuilder, tag: HIR.Tag, var_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(var_id)) {
            return self->push_empty_error_var(src_info);
        }

        varr := self.vars[var_id];
        type := varr->get_type_forced();
        // TODO deduce
        arg_type := type;
        output_type := type;
        switch (tag) {
            case HIR.Tag.LOGICAL_NOT => output_type = Types.instance.type_bool;
            case HIR.Tag.BITWISE_NOT
            case HIR.Tag.UNARY_PLUS => output_type = arg_type;
            case HIR.Tag.UNARY_MINUS => {
                if (arg_type.kind != Type.Kind.Primitive) {
                    io.errorln("Can't unary minus '" .. arg_type->get_name() .. "' in '" .. self.source_info.filename .. "' at " .. src_info.source_offset$cast(str) .. ".");
                    assert(false);
                }
                output_type = arg_type$cast(TypePrimitive)->get_signed();
            }
        }

        arg_src_info := self.vars[var_id].src_info;
        var_id = self->cast_to_type_forced(var_id, arg_type, arg_src_info, false);

        instr := HIR.UnaryOp();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(output_type, instr);
        instr.arg = var_id;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_binary_op(self: HIRBuilder, tag: HIR.Tag, lhs_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(lhs_id) || self->is_undef(rhs_id)) {
            return self->push_empty_error_var(src_info);
        }

        // TODO check if both literals and calc

        common_type := self->get_common_type(lhs_id, rhs_id);

        if (common_type == null) {
            lhs := self.vars[lhs_id];
            rhs := self.vars[rhs_id];

            lhs_type := lhs->get_type_forced();
            rhs_type := rhs->get_type_forced();

            // special case for pointer arithmetic
            if ((tag == HIR.Tag.PLUS || tag == HIR.Tag.MINUS) && 
                (lhs_type == Types.instance.type_raw$cast(Type) && rhs_type.kind == Type.Kind.Primitive && rhs_type$cast(TypePrimitive).numeric ||
                rhs_type == Types.instance.type_raw$cast(Type) && lhs_type.kind == Type.Kind.Primitive && lhs_type$cast(TypePrimitive).numeric)) {
                
                instr := HIR.BinaryOp();
                instr.tag = tag;
                instr.src_info = src_info;
                instr.output = self->push_instr_result_var(Types.instance.type_raw, instr);
                instr.lhs = lhs_id;
                instr.rhs = rhs_id;
                self->append_instr(instr);

                return instr.output;
            }

            self->error(src_info.source_offset, src_info.length, "Can't do operator '" .. HIR.get_str_representation(tag) .. "' over '" 
                .. lhs_type->get_name() .. "' and '" .. rhs_type->get_name() .. "'.");
            return self->push_empty_error_var(src_info);
        }

        // TODO deduce
        arg_type := common_type;
        output_type := common_type;
        switch (tag) {
            case HIR.Tag.LESS
            case HIR.Tag.LESS_OR_EQUAL
            case HIR.Tag.GREATER
            case HIR.Tag.GREATER_OR_EQUAL
            case HIR.Tag.EQUAL
            case HIR.Tag.NOT_EQUAL
                => output_type = Types.instance.type_bool;
        }

        {
            lhs := self.vars[lhs_id];
            lhs_src_info := lhs.src_info;
            if (lhs.kind == HIR.Var.Kind.Literal && lhs->get_type() == null && arg_type.kind == Type.Kind.Enum) {
                // if literal used in expression with Enum and was not specified yet, will allow implicit cast by passing parent Primitive
                lhs_id = self->cast_to_type_forced(lhs_id, arg_type$cast(TypeEnum).parent, lhs_src_info, false);
            } else {
                lhs_id = self->cast_to_type_forced(lhs_id, arg_type, lhs_src_info, false);
            }
            
            rhs := self.vars[rhs_id];
            rhs_src_info := rhs.src_info;
            if (rhs.kind == HIR.Var.Kind.Literal && rhs->get_type() == null && arg_type.kind == Type.Kind.Enum) {
                // if literal used in expression with Enum and was not specified yet, will allow implicit cast by passing parent Primitive
                rhs_id = self->cast_to_type_forced(rhs_id, arg_type$cast(TypeEnum).parent, rhs_src_info, false);
            } else {
                rhs_id = self->cast_to_type_forced(rhs_id, arg_type, rhs_src_info, false);
            }
        }

        if (common_type.kind == Type.Kind.Array &&
            (tag == HIR.Tag.EQUAL || tag == HIR.Tag.NOT_EQUAL)) {
            return self->push_array_equality(tag, lhs_id, rhs_id, common_type$cast(TypeArray), src_info);
        }

        instr := HIR.BinaryOp();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(output_type, instr);
        instr.lhs = lhs_id;
        instr.rhs = rhs_id;
        self->append_instr(instr);

        return instr.output;
    }

    fn push_array_equality(self: HIRBuilder, tag: HIR.Tag, lhs_id: HIR.VarId, rhs_id: HIR.VarId, common_type: TypeArray, src_info: HIR.SrcInfo) => HIR.VarId {
        output_id := self->push_temp_var_of_type(Types.instance.type_bool, src_info);

        first_block := self->reserve_blocks(7);
        init_loop_block := first_block + 0;
        check_length_block := first_block + 1;
        check_values_block := first_block + 2;
        inc_index_block := first_block + 3;
        res_not_equal_block := first_block + 4;
        res_equal_block := first_block + 5;
        after_block := first_block + 6;

        lhs_size_id := self->push_field_access_forced(lhs_id, "size", src_info);
        rhs_size_id := self->push_field_access_forced(rhs_id, "size", src_info);

        is_sizes_not_equal_id := self->push_binary_op(HIR.Tag.NOT_EQUAL, 
            lhs_size_id, 
            rhs_size_id, 
            src_info);
        self->push_jump_if(is_sizes_not_equal_id, res_not_equal_block, init_loop_block, src_info);

        self->set_block(init_loop_block);
        index_id := self->push_temp_var_of_type(Types.instance.type_u64, src_info);
        self->push_assign(HIR.Tag.ASSIGN, 
            index_id, 
            self->push_literal_number(0, src_info), 
            src_info);
        self->push_jump(check_length_block, src_info);

        self->set_block(check_length_block);
        is_index_less_size_id := self->push_binary_op(HIR.Tag.LESS, 
            index_id, 
            lhs_size_id, 
            src_info);
        self->push_jump_if(is_index_less_size_id, check_values_block, res_equal_block, src_info);
        
        self->set_block(check_values_block);
        is_values_not_equal_id := self->push_binary_op(HIR.Tag.NOT_EQUAL, 
            self->push_get_array_value(lhs_id, index_id, src_info), 
            self->push_get_array_value(rhs_id, index_id, src_info), 
            src_info);
        self->push_jump_if(is_values_not_equal_id, res_not_equal_block, inc_index_block, src_info);

        self->set_block(inc_index_block);
        self->push_assign(HIR.Tag.ASSIGN_PLUS, 
            index_id, 
            self->push_literal_number(1, src_info), 
            src_info);
        self->push_jump(check_length_block, src_info);


        // TODO allow explicit cast from bool to int
        not_equal_literal_value: u8;
        equal_literal_value: u8;
        if (tag == HIR.Tag.NOT_EQUAL) {
            not_equal_literal_value = 1;
        } else {
            equal_literal_value = 1;
        }

        self->set_block(res_not_equal_block);
        self->push_assign(HIR.Tag.ASSIGN, 
            output_id, 
            self->push_literal_number(not_equal_literal_value, src_info), 
            src_info);
        self->push_jump(after_block, src_info);

        self->set_block(res_equal_block);
        self->push_assign(HIR.Tag.ASSIGN, 
            output_id, 
            self->push_literal_number(equal_literal_value, src_info), 
            src_info);
        self->push_jump(after_block, src_info);

        self->set_block(after_block);

        return output_id;
    }
    
    export fn push_assign(self: HIRBuilder, tag: HIR.Tag, lhs_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(rhs_id)) {
            return self->push_empty_error_var(src_info);
        }
        
        // Checking if left value is a variable in the process of declaration
        if (self->is_undef(lhs_id)) {
            if (lhs_id >= self.vars.size) {
                return self->push_empty_error_var(src_info);
            }

            if (!self->check_error_var(lhs_id, ErrorsAccum.Error.UndefinedDeclaredId)) {
                return self->push_empty_error_var(src_info);
            }

            type := self.vars[rhs_id]->get_type_forced();
            if (type == null) {
                src_info := self.vars[lhs_id].src_info;
                self->error(src_info.source_offset, src_info.length, "Can't deduce type for var declaration.");
                return self->push_empty_error_var(src_info);
            } 
            
            if (!self->declare_var_from_var_id(lhs_id, type, self.vars[lhs_id].src_info)) {
                return self->push_empty_error_var(src_info);
            }
        }

        // Checking if 'get array value' must be promoted to 'set array value'
        if (self->is_get_array_value(lhs_id)) {
            if (tag == HIR.Tag.ASSIGN) {
                return self->promote_to_set_array_value(lhs_id, rhs_id, src_info);
            } else {
                assert(false);
            }
        }

        lhs := self.vars[lhs_id];
        type := lhs->get_type_forced();
        rhs_src_info := self.vars[rhs_id].src_info;
        rhs_id = self->cast_to_type_forced(rhs_id, type, rhs_src_info, false);

        if (self->is_undef(rhs_id)) {
            return self->push_empty_error_var(src_info);
        }

        instr := HIR.Assign();
        instr.tag = tag;
        instr.src_info = src_info;
        instr.dst = lhs_id;
        instr.src = rhs_id;
        self->append_instr(instr);

        // TODO return new var to update src_info
        return instr.dst;
    }

    export fn push_call(self: HIRBuilder, callee_id: HIR.VarId, arguments: HIR.VarId[], src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(callee_id)) {
            return self->push_empty_error_var(src_info);
        }

        callee := self.vars[callee_id];
        type := callee->get_type_forced();

        if (type.kind != Type.Kind.Function && type.kind != Type.Kind.CFunction) {
            self->error(src_info.source_offset, src_info.length, "Only functions can be called.");
            return self->push_empty_error_var(src_info);
        }
        function_type := type$cast(TypeFunction);
        function_signature := function_type.signature;

        if (function_signature.parameters.size - 1 != arguments.size) {
            self->error(src_info.source_offset, src_info.length, "Arguments count does not match function parameters count: " .. arguments.size$cast(str) .. " instead of " .. (function_signature.parameters.size - 1)$cast(str) .. ".");
            return self->push_empty_error_var(src_info);
        }

        return_type := function_signature.parameters[0];

        i: u64 = 0;
        while (i < arguments.size) {
            arg_id := arguments[i];
            arg := self.vars[arg_id];
            parameter_type := function_signature.parameters[i + 1];
            arg_id = self->cast_to_type_forced(arg_id, parameter_type, arg.src_info, false);

            if (self->is_undef(arg_id)) {
                return self->push_empty_error_var(src_info);
            }

            arguments[i] = arg_id;
            i += 1;
        }
        
        instr := HIR.Call();
        instr.tag = HIR.Tag.CALL;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(return_type, instr);
        instr.callee = callee_id;
        instr.args = arguments;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_new(self: HIRBuilder, callee_type: Type, arguments: HIR.VarId[], src_info: HIR.SrcInfo) => HIR.VarId {
        instr := HIR.New();
        instr.tag = HIR.Tag.NEW_CLASS;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(callee_type, instr);
        instr.type = callee_type;
        instr.args = arguments;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_new_array(self: HIRBuilder, array_type: TypeArray, size: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_new_array_and_init(array_type, size, (-1)$cast(HIR.ConstId), src_info);
    }
    
    export fn push_new_array_and_init(self: HIRBuilder, array_type: TypeArray, size: HIR.VarId, initial_value: HIR.ConstId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(size)) {
            return self->push_empty_error_var(src_info);
        }
        // TODO check types

        instr := HIR.NewArray();
        instr.tag = HIR.Tag.NEW_ARRAY;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(array_type, instr);
        instr.type = array_type.value;
        instr.size = size;
        instr.initial_value = initial_value;
        self->append_instr(instr);

        return instr.output;
    }
    
    export fn push_new_slice(self: HIRBuilder, array_id: HIR.VarId, start_id: HIR.VarId, end_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(start_id) || self->is_undef(end_id)) {
            return self->push_empty_error_var(src_info);
        }
        // TODO check types

        array := self.vars[array_id];
        array_type := array->get_type_forced()$cast(TypeArray);
        assert(array_type.kind == Type.Kind.Array);
        
        instr := HIR.NewSlice();
        instr.tag = HIR.Tag.NEW_SLICE;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(array_type, instr);
        instr.mirrored = array_id;
        instr.start = start_id;
        instr.end = end_id;
        self->append_instr(instr);

        return instr.output;
    }

    export fn push_get_array_value(self: HIRBuilder, array_id: HIR.VarId, index_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(index_id)) {
            return self->push_empty_error_var(src_info);
        }
        // TODO check types

        array := self.vars[array_id];
        array_type := array->get_type_forced()$cast(TypeArray);
        if (array_type.kind != Type.Kind.Array) {
            self->error(src_info.source_offset, src_info.length, "Can't index entity of type '" .. array_type->get_name() .. "'.");
            return self->push_empty_error_var(src_info);
        }
        value_type := array_type.value;

        index_id = self->cast_to_type_forced(index_id, Types.instance.type_u64, src_info, true);

        instr := HIR.GetArrayValue();
        instr.tag = HIR.Tag.GET_ARRAY_VALUE;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(value_type, instr);
        instr.array = array_id;
        instr.index = index_id;
        self->append_instr(instr);

        return instr.output;
    }

    export fn push_set_array_value(self: HIRBuilder, array_id: HIR.VarId, index_id: HIR.VarId, value_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(index_id) || self->is_undef(value_id)) {
            return self->push_empty_error_var(src_info);
        }
        // TODO check types

        array := self.vars[array_id];
        array_type := array->get_type_forced()$cast(TypeArray);
        if (array_type.kind != Type.Kind.Array) {
            self->error(src_info.source_offset, src_info.length, "Can't index entity of type '" .. array_type->get_name() .. "'.");
            return self->push_empty_error_var(src_info);
        }
        value_type := array_type.value;

        index_id = self->cast_to_type_forced(index_id, Types.instance.type_u64, src_info, true);
        
        value_src_info := self.vars[value_id].src_info;
        value_id = self->cast_to_type_forced(value_id, value_type, value_src_info, false);

        instr := HIR.SetArrayValue();
        instr.tag = HIR.Tag.SET_ARRAY_VALUE;
        instr.src_info = src_info;
        instr.output = self->push_instr_result_var(value_type, instr);
        instr.array = array_id;
        instr.index = index_id;
        instr.value = value_id;
        self->append_instr(instr);

        return instr.output;
    }

    export fn is_get_array_value(self: HIRBuilder, value_id: HIR.VarId) => bool {
        value := self.vars[value_id]$cast(HIR.VarCommon);
        if (value.kind != HIR.Var.Kind.Common) {
            return false;
        }

        decl := self.decls[value.decl]$cast(HIR.DeclInstrResult);
        if (decl.kind != HIR.Decl.Kind.InstrResult) {
            return false;
        }

        return decl.instr.tag == HIR.Tag.GET_ARRAY_VALUE;
    }

    export fn promote_to_set_array_value(self: HIRBuilder, output_id: HIR.VarId, value_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(value_id)) {
            return self->push_empty_error_var(src_info);
        }

        output := self.vars[output_id]$cast(HIR.VarCommon);
        assert(output.kind == HIR.Var.Kind.Common);

        decl := self.decls[output.decl]$cast(HIR.DeclInstrResult);
        assert(decl.kind == HIR.Decl.Kind.InstrResult);

        old_instr := decl.instr$cast(HIR.GetArrayValue);
        assert(old_instr.tag == HIR.Tag.GET_ARRAY_VALUE);

        block := self->get_current_block_instrs();
        i := block.size;
        while (i > 0) {
            i -= 1;

            if (block[i] == old_instr$cast(HIR.Instr)) {
                break;
            }
        }

        // i will be (-1)$cast(u64), so u64$max;
        assert(i < block.size);

        type := output->get_type_forced();
        value_src_info := self.vars[value_id].src_info;
        value_id = self->cast_to_type_forced(value_id, type, value_src_info, false);

        instr := HIR.SetArrayValue();
        instr.tag = HIR.Tag.SET_ARRAY_VALUE;
        instr.src_info = old_instr.src_info;
        instr.output = old_instr.output;
        instr.array = old_instr.array;
        instr.index = old_instr.index;
        instr.value = value_id;

        block[i] = instr;
        decl.instr = instr;
        self->on_append(instr);

        return instr.output;
    }

    export fn push_append(self: HIRBuilder, array_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(array_id) || self->is_undef(rhs_id)) {
            return self->push_empty_error_var(src_info);
        }

        array := self.vars[array_id];
        array_type := array->get_type_forced()$cast(TypeArray);
        if (array_type.kind != Type.Kind.Array) {
            self->error(src_info.source_offset, src_info.length, "Can't append to '" .. array_type->get_name() .. "'.");
            return self->push_empty_error_var(src_info);
        }

        instr := HIR.Append();
        instr.src_info = src_info;
        instr.array = array_id;
        instr.appendee = rhs_id;

        rhs := self.vars[rhs_id];
        rhs_type := rhs->get_type_forced();

        rhs_id = self->try_cast_to_type(rhs_id, array_type.value, src_info, false);
        if (!self->is_undef(rhs_id)) {
            instr.appendee = rhs_id;
            instr.tag = HIR.Tag.APPEND_VALUE;
        } else if (array_type$cast(Type) == rhs_type) {
            instr.tag = HIR.Tag.APPEND_ARRAY;
        } else {
            self->error(src_info.source_offset, src_info.length, "Can't append '" .. rhs_type->get_name() .. "' to '" .. array_type->get_name() .. "'.");
            return self->push_empty_error_var(src_info);
        }

        self->append_instr(instr);

        return array_id;
    }

    export fn push_concat(self: HIRBuilder, lhs_id: HIR.VarId, rhs_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        if (self->is_undef(lhs_id) || self->is_undef(rhs_id)) {
            return self->push_empty_error_var(src_info);
        }

        lhs := self.vars[lhs_id];
        rhs := self.vars[rhs_id];

        lhs_type := lhs->get_type_forced();
        rhs_type := rhs->get_type_forced();

        common_array_type: TypeArray;
        size_id := self->push_literal_number_of_type(0, Types.instance.type_u64, src_info);

        if (lhs_type.kind == Type.Kind.Array) {
            if (rhs_type.kind == Type.Kind.Array) {
                if (lhs_type != rhs_type) {
                    self->error(src_info.source_offset, src_info.length, "Can't concat '" .. lhs_type->get_name() .. "' and '" .. rhs_type->get_name() .. "'.");
                    return self->push_empty_error_var(src_info);
                }

                common_array_type = lhs_type$cast(TypeArray);
                /*
                size_id = self->push_temp_var_of_type(Types.instance.type_u64, src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN, size_id, 
                    self->push_field_access_forced(lhs_id, "size", src_info),
                    src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN_PLUS, size_id, 
                    self->push_field_access_forced(rhs_id, "size", src_info),
                    src_info);
                    */
            } else {
                rhs_id = self->cast_to_type_forced(rhs_id, lhs_type$cast(TypeArray).value, src_info, false);
                if (self->is_undef(rhs_id)) {
                    return self->push_empty_error_var(src_info);
                }

                common_array_type = lhs_type$cast(TypeArray);
                /*
                size_id = self->push_temp_var_of_type(Types.instance.type_u64, src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN, size_id, 
                    self->push_literal_number(1, src_info),
                    src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN_PLUS, size_id, 
                    self->push_field_access_forced(lhs_id, "size", src_info),
                    src_info);
                    */
            }
        } else {
            if (rhs_type.kind == Type.Kind.Array) {
                lhs_id = self->cast_to_type_forced(lhs_id, rhs_type$cast(TypeArray).value, src_info, false);
                if (self->is_undef(lhs_id)) {
                    return self->push_empty_error_var(src_info);
                }

                common_array_type = rhs_type$cast(TypeArray);
                /*
                size_id = self->push_temp_var_of_type(Types.instance.type_u64, src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN, size_id, 
                    self->push_literal_number(1, src_info),
                    src_info);
                size_id = self->push_assign(HIR.Tag.ASSIGN_PLUS, size_id, 
                    self->push_field_access_forced(rhs_id, "size", src_info),
                    src_info);
                    */
            } else {
                common_type := self->get_common_type(lhs_id, rhs_id);

                lhs_id = self->cast_to_type_forced(lhs_id, common_type, src_info, false);
                rhs_id = self->cast_to_type_forced(rhs_id, common_type, src_info, false);
                if (self->is_undef(lhs_id) || self->is_undef(lhs_id)) {
                    return self->push_empty_error_var(src_info);
                }
                
                common_array_type = Types.instance->get_array_type(common_type);
                /*
                size_id = self->push_literal_number_of_type(2, Types.instance.type_u64, src_info);
                */
            }
        }
        
        array_id := self->push_new_array(common_array_type, size_id, src_info);

        array_id = self->push_append(array_id, lhs_id, src_info);
        array_id = self->push_append(array_id, rhs_id, src_info);

        return array_id;
    }

    fn push_new_string_literal(self: HIRBuilder, string: str, src_info: HIR.SrcInfo) => HIR.VarId {
        size := string.size;

        initial_value := (-1)$cast(HIR.ConstId);
        if (string.size > 0) {
            initial_value = self->push_string_const(string);
            size = self.consts_infos[initial_value].mem_size;
        }

        size_id := self->push_literal_number(size, src_info);

        return self->push_new_array_and_init(Types.instance->get_str_type(), size_id, initial_value, src_info);
    }

    fn push_string_const(self: HIRBuilder, string: str) => HIR.ConstId {
        const_id := self.consts_infos.size$cast(HIR.ConstId);
        const_offset := self.consts_literals.size$cast(u32);

        self.consts_literals ..= u8[string.size];

        escape_characters_count: u32;
        i: u32;
        while (i < string.size) {
            if (string[i] == '\\') {
                escape_characters_count += 1;

                self.consts_literals[const_offset + i] = string[i]$cast(u8);
                i += 1;

                if (i >= string.size) {
                    break;
                }
            }

            self.consts_literals[const_offset + i] = string[i]$cast(u8);
            i += 1;
        }

        const := HIR.Const();
        const.offset = const_offset;
        const.literal_size = string.size$cast(u32);
        const.mem_size = const.literal_size - escape_characters_count;
        const.name = ".L__const.str" .. self.func_index$cast(str) .. "_" .. self.string_literal_counter$cast(str);
        const.is_string = true;
        self.consts_infos ..= const;

        self.string_literal_counter += 1;

        return const_id;
    }

    export fn push_return_value(self: HIRBuilder, var_id: HIR.VarId, src_info: HIR.SrcInfo) {
        var_id = self->cast_to_type_forced(var_id, self.return_type, src_info, false);

        if (self->is_undef(var_id)) {
            return;
        }

        instr := HIR.ReturnValue();
        instr.tag = HIR.Tag.RETURN_VALUE;
        instr.src_info = src_info;
        instr.value = var_id;
        self->append_instr(instr);
    }

    export fn add_parameter(self: HIRBuilder, name: str, type: Type, src_info: HIR.SrcInfo) {
        bucket := self->find_decl_bucket(name);

        // if got not null - redefinition
        if (bucket != null) {
            // TODO error
            assert(false);
            return;
        }

        decl_id := self.decls.size$cast(HIR.DeclId);
        bucket = self->last_local_map()->get_or_insert(name, decl_id$cast(u64)$cast(raw));
        decl := HIR.DeclParameter();
        decl.kind = HIR.Decl.Kind.Parameter;
        decl.name = name;

        decl.type = type;
        decl.src_info = src_info;
        self.decls ..= decl;

        self.parameters_counter += 1;

        self->push_variable_op(HIR.Tag.ADD_LOCAL_VARIABLE, name, src_info);
    }

    export fn push_literal_number_of_type(self: HIRBuilder, value: u64, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        // TODO check if type big enough for a value

        literal_var_id := self.vars.size$cast(HIR.VarId);
        literal_var := HIR.VarLiteral();
        self.vars ..= literal_var;

        literal_var.kind = HIR.Var.Kind.Literal;
        literal_var.src_info = src_info;

        literal_var.type = type;
        literal_var.value = value;

        return literal_var_id;
    }

    export fn push_literal_number(self: HIRBuilder, value: u64, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_literal_number_of_type(value, null, src_info);
    }

    fn push_common_var(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo, decl_id: HIR.DeclId) => HIR.VarId {
        var_id := self.vars.size$cast(HIR.VarId);
        varr := HIR.VarCommon();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Common;
        varr.src_info = src_info;

        varr.type = type;
        varr.decl = decl_id;

        return var_id;
    }

    fn push_casted_var(self: HIRBuilder, var_id: HIR.VarId, target_type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        cast_var_id := self.vars.size$cast(HIR.VarId);
        cast_var := HIR.VarCast();
        self.vars ..= cast_var;

        cast_var.kind = HIR.Var.Kind.Cast;
        cast_var.src_info = src_info;

        cast_var.type = target_type;
        cast_var.casted = var_id;

        return cast_var_id;
    }

    fn generate_temp_name(self: HIRBuilder) => str {
        name := "~tmp" .. self.temp_counter$cast(str);
        self.temp_counter += 1;
        return name;
    }

    fn push_instr_result_var(self: HIRBuilder, type: Type, instr: HIR.Instr) => HIR.VarId {temp_decl_id := self.decls.size$cast(HIR.DeclId);
        decl_id := self.decls.size$cast(HIR.DeclId);
        decl := HIR.DeclInstrResult();
        decl.kind = HIR.Decl.Kind.InstrResult;

        decl.name = self->generate_temp_name();
        decl.type = type;
        decl.instr = instr;
        self.decls ..= decl;

        return self->push_common_var(type, instr.src_info, decl_id);
    }

    fn push_class_namespace_access(self: HIRBuilder, type: TypeClass, id: str, src_info: HIR.SrcInfo, forced: bool) => HIR.VarId {
        var_id := self->get_namespace_var(type.namespace, id, src_info, forced);
        if (self->is_undef(var_id) && forced) {
            self->error(src_info.source_offset, src_info.length, "Undeclared property '" .. id .. "' from class '" .. type.name .. "'.");
        }
        return var_id;
    }

    fn push_field_access_impl(self: HIRBuilder, object_id: HIR.VarId, field_type: Type, field_name: str, field_offset: u16, src_info: HIR.SrcInfo) => HIR.VarId {
        field_var_id := self.vars.size$cast(HIR.VarId);
        field_var := HIR.VarField();
        self.vars ..= field_var;

        field_var.kind = HIR.Var.Kind.Field;
        field_var.src_info = src_info;

        field_var.type = field_type;
        field_var.object = object_id;
        field_var.field = field_name;
        field_var.offset = field_offset;

        return field_var_id;
    }

    fn push_arbitrary_global_var(self: HIRBuilder, name: str, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        node := Namespace.Node();
        node.key = name;
        node.name = name;

        value := Value();
        value->set_type(type);
        node.value = value;
        node.info = Namespace.Info.construct(true, false);
        node.info.const = (type.kind == Type.Kind.Function || type.kind == Type.Kind.CFunction);

        return self->push_node_var(node, src_info);
    }

    export fn try_push_field_access(self: HIRBuilder, object_id: HIR.VarId, field_name: str, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_field_access(object_id, field_name, src_info, false);
    }

    export fn push_field_access_forced(self: HIRBuilder, object_id: HIR.VarId, field_name: str, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_field_access(object_id, field_name, src_info, true);
    }

    fn push_field_access(self: HIRBuilder, object_id: HIR.VarId, field_name: str, src_info: HIR.SrcInfo, forced: bool) => HIR.VarId {
        object := self.vars[object_id];
        object_type := object->get_type_forced();
        if (object_type == null) {
            return self->push_empty_error_var(src_info);
        }

        if (object_type.kind == Type.Kind.Class) {
            type_class := object_type$cast(TypeClass);

            field_type := type_class->get_field_type(field_name);
            if (field_type != null) {
                return self->push_field_access_impl(
                    object_id, 
                    field_type, 
                    field_name, 
                    type_class->get_field_offset(field_name)$cast(u16), 
                    src_info);
            }
            
            return self->push_class_namespace_access(type_class, field_name, src_info, forced);
        }

        if (object_type.kind == Type.Kind.Enum) {
            type_enum := object_type$cast(TypeEnum);

            constant := type_enum->find_constant(field_name);
            
            if (constant != null) {
                return self->push_literal_number_of_type(constant.value, type_enum, src_info);
            }

            var_id := self->get_namespace_var(type_enum.namespace, field_name, src_info, forced);
            if (self->is_undef(var_id) && forced) {
                self->error(src_info.source_offset, src_info.length, "Undeclared property '" .. field_name .. "' from enum '" .. type_enum.name .. "'.");
            }
            return var_id;
        }

        if (object_type.kind == Type.Kind.Array) {
            type_array := object_type$cast(TypeArray);

            if (field_name == "size") {
                return self->push_field_access_impl(
                    object_id, 
                    Types.instance.type_u64, 
                    field_name, 
                    (raw$size + u64$size)$cast(u16), 
                    src_info);
            } else if (field_name == "clear") {
                return self->push_arbitrary_global_var(
                    "__ketl_rt.array_clear", 
                    Types.instance->get_function_type(Type[2]{
                        Types.instance.type_void,
                        type_array,
                    }), 
                    src_info);
            } else if (field_name == "pop") {
                return self->push_arbitrary_global_var(
                    "__ketl_rt.array_pop", 
                    Types.instance->get_function_type(Type[2]{
                        Types.instance.type_void,
                        type_array,
                    }), 
                    src_info);
            }
        }

        if (forced) {
            self->error(src_info.source_offset, src_info.length, "Can't access field.");
            return self->push_empty_error_var(src_info);
        } else {
            return (-1)$cast(HIR.VarId);
        }
    }

    export fn push_temp_var_of_type(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        temp_decl_id := self.decls.size$cast(HIR.DeclId);
        temp_decl := HIR.DeclCommon();
        temp_decl.kind = HIR.Decl.Kind.Common;
        temp_decl.name = self->generate_temp_name();

        temp_decl.type = type;
        temp_decl.src_info = src_info;

        self.decls ..= temp_decl;

        return self->push_common_var(type, src_info, temp_decl_id);
    }

    export fn push_temp_var(self: HIRBuilder, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_temp_var_of_type(null, src_info);
    }

    export fn push_empty_error_var(self: HIRBuilder, src_info: HIR.SrcInfo) => HIR.VarId {
        return self->push_error_var(src_info, ErrorsAccum.NON_ID);
    }

    export fn push_error_var(self: HIRBuilder, src_info: HIR.SrcInfo, error_id: u64) => HIR.VarId {
        var_id := self.vars.size$cast(HIR.VarId);
        varr := HIR.VarError();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Error;
        varr.src_info = src_info;

        varr.error_id = error_id;

        return var_id;
    }

    export fn check_var_declaration_conditions(self: HIRBuilder, var_id: HIR.VarId, is_field: bool) => str {
        varr := self.vars[var_id];
        src_info := self.vars[var_id].src_info;
        
        if (varr.kind == HIR.Var.Kind.Global) {
            node := varr$cast(HIR.VarGlobal).node;
            if (!is_field && self.local_map_stack.size == 0) {
                //orig_src_info := decl->get_src_info();
                //if (orig_src_info != null) {
                //    self->error(src_info.source_offset, src_info.length, "Variable redefinition.");
                //    self->error(orig_src_info.source_offset, orig_src_info.length, "Was defined first here.");
                //} else {
                    self->error(src_info.source_offset, src_info.length, "Variable redefinition. First definition is unknown (fullname " .. node.name .. ").");
                //}
                return null;
            }
            return node.key;
        } else if (varr.kind != HIR.Var.Kind.Common) {
            self->error(src_info.source_offset, src_info.length, "Must use plain id to declare a variable.");
            return null;
        }

        decl := self.decls[varr$cast(HIR.VarCommon).decl];
        switch (decl.kind) {
            case HIR.Decl.Kind.Error => {
                error := self.errors_accum->get_kind(decl$cast(HIR.DeclError).error_id);
                if (error != ErrorsAccum.Error.UndefinedId) {
                    return null;
                }

                return decl.name;
            }
            case HIR.Decl.Kind.Parameter
            case HIR.Decl.Kind.Common => {
                if (decl.name[0] == '~') {
                    self->error(src_info.source_offset, src_info.length, "Must use plain id to declare a variable.");
                    return null;
                }
                bucket := self->find_decl_bucket_scoped(decl.name);
                if (!is_field && bucket != null && bucket.value$cast(HIR.Decl) == decl) {
                    orig_src_info := decl->get_src_info();
                    if (orig_src_info != null) {
                        self->error(src_info.source_offset, src_info.length, "Variable redefinition.");
                        self->error(orig_src_info.source_offset, orig_src_info.length, "Was defined first here.");
                    } else {
                        self->error(src_info.source_offset, src_info.length, "Variable redefinition. First definition is unknown (error).");
                    }
                    return null;
                }
                return decl.name;
            }
            default => {
                self->error(src_info.source_offset, src_info.length, "Must use plain id to declare a variable.");
                return null;
            }
        }
    }

    fn check_error_var(self: HIRBuilder, var_id: HIR.VarId, error_kind: ErrorsAccum.Error) => bool {
        varr := self.vars[var_id];
        if (varr.kind != HIR.Var.Kind.Common) {
            return false;
        }

        decl := self.decls[varr$cast(HIR.VarCommon).decl];
        if (decl.kind != HIR.Decl.Kind.Error) {
            return false;
        }

        error := self.errors_accum->get_kind(decl$cast(HIR.DeclError).error_id);
        return error == error_kind;
    }

    export fn declare_var_from_var_id(self: HIRBuilder, var_id: HIR.VarId, type: Type, src_info: HIR.SrcInfo) => bool {
        if (type == Types.instance.type_void$cast(Type)) {
            self->error(src_info.source_offset, src_info.length, "Can't declare var of type 'void'.");
            return false;
        }

        global_var := (self.local_map_stack.size == 0 || self.shhared);
        self.shhared = false;

        varr: HIR.Var = self.vars[var_id];
        key: str;
        
        common_var: HIR.VarCommon;
        old_decl_id: HIR.DeclId;
        old_decl: HIR.Decl;

        // gathering data
        if (varr.kind == HIR.Var.Kind.Common) {
            common_var = varr$cast(HIR.VarCommon);
            old_decl_id = common_var.decl;
            old_decl = self.decls[old_decl_id];
            key = old_decl.name;
        } else if (varr.kind == HIR.Var.Kind.Global) {
            key = varr$cast(HIR.VarGlobal).node.key;
        } else {
            assert(false);
        }

        decl: HIR.Decl;
        // deal with error decl
        if (old_decl != null && old_decl.kind == HIR.Decl.Kind.Error) {
            old_error_id := old_decl$cast(HIR.DeclError).error_id;
            if (type == null) {
                self.errors_accum->update(old_error_id, ErrorsAccum.Error.UndefinedDeclaredId, "Declaring variable without type or initial value.");
            } else {
                self.errors_accum->remove(old_error_id);
            }
        } else {
            if (type == null && !global_var) {
                // CREATE NEW DECL - ERROR
                error_id := self->error_type(ErrorsAccum.Error.UndefinedDeclaredId, src_info.source_offset, src_info.length, "Declaring variable without type or initial value.");
                
                decl = error_decl := HIR.DeclError();
                error_decl.kind = HIR.Decl.Kind.Error;
                error_decl.error_id = error_id;
            }
        }

        if (type != null && global_var) {
            // creating global var always
            name: str;
            if (self.cexxport) {
                name = key;
            }
            global_var_id := self->declare_global_var(self.namespace, key, name, type, src_info, self.exxport);
            self.vars[var_id] = self.vars[global_var_id];
            self.vars->pop();
            return true;
        }
        
        // creating common var if needed
        if (common_var == null) {
            common_var_id := self->push_common_var(null, varr.src_info, (-1)$cast(HIR.DeclId));
            common_var = (self.vars[var_id] = self.vars[common_var_id])$cast(HIR.VarCommon);
            self.vars->pop();
        }

        if (type != null && !global_var) {
            // CREATE NEW DECL - COMMON
            common_decl := HIR.DeclCommon();
            common_decl.kind = HIR.Decl.Kind.Common;

            common_decl.type = type;
            common_decl.src_info = src_info;

            common_var.type = type;

            if (old_decl != null && old_decl.kind == HIR.Decl.Kind.Error) {
                // replacing old, no need add and register new
                common_decl.name = key;
                self.decls[old_decl_id] = common_decl;
            } else {
                decl = common_decl;
            }
        }

        if (decl != null) {
            // ADD DECL AND REGISTER ID
            decl_id := self.decls.size$cast(HIR.DeclId);
            self.decls ..= decl;
                
            decl.name = key;
            bucket := self->last_local_map()->get_or_insert(
                    key, decl_id$cast(u64)$cast(raw));
            if (bucket.value$cast(u64)$cast(HIR.DeclId) != decl_id) {
                io.errorln("somehow decl was not registered, there is already one");
                bastard_decl := self.decls[bucket.value$cast(u64)$cast(HIR.DeclId)];
                io.errorln("located somewhere in file " .. self.source_info.filename .. " at line " .. (self.source_info->find_line(bastard_decl->get_src_info().source_offset) + 1)$cast(str));
                assert(false);
            }

            self->push_variable_op(HIR.Tag.ADD_LOCAL_VARIABLE, key, decl->get_src_info());
            
            // REPLACE DECL ID
            common_var.decl = decl_id;
        }
            
        return true;
    }

    fn push_symbol_map(self: HIRBuilder) {
        if (self.local_map_stack.size > 0) {
            self.local_map_stack ..= StrHashMap.construct();
        }
        self.global_map_stack ..= StrHashMap.construct();
    }

    fn pop_symbol_map(self: HIRBuilder, src_info: HIR.SrcInfo) {
        if (self.local_map_stack.size > 0) {
            last_local_map := self.local_map_stack[self.local_map_stack.size - 1];
            self.local_map_stack->pop();
            
            for (bucket := last_local_map.buckets) {
                while (bucket != null) {
                    self->push_variable_op(HIR.Tag.REMOVE_LOCAL_VARIABLE, bucket.key$cast(str), src_info);

                    bucket = bucket.next;
                }
            }
        }
        self.global_map_stack->pop();
    }

    export fn is_global_scope(self: HIRBuilder) => bool {
        return self.local_map_stack.size == 0;
    }

    fn find_decl_bucket(self: HIRBuilder, name: str) => StrHashMap.Bucket {
        i := self.local_map_stack.size;
        while (i > 0) {
            i -= 1;
            name_to_decl := self.local_map_stack[i];
            bucket := name_to_decl->get_or_null(name);
            if (bucket != null) {
                return bucket;
            }
        }

        return null;
    }

    fn find_decl_bucket_scoped(self: HIRBuilder, name: str) => StrHashMap.Bucket {
        i := self.local_map_stack.size;
        i -= 1;
        name_to_decl := self.local_map_stack[i];
        bucket := name_to_decl->get_or_null(name);
        if (bucket != null) {
            return bucket;
        }

        return null;
    }

    fn last_local_map(self: HIRBuilder) => StrHashMap {
        return self.local_map_stack[self.local_map_stack.size - 1];
    }

    fn last_global_map(self: HIRBuilder) => StrHashMap {
        return self.global_map_stack[self.global_map_stack.size - 1];
    }

    export fn get_default_initial_value(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        // TODO do default contructor or smth
        return self->push_literal_number_of_type(0, type, src_info);
    }

    fn push_node_var(self: HIRBuilder, namespace_node: Namespace.Node, src_info: HIR.SrcInfo) => HIR.VarId {
        var_id := self.vars.size$cast(HIR.VarId);
        varr := HIR.VarGlobal();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Global;
        varr.src_info = src_info;

        varr.node = namespace_node;

        return var_id;
    }

    export fn declare_global_var(self: HIRBuilder, namespace: Namespace, key: str, name: str, type: Type, src_info: HIR.SrcInfo, exxport: bool) => HIR.VarId {
        bucket := self->find_decl_bucket(key);

        // if got not null, we found existing decl
        if (self->find_decl_bucket(key) != null) {
            self->error(src_info.source_offset, src_info.length, "Overriding existing variable.");
            return self->push_empty_error_var(src_info);
        }

        // TODO Namespace.declare_var still can crash
        namespace_node := namespace->declare_var(key, name, type, exxport);
        if (namespace_node == null) {
            self->error(src_info.source_offset, src_info.length, "Overriding existing variable.");
            return self->push_empty_error_var(src_info);
        }
        
        return self->push_node_var(namespace_node, src_info);
    }

    export fn declare_global_node(self: HIRBuilder, namespace: Namespace, key: str, name: str, type: Type, src_info: HIR.SrcInfo, exxport: bool) => Namespace.Node {
        bucket := self->find_decl_bucket(key);

        // if got not null, we found existing decl
        if (self->find_decl_bucket(key) != null) {
            return null;
        }

        return namespace->declare_var(key, name, type, exxport);
    }

    export fn push_literal_type(self: HIRBuilder, type: Type, src_info: HIR.SrcInfo) => HIR.VarId {
        var_id := self.vars.size$cast(HIR.VarId);
        varr := HIR.VarLiteralType();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.LiteralType;
        varr.src_info = src_info;

        varr.value = type;

        return var_id;
    }

    export fn push_sequence(self: HIRBuilder, ids: HIR.VarId[], src_info: HIR.SrcInfo) => HIR.VarId {
        var_id := self.vars.size$cast(HIR.VarId);
        varr := HIR.VarSequence();
        self.vars ..= varr;

        varr.kind = HIR.Var.Kind.Sequence;
        varr.src_info = src_info;

        varr.values = ids;

        return var_id;
    }

    export fn get_var(self: HIRBuilder, namespace: Namespace, name: str, fullname: str, src_info: HIR.SrcInfo) => HIR.VarId {
        bucket := self->find_decl_bucket(fullname);
        decl_id: HIR.DeclId;
        type: Type;

        // if got not null, we found existing decl
        if (bucket != null) {
            decl_id = bucket.value$cast(u64)$cast(HIR.DeclId);
            decl := self.decls[decl_id];
            type = decl->get_type();
        } else {
            symbol_node := namespace->find(name);
            
            if (symbol_node != null) {
                return self->push_node_var(symbol_node, src_info);
            }
            
            decl_id = self.decls.size$cast(HIR.DeclId);

            decl := HIR.DeclError();
            decl.kind = HIR.Decl.Kind.Error;
            decl.name = name;

            self.decls ..= decl;

            // TODO use global map instead
            if (self.local_map_stack.size > 0) {
                bucket = self->last_local_map()->get_or_insert(
                    fullname, decl_id$cast(u64)$cast(raw));

                self->push_variable_op(HIR.Tag.ADD_LOCAL_VARIABLE, name, src_info);
            }
        } 

        return self->push_common_var(type, src_info, decl_id);
    }

    export fn get_namespace_var(self: HIRBuilder, namespace: Namespace, name: str, src_info: HIR.SrcInfo, forced: bool) => HIR.VarId {
        symbol_node := namespace->find(name);
        
        if (symbol_node == null) {
            if (forced) {
                return self->push_empty_error_var(src_info);
            } else {
                return (-1)$cast(HIR.VarId);
            }
        }

        return self->push_node_var(symbol_node, src_info);
    }

    export fn flush(self: HIRBuilder, hir: HIR) {
        hir.instrs = HIR.Instr[0];
        hir.block_offsets = HIR.InstrOffset[0];

        offset: HIR.InstrOffset;
        for (instrs := self.blocks) {
            hir.instrs ..= instrs;
            hir.block_offsets ..= offset;
            offset += instrs.size$cast(HIR.InstrOffset);
        }

        hir.vars = self.vars;
        hir.decls = self.decls;
        hir.consts_infos = self.consts_infos;
        hir.consts_literals = self.consts_literals;

        hir.return_type = self.return_type;
        hir.parameters_count = self.parameters_counter$cast(u8);
        hir.max_call_arg_count = self.max_call_arg_count;
        hir.entry = self.entry;
        hir.entry_info = self.entry_info;
    }
}