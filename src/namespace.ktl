//🫖ketl

from common import StrHashMap
from type_base import Type
from value import Value

class Namespace {
    class Info {
        // TODO currently 'export' keyword does not affect accessibility of the symbol, absence only adds dot in the name at the beginning
        var exxport: bool;
        var imported: bool;
        var const: bool;

        export fn construct(exxport: bool, imported: bool) => Info {
            var self = Info();
            self.exxport = exxport;
            self.imported = imported;
            return self;
        }
    }

    class Node {
        var value: Value;
        var name: str;
        var key: str;
        var info: Info;
    }

    var nodes: StrHashMap;
    var parents: Namespace[];
    var name: str;
    var fullname: str;

    export fn construct(name: str, parent: Namespace) => Namespace {
        var self = Namespace();
        
        self.nodes = StrHashMap.construct();
        self.parents = Namespace[0];
        self.name = name;

        if (parent != null) {
            self.parents ..= parent;
            self.fullname = parent.fullname .. "." .. name;
        } else {
            self.fullname = name;
        }

        return self;
    }

    export fn add_parent(self: Namespace, parent: Namespace) {
        self.parents ..= parent;
    }

    export fn is_empty(self: Namespace) => bool {
        return self.nodes.size == 0;
    }

    export fn declare_var(self: Namespace, key: str, name: str, type: Type, exxport: bool) => Node {
        var value = Value();
        value->set_type(type);
        return self->put(key, name, value, Info.construct(exxport, false), false);
    }

    export fn import_namespace(self: Namespace, key: str, name: str, namespace: Namespace, exxport: bool) => Node {
        var value = Value();
        value.value = namespace$cast(raw)$cast(u64);
        value.kind = Value.Kind.Namespace;
        return self->put(key, name, value, Info.construct(exxport, false), false);
    }

    export fn put(self: Namespace, key: str, name: str, value: Value, info: Namespace.Info, force: bool) => Node {
        if (name == null || name == "") {
            name = key;
            if (self.parents.size > 0) {
                assert(self.name != "");

                if (info.exxport) {
                    // skip first dot
                    name = self.fullname[1:self.fullname.size] .. "." .. name;
                } else {
                    name = self.fullname .. "." .. name;
                }
            }
        }

        var new_node = Node();
        new_node.value = value;
        new_node.name = name;
        new_node.key = key;
        new_node.info = info;

        var bucket = self.nodes->get_or_insert(key, new_node);
        if (bucket.value != new_node) {
            if (!force) {
                // TODO check const stuff
                // replace if replacement possible
                // do error if not
                assert(false);
            }
            
            bucket.value == new_node;
        }

        return bucket.value;
    }

    export fn find(self: Namespace, key: str) => Node {
        var bucket = self.nodes->get_or_null(key);
        if (bucket != null) {
            return bucket.value;
        }

        for (var parent <- self.parents) {
            var node = parent->find(key);
            if (node != null) {
                return node;
            }
        }

        return null;
    }

    export fn has_vars(self: Namespace) => bool {
        for (var bucket <- self.nodes.buckets) {
            while (bucket != null) {
                var node = bucket.value$cast(Namespace.Node);
                if (!node.info.imported) {
                    var value = node.value;
                    if (value->is_type()) {
                        from type import TypeClass
                        var type = value.value$cast(raw)$cast(Type);
                        if (type.kind == Type.Kind.Class && type$cast(TypeClass).namespace->has_vars()) {
                            return true;
                        }
                    } else if (value->is_common_var()) {
                        return true;
                    }
                }

                bucket = bucket.next;
            }
        }
        return false;
    }

    export fn has_classes(self: Namespace) => bool {
        for (var bucket <- self.nodes.buckets) {
            while (bucket != null) {
                var node = bucket.value$cast(Namespace.Node);
                if (!node.info.imported) {
                    var value = node.value;
                    if (value->is_type()) {
                        from type import TypeClass
                        var type = value.value$cast(raw)$cast(Type);
                        if (type.kind == Type.Kind.Class) {
                            return true;
                        }
                    }
                }

                bucket = bucket.next;
            }
        }
        return false;
    }
}