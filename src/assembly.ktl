//🫖ketl

import "platform" take Target
import "platform" take resolve_target_if_needed
import "errors" take ErrorsAccum
import "type_base" take Type
import "hir" take HIR
import "namespace" take Namespace

export class Assembly {

    export class Builder {
        build: (Assembly.Builder, HIR, str, u16, bool, Type) => Assembly;

    }

    print: (Assembly) => void;
    func_name: str;
    func_index: u16;
    emit_debug_info: bool;
    return_type: Type;

    export fn get_builder(source_info: ErrorsAccum.SourceInfo) => Builder {
        import "compiler" take Compiler
        switch (Compiler.instance.target) {
            case Target.X86_64_WINDOWS_CLANG
            case Target.X86_64_SYSTEM_V_CLANG => {
                import "asm_x86"
                return asm_x86.ASMX86.Builder.construct(source_info);
            }
            default => assert(false);
        }

        return null;
    }

    export fn print_compilation_unit(fullpath: str, 
        entry_assembly: Assembly, init_assembly: Assembly, assemblies: Assembly[], 
        namespace: Namespace, const_blocks: HIR.ConstBlock[]) {
        import "compiler" take Compiler
        switch (Compiler.instance.target) {
            case Target.X86_64_WINDOWS_CLANG
            case Target.X86_64_SYSTEM_V_CLANG => {
                import "asm_x86"
                asm_x86.ASMX86.print_compilation_unit(fullpath, 
                    entry_assembly, init_assembly, assemblies, 
                    namespace, const_blocks);
            }
            default => assert(false);
        }
    }

}