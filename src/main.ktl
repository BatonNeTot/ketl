//🫖ketl

from module import Modules
from platform import Target
from platform import resolve_target_if_needed
import io

class ArgsParser {
    enum Operation {
        ExecuteScript,
        CompileToAsm,
    }

    enum State {
        ExpectingExecutionScript,
        ExpectingExecution,

        ExpectingCompilationTargets,
        ExpectingOutputTarget,
    }

    op: Operation;
    state: State;
    target_os: Target;

    execution_script: str;
    
    compilation_targets: str[];
    output_target: str;

    emit_debug_info: bool;
}

parser: ArgsParser;

#entry
fn main(args: str[]) => i64 {
    parser = ArgsParser();
    parser.target_os = Target.DEFAULT;

    for (arg := args[1:]) {
        if (arg[0] == '-') {
            if (arg[1] == '-') {
                flag := arg[2:];
                if (flag.size >= 3 && flag[:6] == "target") {
                    if (flag[6] != '=') {
                        io.errorln("Unknown flag '" .. flag .. "'");
                        return -1;
                    }
                    option := flag[7:];
                    switch (option) {
                        case "default" => parser.target_os = Target.DEFAULT;
                        case "x86_64_windows_clang" => parser.target_os = Target.X86_64_WINDOWS_CLANG;
                        case "x86_64_system_v" => parser.target_os = Target.X86_64_SYSTEM_V_CLANG;
                        default => {
                            io.errorln("Unknown option '" .. option .. "' for flag 'tos'");
                            return -1;
                        }
                    }
                    continue;
                }
                io.errorln("Unknown flag '" .. flag .. "'");
                return -1;
            }

            for (symbol := arg[1:]) {
                switch (symbol) {
                    case 'S' => {
                        parser.op = ArgsParser.Operation.CompileToAsm;
                        parser.state = ArgsParser.State.ExpectingCompilationTargets;
                        parser.compilation_targets = str[0];
                        continue;
                    }
                    case 'o' => {
                        // TODO check known conditions
                        parser.state = ArgsParser.State.ExpectingOutputTarget;
                        continue;
                    }
                    case 'g' => {
                        parser.emit_debug_info = true;
                        continue;
                    }
                }

                io.errorln("Unknown flag '" .. symbol .. "'");
                return -1;
            }

            continue;
        }

        switch (parser.state) {
            case ArgsParser.State.ExpectingCompilationTargets => parser.compilation_targets ..= arg;
            case ArgsParser.State.ExpectingOutputTarget => parser.output_target = arg;
        }
    }

    parser.target_os = resolve_target_if_needed(parser.target_os);

    switch (parser.op) {
        case ArgsParser.Operation.CompileToAsm => {
            if (parser.output_target == null) {
                if (!compile_asm_list(parser.compilation_targets)) {
                    return -1;
                }
            } else {
                compilation_target := parser.compilation_targets[0];
                if (!compile_asm(compilation_target, parser.output_target)) {
                    return -1;
                }
            }
        }
    }

    prog_name := args[0];
    if (prog_name.size >= 8 && prog_name[prog_name.size - 8:prog_name.size - 4] == "test") {
        assert(false);
    }

    return 0;
}

fn compile_asm_list(targets: str[]) => bool {
    for (target := targets) {
        if (!compile_asm(target, null)) {
            return false;
        }
    }
    return true;
}

fn compile_asm(target: str, output: str) => bool {
    info := io.FileInfo.get(target);
    if (info == null) {
        return true;
    }
    
    kind := info->get_kind();
    if (kind == io.FileInfo.Kind.Directory) {
        items := io.Dir.get_items(target);
        if (items == null) {
            return true;
        }

        if (output != null) {
            for (item := items) {
                if (item != "." && item != "..") {
                    if (!compile_asm(target .. "/" .. item, output .. "/" .. item)) {
                        return false;
                    }
                }
            }
        } else {
            for (item := items) {
                if (item != "." && item != "..") {
                    if (!compile_asm(target .. "/" .. item, null)) {
                        return false;
                    }
                }
            }
        }
    }
    
    if (kind != io.FileInfo.Kind.RegularFile) {
        return true;
    }

    return compile_asm_file(target, output);
}

fn compile_asm_file(path: str, output_path: str) => bool {
    dir_path: str;
    module_name: str;

    {
        ext := io.get_ext(path);
        if (ext != "ktl") {
            return true;
        }

        module_name = io.get_filename(path);
        module_name = module_name[0:module_name.size - ext.size - 1];

        dir_path = io.get_dir(path);
        if (dir_path.size > 0) {
            dir_path ..= "/";
        }
    }

    if (output_path == null) {
        if (dir_path == null || dir_path.size == 0) {
            output_path = module_name .. ".s";
        } else {
            output_path = dir_path .. module_name .. ".s";
        }
    } else {
        ext := io.get_ext(output_path);
        if (ext == "ktl") {
            output_path = output_path[0:output_path.size - ext.size] .. "s";
        }
    }

    module := Modules.instance->load(module_name, dir_path, parser.target_os, parser.emit_debug_info);
    if (module == null || module.has_errors) {
        return false;
    }

    if (!io.create_dirs_if_needed(io.get_dir(output_path))) {
        return false;
    }
    if (!io.stdout_redirect(output_path)) {
        return false;
    }

    module->print_asm();
    io.stdout_redirect_restore();

    return true;
}
