//🫖ketl

from module import Modules
import io

class ArgsParser {
    enum Operation {
        ExecuteScript,
        CompileToAsm,
    }

    enum State {
        ExpectingExecutionScript,
        ExpectingExecution,

        ExpectingCompilationTargets,
        ExpectingOutputTarget,
    }

    var op: Operation;
    var state: State;

    var execution_script: str;
    
    var compilation_targets: str[];
    var output_target: str;

    var emit_debug_info: bool;
}

var parser: ArgsParser;

#entry
fn main(args: str[]) => i64 {
    parser = ArgsParser();

    for (var arg <- args[1:args.size]) {
        if (arg[0] == '-') {
            for (var symbol <- arg[1:arg.size]) {
                switch (symbol) {
                    case 'S' => {
                        parser.op = ArgsParser.Operation.CompileToAsm;
                        parser.state = ArgsParser.State.ExpectingCompilationTargets;
                        parser.compilation_targets = str[0];
                        continue;
                    }
                    case 'o' => {
                        // TODO check known conditions
                        parser.state = ArgsParser.State.ExpectingOutputTarget;
                        continue;
                    }
                    case 'g' => {
                        parser.emit_debug_info = true;
                        continue;
                    }
                }

                io.errorln("Unknown flag '" .. symbol .. "'");
                return -1;
            }

            continue;
        }

        switch (parser.state) {
            case ArgsParser.State.ExpectingCompilationTargets => parser.compilation_targets ..= arg;
            case ArgsParser.State.ExpectingOutputTarget => parser.output_target = arg;
        }
    }

    switch (parser.op) {
        case ArgsParser.Operation.CompileToAsm => {
            if (parser.output_target == null) {
                if (!compile_asm_list(parser.compilation_targets)) {
                    return -1;
                }
            } else {
                var compilation_target = parser.compilation_targets[0];
                if (!compile_asm(compilation_target, parser.output_target)) {
                    return -1;
                }
            }
        }
    }

    return 0;
}

fn compile_asm_list(targets: str[]) => bool {
    for (var target <- targets) {
        if (!compile_asm(target, null)) {
            return false;
        }
    }
    return true;
}

fn compile_asm(target: str, output: str) => bool {
    var info = io.FileInfo.get(target);
    if (info == null) {
        return true;
    }
    
    var kind = info->get_kind();
    if (kind == io.FileInfo.Kind.Directory) {
        var items = io.Dir.get_items(target);
        if (items == null) {
            return true;
        }

        if (output != null) {
            for (var item <- items) {
                if (item != "." && item != "..") {
                    if (!compile_asm(target .. "/" .. item, output .. "/" .. item)) {
                        return false;
                    }
                }
            }
        } else {
            for (var item <- items) {
                if (item != "." && item != "..") {
                    if (!compile_asm(target .. "/" .. item, null)) {
                        return false;
                    }
                }
            }
        }
    }
    
    if (kind != io.FileInfo.Kind.RegularFile) {
        return true;
    }

    return compile_asm_file(target, output);
}

fn compile_asm_file(path: str, output_path: str) => bool {
    var dir_path: str;
    var module_name: str;

    {
        var ext = io.get_ext(path);
        if (ext != "ktl") {
            return true;
        }

        module_name = io.get_filename(path);
        module_name = module_name[0:module_name.size - ext.size - 1];

        dir_path = io.get_dir(path);
        if (dir_path.size > 0) {
            dir_path ..= "/";
        }
    }

    if (output_path == null) {
        if (dir_path == null || dir_path.size == 0) {
            output_path = module_name .. ".s";
        } else {
            output_path = dir_path .. module_name .. ".s";
        }
    } else {
        var ext = io.get_ext(output_path);
        if (ext == "ktl") {
            output_path = output_path[0:output_path.size - ext.size] .. "s";
        }
    }

    var module = Modules.instance->load(module_name, dir_path, parser.emit_debug_info);
    if (module == null || module.has_errors) {
        return false;
    }

    if (!io.create_dirs_if_needed(io.get_dir(output_path))) {
        return false;
    }
    if (!io.stdout_redirect(output_path)) {
        return false;
    }

    module->print_asm();
    io.stdout_redirect_restore();

    return true;
}
