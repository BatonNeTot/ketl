//🫖ketl

from common import StrHashMap
from common import LogAccum
from io import File
import io

from type_base import Type
from type import Types
from type import TypeFunction

from namespace import Namespace

from func import CompileFunctionDeclaration

from lexer import Lexer
from lexer import TokenIterator
from hir import HIR
from variable import VariableDecl
from asm_x86 import ASMX86

class Module {

    class ConstBlock {
        var consts_infos: HIR.Const[];
        var consts_literals: u8[];
    }

    var name: str;
    var path: str;
    var namespace: Namespace;
    var lexer: Lexer;
    var compile_function_declarations: CompileFunctionDeclaration[];
    var init_asm_x86: ASMX86;
    var entry_asm_x86: ASMX86;
    var const_blocks: ConstBlock[];
    var has_errors: bool;
    var header_loaded: bool; // after preload
    var body_loaded: bool; // after load
    var emit_debug_info: bool;

    fn construct(name: str, global_namespace: Namespace, emit_debug_info: bool) => Module {
        var self = Module();

        self.name = name;

        self.namespace = Namespace.construct(name, global_namespace);
        self.compile_function_declarations = CompileFunctionDeclaration[0];
        self.const_blocks = ConstBlock[0];

        self.emit_debug_info = emit_debug_info;

        return self;
    }

    fn get_func_index_offset(module: Module) => u16 {
        var offset: u16;
        if (module.init_asm_x86 != null) {
            offset += 1;
        }
        return offset;
    }

    export fn print_asm(module: Module) {
        var fullpath =  io.resolve_path(module.path .. module.name .. ".ktl");
        var filename =  io.get_filename(fullpath);
        var dir = io.get_dir(fullpath);

        io.println("    .def    @feat.00;");
        io.println("    .scl    3;");
        io.println("    .type   0;");
        io.println("    .endef");
        io.println("    .globl  @feat.00");
        io.println("@feat.00 = 0");
        io.println("    .intel_syntax noprefix");
        io.println("    .file   \"" .. filename .. "\"");
        if (module.emit_debug_info) {
            io.println("    .file   1 \"" .. io.escaped_string(dir) .. "\" \"" .. filename .. "\"");
        }

        io.println("    .text                    # -- Functions");

        if (module.entry_asm_x86 != null) {
            module.entry_asm_x86->print("main", (-1)$cast(u16), false);
        }

        if (module.init_asm_x86 != null) {
            module.init_asm_x86->print(module.name .. "..init", 0, module.emit_debug_info);
        }

        var i: u16;
        var has_functions = false;
        for (var compile_func_decl <- module.compile_function_declarations) {
            var func_index = i + module->get_func_index_offset();
            if (compile_func_decl.asm_x86 != null) {
                compile_func_decl.asm_x86->print(compile_func_decl.node.name, func_index, module.emit_debug_info);
                has_functions = true;
            }
            i += 1;
        }

        // insert vars
        if (module.namespace->has_vars()) {
            io.println("    .bss                    # -- Zero-initialized Variables");

            print_asm_zero_initialized_variables_namespace(module.namespace);
        }

        // insert classes and consts
        if (module.namespace->has_classes() || module.const_blocks.size > 0) {
            io.println("    .section   .rdata,\"dr\"                    # -- Read-only Variables");

            for (var const_block <- module.const_blocks) {
                for (var const_info <- const_block.consts_infos) {
                    var variable_name = const_info.name;

                    io.println(variable_name .. ":");

                    assert(const_info.is_string);
                    io.print("    .asciz    \"");
                    var literal = "";
                    for (var symbol <- const_block.consts_literals[const_info.offset:const_info.offset + const_info.literal_size]) {
                        literal ..= symbol$cast(char);
                    }
                    io.print(literal);
                    io.println("\"");
                }
            }

            print_asm_read_only_data_namespace(module.namespace);
        }

        if (module.init_asm_x86 != null) {
            io.println("    .section .ctors,\"dw\",unique,0");
            io.println("    .p2align    3, 0x0");
            io.println("    .quad " .. module.name .. "..init");
        }

        var debug_line_section_label = ".Lline_table_start0";

        if (module.emit_debug_info) {
            import dwarf
            var debug_info = dwarf.DebugInfo.construct(5,
                has_functions,
                filename,
                ".Lstr_offsets_base0",
                debug_line_section_label,
                dir,
                ".Lfunc_end" .. (module.compile_function_declarations.size - 1 + module->get_func_index_offset())$cast(str) .. "-.Lfunc_begin0",
                ".Laddr_table_base0",
                ASMX86.reg_to_dwarf
                );

            if (module.init_asm_x86 != null) {
                debug_info->add_function(module.name .. "..init", 0, 0 /* TODO line */, false, true);
            }

            // we do not produce debug info for the entry code
            
            i = 0;
            for (var compile_func_decl <- module.compile_function_declarations) {
                var func_index = i + module->get_func_index_offset();
                if (compile_func_decl.asm_x86 != null) {
                    var is_pub = true;
                    if (compile_func_decl.node.name[0] == '.') {
                        is_pub = false;
                    }
                    debug_info->add_function(compile_func_decl.node.name, func_index, 0 /* TODO line */, is_pub, false);
                }
                i += 1;
            }

            debug_info->print();
        }

        // insert addrsigs
        if (module.init_asm_x86 != null ||
            has_functions) {
            io.println("    .p2align    2, 0x0");
            io.println("    .addrsig");

            if (module.init_asm_x86 != null) {
                print_asm_addrsig(module.name .. "..init");
            }
            
            for (var compile_func_decl <- module.compile_function_declarations) {
                if (compile_func_decl.asm_x86 != null) {
                    print_asm_addrsig(compile_func_decl.node.name);
                }
            }
        }

        if (module.emit_debug_info) {
            io.println("    .section	.debug_line,\"dr\"");
            io.println(debug_line_section_label .. ":");
        }
    }

    fn print_asm_addrsig(func_name: str) {
        io.println("    .addrsig_sym " .. func_name);
    }

    fn print_asm_zero_initialized_variable(node: Namespace.Node) {
        var value = node.value;
        if (value->is_type()) {
            from type import TypeClass
            var type = value.value$cast(raw)$cast(Type);
            if (type.kind == Type.Kind.Class) {
                print_asm_zero_initialized_variables_namespace(type$cast(TypeClass).namespace);
            }
            return;
        }
        
        if (!value->is_common_var()) {
            return;
        }
        
        var variable_name = node.name;

        io.println("    .globl    " .. variable_name .. "                    # @" .. variable_name);
        io.println("    .p2align  " .. value.type.align$cast(str) .. ", 0x0");
        io.println(variable_name .. ":");
        io.print("    .");
        ASMX86.print_directive_size(value.type->get_stack_size()$cast(ASMX86.Size));
        io.println("   0");
    }

    fn print_asm_zero_initialized_variables_namespace(namespace: Namespace) {
        for (var bucket <- namespace.nodes.buckets) {
            while (bucket != null) {
                var node = bucket.value$cast(Namespace.Node);
                if (!node.info.imported) {
                    print_asm_zero_initialized_variable(node);
                }

                bucket = bucket.next;
            }
        }
    }

    fn print_asm_read_only_data_variable(node: Namespace.Node) {
        var value = node.value;
        if (!value->is_type()) {
            return;

        }

        from type import TypeClass
        var type = value.value$cast(raw)$cast(Type);
        if (type.kind != Type.Kind.Class) {
            return;
        }
        var type_class = type$cast(TypeClass);
        
        var variable_name = node.name;

        io.println("    .globl    " .. variable_name .. "                    # @" .. variable_name);
        io.println("    .p2align  " .. Types.instance.type_raw.align$cast(str) .. ", 0x0");
        io.println(variable_name .. ":");

        // TODO get types directly from fields with smth like 'typeof'
        // TODO good place for reflection
        io.print("    .");
        ASMX86.print_directive_size(Types.instance.type_u8->get_stack_size()$cast(ASMX86.Size));
        io.println("   " .. type_class.kind$cast(str) .. "    # kind");

        io.print("    .");
        ASMX86.print_directive_size(Types.instance.type_u8->get_stack_size()$cast(ASMX86.Size));
        io.println("   " .. type_class.align$cast(str) .. "    # align");

        io.print("    .");
        ASMX86.print_directive_size(Types.instance.type_u16->get_stack_size()$cast(ASMX86.Size));
        io.println("   " .. type_class.size$cast(str) .. "    # size");


        io.print("    .");
        ASMX86.print_directive_size(Types.instance.type_raw->get_stack_size()$cast(ASMX86.Size));
        io.println("   " .. 0$cast(u64)$cast(str) .. "    # name, TODO");

        io.print("    .");
        ASMX86.print_directive_size(Types.instance.type_raw->get_stack_size()$cast(ASMX86.Size));
        io.println("   " .. 0$cast(u64)$cast(str) .. "    # fullname, TODO");

        io.print("    .");
        ASMX86.print_directive_size(Types.instance.type_u64->get_stack_size()$cast(ASMX86.Size));
        io.println("   " .. type_class.fields.size$cast(str) .. "    # fields_count");

        io.print("    .");
        ASMX86.print_directive_size(Types.instance.type_raw->get_stack_size()$cast(ASMX86.Size));
        io.println("   " .. 0$cast(u64)$cast(str) .. "    # fields, TODO");

        /* TODO
        // using .set directive as macro for field offset
        // cool idea, but must dublicate in files where class is used - hard to track
        for (uint32_t field_index = 0; field_index < p_class_type->fields_count; ++field_index) {
            io.println("    .set %s.%s, %"PRIu16"\n", p_variable_name, 
                ketl_atomic_strings_get_pointer(&p_state->atomic_strings, p_class_type->p_fields[field_index].s_name),
                ketl_type_get_field_offset((ketl_type*)p_class_type, p_class_type->p_fields[field_index].s_name, p_state));
        }
        */

        print_asm_read_only_data_namespace(type_class.namespace);
    }

    fn print_asm_read_only_data_namespace(namespace: Namespace) {
        for (var bucket <- namespace.nodes.buckets) {
            while (bucket != null) {
                var node = bucket.value$cast(Namespace.Node);
                if (!node.info.imported) {
                    print_asm_read_only_data_variable(node);
                }

                bucket = bucket.next;
            }
        }
    }

    fn preload(module: Module, module_filename: str, folder_path: str) => bool {
        if (module.header_loaded) {
            return true;
        }

        module.header_loaded = true;
        var stashed_module = Modules.instance.active_module;
        Modules.instance.active_module = module; 

        var fullpath = "";
        {
            if (stashed_module != null) { 
                fullpath ..= stashed_module.path;
            }

            if (folder_path != null && folder_path.size > 0) {
                fullpath ..= folder_path;
            }

            module.path = fullpath;
        }

        var fullpath_filename = fullpath .. module_filename;
        var source = File.read(fullpath_filename);
        
        if (source == null) {
            module.has_errors = true;
            // TODO something on error
            return false;
        }

        var log_accum = LogAccum.construct();
        var lexer = Lexer();
        module.lexer = lexer;
        lexer->init();
        lexer->build_tokens(module_filename, source, log_accum);

        //for (var token <- lexer.tokens) {
        //    io.errorln("from " .. token.offset$cast(str) .. " to " .. (token.offset + token.length)$cast(str) .. " " .. source[token.offset:token.offset + token.length]);
        //}

        var func_index: u16 = 0;

        from parser import Parser
        var hir = Parser.build_hir(lexer, 0, lexer.tokens.size$cast(TokenIterator.Index), module.namespace, VariableDecl[0], Types.instance.type_void, 
            func_index, true, module.emit_debug_info, log_accum);

        //hir->print();
        
        if (!log_accum->check()) {
            module.has_errors = true;
            // TODO something on error
            return false;
        }

        if (hir.consts_infos.size > 0) {
            var const_block = ConstBlock();

            const_block.consts_infos = hir.consts_infos;
            const_block.consts_literals = hir.consts_literals;

            module.const_blocks ..= const_block;
        }

        module.init_asm_x86 = ASMX86.Builder.construct(ASMX86.ABI.DEFAULT, module.emit_debug_info, lexer->construct_log_info())
            ->build(hir, func_index);

        if (hir.entry != null) {
            var entry_source = 
                "   from __ketl_rt import cstr2str" ..
                "   from __ketl_rt import U64Wrapper" ..

                "    var args = str[argc];" ..
                "    var i: i64;" ..
                "    while (i < argc) {" ..
                "        var arg = (argv + i$cast(u64) * raw$size)$cast(U64Wrapper).value$cast(raw);" ..
                "        args[i] = cstr2str(arg);" ..
                "        i += 1;" ..
                "    }" ..
                "    return " .. hir.entry .. "(args);";

            var entry_lexer = Lexer();
            entry_lexer->init();
            entry_lexer->build_tokens(module_filename, entry_source, log_accum);

            var entry_index = (-1)$cast(u16);
            var parameters = VariableDecl[2];
            {
                var parameter = VariableDecl();

                parameter.type = Types.instance.type_i64;
                parameter.name = "argc";
                parameter.src_info = hir.entry_info;

                parameters[0] = parameter;
            }
            {
                var parameter = VariableDecl();

                parameter.type = Types.instance.type_raw;
                parameter.name = "argv";
                parameter.src_info = hir.entry_info;

                parameters[1] = parameter;
            }

            var entry_hir = Parser.build_hir(entry_lexer, 0, entry_lexer.tokens.size$cast(TokenIterator.Index), 
                module.namespace, parameters, Types.instance.type_i64, 
                entry_index, false, false, log_accum);

            //entry_hir->print();

            assert(log_accum->check());

            module.entry_asm_x86 = ASMX86.Builder.construct(ASMX86.ABI.DEFAULT, false, lexer->construct_log_info())
                ->build(entry_hir, entry_index);
        }

        Modules.instance.active_module = stashed_module;

        Modules.instance.load_queue ..= module;
        
        return true;
    }

    fn load(module: Module) {
        var stashed_module = Modules.instance.active_module;
        Modules.instance.active_module = module; 

        {
        var i: u64;
        while (i < module.compile_function_declarations.size) {
            var compile_function_declaration = module.compile_function_declarations[i];

            var node = compile_function_declaration.node;
            var local_namespace = Namespace.construct(node.name, compile_function_declaration.parent_namespace);
            
            var signature = node.value.type$cast(TypeFunction).signature;
            var return_type = signature.parameters[0];

            var parameters_names = compile_function_declaration.parameters_names;
            var parameters_infos = compile_function_declaration.parameters_infos;
            if (parameters_names.size != signature.parameters.size - 1) {
                i += 1;
                continue;
            }

            var parameters = VariableDecl[0];
            {
                var j: u64;
                while (j < parameters_names.size) {
                    var parameter = VariableDecl();

                    parameter.type = signature.parameters[j + 1];
                    parameter.name = parameters_names[j];
                    parameter.src_info = parameters_infos[j];

                    parameters ..= parameter;
                    
                    j += 1;
                }
            }

            {
                var log_accum = LogAccum.construct();
                var func_index = i$cast(u16) + module->get_func_index_offset();

                from parser import Parser
                var hir = Parser.build_hir(module.lexer, 
                    compile_function_declaration.start_pos, compile_function_declaration.end_pos, 
                    local_namespace, parameters, return_type, func_index, false, module.emit_debug_info, log_accum);
                
                if (!log_accum->check()) {
                    module.has_errors = true;
                    // TODO something on error
                    i += 1;
                    continue;
                }

                //hir->print();

                if (hir.consts_infos.size > 0) {
                    var const_block = ConstBlock();

                    const_block.consts_infos = hir.consts_infos;
                    const_block.consts_literals = hir.consts_literals;

                    module.const_blocks ..= const_block;
                }

                compile_function_declaration.asm_x86 = ASMX86.Builder.construct(ASMX86.ABI.DEFAULT, module.emit_debug_info, module.lexer->construct_log_info())
                    ->build(hir, func_index);
            }

            i += 1;
        }
        }

        Modules.instance.active_module = stashed_module;

        module.body_loaded = true;
    }
}

class Modules {

    var global_namespace: Namespace;
    var modules: StrHashMap;
    var load_queue: Module[];
    var active_module: Module;
    var loading_modules: bool;

    fn construct() => Modules {
        var self = Modules();
        return self;
    }

    fn init_modules_if_needed(self: Modules) {
        if (self.modules == null) {
            self.modules = StrHashMap.construct();
            self.load_queue = Module[0];
        }
    }

    fn init_global_namespace(self: Modules) {
        if (self.global_namespace == null) {
            self.global_namespace = Namespace.construct("", null);

            from type_base import Type
            var node = self.global_namespace->declare_var("assert", "__ketl_rt.assert", Types.instance->get_function_type(
                Type[2] {
                    Types.instance.type_void,
                    Types.instance.type_bool
                }
            ), true);
            node.info.const = true;
        }
    }

    shared instance = construct();

    export fn load(self: Modules, module_name: str, folder_path: str, emit_debug_info: bool) => Module {        
        self->init_modules_if_needed();
        self->init_global_namespace();

        var module_filename = module_name .. ".ktl";

        var modules_size = self.modules.size;
        var module_bucket = self.modules->get_or_insert(module_name, null);
        // old insert
        if (modules_size == self.modules.size) {
            var module = module_bucket.value$cast(Module);
            module->preload(module_filename, folder_path);
            return module;
        }

        var top_loading = !self.loading_modules;
        self.loading_modules = true;

        var module = Module.construct(module_name, self.global_namespace, emit_debug_info);
        module_bucket.value = module;

        // preloading
        if (!module->preload(module_filename, folder_path)) {
            self.modules->erase(module_bucket);
            return null;
        }

        // load will be done later in bulk
        if (!top_loading) {
            return module;
        }

        // postloading everything
        while (self.load_queue.size > 0) {
            var tmp_module = self.load_queue[self.load_queue.size - 1];
            self.load_queue->pop();

            if (tmp_module.header_loaded && !tmp_module.body_loaded) {
                tmp_module->load();
            }
        }

        self.loading_modules = false;

        return module;
    }

}