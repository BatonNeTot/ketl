//🫖ketl

from common import StrHashMap
from errors import ErrorsAccum
from io import File
import io

from type_base import Type
from type import Types
from type import TypeFunction

from namespace import Namespace

from func import CompileFunctionDeclaration

from lexer import Lexer
from lexer import TokenIterator
from hir import HIR
from variable import VariableDecl
from assembly import Target
from assembly import Assembly

class Module {

    name: str;
    path: str;
    namespace: Namespace;
    lexer: Lexer;
    compile_function_declarations: CompileFunctionDeclaration[];
    assembly_builder: Assembly.Builder;
    entry_assembly: Assembly;
    init_assembly: Assembly;
    const_blocks: HIR.ConstBlock[];
    has_errors: bool;
    header_loaded: bool; // after preload
    body_loaded: bool; // after load
    target: Target;
    emit_debug_info: bool;

    fn construct(name: str, global_namespace: Namespace, target: Target, emit_debug_info: bool) => Module {
        self := Module();

        self.name = name;

        self.namespace = Namespace.construct(name, global_namespace);
        self.compile_function_declarations = CompileFunctionDeclaration[0];
        self.const_blocks = HIR.ConstBlock[0];

        self.target = target;
        self.emit_debug_info = emit_debug_info;

        return self;
    }

    export fn print_asm(module: Module) {
        assemblies := Assembly[module.compile_function_declarations.size];

        i: u64;
        for (compile_func_decl := module.compile_function_declarations) {
            if (compile_func_decl.assembly != null) {
                assemblies[i] = compile_func_decl.assembly;
            }

            i += 1;
        }

        Assembly.print_compilation_unit(
            io.resolve_path(module.path .. module.name .. ".ktl"), module.target,
            module.entry_assembly, module.init_assembly, assemblies,
            module.namespace, module.const_blocks, module.emit_debug_info);
    }

    fn preload(module: Module, module_filename: str, folder_path: str) => bool {
        if (module.header_loaded) {
            return true;
        }

        module.header_loaded = true;
        stashed_module := Modules.instance.active_module;
        Modules.instance.active_module = module; 

        fullpath := "";
        {
            if (stashed_module != null) { 
                fullpath ..= stashed_module.path;
            }

            if (folder_path != null && folder_path.size > 0) {
                fullpath ..= folder_path;
            }

            module.path = fullpath;
        }

        fullpath_filename := fullpath .. module_filename;
        source := File.read(fullpath_filename);
        
        if (source == null) {
            module.has_errors = true;
            // TODO something on error
            return false;
        }

        errors_accum := ErrorsAccum.construct();
        lexer := Lexer();
        module.lexer = lexer;
        lexer->init();
        lexer->build_tokens(module_filename, source, errors_accum);

        //for (token := lexer.tokens) {
        //    io.errorln("from " .. token.offset$cast(str) .. " to " .. (token.offset + token.length)$cast(str) .. " " .. source[token.offset:token.offset + token.length]);
        //}

        func_index: u16 = 0;

        from parser import Parser
        hir := Parser.build_hir(lexer, 0, lexer.tokens.size$cast(TokenIterator.Index), module.namespace, VariableDecl[0], Types.instance.type_void, 
            func_index, true, module.emit_debug_info, errors_accum);

        //hir->print();
        
        if (!errors_accum->check()) {
            module.has_errors = true;
            // TODO something on error
            return false;
        }

        if (hir.consts_infos.size > 0) {
            const_block := HIR.ConstBlock();

            const_block.consts_infos = hir.consts_infos;
            const_block.consts_literals = hir.consts_literals;

            module.const_blocks ..= const_block;
        }

        module.assembly_builder = Assembly.get_builder(module.target, lexer->construct_log_info());

        module.init_assembly = module.assembly_builder->build(hir, module.name .. "..init", func_index, module.emit_debug_info, Types.instance.type_void);

        if (hir.entry != null) {
            entry_source := 
                "   from __ketl_rt import cstr2str" ..
                "   from __ketl_rt import U64Wrapper" ..

                "    args := str[argc];" ..
                "    i: i64;" ..
                "    while (i < argc) {" ..
                "        arg := (argv + i$cast(u64) * raw$size)$cast(U64Wrapper).value$cast(raw);" ..
                "        args[i] = cstr2str(arg);" ..
                "        i += 1;" ..
                "    }" ..
                "    return " .. hir.entry .. "(args);";

            entry_lexer := Lexer();
            entry_lexer->init();
            entry_lexer->build_tokens(module_filename, entry_source, errors_accum);

            entry_index := (-1)$cast(u16);
            parameters := VariableDecl[2];
            {
                parameter := VariableDecl();

                parameter.type = Types.instance.type_i64;
                parameter.name = "argc";
                parameter.src_info = hir.entry_info;

                parameters[0] = parameter;
            }
            {
                parameter := VariableDecl();

                parameter.type = Types.instance.type_raw;
                parameter.name = "argv";
                parameter.src_info = hir.entry_info;

                parameters[1] = parameter;
            }

            return_type := Types.instance.type_i64;

            entry_hir := Parser.build_hir(entry_lexer, 0, entry_lexer.tokens.size$cast(TokenIterator.Index), 
                module.namespace, parameters, return_type, 
                entry_index, false, false, errors_accum);

            //entry_hir->print();

            assert(errors_accum->check());

            module.entry_assembly = module.assembly_builder->build(entry_hir, "main", entry_index, false, return_type);
        }

        Modules.instance.active_module = stashed_module;

        Modules.instance.load_queue ..= module;
        
        return true;
    }

    fn load(module: Module) {
        stashed_module := Modules.instance.active_module;
        Modules.instance.active_module = module; 

        {
        i: u64;
        while (i < module.compile_function_declarations.size) {
            compile_function_declaration := module.compile_function_declarations[i];
            func_index := i$cast(u16) + 1;

            hir: HIR;
            if (compile_function_declaration.hir != null) {
                hir = compile_function_declaration.hir;
            } else {
                node := compile_function_declaration.node;
                local_namespace := Namespace.construct(node.name, compile_function_declaration.parent_namespace);
                
                signature := node.value.type$cast(TypeFunction).signature;
                return_type := signature.parameters[0];

                parameters_names := compile_function_declaration.parameters_names;
                parameters_infos := compile_function_declaration.parameters_infos;
                if (parameters_names.size != signature.parameters.size - 1) {
                    i += 1;
                    continue;
                }

                parameters := VariableDecl[0];
                {
                    j: u64;
                    while (j < parameters_names.size) {
                        parameter := VariableDecl();

                        parameter.type = signature.parameters[j + 1];
                        parameter.name = parameters_names[j];
                        parameter.src_info = parameters_infos[j];

                        parameters ..= parameter;
                        
                        j += 1;
                    }
                }

                errors_accum := ErrorsAccum.construct();

                from parser import Parser
                hir = Parser.build_hir(module.lexer, 
                    compile_function_declaration.start_pos, compile_function_declaration.end_pos, 
                    local_namespace, parameters, return_type, func_index, false, module.emit_debug_info, errors_accum);
                
                if (!errors_accum->check()) {
                    module.has_errors = true;
                    // TODO something on error
                    i += 1;
                    continue;
                }
            }

            //hir->print();

            if (hir.consts_infos.size > 0) {
                const_block := HIR.ConstBlock();

                const_block.consts_infos = hir.consts_infos;
                const_block.consts_literals = hir.consts_literals;

                module.const_blocks ..= const_block;
            }

            compile_function_declaration.assembly = module.assembly_builder->build(hir, compile_function_declaration.node.name, func_index, module.emit_debug_info,
                compile_function_declaration.node.value.type$cast(TypeFunction).signature.parameters[0]);

            i += 1;
        }
        }

        Modules.instance.active_module = stashed_module;

        module.body_loaded = true;
    }
}

class Modules {

    global_namespace: Namespace;
    modules: StrHashMap;
    load_queue: Module[];
    active_module: Module;
    loading_modules: bool;

    fn construct() => Modules {
        self := Modules();
        return self;
    }

    fn init_modules_if_needed(self: Modules) {
        if (self.modules == null) {
            self.modules = StrHashMap.construct();
            self.load_queue = Module[0];
        }
    }

    fn init_global_namespace(self: Modules) {
        if (self.global_namespace == null) {
            self.global_namespace = Namespace.construct("", null);

            from type_base import Type
            node := self.global_namespace->declare_var("assert", "__ketl_rt.assert", Types.instance->get_function_type(
                Type[2] {
                    Types.instance.type_void,
                    Types.instance.type_bool
                }
            ), true);
            node.info.const = true;
        }
    }

    #shared instance := construct();

    export fn load(self: Modules, module_name: str, folder_path: str, target: Target, emit_debug_info: bool) => Module {        
        self->init_modules_if_needed();
        self->init_global_namespace();

        module_filename := module_name .. ".ktl";

        modules_size := self.modules.size;
        module_bucket := self.modules->get_or_insert(module_name, null);
        // old insert
        if (modules_size == self.modules.size) {
            module := module_bucket.value$cast(Module);
            module->preload(module_filename, folder_path);
            return module;
        }

        top_loading := !self.loading_modules;
        self.loading_modules = true;

        module := Module.construct(module_name, self.global_namespace, target, emit_debug_info);
        module_bucket.value = module;

        // preloading
        if (!module->preload(module_filename, folder_path)) {
            self.modules->erase(module_bucket);
            return null;
        }

        // load will be done later in bulk
        if (!top_loading) {
            return module;
        }

        // postloading everything
        while (self.load_queue.size > 0) {
            tmp_module := self.load_queue[self.load_queue.size - 1];
            self.load_queue->pop();

            if (tmp_module.header_loaded && !tmp_module.body_loaded) {
                tmp_module->load();
            }
        }

        self.loading_modules = false;

        return module;
    }

}