//🫖ketl

export class StringBuffer {
    array: str;

    export fn construct() => StringBuffer {
        obj := StringBuffer();
        obj.array = "";
        return obj;
    }

    export fn write(buffer: StringBuffer, message: str) => StringBuffer {
        buffer.array ..= message;
        return buffer;
    }
} 

export fn str_padding(size: u32) => str {
    result := char[size];
    while (size > 0) {
        size -= 1;
        result[size] = ' ';
    }
    return result;
} 

fn to_str_padded(value: u32, padding: u32) => str {
    result := value$cast(str);
    if (padding <= result.size) {
        return result;
    }

    padding -= result.size$cast(u32);

    return result .. str_padding(padding);
}

export fn uint_to_str(value: u64, radix: u8) => str {
    if (value == 0) {
        return "0";
    }

    symbols := "0123456789abcdefghijklmnopqrstuvwxyz";
    assert(radix < symbols.size);

    buffer := "";

    while (value > 0) {
        number := value % radix;
        value /= radix;

        buffer = symbols[number] .. buffer;
    }

    return buffer;
}