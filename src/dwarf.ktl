class AttrPair {
    attr: Attr;
    value: AttrValue;

    fn construct(attr: Attr, value: AttrValue) => AttrPair {
        self := AttrPair();
        self.attr = attr;
        self.value = value;
        return self;
    }
}

// DIE ////////////////////////

export class DIE {

    tag: Tag;
    data_offset: u32;
    abbr_index: u64;
    attrs: AttrPair[];
    children: DIE[];

    fn construct() => DIE {
        self := DIE();
        self.attrs = AttrPair[0];
        self.children = DIE[0];
        return self;
    }

    fn get_abbreviation(self: DIE) => Abbreviation {
        abbr := Abbreviation();

        abbr.tag = self.tag;
        abbr.has_children = (self.children != null && self.children.size > 0);

        abbr.attrs = AttrHeader[0];

        for (attr := self.attrs) {
            abbr.attrs ..= AttrHeader.construct(attr.attr, attr.value.form);
        }

        return abbr;
    }

    fn sort_attrs(self: DIE) {
        pairs := self.attrs;
        i: u64 = pairs.size;
        while (i > 0) {
            i -= 1;

            updated := false;

            j: u64;
            while (j < i) {
                if (pairs[j].attr > pairs[j + 1].attr) {
                    // (pairs[j + 1], pairs[j]) = (pairs[j], pairs[j + 1]); // TODO
                    pair := pairs[j];
                    pairs[j] = pairs[j + 1];
                    pairs[j + 1] = pair;

                    updated = true;
                }
                j += 1;
            }

            if (!updated) {
                return;
            }
        }
    }
}

class AttrRef {
    extend AttrValue;
    die: DIE;

    fn construct(die: DIE, size: u64) => AttrRef {
        self := AttrRef();
        self.print = print;
        switch (size) {
            case 1 => self.form = Form.ref1;
            case 2 => self.form = Form.ref2;
            case 4 => self.form = Form.ref4;
            case 8 => self.form = Form.ref8;
            default => self.form = Form.ref_udata;
        }
        self.die = die;
        return self;
    }

    fn print(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        self := attr$cast(AttrRef);
        return print_data(self.die.data_offset$cast(str) .. "                               # DW_AT_" .. tag->to_str(), self.form, print_data_directive);
    }
}

export class Variable {
    name: str;
    type: Type;
    ops: Op[];
}

export class DebugInfo {
    version: u8;
    abbr_section_offset: str;

    dies: DIE[];
    dies_indices: IntHashMap;
    dies_by_name: StrHashMap;

    types_to_dies: IntHashMap;

    abbrs: Abbreviation[];
    abbrs_indices: HashMap;

    strings: str[];
    strings_indices: StrHashMap;

    func_addresses: str[];

    print_data_directive: (DataDirective, str) => u32;

    fn get_abbr_hash(key: raw) => u64 {
        return key$cast(Abbreviation)->get_hash();
    }

    fn is_abbrs_equal(lhs: raw, rhs: raw) => bool {
        return Abbreviation.is_equal(lhs, rhs);
    }

    fn construct(version: u8,
        compile_unit_name: str, 
        str_offsets_base: str, 
        stmt_list: str, 
        comp_dir: str, 
        compile_unit_size: str, 
        addr_base: str,
        print_data_directive: (DataDirective, str) => u32) => DebugInfo {
        self := DebugInfo();

        self.version = version;
        assert(version == 5);

        self.dies = DIE[0];
        self.dies_indices = IntHashMap.construct();
        self.dies_by_name = StrHashMap.construct();

        self.types_to_dies = IntHashMap.construct();

        self.abbrs = Abbreviation[0];
        self.abbrs_indices = HashMap.construct(is_abbrs_equal, get_abbr_hash);

        self.strings = str[0];
        self.strings_indices = StrHashMap.construct();

        self.func_addresses = str[0];

        self.print_data_directive = print_data_directive;

        compile_unit_die := DIE();
        compile_unit_die.tag = Tag.compile_unit;
        compile_unit_die.attrs = AttrPair[9] {
            AttrPair.construct(Attr.producer, AttrStr.construct("ketl 0.1.0")),
            AttrPair.construct(Attr.language, AttrData.construct(64214, 2)), // 0xFAD6 // 0x(1)FAD6 - teapot unicode
            AttrPair.construct(Attr.name, AttrStr.construct(compile_unit_name)),
            AttrPair.construct(Attr.str_offsets_base, AttrSecOffset.construct(str_offsets_base)),
            AttrPair.construct(Attr.stmt_list, AttrSecOffset.construct(stmt_list)),
            AttrPair.construct(Attr.comp_dir, AttrStr.construct(comp_dir)),
            AttrPair.construct(Attr.low_pc, AttrAddr.construct("0")),
            AttrPair.construct(Attr.high_pc, AttrAddrData.construct(compile_unit_size, 4)),
            AttrPair.construct(Attr.addr_base, AttrSecOffset.construct(addr_base)),
        };

        self->add_die(compile_unit_die);

        return self;
    }

    export fn print(self: DebugInfo) {
        import io
        io.println("	.p2align	2, 0x0");
        io.println("	.section	.debug_abbrev,\"dr\"");
        {
            i := 0;
            for (abbr := self.abbrs) {
                i += 1;
                self.print_data_directive(DataDirective.Bit8, i$cast(str) .. "                               # Abbreviation Code");
                abbr->print(self.print_data_directive);
                self.print_data_directive(DataDirective.Bit8, "0                               # EOM(1)");
                self.print_data_directive(DataDirective.Bit8, "0                               # EOM(2)");
            }
        }
        self.print_data_directive(DataDirective.Bit8, "0                               # EOM(3)");

        info_offset: u32;

        io.println("	.section	.debug_info,\"dr\"");
        io.println(".Lcu_begin0:");
        info_offset += self.print_data_directive(DataDirective.Bit32, ".Ldebug_info_end0-.Ldebug_info_start0 # Length of Unit");
        io.println(".Ldebug_info_start0:");
        info_offset += self.print_data_directive(DataDirective.Bit16, self.version$cast(str) .. "                               # DWARF version number");
        info_offset += self.print_data_directive(DataDirective.Bit8, UnitType.compile$cast(str) .. "                               # DWARF Unit Type");
        info_offset += self.print_data_directive(DataDirective.Bit8, raw$size$cast(str) .. "                               # Address Size (in bytes)");
        info_offset += self.print_data_directive(DataDirective.Address, ".debug_abbrev           # Offset Into Abbrev. Section");
        
        for (die := self.dies) {
            die.data_offset = info_offset;
            info_offset += self.print_data_directive(DataDirective.Bit8, die.abbr_index$cast(str) .. "                               # Abbrev [" .. die.abbr_index$cast(str) .. "], DW_TAG_" .. die.tag->to_str() .. " " .. info_offset$cast(str) .. " byte(s) offset");

            for (attr := die.attrs) {
                if (attr.value.print != null) {
                    info_offset += attr.value->print(attr.attr, self.print_data_directive);
                }
            }
        }

        io.println(".Ldebug_info_end0:");
        io.println("	.section	.debug_str_offsets,\"dr\"");
        self.print_data_directive(DataDirective.Bit32, (self.strings.size * 4 + 4)$cast(str) .. "                              # Length of String Offsets Set"); // using 32-bit format
        self.print_data_directive(DataDirective.Bit16, self.version$cast(str));
        self.print_data_directive(DataDirective.Bit16, "0"); // Reserved
        io.println(".Lstr_offsets_base0:");
        io.println("	.section	.debug_str,\"dr\"");

        {
            i: u64;
            while (i < self.strings.size) {
                io.println(".Linfo_string" .. i$cast(str) .. ":");
                io.println("	.asciz	\"" .. io.escaped_string(self.strings[i]) .. "\"");
                i += 1;
            }
            io.println("	.section	.debug_str,\"dr\"");

            i = 0;
            while (i < self.strings.size) {
                self.print_data_directive(DataDirective.Address, ".Linfo_string" .. i$cast(str));
                i += 1;
            }
        }

        io.println("	.section	.debug_addr,\"dr\"");
        self.print_data_directive(DataDirective.Bit32, ".Ldebug_addr_end0-.Ldebug_addr_start0 # Length of contribution");
        io.println(".Ldebug_addr_start0:");
        self.print_data_directive(DataDirective.Bit16, self.version$cast(str) .. "                               # DWARF version number");
        self.print_data_directive(DataDirective.Bit8, "8                               # Address size");
        self.print_data_directive(DataDirective.Bit8, "0                               # Segment selector size");
        io.println(".Laddr_table_base0:");
        for (func_address := self.func_addresses) {
            self.print_data_directive(DataDirective.Bit64, func_address);
        }
        io.println(".Ldebug_addr_end0:");
    }

    from type_base import Type
    export fn add_function(self: DebugInfo, 
        func_name: str,
        func_index: u16,
        return_type: Type,
        decl_line: u64,
        frame_base: Op[],
        variables: Variable[],
        is_pub: bool, // DW_AT_external
        is_main: bool) { // DW_AT_main_subprogram 
        self.abbrs[0].has_children = true;

        return_type_die: DIE;
        from type import Types
        if (return_type != null && return_type != Types.instance.type_void$cast(Type)) {
            return_type_die = self->construct_type_die(return_type);
        }

        low_pc_index := self.func_addresses.size;
        self.func_addresses ..= ".Lfunc_begin" .. func_index$cast(str);

        die := DIE();

        die.tag = DIE.Tag.subroutine_type;
        die.attrs = AttrPair[6]{
            AttrPair.construct(Attr.low_pc, AttrAddr.construct(low_pc_index$cast(str))),
            AttrPair.construct(Attr.high_pc, AttrAddrData.construct(".Lfunc_end" .. func_index$cast(str) .. "-.Lfunc_begin" .. func_index$cast(str), 4)),
            AttrPair.construct(Attr.frame_base, AttrExpr.construct(frame_base)),
            AttrPair.construct(Attr.name, AttrStr.construct(func_name)),
            AttrPair.construct(Attr.decl_file, AttrData.construct(0, 1)),
            AttrPair.construct(Attr.decl_line, AttrData.construct(decl_line, 1)),
        };

        if (return_type_die != null) {
            die.attrs ..= AttrPair.construct(Attr.type, AttrRef.construct(return_type_die, 4));
        }

        if (is_pub) {
            die.attrs ..= AttrPair.construct(Attr.external, AttrValue.construct_empty(Form.flag_present));
        }

        if (is_main) {
            die.attrs ..= AttrPair.construct(Attr.main_subprogram, AttrValue.construct_empty(Form.flag_present));
        }

        if (variables != null) {
            die.children = DIE[variables.size];

            i: u64;
            for (variable := variables) {
                type_die := self->construct_type_die(variable.type);

                variable_die := DIE();

                variable_die.tag = DIE.Tag.variable;
                variable_die.attrs = AttrPair[3]{
                    AttrPair.construct(Attr.location, AttrExpr.construct(Op[1]{
                        Op.reg8,
                    })),
                    AttrPair.construct(Attr.name, AttrStr.construct(variable.name)),
                    AttrPair.construct(Attr.type, AttrRef.construct(type_die, 4)),
                    //AttrPair.construct(Attr.decl_file, AttrData.construct(0, 1)),
                    //AttrPair.construct(Attr.decl_line, AttrData.construct(decl_line, 1)),
                };

                die.children[i] = variable_die;
                i += 1;
            }
        }

        self->add_die(die);
    }

    fn add_die(self: DebugInfo, die: DIE) => u64 {
        die_bucket := self.dies_indices->get_or_insert(die$cast(raw)$cast(u64), null);
        if (die_bucket.value != null) {
            return die_bucket.value$cast(u64);
        }

        self.dies ..= die;
        die_index := self.dies.size;
        die_bucket.value = die_index$cast(u64)$cast(raw);

        for (attr := die.attrs) {
            value := attr.value;
            if (value.form == Form.string) {
                str_value := value$cast(AttrStr);
                string_index := self->register_string(str_value.value);

                if (string_index <= 255) {
                    str_value.form = Form.strx1;
                } else if (string_index <= 65535) {
                    str_value.form = Form.strx2;
                } else {
                    assert(false);
                }
                str_value.index = string_index;
            }
        }

        abbr := die->get_abbreviation();
        abbr_bucket := self.abbrs_indices->get_or_insert(abbr$cast(raw)$cast(u64), null);
        if (abbr_bucket.value != null) {
            die.abbr_index = abbr_bucket.value$cast(u64);
        } else {
            self.abbrs ..= abbr;
            die.abbr_index = self.abbrs.size;
            abbr_bucket.value = die.abbr_index$cast(u64)$cast(raw);
        }

        if (die.children != null) {
            for (child := die.children) {
                self->add_die(child);
            }
        }
        return die_index;
    }

    fn register_string(self: DebugInfo, string: str) => u64 {
        string_bucket := self.strings_indices->get_or_insert(string, self.strings.size$cast(u64)$cast(raw));
        if (string_bucket.value$cast(u64) != self.strings.size) {
            return string_bucket.value$cast(u64);
        }

        self.strings ..= string;
        string_index := string_bucket.value$cast(u64);
    
        return string_index;
    }

    export fn construct_pointer_type_die(self: DebugInfo, wrapped_die: DIE, name: str) => DIE {
        die := DIE();

        die.tag = DIE.Tag.pointer_type;
        die.attrs = AttrPair[0];
        if (name != null) {
            die.attrs ..= AttrPair.construct(Attr.name, AttrStr.construct(name));
        }
        if (wrapped_die != null) {
            die.attrs ..= AttrPair.construct(Attr.type, AttrRef.construct(wrapped_die, 4));
        }

        self->add_die(die);
        return die;
    }

    export fn construct_type_die(self: DebugInfo, type: Type) => DIE {
        import io
        bucket := self.types_to_dies->get_or_insert(type$cast(raw)$cast(u64), null);
        if (bucket.value != null) {
            return bucket.value$cast(DIE);
        }

        if (type.kind == Type.Kind.Primitive) {
            from type import TypePrimitive
            type_primitive := type$cast(TypePrimitive);

            from type import Types
            if (type_primitive == Types.instance.type_raw) {
                bucket.value = self->construct_pointer_type_die(null, type_primitive.name);
                return bucket.value$cast(DIE);
            }

            die := DIE();
            bucket.value = die;

            die.tag = DIE.Tag.base_type;
            die.attrs = AttrPair[1]{
                AttrPair.construct(Attr.name, AttrStr.construct(type_primitive.name)),
            };

            if (type_primitive.size > 0) {
                die.attrs ..= AttrPair.construct(DIE.Attr.byte_size, AttrData.construct(type_primitive.size, 1));
            }

            encoding := AttrEncoding.none;
            if (type_primitive.numeric) {
                if (type_primitive.signed) {
                    encoding = AttrEncoding.signed;
                } else {
                    encoding = AttrEncoding.unsigned;
                }
            } else {
                if (type_primitive == Types.instance.type_bool) {
                    encoding = AttrEncoding.boolean;
                } else if (type_primitive == Types.instance.type_char) {
                    encoding = AttrEncoding.unsigned_char;
                } else {
                    io.errorln("Unsupported primitive type " .. type->get_name());
                    assert(false);
                }
            }
            die.attrs ..= AttrPair.construct(DIE.Attr.encoding, AttrData.construct(encoding$cast(u64), 1));

            self->add_die(die);
            return die;
        }

        if (type.kind == Type.Kind.Enum) {
            from type import TypeEnum
            type_enum := type$cast(TypeEnum);

            parent_type_die := self->construct_type_die(type_enum.parent);

            die := DIE();
            bucket.value = die;

            die.tag = DIE.Tag.enumeration_type;
            die.attrs = AttrPair[3]{
                AttrPair.construct(Attr.name, AttrStr.construct(type_enum.name)),
                AttrPair.construct(Attr.type, AttrRef.construct(parent_type_die, 4)),
                AttrPair.construct(Attr.byte_size, AttrData.construct(type_enum.size, 1)),
            };

            self->add_die(die);
            return die;
        }

        if (type.kind == Type.Kind.Function) {
            // TODO
            return self->construct_type_die(Types.instance.type_raw);
        }

        if (type.kind == Type.Kind.Array) {
            // TODO
            return self->construct_type_die(Types.instance.type_raw);
        }

        if (type.kind == Type.Kind.CArray) {
            // TODO
            return self->construct_type_die(Types.instance.type_raw);
        }

        if (type.kind == Type.Kind.Class) {
            from type import TypeClass
            type_class := type$cast(TypeClass);

            die := DIE();
            bucket.value = self->construct_pointer_type_die(die, type_class.name);

            die.tag = DIE.Tag.structure_type;
            die.attrs = AttrPair[1]{
                AttrPair.construct(DIE.Attr.byte_size, AttrData.construct(type_class.size, 1)),
            };

            die.children = DIE[0];
            for (field := type_class.fields) {
                if (field.name == null || field.name == "") {
                    continue;
                }

                member_die := DIE();

                // TODO count in extended classes
                member_type_die := self->construct_type_die(field.type);

                member_die.tag = DIE.Tag.member;
                member_die.attrs = AttrPair[3]{
                    AttrPair.construct(Attr.name, AttrStr.construct(field.name)),
                    AttrPair.construct(Attr.type, AttrRef.construct(member_type_die, 4)),
                    AttrPair.construct(DIE.Attr.data_member_location, AttrData.construct(type_class.size, 1))
                };

                die.children ..= member_die;
            } 

            self->add_die(die);
            return bucket.value$cast(DIE);
        }
        
        io.errorln("Unsupported yet type " .. type->get_name());
        assert(false);
        return null;
    }

}
