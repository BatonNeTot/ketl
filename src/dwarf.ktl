class AttrHeader {
    attr: Attr;
    form: Form;

    fn construct(attr: Attr, form: Form) => AttrHeader {
        self := AttrHeader();
        self.attr = attr;
        self.form = form;
        return self;
    }
}

export class Abbreviation {
    tag: Tag;
    has_children: bool;
    attrs: AttrHeader[];

    fn get_hash(self: Abbreviation) => u64 {
        hash := self.tag$cast(u64);
        if (self.attrs != null) {
            for (header := self.attrs) {
                hash = (hash << 2) ^ (header.attr << 1) ^ header.form;
            }
        }
        return hash;
    }

    fn is_equal(lhs: Abbreviation, rhs: Abbreviation) => bool {
        if (lhs.tag != rhs.tag) {
            return false;
        }

        lhs_attrs_size: u64;
        rhs_attrs_size: u64;
        if (lhs.attrs != null) {
            lhs_attrs_size = lhs.attrs.size;
        }
        if (rhs.attrs != null) {
            rhs_attrs_size = rhs.attrs.size;
        }
        if (lhs_attrs_size != rhs_attrs_size) {
            return false;
        }
        if (lhs_attrs_size == 0) {
            return true;
        }

        i: u64;
        while (i < lhs_attrs_size) {
            if (lhs.attrs[i].attr != rhs.attrs[i].attr) {
                return false;
            }
            if (lhs.attrs[i].form != rhs.attrs[i].form) {
                return false;
            }
            i += 1;
        }

        return true;
    }

    fn print(self: Abbreviation, print_data_directive: (DataDirective, str) => u32) {
        print_data_directive(DataDirective.Bit8, self.tag$cast(str) .. "                               # DW_TAG_" .. self.tag->to_str());
        if (self.has_children) {
            print_data_directive(DataDirective.Bit8, Children.yes$cast(str) .. "                               # DW_CHILDREN_yes");
        } else {
            print_data_directive(DataDirective.Bit8, Children.no$cast(str) .. "                               # DW_CHILDREN_no");
        }
        for (header := self.attrs) {
            print_data_directive(DataDirective.Bit8, header.attr$cast(str) .. "                               # DW_AT_" .. header.attr->to_str());
            print_data_directive(DataDirective.Bit8, header.form$cast(str) .. "                               # DW_FORM_" .. header.form->to_str());
        }
    }
}

// Attributes //////////////////////////

class AttrValue {
    print: (AttrValue, Attr, (DataDirective, str) => u32) => u32;
    form: Form;

    fn construct_empty(form: Form) => AttrValue {
        self := AttrValue();
        self.print = print_empty;
        self.form = form;
        return self;
    }

    fn print_empty(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        import io
        io.println("                                        # DW_AT_" .. tag->to_str());
        return 0;
    }
}

class AttrStr {
    extend AttrValue;
    value: str;
    index: u64;

    fn construct(value: str) => AttrStr {
        self := AttrStr();
        self.print = print;
        self.form = Form.string;
        self.value = value;
        return self;
    }

    fn print(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        self := attr$cast(AttrStr);
        return print_data(self.index$cast(str) .. "                               # DW_AT_" .. tag->to_str(), self.form, print_data_directive);
    }
}

class AttrSecOffset {
    extend AttrValue;
    value: str;

    fn construct(value: str) => AttrSecOffset {
        self := AttrSecOffset();
        self.print = print;
        self.form = Form.sec_offset;
        self.value = value;
        return self;
    }

    fn print(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        self := attr$cast(AttrSecOffset);
        return print_data_directive(DataDirective.Address, self.value .. "                               # DW_AT_" .. tag->to_str());
    }
}

class AttrAddr {
    extend AttrValue;
    value: str;

    fn construct(value: str) => AttrAddr {
        self := AttrAddr();
        self.print = print;
        self.form = Form.addrx;
        self.value = value;
        return self;
    }

    fn print(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        self := attr$cast(AttrAddr);
        return print_data_directive(DataDirective.Bit8, self.value .. "                               # DW_AT_" .. tag->to_str());
    }
}

fn print_data(value: str, form: Form, print_data_directive: (DataDirective, str) => u32) => u32 {
    size: u32;
    switch (form) {
        case Form.data1 => size += print_data_directive(DataDirective.Bit8, value);
        case Form.data2 => size += print_data_directive(DataDirective.Bit16, value);
        case Form.data4 => size += print_data_directive(DataDirective.Bit32, value);
        case Form.data8 => size += print_data_directive(DataDirective.Bit64, value);
        case Form.data16 => assert(false);
        case Form.udata => assert(false);
        case Form.ref1 => size += print_data_directive(DataDirective.Bit8, value);
        case Form.ref2 => size += print_data_directive(DataDirective.Bit16, value);
        case Form.ref4 => size += print_data_directive(DataDirective.Bit32, value);
        case Form.ref8 => size += print_data_directive(DataDirective.Bit64, value);
        case Form.strx1 => size += print_data_directive(DataDirective.Bit8, value);
        case Form.strx2 => size += print_data_directive(DataDirective.Bit16, value);
        case Form.ref_udata => assert(false);
        default => assert(false);
    }
    return size;
}

class AttrAddrData {
    extend AttrValue;
    value: str;

    fn construct(value: str, size: u64) => AttrAddrData {
        self := AttrAddrData();
        self.print = print;
        switch (size) {
            case 1 => self.form = Form.data1;
            case 2 => self.form = Form.data2;
            case 4 => self.form = Form.data4;
            case 8 => self.form = Form.data8;
            case 16 => self.form = Form.data16;
            default => self.form = Form.udata;
        }
        self.value = value;
        return self;
    }

    fn print(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        self := attr$cast(AttrAddrData);
        return print_data(self.value .. "                               # DW_AT_" .. tag->to_str(), self.form, print_data_directive);
    }
}

class AttrData {
    extend AttrValue;
    value: u64;

    fn construct(value: u64, size: u64) => AttrData {
        self := AttrData();
        self.print = print;
        switch (size) {
            case 1 => self.form = Form.data1;
            case 2 => self.form = Form.data2;
            case 4 => self.form = Form.data4;
            case 8 => self.form = Form.data8;
            case 16 => self.form = Form.data16;
            default => self.form = Form.udata;
        }
        self.value = value;
        return self;
    }

    fn print(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        self := attr$cast(AttrData);
        return print_data(self.value$cast(str) .. "                               # DW_AT_" .. tag->to_str(), self.form, print_data_directive);
    }
}

