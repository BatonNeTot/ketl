class AttrExpr {
    extend AttrValue;
    ops: Op[];

    fn construct(ops: Op[]) => AttrExpr {
        self := AttrExpr();
        self.print = print;
        self.form = Form.exprloc;
        self.ops = ops;
        return self;
    }

    fn print(attr: AttrValue, tag: Attr, print_data_directive: (DataDirective, str) => u32) => u32 {
        self := attr$cast(AttrExpr);
        data := print_data_directive(DataDirective.Bit8, self.ops.size$cast(str) .. "                               # DW_AT_" .. tag->to_str());
        for (op := self.ops) {
            data += print_data_directive(DataDirective.Bit8, op$cast(str) .. "                               # DW_OP_" .. op->to_str());
        }
        return data;
    }
}

