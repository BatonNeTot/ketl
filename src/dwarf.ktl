export enum DataDirective: u8 {
    Bit8,
    Bit16,
    Bit32,
    Bit64,
    Address,
}

export fn split_value_to_uleb128(value: u64) => u8[] {
    result := u8[0];

    while (value != 0) {
        byte := (value & 127)$cast(u8); // 0xf7
        value = value >> 7; // TODO replace with shift_assign
        if (value != 0) {
            byte |= 128; // 0x80 to show that there are more
        }
        result ..= byte;
    }

    return result;
}

export fn split_value_to_sleb128(value: i64) => u8[] {
    result := u8[0];

    while (true) {
        byte := (value & 127)$cast(u8); // 0xf7
        value = value >> 7; // TODO replace with shift_assign
        
        sign_bit := byte & 64; // 0x40, sign bit of byte is second high-order bit
        // https://en.wikipedia.org/wiki/LEB128#Encode_signed_integer
        if ((value == 0 && sign_bit == 0) || (value == -1 && sign_bit != 0)) {
            result ..= byte;
            break;
        } else {
            byte |= 128; // 0x80 to show that there are more
        }
        result ..= byte;
    }

    return result;
}

