//🫖ketl

from common import FilePointer
from common import LogAccum
from variable import VariableDecl

import io

from type_base import Type
from type import TypePrimitive
from type import TypeEnum
from type import TypeClass
from type import TypeArray
from type import TypeTuple
from type import Types
from value import Value
from token import Token
from lexer import TokenIterator
from lexer import Lexer
from hir import HIR

from namespace import Namespace
from func import CompileFunctionDeclaration
from module import Modules

from hir_builder import HIRBuilder

class Parser {

    class Context {
        var log_accum: LogAccum;
        var log_info: LogAccum.LogInfo;

        var source: str;
        var namespace: Namespace;
        var iterator: TokenIterator;
        var hir_builder: HIRBuilder;

        var reserved_break: HIR.BlockId;
        var reserved_continue: HIR.BlockId;
        var is_global_scope: bool;
        var exxport: bool;
        var cexxport: bool;
        var next_symbol_entry: bool;
        var omit_var_init: bool;
    }

    fn error(self: Context, offset: u32, length: u32, message: str) {
        self.log_accum->error(
            self.log_info,
            FilePointer.construct(offset, offset, length),
            message 
        );
    }

    fn error_var() => HIR.VarId {
        assert(false);
        return (-1)$cast(HIR.VarId);
    }
 
    fn current_token(context: Context, offset: u64) => Token {
        return context.iterator->current(offset);
    }

    fn token_check(context: Context, token_type: Token.Type) => bool {
        return context->current_token(0).type == token_type;
    }

    fn token_advance(context: Context) {
        while (true) {
            context.iterator->advance();

            if (context->current_token(0).type != Token.Type.ERROR) break;

            // TODO error
            assert(false);
        }
    }

    fn token_match(context: Context, token_type: Token.Type) => bool {
        if (!context->token_check(token_type)) return false;
        context->token_advance();
        return true;
    }

    fn token_consume(context: Context, token_type: Token.Type, message: str) => bool {
        if (!context->token_match(token_type)) {
            var token = context->current_token(0);
            context->error(token.offset, token.length, message);
            return false;
        }
        return true;
    }

    fn token_str(context: Context, token: Token) => str {
        assert(token.offset <= context.source.size && token.offset + token.length <= context.source.size);
        return context.source[token.offset:token.offset + token.length];
    }

    fn get_var(context: Context, var_id: HIR.VarId) => HIR.Var {
        return context.hir_builder.vars[var_id];
    }

    fn get_var_as_type(context: Context, var_id: HIR.VarId) => Type {
        var type_var = context->get_var(var_id);
        if (type_var.kind == HIR.Var.Kind.LiteralType) {
            return type_var$cast(HIR.VarLiteralType).value;
        }

        if (type_var.kind != HIR.Var.Kind.Global) {
            return null;
        }

        var node = type_var$cast(HIR.VarGlobal).node;

        if (node == null || node.value.kind != Value.Kind.Type) {
            return null;
        }
        
        return node.value.value$cast(raw);
    }

    fn get_var_as_namespace(context: Context, var_id: HIR.VarId) => Namespace {
        var namespace_var = context->get_var(var_id);

        if (namespace_var.kind != HIR.Var.Kind.Global) {
            return null;
        }

        var node = namespace_var$cast(HIR.VarGlobal).node;

        if (node == null || node.value.kind != Value.Kind.Namespace) {
            return null;
        }

        return node.value.value$cast(raw);
    }

    class StatementInfo {
        enum ReturnInfo: u8 {
            Empty   = 0,
            None    = 1,
            Value   = 2,
            Undef   = 3, // None | Value
            Always  = 4,

            AlwaysNone  = 5, //None  | Always
            AlwaysValue = 6, //Value | Always;
            AlwaysUndef = 7, //Undef | Always;
        }

        var return_info: ReturnInfo;

        export fn construct(return_info: ReturnInfo) => StatementInfo {
            var self = StatementInfo();
            self.return_info = return_info;
            return self;
        }
    }

    enum Precedence: u8 {
        None,
        Sequence,
        Assigment,
        Colon,
        Pair,
        LogicalOr,
        LogicalAnd,
        Equality,
        Comparison,
        Concat,
        Shift,
        Term,
        Factor,
        BitwiseOr,
        BitwiseXor,
        BitwiseAnd,
        Prefix,
        Call,
        Primary,
    }

    enum Associativity: u8 {
        LTR, // Left To Right
        RTL, // Right To Left
    }

    shared associativity = Associativity[Precedence$count]{
        Precedence.None       => Associativity.LTR,
        Precedence.Sequence   => Associativity.LTR,
        Precedence.Assigment  => Associativity.RTL,
        Precedence.Colon      => Associativity.LTR,
        Precedence.Pair       => Associativity.LTR, // TODO perhaps RTL instead? think about function definition in haskell
        Precedence.LogicalOr  => Associativity.LTR,
        Precedence.LogicalAnd => Associativity.LTR,
        Precedence.Equality   => Associativity.LTR,
        Precedence.Comparison => Associativity.LTR,
        Precedence.Concat     => Associativity.LTR,
        Precedence.Shift      => Associativity.LTR,
        Precedence.Term       => Associativity.LTR,
        Precedence.Factor     => Associativity.LTR,
        Precedence.BitwiseOr  => Associativity.LTR,
        Precedence.BitwiseXor => Associativity.LTR,
        Precedence.BitwiseAnd => Associativity.LTR,
        Precedence.Prefix     => Associativity.LTR,
        Precedence.Call       => Associativity.LTR,
        Precedence.Primary    => Associativity.LTR,
    };

    class ParseRule {
        var prefix: (Context) => HIR.VarId;
        var ltr_infix: (Context, HIR.VarId) => HIR.VarId;
        var rtl_infix: (Context, HIR.VarId, HIR.VarId) => HIR.VarId;
        var precedence: Precedence;

        export fn construct(prefix: (Context) => HIR.VarId, 
                            ltr_infix: (Context, HIR.VarId) => HIR.VarId, 
                            rtl_infix: (Context, HIR.VarId, HIR.VarId) => HIR.VarId,
                            precedence: Precedence) => ParseRule {
            var self = ParseRule();
            self.prefix = prefix;
            self.ltr_infix = ltr_infix;
            self.rtl_infix = rtl_infix;
            self.precedence = precedence;
            return self;
        }
    }

    shared parse_rule_default = ParseRule.construct(null, null, null, Precedence.None);
    
    fn get_parse_rule(token_type: Token.Type) => ParseRule {
        var parse_rule = parse_rules[token_type];
        if (parse_rule != null) {
            return parse_rule;
        } else {
            return parse_rule_default;
        }
    }

    enum Bracket: u8 {
        PARENTHESIS,
        CURLY,
        SQUARE,
    }

    class BracketInfo {
        var type: Bracket;
        var source_offset: Token.Offset;

        fn construct(type: Bracket, source_offset: Token.Offset) => BracketInfo {
            var self = BracketInfo();

            self.type = type;
            self.source_offset = source_offset;

            return self;
        }
    }

    fn get_opening_bracket_str(bracket: BracketInfo) => str {
        switch (bracket.type) {
            case Bracket.PARENTHESIS => return "( at " .. bracket.source_offset$cast(str);
            case Bracket.CURLY => return "{ at " .. bracket.source_offset$cast(str);
            case Bracket.SQUARE => return "[ at " .. bracket.source_offset$cast(str);
        }

        return "<" .. bracket.type$cast(str)  .. "% at " .. bracket.source_offset$cast(str);
    }

    fn get_closing_bracket_str(bracket: BracketInfo) => str {
        switch (bracket.type) {
            case Bracket.PARENTHESIS => return ") at " .. bracket.source_offset$cast(str);
            case Bracket.CURLY => return "} at " .. bracket.source_offset$cast(str);
            case Bracket.SQUARE => return "] at " .. bracket.source_offset$cast(str);
        }

        return "%" .. bracket.type$cast(str)  .. "> at " .. bracket.source_offset$cast(str);
    }

    // returns true if unexpexted closing bracket met
    fn dummy_parse_bracket(context: Context, brackets: BracketInfo[], token: Token) => bool {
        var token_type = token.type;
        switch (token_type) {
            case Token.Type.PARENTHESIS_LEFT => {
                var bracket = BracketInfo.construct(Bracket.PARENTHESIS, token.offset);
                //io.errorln("Pushing " .. bracket->get_opening_bracket_str());
                brackets ..= bracket;
            }
            case Token.Type.CURLY_LEFT => {
                var bracket = BracketInfo.construct(Bracket.CURLY, token.offset);
                //io.errorln("Pushing " .. bracket->get_opening_bracket_str());
                brackets ..= bracket;
            }
            case Token.Type.SQUARE_LEFT => {
                var bracket = BracketInfo.construct(Bracket.SQUARE, token.offset);
                //io.errorln("Pushing " .. bracket->get_opening_bracket_str());
                brackets ..= bracket;
            }
            case Token.Type.PARENTHESIS_RIGHT => {
                var closing_bracket = BracketInfo.construct(Bracket.PARENTHESIS, token.offset);
                if (brackets.size <= 0) {
                    return true;
                }
                var bracket = brackets[brackets.size - 1];
                if (bracket.type != closing_bracket.type) {
                    io.errorln("Got " .. closing_bracket->get_closing_bracket_str() .. " to close " .. bracket->get_opening_bracket_str());
                    io.errorln("Full stack:");
                    for (var stack_bracket <- brackets) {
                        io.errorln(stack_bracket->get_opening_bracket_str());
                    }
                    assert(false);
                }
                //io.errorln("Poping " .. bracket->get_opening_bracket_str() .. " with " .. closing_bracket->get_closing_bracket_str());
                brackets->pop();
            }
            case Token.Type.CURLY_RIGHT => {
                var closing_bracket = BracketInfo.construct(Bracket.CURLY, token.offset);
                if (brackets.size <= 0) {
                    return true;
                }
                var bracket = brackets[brackets.size - 1];
                if (bracket.type != closing_bracket.type) {
                    io.errorln("Got " .. closing_bracket->get_closing_bracket_str() .. " to close " .. bracket->get_opening_bracket_str());
                    io.errorln("Full stack:");
                    for (var stack_bracket <- brackets) {
                        io.errorln(stack_bracket->get_opening_bracket_str());
                    }
                    assert(false);
                }
                //io.errorln("Poping " .. bracket->get_opening_bracket_str() .. " with " .. closing_bracket->get_closing_bracket_str());
                brackets->pop();
            }
            case Token.Type.SQUARE_RIGHT => {
                var closing_bracket = BracketInfo.construct(Bracket.SQUARE, token.offset);
                if (brackets.size <= 0) {
                    return true;
                }
                var bracket = brackets[brackets.size - 1];
                if (bracket.type != closing_bracket.type) {
                    io.errorln("Got " .. closing_bracket->get_closing_bracket_str() .. " to close " .. bracket->get_opening_bracket_str());
                    io.errorln("Full stack:");
                    for (var stack_bracket <- brackets) {
                        io.errorln(stack_bracket->get_opening_bracket_str());
                    }
                    assert(false);
                }
                //io.errorln("Poping " .. bracket->get_opening_bracket_str() .. " with " .. closing_bracket->get_closing_bracket_str());
                brackets->pop();
            }
        }
        
        return false;
    }

    fn parse_identificator(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, token);

        if (token.type == Token.Type.ID) {
            var name = context->token_str(token);
            var var_id = context.hir_builder->get_var(context.namespace, name, name, src_info);
            if (context.hir_builder->is_undef(var_id)) {
                context->error(src_info.source_offset, src_info.length, "Undeclared variable.");
            }

            return var_id;
        }

        switch (token.type) {
            case Token.Type.I8    => return context.hir_builder->push_literal_type(Types.instance.type_i8, src_info);
            case Token.Type.I16   => return context.hir_builder->push_literal_type(Types.instance.type_i16, src_info);
            case Token.Type.I32   => return context.hir_builder->push_literal_type(Types.instance.type_i32, src_info);
            case Token.Type.I64   => return context.hir_builder->push_literal_type(Types.instance.type_i64, src_info);
            case Token.Type.U8    => return context.hir_builder->push_literal_type(Types.instance.type_u8, src_info);
            case Token.Type.U16   => return context.hir_builder->push_literal_type(Types.instance.type_u16, src_info);
            case Token.Type.U32   => return context.hir_builder->push_literal_type(Types.instance.type_u32, src_info);
            case Token.Type.U64   => return context.hir_builder->push_literal_type(Types.instance.type_u64, src_info);
            case Token.Type.BOOL  => return context.hir_builder->push_literal_type(Types.instance.type_bool, src_info);
            case Token.Type.CHAR  => return context.hir_builder->push_literal_type(Types.instance.type_char, src_info);
            case Token.Type.CSTR  => return context.hir_builder->push_literal_type(Types.instance->get_cstr_type(), src_info);
            case Token.Type.FALSE => return context.hir_builder->push_literal_number_of_type(0, Types.instance.type_bool, src_info);
            case Token.Type.NULL  => return context.hir_builder->push_literal_number_of_type(0, Types.instance.type_raw, src_info);
            case Token.Type.RAW   => return context.hir_builder->push_literal_type(Types.instance.type_raw, src_info);
            case Token.Type.STR   => return context.hir_builder->push_literal_type(Types.instance->get_str_type(), src_info);
            case Token.Type.TRUE => return context.hir_builder->push_literal_number_of_type(1, Types.instance.type_bool, src_info);
        }

        return error_var();
    }

    fn parse_number(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        return context.hir_builder->push_literal_number(context->token_str(token)$cast(u64), HIR.SrcInfo.from_token(context.log_info.filename, token));
    }

    fn parse_string(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        return context.hir_builder->push_new_string_literal(context->token_str(token), HIR.SrcInfo.from_token(context.log_info.filename, token));
    }

    fn parse_char(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        var literal = context->token_str(token);
        var int_repr: u64;
        if (literal.size == 1) {
            int_repr = literal[0]$cast(u64);
        } else if (literal.size == 2) {
            assert(literal[0] == '\\');
            var symbol = literal[1];
            int_repr = Lexer.resolve_escaped_char(symbol);
        } else {
            assert(false);
        }
        return context.hir_builder->push_literal_number_of_type(int_repr, Types.instance.type_char, HIR.SrcInfo.from_token(context.log_info.filename, token));
    }

    fn parse_sequence(context: Context, lhs_id: HIR.VarId) => HIR.VarId {
        var rhs_id = context->parse_precedence(Precedence.Sequence + 1);
        var src_info = HIR.SrcInfo.merge(context->get_var(lhs_id).src_info, context->get_var(rhs_id).src_info);

        var lhs = context->get_var(lhs_id);

        if (lhs.kind != HIR.Var.Kind.Sequence) {
            return context.hir_builder->push_sequence(HIR.VarId[2]{
                lhs_id, rhs_id,
            }, src_info);
        } else {
            lhs$cast(HIR.VarSequence).values ..= rhs_id;
            lhs.src_info = src_info;
            return lhs_id;
        }
    }
    
    fn parse_grouping(context: Context) => HIR.VarId {
        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));
        var expr_id = context->parse_expression();
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after expression.");
        src_info = HIR.SrcInfo.merge(src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));

        var expr = context->get_var(expr_id);
        var expr_as_type = context->get_var_as_type(expr_id);
        if (expr_as_type != null) {
            var tuple = Types.instance->get_tuple_type(Type[1]{ 
                expr_as_type,
            });
            return context.hir_builder->push_literal_type(expr_as_type, src_info);
        } else if (expr.kind == HIR.Var.Kind.Sequence) {
            var values = expr$cast(HIR.VarSequence).values;
            var seq_as_types = Type[0];
            for (var value_id <- values) {
                var value_as_type = context->get_var_as_type(value_id);
                if (value_as_type == null) {
                    break;
                }

                seq_as_types ..= value_as_type;
            }
            if (values.size == seq_as_types.size) {
                var tuple = Types.instance->get_tuple_type(seq_as_types);
                return context.hir_builder->push_literal_type(tuple, src_info);
            }
        }

        // TODO create new var to update src_info
        return expr_id;
    }

    fn parse_indexing(context: Context, var_id: HIR.VarId) => HIR.VarId {
        if (context->token_match(Token.Type.SQUARE_RIGHT)) {
            var src_info = HIR.SrcInfo.merge(context->get_var(var_id).src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));
            var var_as_type = context->get_var_as_type(var_id);
            if (var_as_type == null) {
                context->error(src_info.source_offset, src_info.length, "Can't have empty indexing expression.");
                return context.hir_builder->push_error_var(src_info);
            }
            var array_type = Types.instance->get_array_type(var_as_type);
            return context.hir_builder->push_literal_type(array_type, src_info);
        }
        
        if (context->token_match(Token.Type.COLON)) {
            var start_id = context.hir_builder->push_literal_number(0, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));
            
            var end_id: HIR.VarId;
            if (context->token_match(Token.Type.SQUARE_RIGHT)) {
                io.errorln("Subrange with deducted end");
                assert(false);
            } else {
                end_id = context->parse_precedence(Precedence.Colon + 1);
            }
            
            context->token_consume(Token.Type.SQUARE_RIGHT, "Expected ']' after expression.");

            var src_info = HIR.SrcInfo.merge(context->get_var(var_id).src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));
            return context.hir_builder->push_new_slice(var_id, start_id, end_id, src_info);
        }

        var expr_id = context->parse_precedence(Precedence.Colon + 1);
        
        if (context->token_match(Token.Type.COLON)) {
            var start_id = expr_id;

            var end_id: HIR.VarId;
            if (context->token_match(Token.Type.SQUARE_RIGHT)) {
                io.errorln("Subrange with deducted end");
                assert(false);
            } else {
                end_id = context->parse_precedence(Precedence.Colon + 1);
            }
            
            context->token_consume(Token.Type.SQUARE_RIGHT, "Expected ']' after expression.");

            var src_info = HIR.SrcInfo.merge(context->get_var(var_id).src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));
            return context.hir_builder->push_new_slice(var_id, start_id, end_id, src_info);
        }
        context->token_consume(Token.Type.SQUARE_RIGHT, "Expected ']' after expression.");

        var src_info = HIR.SrcInfo.merge(context->get_var(var_id).src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));

        var var_as_type = context->get_var_as_type(var_id);
        if (var_as_type != null) {
            var array_type = Types.instance->get_array_type(var_as_type);

            var array_id = context.hir_builder->push_new_array(array_type, expr_id, src_info);

            if (!context->token_match(Token.Type.CURLY_LEFT)) {
                return array_id;
            }

            var index_var_id = (-1)$cast(HIR.VarId);
            while (true) {
                if (context->token_check(Token.Type.CURLY_RIGHT)) {
                    break;
                }

                var value_id = context->parse_precedence(Precedence.Pair + 1);

                if (context->token_match(Token.Type.DOUBLE_ARROW_RIGHT)) {
                    index_var_id = value_id;
                    value_id = context->parse_precedence(Precedence.Sequence + 1);
                } else if (index_var_id == (-1)$cast(HIR.VarId)) {
                    var local_src_info = context->get_var(value_id).src_info;
                    index_var_id = context.hir_builder->push_temp_var_of_type(Types.instance.type_u64, local_src_info);
                    var zero_id = context.hir_builder->push_literal_number_of_type(0, Types.instance.type_u64, local_src_info);
                    context.hir_builder->push_assign(HIR.Tag.ASSIGN, index_var_id, zero_id, local_src_info);
                } else {
                    var local_src_info = context->get_var(value_id).src_info;
                    var one_id = context.hir_builder->push_literal_number_of_type(1, Types.instance.type_u64, local_src_info);
                    index_var_id = context.hir_builder->push_binary_op(HIR.Tag.PLUS, index_var_id, one_id, local_src_info);
                }

                context.hir_builder->push_set_array_value(array_id, index_var_id, value_id, HIR.SrcInfo.merge(
                    context->get_var(index_var_id).src_info, context->get_var(value_id).src_info));

                if (!context->token_match(Token.Type.COMMA)) {
                    break;
                }
            }
            
            context->token_consume(Token.Type.CURLY_RIGHT, "Expected '}' after array initialization values.");
            return array_id;
        } else {
            return context.hir_builder->push_get_array_value(var_id, expr_id, src_info);
        }
    }

    fn parse_argument_list(context: Context) => HIR.VarId[] {
        var arguments = HIR.VarId[0];
        if (!context->token_check(Token.Type.PARENTHESIS_RIGHT)) {
            while (true) {
                var arg = context->parse_precedence(Precedence.Sequence + 1);
                arguments ..= arg;
                
                if (!context->token_match(Token.Type.COMMA)) {
                    break;
                }
            }
        }
        
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after arguments.");
        return arguments;
    }

    fn parse_call_impl(context: Context, callee_id: HIR.VarId, collected_arguments: HIR.VarId[]) => HIR.VarId {
        var arguments = context->parse_argument_list();
        if (collected_arguments != null && collected_arguments.size > 0) {
            arguments = collected_arguments .. arguments;
        }
        if (context.hir_builder->is_undef(callee_id)) {
            return callee_id;
        }

        var callee = context->get_var(callee_id);
        var src_info = HIR.SrcInfo.merge(callee.src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));

        if (callee.kind == HIR.Var.Kind.Global) {
            var callee_node = callee$cast(HIR.VarGlobal).node;

            if (callee_node.value.kind == Value.Kind.Type) {
                var callee_type = callee_node.value.value$cast(raw)$cast(Type);
                if (callee_type.kind != Type.Kind.Class) {
                    context->error(src_info.source_offset, src_info.length, "Only class objects can be constructed through calling a type.");
                    return context.hir_builder->push_error_var(src_info);
                }

                return context.hir_builder->push_new(callee_type$cast(TypeClass), arguments, src_info);
            }
        }

        return context.hir_builder->push_call(callee_id, arguments, src_info);
    }

    fn parse_call(context: Context, callee_id: HIR.VarId) => HIR.VarId {
        return context->parse_call_impl(callee_id, null);
    }

    fn parse_arrow_operator(context: Context, object_id: HIR.VarId) => HIR.VarId {
        var callee_id = context->parse_dot_operator(object_id);
        context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected call after id of an arrow operator.");

        return context->parse_call_impl(callee_id, HIR.VarId[1]{ object_id });
    }

    fn parse_dot_operator(context: Context, object_id: HIR.VarId) => HIR.VarId {
        if (context.hir_builder->is_undef(object_id)) {
            return object_id;
        }

        var object = context->get_var(object_id);
        var is_arrow_op = false;
        switch (context->current_token(1).type) {
            case Token.Type.DOT => context->token_consume(Token.Type.ID, "Expected id after access operator.");
            case Token.Type.ARROW_RIGHT => {
                is_arrow_op = true;
                context->token_consume(Token.Type.ID, "Expected id after arrow operator.");
            }
            default => {
                io.errorln("Unknown token '" .. context->current_token(1).type$cast(str) .. "' as dot operator.");
                assert(false);
            }
        }
        
        var id_token = context->current_token(1);
        var id = context->token_str(id_token);

        var src_info = HIR.SrcInfo.merge(object.src_info, HIR.SrcInfo.from_token(context.log_info.filename, id_token));

        if (context.hir_builder->is_undef(object_id)) {
            return context.hir_builder->push_error_var(src_info);
        }

        var object_as_type = context->get_var_as_type(object_id);
        if (object_as_type != null) {
            var type = object_as_type;

            if (type.kind == Type.Kind.Class) {
                return context.hir_builder->push_class_namespace_access(type$cast(TypeClass), id, src_info, true);
            }

            if (type.kind == Type.Kind.Enum) {
                var constant = type$cast(TypeEnum)->find_constant(id);
                
                if (constant == null) {
                    context->error(src_info.source_offset, src_info.length, "Undeclared constant '" .. id .. "' of enum '" .. type->get_name() .. "'.");
                    return context.hir_builder->push_error_var(src_info);
                }

                return context.hir_builder->push_literal_number_of_type(constant.value, type, src_info);
            }

            context->error(src_info.source_offset, src_info.length, "Unknown property '" .. id .. "' of type '" .. type->get_name() .. "'.");
            return context.hir_builder->push_error_var(src_info);
        }

        var object_as_namespace = context->get_var_as_namespace(object_id);
        if (object_as_namespace != null) {
            return context.hir_builder->get_namespace_var(object_as_namespace, id, src_info, true);
        }

        var object_type = object->get_type();

        if (!is_arrow_op && object_type.kind != Type.Kind.Class && object_type.kind != Type.Kind.Array) {
            context->error(src_info.source_offset, src_info.length, "Fields and properties through access parameter only allowed for class and array objects.");
            return context.hir_builder->push_error_var(src_info);
        }

        var field_id = context->token_str(id_token);
        if (!is_arrow_op) {
            return context.hir_builder->push_field_access_forced(object_id, field_id, src_info);
        } else {
            var field_var = context.hir_builder->try_push_field_access(object_id, field_id, src_info);
            if (!context.hir_builder->is_undef(field_var)) {
                return field_var;
            }

            field_var = context.hir_builder->get_var(context.namespace, field_id, field_id, src_info);
            if (context.hir_builder->is_undef(field_var)) {
                context->error(src_info.source_offset, src_info.length, "Undeclared variable.");
            }

            return field_var;
        }
    }

    fn parse_double_arrow_operator(context: Context, lhs_id: HIR.VarId) => HIR.VarId {
        var rhs_id = context->parse_precedence(Precedence.Pair + 1);
        var src_info = HIR.SrcInfo.merge(context->get_var(lhs_id).src_info, context->get_var(rhs_id).src_info);

        var lhs_as_type = context->get_var_as_type(lhs_id);
        var rhs_as_type = context->get_var_as_type(rhs_id);

        if (lhs_as_type != null && rhs_as_type != null) {
            var signature = Type[1]{ rhs_as_type };
            if (lhs_as_type.kind != Type.Kind.Tuple) {
                signature ..= lhs_as_type;
            } else {
                signature ..= lhs_as_type$cast(TypeTuple).values;
            }
            return context.hir_builder->push_literal_type(Types.instance->get_function_type(signature), src_info);
        }
        
        context->error(src_info.source_offset, src_info.length, "WTF.");
        return context.hir_builder->push_error_var(src_info);
    }
    
    fn parse_dollar_operator(context: Context, lhs: HIR.VarId) => HIR.VarId {
        var object = context->get_var(lhs);
        context->token_consume(Token.Type.ID, "Expected id after meta access operator.");
        var id_token = context->current_token(1);
        var id = context->token_str(id_token);

        var src_info =  HIR.SrcInfo.merge(object.src_info, HIR.SrcInfo.from_token(context.log_info.filename, id_token));

        if (context.hir_builder->is_undef(lhs)) {
            return context.hir_builder->push_error_var(src_info);
        }

        {
            var object_as_type = context->get_var_as_type(lhs);
            if (object_as_type != null) {
                if (id == "size") {
                    var type_size = object_as_type->get_size();
                    return context.hir_builder->push_literal_number(type_size, src_info);
                }

                if (id == "count") {
                    if (object_as_type.kind != Type.Kind.Enum) {
                        context->error(src_info.source_offset, src_info.length, "Only enum has meta property 'count'.");
                        return context.hir_builder->push_error_var(src_info);
                    }

                    var enum_count = object_as_type$cast(TypeEnum).constants.size;
                    return context.hir_builder->push_literal_number(enum_count, src_info);
                }

                context->error(src_info.source_offset, src_info.length, "There is no meta property '" .. id .. "' of type.");
                return context.hir_builder->push_error_var(src_info);
            }
        }

        if (id == "cast") {
            context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected '(' after 'cast' meta property.");
            var target_type = context->parse_type();
            context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after 'cast' meta property parameter.");

            src_info = HIR.SrcInfo.merge(src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));

            return context.hir_builder->cast_to_type_forced(lhs, target_type, src_info, true);
        }

        context->error(src_info.source_offset, src_info.length, "There is no meta property '" .. id .. "'.");
        return context.hir_builder->push_error_var(src_info);
    }

    fn parse_short_circuit(context: Context, lhs_id: HIR.VarId) => HIR.VarId {
        var token_type = context->current_token(1).type;
        var parse_rule = token_type->get_parse_rule();

        if (context.hir_builder->is_undef(lhs_id)) {
            return lhs_id;
        }
        var lhs = context->get_var(lhs_id);
        var src_info = lhs.src_info;
        
        var first_block = context.hir_builder->reserve_blocks(3);
        var second_block = first_block;
        var short_circuit_block = first_block + 1;
        var after_block = first_block + 2;

        var true_statement: HIR.BlockId;
        var false_statement: HIR.BlockId;
        switch (token_type) {
            case Token.Type.LOGICAL_OR => {
                true_statement = short_circuit_block;
                false_statement = second_block;
                break;
            }
            case Token.Type.LOGICAL_AND => {
                true_statement = second_block;
                false_statement = short_circuit_block;
                break;
            }
            default => assert(false);
        }
        context.hir_builder->push_if(lhs_id, true_statement, false_statement, src_info);

        context.hir_builder->set_block(second_block);
        var rhs_id = context->parse_precedence(parse_rule.precedence + 1);

        var rhs = context->get_var(rhs_id);
        src_info = HIR.SrcInfo.merge(src_info, rhs.src_info);

        if (context.hir_builder->is_undef(rhs_id)) {
            return context.hir_builder->push_error_var(src_info);
        }

        // TODO check if both literals and calc

        var common_type = context.hir_builder->get_common_type(lhs_id, rhs_id);

        if (common_type == null) {
            var lhs_type = lhs->get_type_forced();
            var rhs_type = rhs->get_type_forced();

            context->error(src_info.source_offset, src_info.length, "Can't do logical operations over '" 
                .. lhs_type->get_name() .. "' and '" .. rhs_type->get_name() .. "'.");
            return context.hir_builder->push_error_var(src_info);
        }
        
        var output_type = common_type;
        var output_var = context.hir_builder->push_temp_var_of_type(output_type, src_info); 
        
        rhs_id = context.hir_builder->cast_to_type_forced(rhs_id, output_type, rhs.src_info, false);
        context.hir_builder->push_assign(HIR.Tag.ASSIGN, output_var, rhs_id, src_info);
        context.hir_builder->push_jump(after_block, src_info);
        
        context.hir_builder->set_block(short_circuit_block);
        lhs_id = context.hir_builder->cast_to_type_forced(lhs_id, output_type, lhs.src_info, false);
        context.hir_builder->push_assign(HIR.Tag.ASSIGN, output_var, lhs_id, src_info);
        context.hir_builder->push_jump(after_block, src_info);

        context.hir_builder->set_block(after_block);

        return output_var;
    }

    fn parse_unary_rtl(context: Context) => HIR.VarId {
        var token = context->current_token(1);
        var token_type = token.type;
        var rhs_id = context->parse_precedence(Precedence.Call);
        var src_info = HIR.SrcInfo.merge(HIR.SrcInfo.from_token(context.log_info.filename, token), context->get_var(rhs_id).src_info);

        switch (token_type) {
            case Token.Type.LOGICAL_NOT => return context.hir_builder->push_unary_op(HIR.Tag.LOGICAL_NOT, rhs_id, src_info);
            case Token.Type.BITWISE_NOT => return context.hir_builder->push_unary_op(HIR.Tag.BITWISE_NOT, rhs_id, src_info);

            case Token.Type.PLUS        => return context.hir_builder->push_unary_op(HIR.Tag.UNARY_PLUS,  rhs_id, src_info);
            case Token.Type.MINUS       => return context.hir_builder->push_unary_op(HIR.Tag.UNARY_MINUS, rhs_id, src_info);
        }

        return error_var();
    }

    fn parse_binary_ltr(context: Context, lhs: HIR.VarId) => HIR.VarId {
        var token_type = context->current_token(1).type;
        var parse_rule = token_type->get_parse_rule();
        var rhs = context->parse_precedence(parse_rule.precedence + 1);
        var src_info = HIR.SrcInfo.merge(context->get_var(lhs).src_info, context->get_var(rhs).src_info);

        switch (token_type) {
            case Token.Type.PLUS                => return context.hir_builder->push_binary_op(HIR.Tag.PLUS,                lhs, rhs, src_info);
            case Token.Type.MINUS               => return context.hir_builder->push_binary_op(HIR.Tag.MINUS,               lhs, rhs, src_info);
            case Token.Type.MULTIPLY            => return context.hir_builder->push_binary_op(HIR.Tag.MULTY,               lhs, rhs, src_info);
            case Token.Type.DIVIDE              => return context.hir_builder->push_binary_op(HIR.Tag.DIVIDE,              lhs, rhs, src_info);
            case Token.Type.REMAINDER           => return context.hir_builder->push_binary_op(HIR.Tag.MOD,                 lhs, rhs, src_info);
            
            case Token.Type.CONCAT              => return context.hir_builder->push_concat(lhs, rhs, src_info);

            case Token.Type.LESS                => return context.hir_builder->push_binary_op(HIR.Tag.LESS,                lhs, rhs, src_info);
            case Token.Type.LESS_OR_EQUAL       => return context.hir_builder->push_binary_op(HIR.Tag.LESS_OR_EQUAL,       lhs, rhs, src_info);
            case Token.Type.GREATER             => return context.hir_builder->push_binary_op(HIR.Tag.GREATER,             lhs, rhs, src_info);
            case Token.Type.GREATER_OR_EQUAL    => return context.hir_builder->push_binary_op(HIR.Tag.GREATER_OR_EQUAL,    lhs, rhs, src_info);
            case Token.Type.EQUAL               => return context.hir_builder->push_binary_op(HIR.Tag.EQUAL,               lhs, rhs, src_info);
            case Token.Type.NOT_EQUAL           => return context.hir_builder->push_binary_op(HIR.Tag.NOT_EQUAL,           lhs, rhs, src_info);
            
            case Token.Type.BITWISE_AND         => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_AND,         lhs, rhs, src_info);
            case Token.Type.BITWISE_OR          => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_OR,          lhs, rhs, src_info);
            case Token.Type.BITWISE_XOR         => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_XOR,         lhs, rhs, src_info);
            
            case Token.Type.BITWISE_SHIFT_LEFT  => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_SHIFT_LEFT,  lhs, rhs, src_info);
            case Token.Type.BITWISE_SHIFT_RIGHT => return context.hir_builder->push_binary_op(HIR.Tag.BITWISE_SHIFT_RIGHT, lhs, rhs, src_info);
            }

        return error_var();
    }

    fn parse_binary_rtl(context: Context, lhs: HIR.VarId, rhs: HIR.VarId) => HIR.VarId {
        var token_type = context->current_token(1).type;
        var src_info = HIR.SrcInfo.merge(context->get_var(lhs).src_info, context->get_var(rhs).src_info);

        switch (token_type) {
            case Token.Type.ASSIGN             => return context.hir_builder->push_assign(HIR.Tag.ASSIGN, lhs, rhs, src_info);

            case Token.Type.ASSIGN_PLUS        => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_PLUS, lhs, rhs, src_info);
            case Token.Type.ASSIGN_MINUS       => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_MINUS, lhs, rhs, src_info);
            case Token.Type.ASSIGN_MULTIPLY    => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_MULTY, lhs, rhs, src_info);
            case Token.Type.ASSIGN_DIVIDE      => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_DIVIDE, lhs, rhs, src_info);
            case Token.Type.ASSIGN_REMAINDER   => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_MOD, lhs, rhs, src_info);

            case Token.Type.ASSIGN_CONCAT      => return context.hir_builder->push_append(lhs, rhs, src_info);

            case Token.Type.ASSIGN_BITWISE_AND => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_BITWISE_AND, lhs, rhs, src_info);
            case Token.Type.ASSIGN_BITWISE_OR  => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_BITWISE_OR, lhs, rhs, src_info);
            case Token.Type.ASSIGN_BITWISE_XOR => return context.hir_builder->push_assign(HIR.Tag.ASSIGN_BITWISE_XOR, lhs, rhs, src_info);
        }

        return error_var();
    }
    
    fn parse_lhs_operand(context: Context, precedence: Precedence) => HIR.VarId {  
        var current_token = context->current_token(1);
        var prefix_rule = current_token.type->get_parse_rule().prefix;
        if (prefix_rule == null) {
            context->error(current_token.offset, current_token.length, "Expected expression.");
            return context.hir_builder->push_error_var(HIR.SrcInfo.from_token(context.log_info.filename, current_token));
        }

        var lhs = context->prefix_rule();

        current_token = context->current_token(0);
        var current_precedence = current_token.type->get_parse_rule().precedence;
        while (associativity[current_precedence] == Associativity.LTR && precedence <= current_precedence) {
            context->token_advance();

            var ltr_infix_rule = context->current_token(1).type->get_parse_rule().ltr_infix;
            if (ltr_infix_rule == null) {
                var token_line = context.log_info->find_line(context->current_token(1).offset);
                var prev_token_line = context.log_info->find_line(context->current_token(2).offset);

                if (token_line > prev_token_line) {
                    // Line break, replaces terminator ';'
                    break;
                }

                context->error(context->current_token(1).offset, context->current_token(1).length, "Expected operator (ltr).");
                return context.hir_builder->push_error_var(HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));
            }
            lhs = context->ltr_infix_rule(lhs);

            current_token = context->current_token(0);
            current_precedence = current_token.type->get_parse_rule().precedence;
        }
    
        return lhs;
    }

    fn parse_precedence(context: Context, precedence: Precedence) => HIR.VarId {
        context->token_advance();

        // looking for the rtl operator
        var start_pos = context.iterator->mark();
        var brackets_stack = BracketInfo[0];

        var token = context->current_token(1);
        context->dummy_parse_bracket(brackets_stack, token);
        var parse_rule = token.type->get_parse_rule();
        var token_precedence = parse_rule.precedence;
        while (precedence < token_precedence && associativity[token_precedence] != Associativity.RTL) {
            context->token_advance();

            token = context->current_token(1);
            var current_token_type = token.type;
            if (current_token_type == Token.Type.EOF) {
                //context->error(token.offset, token.length, "Expected operator, got EOF.");
                //return context.hir_builder->push_error_var(HIR.SrcInfo.from_token(context.log_info.filename, token));
                break;
            }

            if (context->dummy_parse_bracket(brackets_stack, token)) {
                break;
            }

            parse_rule = current_token_type->get_parse_rule();
            if (current_token_type != Token.Type.PARENTHESIS_RIGHT 
                && current_token_type != Token.Type.SQUARE_RIGHT 
                && current_token_type != Token.Type.CURLY_RIGHT 
                && brackets_stack.size == 0) {
                token_precedence = parse_rule.precedence;
            }
        }

        // we coudln't find rtl operator, restoring token iterator and do simple ltr
        if (precedence > token_precedence || associativity[token_precedence] != Associativity.RTL) {
            context.iterator->rewind(start_pos);
            
            var lhs_id = context->parse_lhs_operand(precedence);
            return lhs_id;
        }

        // parse after the operator, rhs operand
        var rhs = context->parse_precedence(token_precedence);

        // saving end of the rhs operand for restoring later
        var end_pos = context.iterator->mark();
        context.iterator->rewind(start_pos);

        var lhs = context->parse_lhs_operand(precedence);
            
        context->token_advance();

        // back to the rtl operator
        var rtl_infix = context->current_token(1).type->get_parse_rule().rtl_infix;
        if (rtl_infix == null) {
            var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(2)); // TODO really 2? not 1?
            context->error(src_info.source_offset, src_info.length, "Expected operator (rtl).");
            return context.hir_builder->push_error_var(src_info);
        }
        lhs = context->rtl_infix(lhs, rhs);

        // restore token iterator
        context.iterator->rewind(end_pos);
        return lhs;
    }

    fn parse_expression(context: Context) => HIR.VarId {
        return context->parse_precedence(Precedence.None + 1);
    }

    fn parse_type(context: Context) => Type {
        var type_var_id = context->parse_precedence(Precedence.Assigment + 1);
        var type = context->get_var_as_type(type_var_id);

        if (type == null) {
            // TODO error
            return null;
        }

        return type;
    }

    shared parse_rules = ParseRule[Token.Type$count]{
        Token.Type.ID                  => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.LITERAL_INTEGER     => ParseRule.construct(parse_number,        null,                        null,             Precedence.Primary), 
        Token.Type.LITERAL_STRING      => ParseRule.construct(parse_string,        null,                        null,             Precedence.Primary), 
        Token.Type.LITERAL_CHAR        => ParseRule.construct(parse_char,          null,                        null,             Precedence.Primary), 
        Token.Type.PARENTHESIS_LEFT    => ParseRule.construct(parse_grouping,      parse_call,                  null,             Precedence.Call),
        Token.Type.SQUARE_LEFT         => ParseRule.construct(null,                parse_indexing,              null,             Precedence.Call),
        Token.Type.DOT                 => ParseRule.construct(null,                parse_dot_operator,          null,             Precedence.Call),
        Token.Type.COMMA               => ParseRule.construct(null,                parse_sequence,              null,             Precedence.Sequence),
        Token.Type.DOLLAR              => ParseRule.construct(null,                parse_dollar_operator,       null,             Precedence.Call),
        Token.Type.LOGICAL_NOT         => ParseRule.construct(parse_unary_rtl,     null,                        null,             Precedence.None),
        Token.Type.LOGICAL_AND         => ParseRule.construct(null,                parse_short_circuit,         null,             Precedence.LogicalAnd),
        Token.Type.LOGICAL_OR          => ParseRule.construct(null,                parse_short_circuit,         null,             Precedence.LogicalOr),
        Token.Type.ARROW_RIGHT         => ParseRule.construct(null,                parse_arrow_operator,        null,             Precedence.Call),
        Token.Type.DOUBLE_ARROW_RIGHT  => ParseRule.construct(null,                parse_double_arrow_operator, null,             Precedence.Pair),
        Token.Type.LESS                => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Comparison),
        Token.Type.LESS_OR_EQUAL       => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Comparison),
        Token.Type.GREATER             => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Comparison),
        Token.Type.GREATER_OR_EQUAL    => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Comparison),
        Token.Type.EQUAL               => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Equality),
        Token.Type.NOT_EQUAL           => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Equality),
        Token.Type.BITWISE_NOT         => ParseRule.construct(parse_unary_rtl,     null,                        null,             Precedence.None),
        Token.Type.BITWISE_AND         => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.BitwiseAnd),
        Token.Type.BITWISE_OR          => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.BitwiseOr),
        Token.Type.BITWISE_XOR         => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.BitwiseXor),
        Token.Type.BITWISE_SHIFT_LEFT  => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Shift),
        Token.Type.BITWISE_SHIFT_RIGHT => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Shift),
        Token.Type.INCREMENT           => ParseRule.construct(null,                null,                        null,             Precedence.None),
        Token.Type.DECREMENT           => ParseRule.construct(null,                null,                        null,             Precedence.None),
        Token.Type.PLUS                => ParseRule.construct(parse_unary_rtl,     parse_binary_ltr,            null,             Precedence.Term),
        Token.Type.MINUS               => ParseRule.construct(parse_unary_rtl,     parse_binary_ltr,            null,             Precedence.Term),
        Token.Type.MULTIPLY            => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Factor),
        Token.Type.DIVIDE              => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Factor),
        Token.Type.REMAINDER           => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Factor),
        Token.Type.CONCAT              => ParseRule.construct(null,                parse_binary_ltr,            null,             Precedence.Concat),
        Token.Type.ASSIGN              => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_PLUS         => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_MINUS        => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_MULTIPLY     => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_DIVIDE       => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_REMAINDER    => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_CONCAT       => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_BITWISE_AND  => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_BITWISE_OR   => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.ASSIGN_BITWISE_XOR  => ParseRule.construct(null,                null,                        parse_binary_rtl, Precedence.Assigment),
        Token.Type.I8                  => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.I16                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.I32                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.I64                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.U8                  => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.U16                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.U32                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.U64                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.F32                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.F64                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.BOOL                => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.CHAR                => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.CSTR                => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.FALSE               => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.NULL                => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.RAW                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.STR                 => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
        Token.Type.TRUE                => ParseRule.construct(parse_identificator, null,                        null,             Precedence.Primary),
    };

    fn parse_import(context: Context) => StatementInfo {
        var path = "";
        var start_src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(0));

        context->token_advance(); // import
        var module_token = context->current_token(0);
        context->token_advance(); // id
        while (context->token_match(Token.Type.DOT)) {
            path ..= context->token_str(module_token);
            path ..= "/";
            module_token = context->current_token(0);
            context->token_advance(); // module id
        }

        var src_info = HIR.SrcInfo.merge(
            start_src_info,
            HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));

        var module_name = context->token_str(module_token);

        from module import Modules
        var module = Modules.instance->load(module_name, path, null, true);
        if (module == null) {
            context->error(src_info.source_offset, src_info.length, "Couldn't load module '" .. module_name .. "'.");
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        context.namespace->import_namespace(module_name, null, module.namespace, context.exxport);

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_sharp_prefix(context: Context) => StatementInfo {
        context->token_advance(); // #
        context->token_consume(Token.Type.ID, "Expected id after '#' prefix.");
        var id_token = context->current_token(1);

        var src_info = HIR.SrcInfo.merge(HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(2)), HIR.SrcInfo.from_token(context.log_info.filename, id_token));

        var id = context->token_str(id_token);

        if (id == "entry") {
            context.next_symbol_entry = true;
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        if (id == "uninitialized") {
            context.omit_var_init = true;
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        context->error(src_info.source_offset, src_info.length, "Unknown '#' command '" .. id .. "'.");
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_from_import(context: Context) => StatementInfo {
        var path = "";
        var start_src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(0));

        context->token_advance(); // import
        var module_token = context->current_token(0);
        context->token_advance(); // id
        while (context->token_match(Token.Type.DOT)) {
            path ..= context->token_str(module_token);
            path ..= "/";
            module_token = context->current_token(0);
            context->token_advance(); // module id
        }

        context->token_consume(Token.Type.IMPORT, "Expected 'import' keyword after module name.");
        var name_token = context->current_token(0);
        context->token_advance(); // entity id

        var src_info = HIR.SrcInfo.merge(
            start_src_info,
            HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));

        var module_name = context->token_str(module_token);

        from module import Modules
        var module = Modules.instance->load(module_name, path, null, true);
        if (module == null) {
            context->error(src_info.source_offset, src_info.length, "Couldn't load module '" .. module_name .. "'.");
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        var name = context->token_str(name_token);
    
        var target_namespace_node = context.hir_builder->declare_global_node(context.namespace, name, null, null, HIR.SrcInfo.from_token(context.log_info.filename, name_token), context.exxport);
        if (target_namespace_node == null) {
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        var source_namespace_node = module.namespace->find(name);
        if (source_namespace_node == null) {
            context->error(src_info.source_offset, src_info.length, "Couldn't find '" .. name .. "' in module '" .. module_name .. "'.");
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        target_namespace_node.name = source_namespace_node.name;
        target_namespace_node.value = source_namespace_node.value->copy();
        target_namespace_node.info.imported = true;
        //target_namespace_node.info.exxport = source_namespace_node.info.exxport;
        target_namespace_node.info.const = source_namespace_node.info.const;

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }
    
    // TODO move this to hir_builder
    fn declare_var(context: Context, key: str, type: Type, init_value_id: HIR.VarId, src_info: HIR.SrcInfo) => HIR.VarId {
        var var_id: HIR.VarId;
        // TODO can't do local scope vars in global this way
        if (context.is_global_scope) {
            var name: str;
            if (context.cexxport) {
                name = key;
            }
            var_id = context.hir_builder->declare_global_var(context.namespace, key, name, type, src_info, context.exxport);
        } else {
            var_id = context.hir_builder->declare_local_var(key, type, src_info);
        }

        if (context.hir_builder->is_undef(var_id)) {
            return var_id;
        }

        // TODO if const zero and global omit assign
        if (!context.hir_builder->is_undef(init_value_id)) {
            context.hir_builder->push_assign(HIR.Tag.ASSIGN, var_id, init_value_id, src_info);
        }
        return var_id;
    }

    fn parse_var_declaration(context: Context) => StatementInfo {
        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(0));

        context->token_advance(); // var
        var id_token = context->current_token(0);
        var name = context->token_str(id_token);
        context->token_advance(); // id

        var type: Type = null;
        var initial_value = (-1)$cast(HIR.VarId);
        if (context->token_match(Token.Type.COLON)) {
            type = context->parse_type();
        }
        if (context->token_match(Token.Type.ASSIGN)) {
            initial_value = context->parse_expression();

            if (!context.hir_builder->is_undef(initial_value)) {
                src_info = HIR.SrcInfo.merge(src_info, context->get_var(initial_value).src_info);
                if (type == null) {
                    type = context->get_var(initial_value)->get_type_forced();
                } else {
                    var initial_value_src_info = context->get_var(initial_value).src_info;
                    initial_value = context.hir_builder->cast_to_type_forced(initial_value, type, initial_value_src_info, false);
                }
            }
        } else {
            if (type == null) {
                src_info = HIR.SrcInfo.merge(src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));
                context->error(src_info.source_offset, src_info.length, "Variable declaration without a type expects an initial expression.");

                initial_value = context.hir_builder->push_error_var(src_info);
            } else {
                if (!context.omit_var_init) {
                    initial_value = context.hir_builder->get_default_initial_value(type, src_info);
                } else {
                    context.omit_var_init = false;
                }
            }
        }
        if (type == null) {
            context->error(src_info.source_offset, src_info.length, "Can't deduce var type.");
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        context->declare_var(name, type, initial_value, src_info);
        context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after variable declaration.");
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    class FunctionHeader {
        var namespace_node: Namespace.Node;
        var parameters_names: str[];
        var parameters_infos: HIR.SrcInfo[];
    }

    fn parse_function_header(context: Context) => FunctionHeader {
        context->token_advance(); // fn/cimport
        var id_token = context->current_token(0);
        context->token_advance(); // id
        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));

        context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected '(' after function name.");

        var function_parameters_names = str[0];
        var function_parameters_infos = HIR.SrcInfo[0];
        var function_parameters = Type[1];

        if (!context->token_check(Token.Type.PARENTHESIS_RIGHT)) {
            while (true) {
                var parameter_token = context->current_token(0);
                function_parameters_names ..= context->token_str(parameter_token);
                function_parameters_infos ..= HIR.SrcInfo.from_token(context.log_info.filename, parameter_token);
                context->token_advance(); // id

                context->token_consume(Token.Type.COLON, "Expected ':' after parameter name.");

                var parameter_type = context->parse_type();
                function_parameters ..= parameter_type;

                if (!context->token_match(Token.Type.COMMA)) {
                    break;
                }
            }
        }
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after parameters.");

        var return_type: Type;
        if (context->token_match(Token.Type.DOUBLE_ARROW_RIGHT)) {
            return_type = context->parse_type();
        }
        if (return_type == null) {
            return_type = Types.instance.type_void;
        }

        function_parameters[0] = return_type;

        var function_type = Types.instance->get_function_type(function_parameters);
        var key = context->token_str(id_token);
        var name: str;
        if (context.cexxport) {
            name = key;
        }
        var namespace_node = context.hir_builder->declare_global_node(context.namespace, key, name, function_type, HIR.SrcInfo.from_token(context.log_info.filename, id_token), context.exxport);
        namespace_node.info.const = true;

        if (context.next_symbol_entry) {
            context.next_symbol_entry = false;
            context.hir_builder.entry = namespace_node.key;
            context.hir_builder.entry_info = src_info;
        }

        var header = FunctionHeader();

        header.namespace_node = namespace_node;
        header.parameters_names = function_parameters_names;
        header.parameters_infos = function_parameters_infos;

        return header;
    }

    fn parse_function_declaration(context: Context) => StatementInfo {
        var header = context->parse_function_header();
        
        context->token_consume(Token.Type.CURLY_LEFT, "Expected '{' after function declaration.");

        // looking for the end of the function definition
        var start_pos = context.iterator->mark();
        var brackets_stack = BracketInfo[0];

        var current_token_type = Token.Type.CURLY_LEFT;
        context->dummy_parse_bracket(brackets_stack, context->current_token(1));
        while (brackets_stack.size > 0) {
            var token = context->current_token(0);
            if (token.type == Token.Type.EOF) {
                context->error(token.offset, token.length, "Expected '}' after function body.");
                return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
            }

            context->dummy_parse_bracket(brackets_stack, token);
            context->token_advance();
        }

        // TODO do proper error evaluation during this pass
        //context->token_consume(Token.Type.CURLY_RIGHT, "Expected '}' after function body.");

        // saving end of the function definition for later
        var end_pos = context.iterator->mark();

        if (header.namespace_node != null) {
            var function_decl = CompileFunctionDeclaration();
            function_decl.parent_namespace = context.namespace;
            function_decl.node = header.namespace_node;
            function_decl.parameters_names = header.parameters_names;
            function_decl.parameters_infos = header.parameters_infos;
            function_decl.start_pos = start_pos;
            function_decl.end_pos = end_pos;
            
            Modules.instance.active_module.compile_function_declarations ..= function_decl;
        }
        
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_cimport_declaration(context: Context) => StatementInfo {
        var old_cexxport = context.cexxport;
        context.cexxport = true;

        context->parse_function_header();

        context.cexxport = old_cexxport;

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_class_declaration_inner(context: Context, class_fields: TypeClass.Field[]) {
        while (true) switch (context->current_token(0).type) {
            case Token.Type.TERMINATION_CHARACTER => { 
                context->token_advance(); // ;
                return;
            }
            case Token.Type.VAR => {
                context->token_advance(); // var

                var field = TypeClass.Field();

                var field_token = context->current_token(0);
                field.name = context->token_str(field_token);
                context->token_advance(); // id

                context->token_consume(Token.Type.COLON, "Expected ':' after field name.");

                field.type = context->parse_type();

                context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after field declaration.");

                class_fields ..= field;
                return;
            }
            case Token.Type.EXTEND => {
                context->token_advance(); // extend

                var field = TypeClass.Field();

                field.type = context->parse_type();

                context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after field declaration.");

                class_fields ..= field;
                return;
            }
            case Token.Type.SHARED => {
                context->parse_var_declaration();
                return;
            }
            case Token.Type.CIMPORT => { context->parse_cimport_declaration (); return; }
            case Token.Type.FN      => { context->parse_function_declaration(); return; }
            case Token.Type.CLASS   => { context->parse_class_declaration   (); return; }
            case Token.Type.ENUM    => { context->parse_enum_declaration    (); return; }
            case Token.Type.MIMIC   => { context->parse_mimic_declaration   (); return; }
            case Token.Type.EXPORT  => {
                context->token_advance();
                if (context.exxport) {
                    var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));
                    context->error(src_info.source_offset, src_info.length, "Excessive 'export' operator.");
                    continue;
                }
                context.exxport = true;
                context->parse_class_declaration_inner(class_fields);
                context.exxport = false;
                return;
            }
            case Token.Type.CEXPORT => {
                context->token_advance();
                if (context.cexxport) {
                    var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));
                    context->error(src_info.source_offset, src_info.length, "Excessive 'cexport' operator.");
                    continue;
                }
                context.cexxport = true;
                context->parse_class_declaration_inner(class_fields);
                context.cexxport = false;
                return;
            }
            case Token.Type.IMPORT => { 
                var keyword_token = context->current_token(0);
                context->error(keyword_token.offset, keyword_token.length, "'import' is not supported inside class declaration.");
                context->parse_import();
                return;
            }
            case Token.Type.FROM   => { 
                var keyword_token = context->current_token(0);
                context->error(keyword_token.offset, keyword_token.length, "'import' is not supported inside class declaration.");
                context->parse_from_import();
                return;
            }
            case Token.Type.SHARP => {
                var keyword_token = context->current_token(0);
                context->error(keyword_token.offset, keyword_token.length, "'#' prefixes are not supported inside class declaration.");
                context->parse_statement();
                return;
            }
            default => {
                var keyword_token = context->current_token(0);
                context->error(keyword_token.offset, keyword_token.length, "Statements are not supported inside class declaration.");
                context->parse_statement();
                return;
            }
        }
    }
    
    fn parse_class_declaration(context: Context) => StatementInfo {
        context->token_advance(); // class
        var id_token = context->current_token(0);
        context->token_advance(); // id

        context->token_consume(Token.Type.CURLY_LEFT, "Expected '{' after class name.");

        var name = context->token_str(id_token);
        var class_type = TypeClass.construct(name, context.namespace, context.exxport);
        var class_namespace = class_type.namespace;
        var namespace_node = context.hir_builder->declare_global_node(context.namespace, name, null, null, HIR.SrcInfo.from_token(context.log_info.filename, id_token), context.exxport);
        namespace_node.value.kind = Value.Kind.Type;
        namespace_node.value.value = class_type$cast(raw)$cast(u64);

        var old_namespace = context.namespace;
        context.namespace = class_namespace;

        var old_export = context.exxport;
        context.exxport = false;

        context.hir_builder->push_symbol_map();

        var class_fields = TypeClass.Field[0];

        while (!context->token_check(Token.Type.CURLY_RIGHT) && !context->token_check(Token.Type.EOF)) {
            context->parse_class_declaration_inner(class_fields);
        }

        context.hir_builder->pop_symbol_map();
        
        context.exxport = old_export;
        context.namespace = old_namespace;

        class_type->finalize(class_fields);

        context->token_consume(Token.Type.CURLY_RIGHT, "Expected '}' in the end of a class declaration.");

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }
    
    fn parse_enum_declaration(context: Context) => StatementInfo {
        
        context->token_advance(); // enum
        var id_token = context->current_token(0);
        context->token_advance(); // id

        var parent_primitive = Types.instance.type_u8;
        if (context->token_match(Token.Type.COLON)) {
            var type = context->parse_type();
            if (type == null || type.kind != Type.Kind.Primitive) {
                context->error(id_token.offset, id_token.length, "Only numeric primitive types are supported as backend for the enum, got '" .. type->get_name() .. "' instead.");
            } else {
                parent_primitive = type$cast(TypePrimitive);
            }
            context->token_consume(Token.Type.CURLY_LEFT, "Expected '{' after enum parent type");
        } else {
            context->token_consume(Token.Type.CURLY_LEFT, "Expected '{' after enum name.");
        }

        var enum_constants = TypeEnum.Pair[0];

        var current_value = Value();
        current_value->set_type(parent_primitive);
        current_value.value -= 1;

        while (true) {
            if (context->token_check(Token.Type.CURLY_RIGHT)) {
                break;
            }

            var pair = TypeEnum.Pair();

            var constant_name_token = context->current_token(0);
            pair.name = context->token_str(constant_name_token);
            context->token_advance(); // id

            if (context->token_match(Token.Type.ASSIGN)) {
                var constant_token = context->current_token(0);
                if (context->token_match(Token.Type.LITERAL_INTEGER)) {
                    current_value.value = context->token_str(constant_token)$cast(u64);
                } else if (context->token_match(Token.Type.ID)) {
                    var other_constant_name = context->token_str(constant_token);

                    var found = false;
                    for (var enum_constant <- enum_constants) {
                        if (enum_constant.name == other_constant_name) {
                            current_value.value = enum_constant.value.value;

                            found = true;
                            break;
                        }
                    }
                    
                    if (!found) {
                        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, constant_token);
                        context->error(src_info.source_offset, src_info.length, "Unexpected '" .. context->token_str(constant_token) .. "' for the enum constant value.");
                        current_value.value += 1;
                    }
                } else {
                    var src_info = HIR.SrcInfo.from_token(context.log_info.filename, constant_token);
                    context->error(src_info.source_offset, src_info.length, "Unexpected '" .. context->token_str(constant_token) .. "' for the enum constant value.");
                    current_value.value += 1;
                }
            } else {
                current_value.value += 1;
            }

            pair.value = Value();
            pair.value->set_type(parent_primitive);
            pair.value.value = current_value.value;

            enum_constants ..= pair;

            if (!context->token_match(Token.Type.COMMA)) {
                break;
            }
        }

        context->token_consume(Token.Type.CURLY_RIGHT, "Expected '}' at the end of an enum declaration.");

        var name = context->token_str(id_token);
        var enum_type = TypeEnum.construct(name, parent_primitive, enum_constants);
        var namespace_node = context.hir_builder->declare_global_node(context.namespace, name, null, null, HIR.SrcInfo.from_token(context.log_info.filename, id_token), context.exxport);
        if (namespace_node != null) {
            namespace_node.value.kind = Value.Kind.Type;
            namespace_node.value.value = enum_type$cast(raw)$cast(u64);
        }

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_mimic_declaration(context: Context) => StatementInfo {
        context->token_advance(); // mimic
        var id_token = context->current_token(0);
        context->token_advance(); // id

        context->token_consume(Token.Type.ASSIGN, "Expected '=' after mimic name.");

        var name = context->token_str(id_token);
        var type = context->parse_type();
        var namespace_node = context.hir_builder->declare_global_node(context.namespace, name, null, null, HIR.SrcInfo.from_token(context.log_info.filename, id_token), context.exxport);
        namespace_node.value.kind = Value.Kind.Type;
        namespace_node.value.value = type$cast(raw)$cast(u64);

        context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' at the end of a mimic declaration.");

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_declaration(context: Context) => StatementInfo {
        while (true) switch (context->current_token(0).type) {
            case Token.Type.SHARP   => return context->parse_sharp_prefix();
            case Token.Type.IMPORT  => return context->parse_import();
            case Token.Type.FROM    => return context->parse_from_import();
            case Token.Type.VAR     => return context->parse_var_declaration();
            case Token.Type.SHARED => {
                var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(0));
                context->error(src_info.source_offset, src_info.length, "Can't use 'shared' outside class declaration.");
                return context->parse_var_declaration();
            }
            case Token.Type.CIMPORT => return context->parse_cimport_declaration();
            case Token.Type.FN      => return context->parse_function_declaration();
            case Token.Type.CLASS   => return context->parse_class_declaration();
            case Token.Type.ENUM    => return context->parse_enum_declaration();
            case Token.Type.MIMIC   => return context->parse_mimic_declaration();
            case Token.Type.EXPORT => {
                context->token_advance();
                if (context.exxport) {
                    var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));
                    context->error(src_info.source_offset, src_info.length, "Excessive 'export' operator.");
                    continue;
                }
                context.exxport = true;
                var result = context->parse_declaration();
                context.exxport = false;
                return result;
            }
            case Token.Type.CEXPORT => {
                context->token_advance();
                if (context.cexxport) {
                    var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));
                    context->error(src_info.source_offset, src_info.length, "Excessive 'cexport' operator.");
                    continue;
                }
                context.cexxport = true;
                var result = context->parse_declaration();
                context.cexxport = false;
                return result;
            }
            default                 => return context->parse_statement();
        }

        assert(false);
        return null;
    }

    fn parse_block_statement_inner(context: Context) => StatementInfo {
        var return_info = StatementInfo.ReturnInfo.Empty;

        while (!context->token_check(Token.Type.CURLY_RIGHT) && !context->token_check(Token.Type.EOF)) {
            if (return_info & StatementInfo.ReturnInfo.Always > 0) {
                var statement_start = context->current_token(0).offset;

                var decl_return_info = context->parse_declaration().return_info;

                var last_token = context->current_token(1);
                var statement_end = last_token.offset + last_token.length;

                context->error(statement_start, statement_end - statement_start, "Unreachable statement.");

                return_info |= decl_return_info;
            } else {
                return_info |= context->parse_declaration().return_info;
            }
        }

        var statement_info = StatementInfo();
        statement_info.return_info = return_info;
        return statement_info;
    }

    fn parse_block_statement(context: Context) => StatementInfo {
        context->token_advance(); // {

        context.hir_builder->push_symbol_map();
        var statement_info = context->parse_block_statement_inner();
        context.hir_builder->pop_symbol_map();

        context->token_consume(Token.Type.CURLY_RIGHT, "Expected '}' at the end of the block.");
        return statement_info;
    }

    fn parse_if_statement(context: Context) => StatementInfo {
        context->token_advance(); // if

        var first_block = context.hir_builder->reserve_blocks(2);
        var true_statement = first_block;
        var false_statement = first_block + 1;

        context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected '(' after 'if' keyword.");
        var expr_id = context->parse_expression();
        var src_info = context->get_var(expr_id).src_info;
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after 'if' statement expression.");

        context.hir_builder->push_if(expr_id, true_statement, false_statement, src_info);

        context.hir_builder->set_block(true_statement);
        var true_return_info = context->parse_statement().return_info;

        var return_info = StatementInfo.ReturnInfo.None;

        if (context->token_match(Token.Type.ELSE)) {
            var false_return_info = StatementInfo.ReturnInfo.None;
            if (true_return_info & StatementInfo.ReturnInfo.Always) {
                context.hir_builder->set_block(false_statement);
                false_return_info = context->parse_statement().return_info;
                if (!(false_return_info & StatementInfo.ReturnInfo.Always)) {
                    var after_block = context.hir_builder->reserve_blocks(1);
                    context.hir_builder->push_jump(after_block, src_info);
                    context.hir_builder->set_block(after_block);
                }
            } else {
                var after_block = context.hir_builder->reserve_blocks(1);
                context.hir_builder->push_jump(after_block, src_info);
            
                context.hir_builder->set_block(false_statement);
                false_return_info = context->parse_statement().return_info;
                if (!(false_return_info & StatementInfo.ReturnInfo.Always)) {
                    context.hir_builder->push_jump(after_block, src_info);
                }

                context.hir_builder->set_block(after_block);
            }

            return_info = 
                ((true_return_info & false_return_info) & StatementInfo.ReturnInfo.Always) |
                ((true_return_info | false_return_info) & StatementInfo.ReturnInfo.Undef);
        } else {
            if (!(true_return_info & StatementInfo.ReturnInfo.Always)) {
                context.hir_builder->push_jump(false_statement, src_info);
            }
            context.hir_builder->set_block(false_statement);

            return_info = true_return_info & StatementInfo.ReturnInfo.Undef;
        }

        return StatementInfo.construct(return_info);
    }

    fn parse_while_statement(context: Context) => StatementInfo {
        context->token_advance(); // while

        var first_block = context.hir_builder->reserve_blocks(3);
        var expr_statement = first_block;
        var body_statement = first_block + 1;
        var after_statement = first_block + 2;

        var first_jump = context.hir_builder->push_jump(expr_statement, null);

        context.hir_builder->set_block(expr_statement);
        context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected '(' after 'while' keyword.");
        var expr_id = context->parse_expression();
        var src_info = context->get_var(expr_id).src_info;
        first_jump.src_info = src_info;
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after 'while' statement expression.");

        context.hir_builder->push_if(expr_id, body_statement, after_statement, src_info);

        var old_reserved_break = context.reserved_break;
        context.reserved_break = after_statement;
        var old_reserved_continue = context.reserved_continue;
        context.reserved_continue = expr_statement;

        context.hir_builder->set_block(body_statement);
        var body_return_info = context->parse_statement().return_info;

        context.reserved_continue = old_reserved_continue;
        context.reserved_break = old_reserved_break;

        if (!(body_return_info & StatementInfo.ReturnInfo.Always)) {
            context.hir_builder->push_jump(expr_statement,  src_info);
        }
        context.hir_builder->set_block(after_statement);

        var return_info = body_return_info & StatementInfo.ReturnInfo.Undef;

        return StatementInfo.construct(return_info);
    }
    
    fn parse_for_statement(context: Context) => StatementInfo {
        context->token_advance(); // for

        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));

        context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected '(' after 'for' keyword.");
        context->token_consume(Token.Type.VAR, "Expected 'var' keyword in the beggining of 'for' statement expression.");
        var id_token = context->current_token(0);
        context->token_consume(Token.Type.ID, "Expected id after 'var' keyword.");

        var var_type: Type;
        if (context->token_match(Token.Type.COLON)) {
            var_type = context->parse_type();
        }

        context->token_consume(Token.Type.ARROW_LEFT, "Expected '<-' after 'var' declaration.");
        var array_id = context->parse_expression();

        if (context.hir_builder->is_undef(array_id)) {
            return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
        }

        var array_var = context->get_var(array_id);
        var array_type = array_var->get_type_forced()$cast(TypeArray);
        assert(array_type.kind == Type.Kind.Array);

        if (var_type == null) {
            var_type = array_type.value; 
        }

        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after 'for' statement expression.");
        src_info = HIR.SrcInfo.merge(src_info, HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1)));

        context.hir_builder->push_symbol_map();

        var iterator_var = context.hir_builder->declare_local_var(context->token_str(id_token), var_type, src_info);
        var index_var = context.hir_builder->push_temp_var_of_type(Types.instance.type_u64, src_info);
        context.hir_builder->push_assign(HIR.Tag.ASSIGN, index_var, 
            context.hir_builder->push_literal_number(0, src_info), 
            src_info);

        var array_size_var = context.hir_builder->push_field_access_forced(array_id, "size", src_info);

        var first_block = context.hir_builder->reserve_blocks(4);
        var expr_statement = first_block;
        var body_statement = first_block + 1;
        var inc_statement = first_block + 2;
        var after_statement = first_block + 3;

        context.hir_builder->push_jump(expr_statement, src_info);

        context.hir_builder->set_block(expr_statement);
        var is_index_less_size_var = context.hir_builder->push_binary_op(HIR.Tag.LESS, index_var, array_size_var, src_info);
        context.hir_builder->push_if(is_index_less_size_var, body_statement, after_statement, src_info);

        context.hir_builder->set_block(body_statement);
        context.hir_builder->push_assign(HIR.Tag.ASSIGN, iterator_var, 
            context.hir_builder->push_get_array_value(array_id, index_var, src_info),
            src_info);

        var old_reserved_break = context.reserved_break;
        context.reserved_break = after_statement;
        var old_reserved_continue = context.reserved_continue;
        context.reserved_continue = inc_statement;

        var body_return_info = context->parse_statement().return_info;
        context.hir_builder->push_jump(inc_statement, src_info);

        context.hir_builder->set_block(inc_statement);
        context.hir_builder->push_assign(HIR.Tag.ASSIGN_PLUS, index_var, 
            context.hir_builder->push_literal_number(1, src_info), 
            src_info);
        
        context.reserved_break = old_reserved_break;
        context.reserved_continue = old_reserved_continue;

        if (!(body_return_info & StatementInfo.ReturnInfo.Always)) {
            context.hir_builder->push_jump(expr_statement, src_info);
        }
        context.hir_builder->set_block(after_statement);

        context.hir_builder->pop_symbol_map();

        var return_info = body_return_info & StatementInfo.ReturnInfo.Undef;

        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_switch_statement(context: Context) => StatementInfo {
        context->token_advance(); // switch

        context->token_consume(Token.Type.PARENTHESIS_LEFT, "Expected '(' after 'switch' keyword.");
        var expr_id = context->parse_expression();
        var src_info = context->get_var(expr_id).src_info;
        context->token_consume(Token.Type.PARENTHESIS_RIGHT, "Expected ')' after 'switch' statement expression.");

        context->token_consume(Token.Type.CURLY_LEFT, "Expected '{' after 'switch' statement.");
        
        var return_info = StatementInfo.ReturnInfo.Always;
        var default_return_info = StatementInfo.ReturnInfo.Undef;

        var default_block = (-1)$cast(HIR.BlockId);

        if (!context->token_match(Token.Type.CURLY_RIGHT)) {
            var first_block = context.hir_builder->reserve_blocks(2);
            var after_statement = first_block;
            var next_cmp_block = first_block + 1;
            context.hir_builder->push_jump(next_cmp_block, src_info);

            var old_reserved_break = context.reserved_break;
            context.reserved_break = after_statement;

            while (!context->token_match(Token.Type.CURLY_RIGHT)) {
                var current = context->current_token(0);
                var src_info = HIR.SrcInfo.from_token(context.log_info.filename, current);

                switch(current.type) {
                    case Token.Type.CASE => {
                        context->token_advance(); // case

                        var current_block = context.hir_builder->reserve_blocks(1);

                        context.hir_builder->set_block(next_cmp_block);
                        var case_expr = context->parse_precedence(Precedence.Pair + 1);

                        while (context->token_match(Token.Type.CASE)) {
                            src_info = context->get_var(case_expr).src_info;
                            var cmp_expr = context.hir_builder->push_binary_op(HIR.Tag.EQUAL, expr_id, case_expr, src_info);

                            next_cmp_block = context.hir_builder->reserve_blocks(1);
                            
                            context.hir_builder->push_if(cmp_expr, current_block, next_cmp_block, src_info);

                            ////////////////

                            context.hir_builder->set_block(next_cmp_block);
                            case_expr = context->parse_precedence(Precedence.Pair + 1);
                        }

                        context->token_consume(Token.Type.DOUBLE_ARROW_RIGHT, "Expected '=>' after 'case' statement expression.");

                        src_info = context->get_var(case_expr).src_info;
                        var cmp_expr = context.hir_builder->push_binary_op(HIR.Tag.EQUAL, expr_id, case_expr, src_info);

                        next_cmp_block = context.hir_builder->reserve_blocks(1);
                        
                        context.hir_builder->push_if(cmp_expr, current_block, next_cmp_block, src_info);

                        ///////////

                        context.hir_builder->set_block(current_block);
                        var body_return_info = context->parse_statement().return_info;

                        if (!(body_return_info & StatementInfo.ReturnInfo.Always)) {
                            context.hir_builder->push_jump(after_statement, src_info);
                        }

                        return_info = 
                            ((return_info & body_return_info) & StatementInfo.ReturnInfo.Always) |
                            ((return_info | body_return_info) & StatementInfo.ReturnInfo.Undef);
                    }
                    case Token.Type.DEFAULT => {
                        context->token_advance(); // default

                        context->token_consume(Token.Type.DOUBLE_ARROW_RIGHT, "Expected '=>' after 'default' statement expression.");

                        assert(default_block == (-1)$cast(HIR.BlockId));
                        default_block = context.hir_builder->reserve_blocks(1);
                        context.hir_builder->set_block(default_block);

                        var body_return_info = context->parse_statement().return_info;

                        if (!(body_return_info & StatementInfo.ReturnInfo.Always)) {
                            context.hir_builder->push_jump(after_statement, src_info);
                        }

                        default_return_info = body_return_info;
                    }
                    default => {
                        context->error(src_info.source_offset, src_info.length, "Unexpected token inside 'switch' body.");
                        context->token_advance();
                    }
                }
            }

            context.reserved_break = old_reserved_break;

            context.hir_builder->set_block(next_cmp_block);
                
            if (default_block == (-1)$cast(HIR.BlockId)) {
                context.hir_builder->push_jump(after_statement, src_info);

                return_info &= StatementInfo.ReturnInfo.Undef;
            } else {
                context.hir_builder->push_jump(default_block, src_info);

                return_info = 
                    ((return_info & default_return_info) & StatementInfo.ReturnInfo.Always) |
                    ((return_info | default_return_info) & StatementInfo.ReturnInfo.Undef);
            }
                
            if (!(return_info & StatementInfo.ReturnInfo.Always)) {
                context.hir_builder->set_block(after_statement);
            }
        } else {
            return_info &= StatementInfo.ReturnInfo.Undef;
        }

        return StatementInfo.construct(return_info);
    }

    fn parse_break_statement(context: Context) => StatementInfo {
        context->token_advance(); // break
        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));

        var statement_info = StatementInfo.construct(StatementInfo.ReturnInfo.Empty);

        if (context.reserved_break == (-1)$cast(HIR.BlockId)) {
            var token = context->current_token(1);
            context->error(token.offset, token.length, "'break' statement outside of loop or switch body.");
        } else {
            context.hir_builder->push_jump(context.reserved_break, src_info);
        }
            
        context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after 'break' statement.");
        return statement_info;
    }

    fn parse_continue_statement(context: Context) => StatementInfo {
        context->token_advance(); // continue
        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));

        var statement_info = StatementInfo.construct(StatementInfo.ReturnInfo.Empty);

        if (context.reserved_continue == (-1)$cast(HIR.BlockId)) {
            var token = context->current_token(1);
            context->error(token.offset, token.length, "'continue' statement outside of loop body.");
        } else {
            context.hir_builder->push_jump(context.reserved_continue, src_info);
        }
            
        context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after 'continue' statement.");
        return statement_info;
    }

    fn parse_return_statement(context: Context) => StatementInfo {
        context->token_advance(); // return
        var src_info = HIR.SrcInfo.from_token(context.log_info.filename, context->current_token(1));

        if (context->token_match(Token.Type.TERMINATION_CHARACTER)) {
            context.hir_builder->push_tagonly_instr(HIR.Tag.RETURN, src_info);
            return StatementInfo.construct(StatementInfo.ReturnInfo.AlwaysNone);
        } else {
            context.hir_builder->push_return_value(context->parse_expression(), src_info);
            context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after return statement expression.");
            return StatementInfo.construct(StatementInfo.ReturnInfo.AlwaysValue);
        }
    }

    fn parse_expression_statement(context: Context) => StatementInfo {
        context->parse_expression();
        context->token_consume(Token.Type.TERMINATION_CHARACTER, "Expected ';' after expression.");
        return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
    }

    fn parse_statement(context: Context) => StatementInfo {
        switch (context->current_token(0).type) {
            case Token.Type.CURLY_LEFT            => return context->parse_block_statement();
            case Token.Type.IF                    => return context->parse_if_statement();
            case Token.Type.WHILE                 => return context->parse_while_statement();
            case Token.Type.FOR                   => return context->parse_for_statement();
            case Token.Type.SWITCH                => return context->parse_switch_statement();
            case Token.Type.BREAK                 => return context->parse_break_statement();
            case Token.Type.CONTINUE              => return context->parse_continue_statement();
            case Token.Type.RETURN                => return context->parse_return_statement();
            case Token.Type.TERMINATION_CHARACTER => { 
                context->token_advance(); 
                return StatementInfo.construct(StatementInfo.ReturnInfo.Empty);
            }
            default                               => return context->parse_expression_statement();
        }
    }

    export fn build_hir(lexer: Lexer, start_pos: TokenIterator.Index, end_pos: TokenIterator.Index, namespace: Namespace, parameters: VariableDecl[], return_type: Type, func_index: u16, is_global_scope: bool, log_accum: LogAccum) => HIR {
        var context = Context();

        context.log_accum = log_accum;
        context.log_info = lexer->construct_log_info();

        context.source = lexer.source;
        context.namespace = namespace;
        context.iterator = TokenIterator.construct(lexer.tokens[start_pos:end_pos]);

        context.reserved_break = (-1)$cast(HIR.BlockId);
        context.reserved_continue = (-1)$cast(HIR.BlockId);
        context.is_global_scope = is_global_scope;

        context.hir_builder = HIRBuilder.construct(return_type, func_index, context.log_accum, context.log_info);

        for (var parameter <- parameters) {
            context.hir_builder->add_parameter(parameter.name, parameter.type, parameter.src_info);
        }

        if (lexer.tokens.size > 0) {
            var statement_info = context->parse_block_statement_inner();
            if ((statement_info.return_info & StatementInfo.ReturnInfo.Undef) == StatementInfo.ReturnInfo.Undef ||
                (!(statement_info.return_info & StatementInfo.ReturnInfo.Always) && (
                    !!(statement_info.return_info & StatementInfo.ReturnInfo.Value) || (return_type != null && !return_type->is_void())
                ))) {
                var last_token = lexer.tokens[end_pos - 1];
                context->error(last_token.offset, 1, "Not all control returns value.");
            }

            /* // Doesn't look like necessary
            if (p_context->reserved_break != (ketl_hir_block_index_t)-1 ||
                p_context->reserved_continue != (ketl_hir_block_index_t)-1) {
                errorf(p_lexer->tokens.p_data[end_pos - 1].offset, 1, "Expected statement.");
            }
            */

            if (!(statement_info.return_info & StatementInfo.ReturnInfo.Always)) {
                // we need to return eventually
                context.hir_builder->push_tagonly_instr(HIR.Tag.RETURN, HIR.SrcInfo.construct(context.log_info.filename, lexer.tokens[end_pos - 1].offset, 1));
            }
        }

        var hir = HIR();
        context.hir_builder->flush(hir);
        if (return_type != null) {
            hir.return_type = return_type;
        }
        return hir;
    }
}