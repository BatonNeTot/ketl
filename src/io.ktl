//🫖ketl

export class File {

    export fn read(path: str) => str {
        var file = fopen(path$cast(cstr), "rb"$cast(cstr));
        if (file == null) {
            error("error opening file '");
            error(path);
            error("':");
            errorln(get_last_error()$cast(str));
            return null;
        }
        
        var SEEK_END: i32 = 2;
        fseek(file, 0, SEEK_END);
        var filesize = ftell(file)$cast(u64);
        assert(filesize >= 0);

        var buffer = malloc(filesize);

        var SEEK_SET: i32 = 0;
        fseek(file, 0, SEEK_SET);
        fread(buffer, 1, filesize, file);
        assert(ferror(file) == 0);

        fclose(file);

        from __ketl_rt import buffer_as_str
        return buffer_as_str(buffer, filesize, filesize);
    }
} 

export fn get_last_error() => i32 {
    return _errno().value;
}

cimport fopen(path: cstr, mode: cstr) => File
cimport fseek(file: File, offset: i64, origin: i32)
cimport ftell(file: File) => i64
cimport fputs(message: cstr, file: File) => i64
cimport fread(buffer: raw, size: u64, count: u64, file: File)
cimport ferror(file: File) => i32
cimport fflush(file: File) => i64
cimport fclose(file: File)

cimport malloc(size: u64) => raw
cimport free(pointer: raw)

class IntPointer {
    var value: i32;
}
cimport _errno() => IntPointer

mimic FileHandle = i64;

var stdout_handle: FileHandle = 1;
var stderr_handle: FileHandle = 2;

cimport __acrt_iob_func(handle: FileHandle) => File
var stdout = __acrt_iob_func(stdout_handle);
var stderr = __acrt_iob_func(stderr_handle);


export fn print(message: str) {
    fputs(message$cast(cstr), stdout);
}

export fn println(message: str) {
    fputs(message$cast(cstr), stdout);
    fputs("\n"$cast(cstr), stdout);
}

export fn error(message: str) {
    fputs(message$cast(cstr), stderr);
}

export fn errorln(message: str) {
    fputs(message$cast(cstr), stderr);
    fputs("\n"$cast(cstr), stderr);
}

cimport _fileno(file: File) => FileHandle
cimport _dup(handle: FileHandle) => FileHandle
cimport _dup2(handle_src: FileHandle, handle_dst: FileHandle) => FileHandle

var stdout_backup = _dup(stdout_handle);
var stderr_backup = _dup(stderr_handle);
var stdout_redirect_file: File;
var stderr_redirect_file: File;

export fn stdout_redirect_restore() {
    fflush(stdout);
    if (stdout_redirect_file != null) {
        fclose(stdout_redirect_file);
    }
    _dup2(stdout_backup, stdout_handle);
}
export fn stderr_redirect_restore() {
    fflush(stderr);
    if (stderr_redirect_file != null) {
        fclose(stderr_redirect_file);
    }
    _dup2(stderr_backup, stderr_handle);
}

export fn stdout_redirect(target_filename: str) => bool {
    stdout_redirect_restore();
    
    stdout_redirect_file = fopen(target_filename$cast(cstr), "w"$cast(cstr));
    if (stdout_redirect_file == null) {
        errorln("Can't open file '" .. target_filename .. "'");
        return false;
    }

    // stdout now refers to file p_target_filename
    if (-1 == _dup2(_fileno(stdout_redirect_file), stdout_handle)) {
        errorln("Can't _dup2 stdout");
        return false;
    }

    return true;
}
export fn stderr_redirect(target_filename: str) => bool {
    stderr_redirect_restore();
    
    stderr_redirect_file = fopen(target_filename$cast(cstr), "a"$cast(cstr));
    if (stderr_redirect_file == null) {
        errorln("Can't open file '" .. target_filename .. "'");
        return false;
    }

    // stderr now refers to file p_target_filename
    if (-1 == _dup2(_fileno(stderr_redirect_file), stderr_handle)) {
        errorln("Can't _dup2 stderr");
        return false;
    }

    return true;
}

export class Dir {

    export fn get_items(path: str) => str[] {
        var dir = Dir.open(path);
        if (dir == null) {
            return null;
        }

        var items = str[0];
        var item = dir->next_item();
        while (item != null) {
            items ..= item;
            item = dir->next_item();
        }
        dir->close();

        return items;
    }

    export fn open(path: str) => Dir {
        cimport opendir(path: cstr) => Dir;
        var dir = opendir(path$cast(cstr));
        if (dir == null)
        {
            errorln("Failed to open directory '" .. path .. "'");
        }

        return dir;
    }
    
    // returns null when reaches end
    export fn next_item(dir: Dir) => str {
        cimport readdir(dir: Dir) => raw;
        var dirent = readdir(dir);
        if (dirent == null) {
            return null;
        }

        var dirent_name_offset = (i32$size + i16$size + i16$size)$cast(u64);
        var cstr_name = dirent + dirent_name_offset;

        from __ketl_rt import cstr2str
        return cstr2str(cstr_name);
    }

    export fn close(dir: Dir) {
        cimport closedir(dir: Dir) => i32
        closedir(dir);
    }
} 

export class FileInfo {

    mimic _dev_t = u32;
    mimic _ino_t = u16;
    mimic off_t = i32;
    mimic time_t = i64;

    var st_dev: _dev_t;
    var st_ino: _ino_t;
    var st_mode: u16;
    var st_nlink: i16;
    var st_uid: i16;
    var st_gid: i16;
    var st_rdev: _dev_t;
    var st_size: off_t; /* off_t follows _FILE_OFFSET_BITS */
    var st_atime: time_t; /* time_t follows _USE_32BIT_TIME_T */
    var st_mtime: time_t;
    var st_ctime: time_t;

    export fn get(path: str) => FileInfo {
        cimport stat(filename: cstr, stat: FileInfo) => i32;

        var info = FileInfo();
        if (stat(path$cast(cstr), info) != 0) {
            return null;
        }

        return info;
    }

    enum Kind: u8 {
        Unsupported,
        Directory,
        RegularFile,
    }

    shared _S_IFMT:   u16 = 61440; // 0xF000
    shared _S_IFDIR:  u16 = 16384;  // 0x4000
    shared _S_IFCHR:  u16 = 8192;  // 0x2000
    shared _S_IFIFO:  u16 = 4096;  // 0x1000
    shared _S_IFREG:  u16 = 32768;  // 0x8000
    shared _S_IREAD:  u16 = 256;  // 0x0100
    shared _S_IWRITE: u16 = 128; // 0x0080
    shared _S_IEXEC:  u16 = 64;  // 0x0040

    shared _S_IRWXU:  u16 = (_S_IREAD | _S_IWRITE | _S_IEXEC);
    shared _S_IRUSR:  u16 = _S_IREAD;
    shared _S_IWUSR:  u16 = _S_IWRITE;
    shared _S_IXUSR:  u16 = _S_IEXEC;

    export shared S_IRWXU:   u16 = _S_IRWXU;
    export shared S_IRUSR:   u16 = _S_IRUSR;
    export shared S_IWUSR:   u16 = _S_IWUSR;
    export shared S_IXUSR:   u16 = _S_IXUSR;

    export shared S_IRWXG:   u16 = (S_IRWXU >> 3);
    export shared S_IRGRP:   u16 = (S_IRUSR >> 3);
    export shared S_IWGRP:   u16 = (S_IWUSR >> 3);
    export shared S_IXGRP:   u16 = (S_IXUSR >> 3);

    export shared S_IRWXO:   u16 = (S_IRWXG >> 3);
    export shared S_IROTH:   u16 = (S_IRGRP >> 3);
    export shared S_IWOTH:   u16 = (S_IWGRP >> 3);
    export shared S_IXOTH:   u16 = (S_IXGRP >> 3);

    export fn get_kind(info: FileInfo) => Kind {
        switch (info.st_mode & _S_IFMT) {
            case _S_IFDIR => return Kind.Directory;
            case _S_IFREG => return Kind.RegularFile;
            default => return Kind.Unsupported;
        }
    }

}

fn find_last(string: str, symbol: char) => i64 {
    var last_index = string.size$cast(i64) - 1;
    while (last_index >= 0 && string[last_index] != symbol) {
        last_index -= 1;
    }
    return last_index;
}

cimport mkdir(path: cstr, mode: u16) => i64;

export fn get_dir(path: str) => str {
    var last_fslash_index = find_last(path, '/');
    var last_bslash_index = find_last(path, '\\');

    var last_slash_index: i64;
    if (last_fslash_index > last_bslash_index) {
        last_slash_index = last_fslash_index;
    } else {
        last_slash_index = last_bslash_index;
    }

    if (last_slash_index > 0) {
        return path[0:last_slash_index];
    } else {
        return "";
    }
}

export fn get_filename(path: str) => str {
    var last_fslash_index = find_last(path, '/');
    var last_bslash_index = find_last(path, '\\');

    var after_last_slash_index: i64;
    if (last_fslash_index > last_bslash_index) {
        after_last_slash_index = last_fslash_index + 1;
    } else {
        after_last_slash_index = last_bslash_index + 1;
    }

    if (after_last_slash_index > 0) {
        return path[after_last_slash_index:path.size];
    } else {
        return path;
    }
}

export fn get_ext(path: str) => str {
    var after_last_dot_index = find_last(path, '.') + 1;

    if (after_last_dot_index > 0) {
        return path[after_last_dot_index:path.size];
    } else {
        return path;
    }
}

fn create_dirs_if_needed_resolved(path: str) => bool {
    var info = FileInfo.get(path);
    if (info == null) {
        var dir = get_dir(path);
        if (dir != "") {
            if (!create_dirs_if_needed_resolved(dir)) {
                return false;
            }
        }

        if (mkdir(path$cast(cstr), 
            FileInfo.S_IRUSR | FileInfo.S_IWUSR |
            FileInfo.S_IRGRP | FileInfo.S_IWGRP |
            FileInfo.S_IROTH | FileInfo.S_IWOTH) != 0) {
            return false;
        } 

        return true;
    }
    
    var kind = info->get_kind();
    if (kind == FileInfo.Kind.Directory) {
        return true;
    }

    return false;
}

export fn create_dirs_if_needed(path: str) => bool {
    return create_dirs_if_needed_resolved(resolve_path(path));
}

#uninitialized
cexport var __imp_GetFullPathNameA: (cstr, u32, raw, raw) => u32;

export fn resolve_path(path: str) => str {
    if (path == null || path.size == 0) {
        path = ".";
    }

    var capacity: u64 = 64;
    var buffer = malloc(capacity);

    var size = __imp_GetFullPathNameA(path$cast(cstr), capacity$cast(u32), buffer, null);
    if (size == 0) {
        free(buffer);
        return null;
    }

    from __ketl_rt import buffer_as_str
    return buffer_as_str(buffer, size, capacity);
}

export fn escaped_string(string: str) => str {
    var result = "";
    var last_index: u64;
    var i: u64;
    while (i < string.size) {
        if (string[i] == '\\') {
            result ..= string[last_index:i];
            result ..= "\\\\";
            last_index = i + 1;
        }
        i += 1;
    }
    result ..= string[last_index:i];
    return result;
}
