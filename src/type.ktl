//🫖ketl

import common
from type_base import Type
from value import Value
from namespace import Namespace
from namespace import NamespaceContext

export class TypePrimitive {
    extend Type;
    name: str;
    integer: bool;
    signed: bool;
    numeric: bool;

    fn construct(size: u8, name: str, integer: bool, signed: bool, numeric: bool) => TypePrimitive {
        self := TypePrimitive();

        self.kind = Kind.Primitive;
        self.align = find_align_enum(size);
        self.size = size;
        self.name = name;
        self.integer = integer;
        self.signed = signed;
        self.numeric = numeric;

        return self;
    }

    fn get_signed(self: TypePrimitive) => TypePrimitive {
        if (!self.numeric) {
            return null;
        }

        switch (self.size) {
            case 1 => return Types.instance.type_i8;
            case 2 => return Types.instance.type_i16;
            case 4 => return Types.instance.type_i32;
            case 8 => return Types.instance.type_i64;
        }

        return null;
    }
}

export class TypeEnum {

    export class Pair {
        name: str;
        value: Value;
    }

    extend Type;
    name: str;
    parent: TypePrimitive;
    constants: Pair[];

    export fn construct(name: str, parent: TypePrimitive, constants: Pair[]) => TypeEnum {
        type := TypeEnum();

        type.kind = Type.Kind.Enum;
        type.align = parent.align;
        type.size = parent.size;

        type.name = name;
        type.parent = parent;
        type.constants = constants;
        
        return type;
    }

    export fn find_constant(self: TypeEnum, name: str) => Value {
        for (constant := self.constants) {
            if (constant.name == name) {
                return constant.value->copy();
            }
        }

        return null;
    }
}

export class TypeFunction {
    export class Signature {
        parameters: Type[];

        fn is_equal(lhs: Signature, rhs: Signature) => bool {
            return lhs.parameters == rhs.parameters;
        }

        fn get_hash(self: Signature) => u64 {
            hash: u64;

            for (parameter := self.parameters) {
                hash = (parameter$cast(raw)$cast(u64) >> 3) ^ (hash << 1);
            }

            return hash;
        }
    }

    extend Type;
    signature: Signature;
}

export class TypeArray {

    extend Type;
    value: Type;
}

export class TypeClass {

    class Field {
        type: Type;
        name: str;
        facaded: bool;
    }

    extend Type;
    name: str;
    fullname: str;
    fields: Field[];
    namespace: Namespace;
    context_namespaces: Namespace[];
    context: NamespaceContext;

    export fn construct(name: str, parent_namespace: Namespace, exxport: bool) => TypeClass {
        self := TypeClass();

        self.kind = Type.Kind.Class;

        self.name = name;
        self.namespace = Namespace.construct(name, parent_namespace);

        if (exxport) {
            // skip first dot
            self.fullname = self.namespace.fullname[1:];
        } else {
            self.fullname = self.namespace.fullname;
        }

        return self;
    }

    export fn finalize(self: TypeClass, fields: TypeClass.Field[]) {
        self.fields = fields;

        self.align = Type.Align.Byte;
        self->calc_size_and_align();
        self.size = common.align_forward(self.size, Type.from_align_enum(self.align))$cast(u16);

        for (field := fields) {
            if (field.name == null || field.name == "") {
                type := field.type$cast(TypeClass);
                assert(type.kind == Type.Kind.Class);

                self.namespace.parents ..= type.namespace;
            }
        }
    }

    export fn calc_size_and_align(self: TypeClass) {
        for (field := self.fields) {
            align := Align.Byte; // TODO delayed initialization
            size: u16;
            if (field.name == null || field.name == "") {
                assert(field.type.kind == Type.Kind.Class);

                align = field.type->get_align();
                self.size = common.align_forward(self.size, Type.from_align_enum(align))$cast(u16);

                size = field.type->get_size();
            } else {
                align = field.type->get_stack_align();
                self.size = common.align_forward(self.size, Type.from_align_enum(align))$cast(u16);

                size = field.type->get_stack_size();
            }

            if (align > self.align) {
                self.align = align;
            }

            self.size += size;
        }
    }

    // returns null if field doesn't exist
    export fn get_field_type(self: TypeClass, name: str) => Type {
        if (self.fields == null) {
            return null;
        }

        for (field := self.fields) {
            if (field.name == null || field.name == "") {
                assert(field.type.kind == Type.Kind.Class);

                type := field.type$cast(TypeClass)->get_field_type(name);
                if (type != null) {
                    return type;
                }
            } else {
                if (field.name == name) {
                    return field.type;
                }
            }
        }

        return null;
    }

    // returns -1 if field doesn't exist
    export fn get_field_offset(self: TypeClass, name: str) => i32 {
        if (self.fields == null) {
            return (-1)$cast(i32);
        }
        
        offset: u16;
        for (field := self.fields) {
            align := Align.Byte; // TODO delayed initialization
            size: u16;
            if (field.name == null || field.name == "") {
                assert(field.type.kind == Type.Kind.Class);

                align = field.type->get_align();
                offset = common.align_forward(offset, Type.from_align_enum(align))$cast(u16);

                extended_offset := field.type$cast(TypeClass)->get_field_offset(name);
                if (extended_offset >= 0) {
                    return offset$cast(i32) + extended_offset;
                }

                size = field.type->get_size();
            } else {
                align = field.type->get_stack_align();
                offset = common.align_forward(offset, Type.from_align_enum(align))$cast(u16);

                if (field.name == name) {
                    return offset$cast(i32);
                }

                size = field.type->get_stack_size();
            }

            offset += size;
        }

        return (-1)$cast(i32);
    }

    // returns -1 if field doesn't exist
    export fn find_extended_class_offset(self: TypeClass, type: TypeClass) => i32 {
        if (self.fields == null) {
            return (-1)$cast(i32);
        }
        
        offset: u16;
        for (field := self.fields) {
            align := Align.Byte; // TODO delayed initialization
            size: u16;
            if (field.name == null || field.name == "") {
                assert(field.type.kind == Type.Kind.Class);

                align = field.type->get_align();
                offset = common.align_forward(offset, Type.from_align_enum(align))$cast(u16);

                if (field.type == type$cast(Type)) {
                    return offset$cast(i32);
                }

                extended_offset := field.type$cast(TypeClass)->find_extended_class_offset(type);
                if (extended_offset >= 0) {
                    return offset$cast(i32) + extended_offset;
                }

                size = field.type->get_size();
            } else {
                align = field.type->get_stack_align();
                offset = common.align_forward(offset, Type.from_align_enum(align))$cast(u16);

                size = field.type->get_stack_size();
            }

            offset += size;
        }

        return (-1)$cast(i32);
    }

    export fn get_full_name(self: TypeClass) => str {
        return self.fullname;
    }

    export fn find(self: TypeClass, key: str) => Namespace.Node {
        node := self.namespace->find(key);
        if (node != null) {
            return node;
        }

        for (namespace := self.context_namespaces) {
            node = namespace->find(key);
            if (node != null) {
                return node;
            }
        }

        return null;
    }    

    fn extract_extended_classes(self: TypeClass) => TypeClass[] {
        // TODO
        return null;
    }
}

export class TypeTuple {

    extend Type;
    values: Type[];
    
    export fn finalize(self: TypeTuple, values: Type[]) {
        self.values = values;

        self.align = Type.Align.Byte;
        self->calc_size_and_align();
        self.size = common.align_forward(self.size, Type.from_align_enum(self.align))$cast(u16);
    }

    export fn calc_size_and_align(self: TypeTuple) {
        for (value := self.values) {
            align := value->get_stack_align();
            size := value->get_stack_size();

            if (align > self.align) {
                self.align = align;
            }

            self.size = common.align_forward(self.size, Type.from_align_enum(align))$cast(u16) + size;
        }
    }
 
    export fn get_value_type(self: TypeTuple, index: i64) => Type {
        return self.values[index];
    }

    // returns -1 if index doesn't exist
    export fn get_field_offset(self: TypeTuple, index: i64) => i32 {
        if (index < 0) {
            index += self.values.size$cast(i64);

            if (index < 0) {
                return (-1)$cast(i32);
            }
        }

        offset: u16;
        i: i64;
        while (i < self.values.size$cast(i64)) {
            value := self.values[i];

            align := value->get_stack_align();
            offset = common.align_forward(offset, Type.from_align_enum(align))$cast(u16);

            if (i == index) {
                return offset$cast(i32);
            }

            size := value->get_stack_size();

            offset += size;

            i += 1;
        }

        return (-1)$cast(i32);
    }
}

class Types {

    type_void: TypePrimitive;
    type_bool: TypePrimitive;
    type_char: TypePrimitive;
    type_raw: TypePrimitive;

    type_i8: TypePrimitive;
    type_i16: TypePrimitive;
    type_i32: TypePrimitive;
    type_i64: TypePrimitive;
    
    type_u8: TypePrimitive;
    type_u16: TypePrimitive;
    type_u32: TypePrimitive;
    type_u64: TypePrimitive;

    type_str: TypeArray;
    type_cstr: TypeArray;

    functions: common.HashMap;
    arrays: common.HashMap;
    carrays: common.HashMap;
    tuples: common.HashMap;

    fn construct() => Types {
        self := Types();

        self.type_void = TypePrimitive.construct(0, "void", false, false, false);
        self.type_bool = TypePrimitive.construct(1, "bool", false, false, false);
        self.type_char = TypePrimitive.construct(1, "char", true,  false, false);
        self.type_raw  = TypePrimitive.construct(8, "raw",  false, false, false);

        self.type_i8   = TypePrimitive.construct(1, "i8",   true,  true,  true);
        self.type_i16  = TypePrimitive.construct(2, "i16",  true,  true,  true);
        self.type_i32  = TypePrimitive.construct(4, "i32",  true,  true,  true);
        self.type_i64  = TypePrimitive.construct(8, "i64",  true,  true,  true);
        
        self.type_u8   = TypePrimitive.construct(1, "u8",   true,  false, true);
        self.type_u16  = TypePrimitive.construct(2, "u16",  true,  false, true);
        self.type_u32  = TypePrimitive.construct(4, "u32",  true,  false, true);
        self.type_u64  = TypePrimitive.construct(8, "u64",  true,  false, true);

        return self;
    }

    fn is_signature_equal(lhs: raw, rhs: raw) => bool {
        return TypeFunction.Signature.is_equal(lhs, rhs);
    }

    fn get_signature_hash(sign: raw) => u64 {
        return TypeFunction.Signature.get_hash(sign);
    }

    fn init_functions_if_needed(self: Types) {
        if (self.functions == null) {
            self.functions = common.HashMap.construct(is_signature_equal, get_signature_hash);
        }
    }

    fn init_arrays_if_needed(self: Types) {
        if (self.arrays == null) {
            self.arrays = common.IntHashMap.construct();
        }
    }

    fn init_carrays_if_needed(self: Types) {
        if (self.carrays == null) {
            self.carrays = common.IntHashMap.construct();
        }
    }

    fn is_array_of_types_equal(lhs_types: raw, rhs_types: raw) => bool {
        return lhs_types$cast(Type[]) == rhs_types$cast(Type[]);
    }

    fn get_array_of_types_hash(types: raw) => u64 {
        hash: u64;

        for (type := types$cast(Type[])) {
            hash = (type$cast(raw)$cast(u64) >> 3) ^ (hash << 1);
        }

        return hash;
    }

    fn init_tuples_if_needed(self: Types) {
        if (self.tuples == null) {
            self.tuples = common.HashMap.construct(is_array_of_types_equal, get_array_of_types_hash);
        }
    }

    export #shared instance := Types.construct(); 

    export fn get_common_type(lhs: Type, rhs: Type) => Type {
        if (lhs == null || rhs == null) {
            return null;
        }

        if (is_types_equal(lhs, rhs)) {
            return lhs;
        }

        if ((lhs.kind == Type.Kind.Primitive || lhs.kind == Type.Kind.Enum) && 
            rhs.kind == Type.Kind.Primitive || rhs.kind == Type.Kind.Enum) {
            if (lhs.kind == Type.Kind.Enum) {
                lhs = lhs$cast(TypeEnum).parent;
            }
            if (rhs.kind == Type.Kind.Enum) {
                rhs = rhs$cast(TypeEnum).parent;
            }

            lhs_primitive := lhs$cast(TypePrimitive);
            rhs_primitive := rhs$cast(TypePrimitive);

            if (!lhs_primitive.integer || !rhs_primitive.integer) {
                return null;
            }

            if (lhs_primitive.integer != rhs_primitive.integer) {
                assert(false);
                return null;
            }

            if (lhs.size > rhs.size) {
                return lhs;
            } else {
                return rhs;
            }
        }

        if (lhs == Types.instance.type_raw$cast(Type) && rhs->is_pointer_kind() ||
            rhs == Types.instance.type_raw$cast(Type) && lhs->is_pointer_kind()) {
            return Types.instance.type_raw;
        }

        if (lhs.kind == Type.Kind.Class && rhs.kind == Type.Kind.Class) {
            lhs_class := lhs$cast(TypeClass);
            rhs_class := rhs$cast(TypeClass);

            
        }

        return null;
    }

    export fn is_types_equal(lhs: Type, rhs: Type) => bool {
        return lhs == rhs;
    }

    export fn get_function_type(self: Types, parameters: Type[]) => TypeFunction {
        self->init_functions_if_needed();

        signature := TypeFunction.Signature();
        signature.parameters = parameters;

        bucket := self.functions->get_or_insert(signature, null);
        if (bucket.value != null) {
            return bucket.value;
        }

        type := TypeFunction();
        type.kind = Type.Kind.Function;
        // TODO replace with raw$size and raw$align
        type.align = Type.Align.Bytes8;
        type.size = 8;

        type.signature = signature;

        bucket.value = type;
        return type;
    }

    export fn get_str_type(self: Types) => TypeArray {
        if (self.type_str == null) {
            self.type_str = self->get_array_type(self.type_char);
        }

        return self.type_str;
    }

    export fn get_cstr_type(self: Types) => TypeArray {
        if (self.type_cstr == null) {
            self.type_cstr = self->get_carray_type(self.type_char);
        }

        return self.type_cstr;
    }

    export fn get_array_type(self: Types, value_type: Type) => TypeArray {
        self->init_arrays_if_needed();

        bucket := self.arrays->get_or_insert(value_type, null);
        if (bucket.value != null) {
            return bucket.value;
        }

        type := TypeArray();
        type.kind = Type.Kind.Array;
        type.align = value_type.align;
        type.size = value_type.size;

        type.value = value_type;

        bucket.value = type;
        return type;
    }

    export fn get_carray_type(self: Types, value_type: Type) => TypeArray {
        self->init_carrays_if_needed();

        bucket := self.carrays->get_or_insert(value_type, null);
        if (bucket.value != null) {
            return bucket.value;
        }

        type := TypeArray();
        type.kind = Type.Kind.CArray;
        type.align = value_type.align;
        type.size = value_type.size;

        type.value = value_type;

        bucket.value = type;
        return type;
    }

    export fn get_tuple_type(self: Types, value_types: Type[]) => TypeTuple {
        self->init_tuples_if_needed();

        bucket := self.tuples->get_or_insert(value_types, null);
        if (bucket.value != null) {
            return bucket.value;
        }

        type := TypeTuple();
        type.kind = Type.Kind.Tuple;
        
        type->finalize(value_types);

        bucket.value = type;
        return type;
    }


}
