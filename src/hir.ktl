//🫖ketl

from token import Token
from type_base import Type
from type import Types
from namespace import Namespace
import io

export class HIR {

    enum Tag: u16 {
        NONE_STMT,
        BEGIN_STMT,

        LOGICAL_NOT,
        BITWISE_NOT,

        UNARY_PLUS,
        UNARY_MINUS,

        PLUS,
        MINUS,

        MULTY,
        DIVIDE,
        MOD,

        BITWISE_AND,
        BITWISE_OR,
        BITWISE_XOR,

        BITWISE_SHIFT_LEFT,
        BITWISE_SHIFT_RIGHT,

        COMPARE,
        TEST,

        EQUAL,
        NOT_EQUAL,
        LESS,
        ILESS,
        LESS_OR_EQUAL,
        ILESS_OR_EQUAL,
        GREATER,
        IGREATER,
        GREATER_OR_EQUAL,
        IGREATER_OR_EQUAL,

        ASSIGN,

        ASSIGN_PLUS,
        ASSIGN_MINUS,

        ASSIGN_MULTY,
        ASSIGN_DIVIDE,
        ASSIGN_MOD,

        ASSIGN_BITWISE_AND,
        ASSIGN_BITWISE_OR,
        ASSIGN_BITWISE_XOR,

        CALL,

        NEW_CLASS,
        NEW_ARRAY,
        NEW_SLICE,

        GET_ARRAY_VALUE,
        SET_ARRAY_VALUE,

        APPEND_VALUE,
        APPEND_ARRAY,

        JUMP,

        JUMP_IF_TRUE,
        JUMP_IF_FALSE,
        
        JUMP_IF_EQUAL,
        JUMP_IF_NOT_EQAUL,
        JUMP_IF_LESS,
        JUMP_IF_ILESS,
        JUMP_IF_LESS_OR_EQAUL,
        JUMP_IF_ILESS_OR_EQAUL,
        JUMP_IF_GREATER,
        JUMP_IF_IGREATER,
        JUMP_IF_GREATER_OR_EQAUL,
        JUMP_IF_IGREATER_OR_EQAUL,

        RETURN,
        RETURN_VALUE,
    }

    export fn is_terminator(tag: Tag) => bool {
        return tag >= Tag.JUMP;
    }

    export mimic InstrOffset = u32;
    export mimic VarId = u16;
    export mimic DeclId = u16;
    export mimic BlockId = u16;
    export mimic ConstId = u16;

////////////////////////////

    export class SrcInfo {
        export mimic Length = u32;

        var filename: str;
        var source_offset: Token.Offset;
        var length: Length;

        export fn construct(filename: str, source_offset: Token.Offset, length: Length) => SrcInfo {
            var self = SrcInfo();
            self.filename = filename;
            self.source_offset = source_offset;
            self.length = length;
            return self;
        }

        export fn from_token(filename: str, token: Token) => SrcInfo {
            var self = SrcInfo();
            self.filename = filename;
            self.source_offset = token.offset;
            self.length = token.length;
            return self;
        }

        export fn merge(lhs: SrcInfo, rhs: SrcInfo) => SrcInfo {
            var self = SrcInfo();
            assert(lhs.filename == rhs.filename);
            self.filename = lhs.filename;
            self.source_offset = lhs.source_offset;
            self.length = rhs->get_end_offset() - lhs.source_offset;
            return self;
        }

        export fn get_end_offset(self: SrcInfo) => Token.Offset {
            return self.source_offset + self.length;
        }
    }

    export class Instr {
        var tag: Tag;
        var src_info: SrcInfo;
    }

    export class InstrWithOutput {
        extend Instr;
        var output: VarId;
    }

    export class UnaryOp {
        extend InstrWithOutput;
        var arg: VarId;
    }

    export class BinaryOp {
        extend InstrWithOutput;
        var lhs: VarId;
        var rhs: VarId;
    }

    export class Call {
        extend InstrWithOutput;
        var callee: VarId;
        var args: VarId[];
    }

    export class New {
        extend InstrWithOutput;
        var type: Type;
        var args: VarId[];
    }

    export class NewArray {
        extend InstrWithOutput;
        var type: Type;
        var size: VarId;
        var initial_value: ConstId;
    }

    export class NewSlice {
        extend InstrWithOutput;
        var mirrored: VarId;
        var start: VarId;
        var end: VarId;
    }

    export class GetArrayValue {
        extend InstrWithOutput;
        var array: VarId;
        var index: VarId;
    }

    export class SetArrayValue {
        extend InstrWithOutput;
        var array: VarId;
        var index: VarId;
        var value: VarId;
    }

    export class Append {
        extend Instr;
        var array: VarId;
        var appendee: VarId;
    }

    export class Assign {
        extend Instr;
        var dst: VarId;
        var src: VarId;
    }

    export class Jump {
        extend Instr;
        var dst: BlockId;
    }

    export class JumpIf {
        extend Instr;
        var expr: VarId;
        var true_dst: BlockId;
        var false_dst: BlockId;
    }

    export class ReturnValue {
        extend Instr;
        var value: VarId;
    }

////////////////////////

    export class Decl {
        export enum Kind: u8 {
            Error,
            Common,
            Parameter,
            InstrResult,
        }

        var kind: Kind;
        var name: str;

        export fn get_type(decl: Decl) => Type {
            switch (decl.kind) {
                case Kind.Error => return null;
                case Kind.Common
                case Kind.Parameter
                case Kind.InstrResult => return decl$cast(DeclWithType).type;
            }
            return null;
        }

        export fn get_src_info(decl: Decl) => SrcInfo {
            switch (decl.kind) {
                case Kind.Error => return null;
                case Kind.Common => return decl$cast(DeclCommon).src_info;
                case Kind.Parameter => return decl$cast(DeclParameter).src_info;
                case Kind.InstrResult => return decl$cast(DeclInstrResult).instr.src_info;
            }
            return null;
        }
    }

    export class DeclWithType {
        extend Decl;
        var type: Type;
    }

    export class DeclCommon {
        extend DeclWithType;
        var src_info: SrcInfo;
    }

    export class DeclParameter {
        extend DeclWithType;
        var src_info: SrcInfo;
    }

    export class DeclInstrResult {
        extend DeclWithType;
        var instr: HIR.Instr;
    }


    export class Var {
        export enum Kind: u8 {
            Error,
            Common,
            Global,
            Literal,
            LiteralType,
            Sequence,
            Cast,
            Field,
        } 

        var kind: Kind;
        var src_info: SrcInfo;

        export fn get_type(varr: Var) => Type {
            switch (varr.kind) {
                case Kind.Common
                case Kind.Literal
                case Kind.Cast
                case Kind.Field => return varr$cast(VarWithType).type;
                case Kind.Global => return varr$cast(VarGlobal).node.value.type;
            }
            return null;
        }

        export fn get_type_forced(varr: Var) => Type {
            if (varr.kind == HIR.Var.Kind.Literal) {
                var type = varr$cast(HIR.VarWithType).type;
                if (type != null) {
                    return type;
                }
                // TODO check value for range
                return Types.instance.type_i64;
            }

            return varr->get_type();
        }
    }

    export class VarWithType {
        extend Var;
        var type: Type;
    }

    export class VarCommon {
        extend VarWithType;
        var decl: DeclId;
    }

    export class VarGlobal {
        extend Var;
        var node: Namespace.Node;
    }

    export class VarLiteral {
        extend VarWithType;
        var value: u64;
    }

    export class VarLiteralType {
        extend Var;
        var value: Type;
    }

    export class VarSequence {
        extend Var;
        var values: HIR.VarId[];
    }

    export class VarCast {
        extend VarWithType;
        var casted: VarId;
    }

    export class VarField {
        extend VarWithType;
        var object: VarId;
        var field: str;
        var offset: u16;
    }

    export class Const {
        var offset: u32;
        var mem_size: u32;
        var literal_size: u32;
        var name: str;
        var is_string: bool;
    }

    var instrs: Instr[];
    var vars: Var[];
    var decls: Decl[];
    var block_offsets: InstrOffset[];
    var consts_infos: Const[];
    var consts_literals: u8[];

    var return_type: Type;
    var parameters_count: u8;
    var max_call_arg_count: u8;
    var entry: str;
    var entry_info: SrcInfo;

    export fn get_first_non_empty_block(hir: HIR, block: BlockId) => BlockId {
        while (true) {
            assert(block < hir.block_offsets.size);
            var instr_offset = hir.block_offsets[block];
            assert(instr_offset < hir.instrs.size);
            var instr = hir.instrs[instr_offset];
            while ((instr.tag == Tag.NONE_STMT || instr.tag == Tag.BEGIN_STMT) &&
                (instr_offset += 1) < hir.instrs.size) {
                instr = hir.instrs[instr_offset];
            }
            if (instr.tag != Tag.JUMP) {
                return block;
            }
            var jump = instr$cast(HIR.Jump);
            block = jump.dst;
        }

        assert(false);
        return 0;
    }

    export fn get_constant(hir: HIR, constant_id: HIR.ConstId) => HIR.Const {
        if (constant_id < hir.consts_infos.size) {
            return hir.consts_infos[constant_id];
        }

        return null;
    }

    fn print_var(hir: HIR, var_id: HIR.VarId) {
        var varr = hir.vars[var_id];
        switch (varr.kind) {
            default => io.error("<unknown " .. varr.kind$cast(str) .. ">");
            case HIR.Var.Kind.Common => {
                var decl_id = varr$cast(HIR.VarCommon).decl;
                var decl = hir.decls[decl_id];
                io.error(decl.name);
            }
            case HIR.Var.Kind.Global => io.error(varr$cast(HIR.VarGlobal).node.name$cast(str));
            case HIR.Var.Kind.Literal => io.error(varr$cast(HIR.VarLiteral).value$cast(str));
            case HIR.Var.Kind.Cast => {
                var var_cast = varr$cast(HIR.VarCast);
                hir->print_var(var_cast.casted);
                // TODO show that it casted?
            }
            case HIR.Var.Kind.Field => {
                var var_field = varr$cast(HIR.VarField);
                hir->print_var(var_field.object);
                io.error("." .. var_field.field);
            }
        }
    }

    fn get_str_representation(tag: HIR.Tag) => str {
        switch (tag) {
            case HIR.Tag.LOGICAL_NOT       => return "!";
            case HIR.Tag.BITWISE_NOT       => return "~";

            case HIR.Tag.UNARY_PLUS        => return "+";
            case HIR.Tag.UNARY_MINUS       => return "-";

            case HIR.Tag.PLUS              => return "+";
            case HIR.Tag.MINUS             => return "-";

            case HIR.Tag.MULTY             => return "*";
            case HIR.Tag.DIVIDE            => return "/";
            case HIR.Tag.MOD               => return "%";
            
            case HIR.Tag.EQUAL             => return "==";
            case HIR.Tag.NOT_EQUAL         => return "!=";
            case HIR.Tag.LESS   
            case HIR.Tag.ILESS             => return "<";
            case HIR.Tag.LESS_OR_EQUAL
            case HIR.Tag.ILESS_OR_EQUAL    => return "<=";
            case HIR.Tag.GREATER
            case HIR.Tag.IGREATER          => return ">=";
            case HIR.Tag.GREATER_OR_EQUAL
            case HIR.Tag.IGREATER_OR_EQUAL => return ">=";

            case HIR.Tag.ASSIGN            => return "=";
            
            case HIR.Tag.ASSIGN_PLUS            => return "+=";
            case HIR.Tag.ASSIGN_MINUS            => return "-=";
            
            case HIR.Tag.ASSIGN_MULTY            => return "*=";
            case HIR.Tag.ASSIGN_DIVIDE            => return "/=";
            case HIR.Tag.ASSIGN_MOD            => return "%=";
            
            case HIR.Tag.ASSIGN_BITWISE_AND            => return "&=";
            case HIR.Tag.ASSIGN_BITWISE_OR            => return "|=";
            case HIR.Tag.ASSIGN_BITWISE_XOR            => return "^=";
        }

        return "[" .. tag$cast(str) .. "]";
    }

    fn print_instr(hir: HIR, instr: HIR.Instr) {
        switch (instr.tag) {
            default => {
                io.error("unknown tag: ");
                io.error(instr.tag$cast(str));
            }
            case HIR.Tag.NONE_STMT => io.error("none");
            case HIR.Tag.BEGIN_STMT => io.error("@begin_stmt");

            case HIR.Tag.LOGICAL_NOT
            case HIR.Tag.BITWISE_NOT

            case HIR.Tag.UNARY_PLUS
            case HIR.Tag.UNARY_MINUS => {
                var hir_info = instr$cast(HIR.UnaryOp);
                hir->print_var(hir_info.output);
                io.error(" = ");
                io.error(get_str_representation(instr.tag));
                io.error(" ");
                hir->print_var(hir_info.arg);
            }

            case HIR.Tag.PLUS 
            case HIR.Tag.MINUS 

            case HIR.Tag.MULTY 
            case HIR.Tag.DIVIDE 
            case HIR.Tag.MOD

/*
            case HIR.Tag.BITWISE_AND =>
            case HIR.Tag.BITWISE_OR =>
            case HIR.Tag.BITWISE_XOR =>

            case HIR.Tag.COMPARE =>
            case HIR.Tag.TEST =>
            */

            case HIR.Tag.EQUAL
            case HIR.Tag.NOT_EQUAL
            case HIR.Tag.LESS
            case HIR.Tag.ILESS
            case HIR.Tag.LESS_OR_EQUAL
            case HIR.Tag.ILESS_OR_EQUAL
            case HIR.Tag.GREATER
            case HIR.Tag.IGREATER
            case HIR.Tag.GREATER_OR_EQUAL
            case HIR.Tag.IGREATER_OR_EQUAL => {
                var hir_info = instr$cast(HIR.BinaryOp);
                hir->print_var(hir_info.output);
                io.error(" = ");
                hir->print_var(hir_info.lhs);
                io.error(" ");
                io.error(get_str_representation(instr.tag));
                io.error(" ");
                hir->print_var(hir_info.rhs);
            }

            case HIR.Tag.ASSIGN

            case HIR.Tag.ASSIGN_PLUS
            case HIR.Tag.ASSIGN_MINUS

            case HIR.Tag.ASSIGN_MULTY
            case HIR.Tag.ASSIGN_DIVIDE
            case HIR.Tag.ASSIGN_MOD

            case HIR.Tag.ASSIGN_BITWISE_AND
            case HIR.Tag.ASSIGN_BITWISE_OR
            case HIR.Tag.ASSIGN_BITWISE_XOR  => {
                var hir_info = instr$cast(HIR.Assign);
                hir->print_var(hir_info.dst);
                io.error(" ");
                io.error(get_str_representation(instr.tag));
                io.error(" ");
                hir->print_var(hir_info.src);
            }

            case HIR.Tag.CALL => {
                var hir_info = instr$cast(HIR.Call);
                hir->print_var(hir_info.output);
                io.error(" = ");
                hir->print_var(hir_info.callee);
                io.error("(");
                for (var arg <- hir_info.args) {
                    hir->print_var(arg);
                    io.error(", ");
                }
                io.error(")");
            }

            case HIR.Tag.NEW_CLASS => {
                var hir_info = instr$cast(HIR.New);
                hir->print_var(hir_info.output);
                io.error(" = ");
                io.error(hir_info.type->get_full_name());
                io.error("(");
                for (var arg <- hir_info.args) {
                    hir->print_var(arg);
                    io.error(", ");
                }
                io.error(")");
            }
            case HIR.Tag.NEW_ARRAY => {
                var hir_info = instr$cast(HIR.NewArray);
                hir->print_var(hir_info.output);
                io.error(" = ");
                io.error(hir_info.type->get_full_name());
                io.error("[");
                hir->print_var(hir_info.size);
                io.error("]");

                if (hir_info.initial_value != (-1)$cast(HIR.ConstId)) {
                    var constant = hir->get_constant(hir_info.initial_value);
                    assert(constant.is_string);

                    io.error("\"");
                    for (var symbol <- hir.consts_literals[constant.offset:constant.offset + constant.literal_size]) {
                        io.error("" .. symbol);
                    }
                    io.error("\"");
                }
            }
            case HIR.Tag.NEW_SLICE => {
                var hir_info = instr$cast(HIR.NewSlice);
                hir->print_var(hir_info.output);
                io.error(" = ");
                hir->print_var(hir_info.mirrored);
                io.error("[");
                hir->print_var(hir_info.start);
                io.error(":");
                hir->print_var(hir_info.end);
                io.error("]");
            }

            case HIR.Tag.GET_ARRAY_VALUE => {
                var hir_info = instr$cast(HIR.GetArrayValue);
                hir->print_var(hir_info.output);
                io.error(" = ");
                hir->print_var(hir_info.array);
                io.error("[");
                hir->print_var(hir_info.index);
                io.error("]");
            }
            case HIR.Tag.SET_ARRAY_VALUE => {
                var hir_info = instr$cast(HIR.SetArrayValue);
                hir->print_var(hir_info.output);
                io.error(" = ");
                hir->print_var(hir_info.array);
                io.error("[");
                hir->print_var(hir_info.index);
                io.error("] = ");
                hir->print_var(hir_info.value);
            }

/*
            case HIR.Tag.APPEND_VALUE =>
            */

            case HIR.Tag.JUMP => {
                var hir_info = instr$cast(HIR.Jump);
                io.error("jump BB");
                io.error(hir_info.dst$cast(str));
            }

            case HIR.Tag.JUMP_IF_TRUE => {
                var hir_info = instr$cast(HIR.JumpIf);
                io.error("jump if ");
                hir->print_var(hir_info.expr);
                io.error(" to BB");
                io.error(hir_info.true_dst$cast(str));
                io.error(" or BB");
                io.error(hir_info.false_dst$cast(str));
            }
            case HIR.Tag.JUMP_IF_FALSE => {
                var hir_info = instr$cast(HIR.JumpIf);
                io.error("jump if not ");
                hir->print_var(hir_info.expr);
                io.error(" to BB");
                io.error(hir_info.true_dst$cast(str));
                io.error(" or BB");
                io.error(hir_info.false_dst$cast(str));
            }

            /*
            case HIR.Tag.JUMP_IF_EQUAL =>
            case HIR.Tag.JUMP_IF_NOT_EQAUL =>
            case HIR.Tag.JUMP_IF_LESS =>
            case HIR.Tag.JUMP_IF_ILESS =>
            case HIR.Tag.JUMP_IF_LESS_OR_EQAUL =>
            case HIR.Tag.JUMP_IF_ILESS_OR_EQAUL =>
            case HIR.Tag.JUMP_IF_GREATER =>
            case HIR.Tag.JUMP_IF_IGREATER =>
            case HIR.Tag.JUMP_IF_GREATER_OR_EQAUL =>
            case HIR.Tag.JUMP_IF_IGREATER_OR_EQAUL =>

            */

            case HIR.Tag.RETURN => io.error("return");
            case HIR.Tag.RETURN_VALUE => {
                var hir_info = instr$cast(HIR.ReturnValue);
                io.error("return ");
                hir->print_var(hir_info.value);
            }
        }
    }

    export fn print(hir: HIR) {
        var tab_size: u32 = 4;
        var tab = "";
        while (tab_size > 0) {
            tab ..= " ";
            tab_size -= 1;
        }

        var block: BlockId;

        while (block < hir.block_offsets.size) {
            io.error("BB");
            io.error(block$cast(str));
            io.errorln(":");

            var end_offset: HIR.InstrOffset;
            if (block + 1 < hir.block_offsets.size) {
                end_offset = hir.block_offsets[block + 1];
            } else {
                end_offset = hir.instrs.size$cast(HIR.InstrOffset);
            }

            var i = hir.block_offsets[block];
            while (i < end_offset) {
                io.error(tab);
                io.error(i$cast(str));
                io.error(": ");

                var instr = hir.instrs[i];

                hir->print_instr(instr);
                io.errorln("");

                i += 1;
            }

            block += 1;
        }

        io.errorln("");
    }
}
